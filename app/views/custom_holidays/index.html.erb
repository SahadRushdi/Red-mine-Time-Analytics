<div class="contextual">
  <%= link_to 'Extract Holidays from CSV', '#', class: 'icon icon-file', 
      onclick: "document.getElementById('csv-upload-modal').style.display='block'; return false;" %>
  <%= link_to 'New Holiday', new_custom_holiday_path, class: 'icon icon-add' %>
</div>

<h2>Holidays</h2>

<p class="subtitle"> Define custom holidays and office closures. </p>

<!-- CSV Upload Modal -->
<div id="csv-upload-modal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="document.getElementById('csv-upload-modal').style.display='none'">&times;</span>
    <h3>Import Holidays from CSV</h3>
    <p>Upload a CSV file with the following format:</p>
    <p><strong>Name, Start Date, End Date (optional), Description (optional)</strong></p>
    <p style="font-size: 12px; color: #666;">
      • First row must contain headers: Name, Start Date, End Date, Description<br>
      • Name and Start Date are required (format: YYYY-MM-DD or MM/DD/YYYY)<br>
      • End Date is optional - if empty, holiday is treated as 1 day<br>
      • For multi-day holidays (e.g., New Year 5 days), provide both start and end dates<br>
      • Description is optional
    </p>
    <div style="background: #f5f5f5; padding: 10px; margin: 10px 0; font-family: monospace; font-size: 12px;">
      Example CSV content:<br>
      Name,Start Date,End Date,Description<br>
      Independence Day, 2026-02-04, , National holiday<br>
      Sinhala & Tamil New Year, 2026-04-13, 2026-04-17, 5 day holiday<br>
      Christmas Day, 2026-12-25
    </div>
    <%= form_tag import_csv_custom_holidays_path, method: :post, multipart: true do %>
      <p>
        <%= file_field_tag :csv_file, accept: '.csv', required: true %>
      </p>
      <p>
        <%= submit_tag 'Import', class: 'button' %>
        <button type="button" class="button" onclick="document.getElementById('csv-upload-modal').style.display='none'">Cancel</button>
      </p>
    <% end %>
  </div>
</div>

<% if @holidays.any? %>
  <% 
    # Group holidays by year
    holidays_by_year = @holidays.group_by { |h| h.start_date.year }.sort_by { |year, _| -year }
  %>
  
  <% holidays_by_year.each do |year, year_holidays| %>
    <h3 style="margin-top: 30px; color: #555; border-bottom: 2px solid #ddd; padding-bottom: 5px;">
      <%= year %> (<%= year_holidays.count %> <%= year_holidays.count == 1 ? 'holiday' : 'holidays' %>)
    </h3>
    
    <table class="list holidays">
      <thead>
        <tr>
          <th>Name</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Duration</th>
          <th>Description</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% year_holidays.each do |holiday| %>
          <tr class="<%= cycle('odd', 'even') %> <%= 'inactive' unless holiday.active %>">
            <td><%= holiday.name %></td>
            <td><%= format_date(holiday.start_date) %></td>
            <td><%= format_date(holiday.end_date) %></td>
            <td class="center">
              <%= holiday.duration_days %> 
              <%= holiday.duration_days == 1 ? 'day' : 'days' %>
            </td>
            <td><%= truncate(holiday.description, length: 50) %></td>
            <td class="center">
              <%= holiday.active ? content_tag(:span, 'Active', class: 'badge badge-success') : content_tag(:span, 'Inactive', class: 'badge badge-secondary') %>
            </td>
            <td class="buttons">
              <%= link_to 'Edit', edit_custom_holiday_path(holiday), class: 'icon icon-edit' %>
              <%= link_to 'Delete', custom_holiday_path(holiday), 
                  method: :delete, 
                  data: { confirm: 'Are you sure you want to delete this holiday?' },
                  class: 'icon icon-del' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% else %>
  <p class="nodata">No holidays have been defined yet.</p>
<% end %>

<style>
  table.holidays td.center { text-align: center; }
  table.holidays tr.inactive { opacity: 0.6; }
  .badge {
    display: inline-block;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
    border-radius: 3px;
  }
  .badge-success {
    background-color: #28a745;
    color: white;
  }
  .badge-secondary {
    background-color: #6c757d;
    color: white;
  }
  .subtitle {
    font-style: italic;
    color: #666;
    margin-bottom: 20px;
  }
  
  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.4);
  }
  
  .modal-content {
    background-color: #fefefe;
    margin: 5% auto;
    padding: 20px;
    border: 1px solid #888;
    width: 80%;
    max-width: 600px;
    border-radius: 5px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
  }
  
  .close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
  }
  
  .close:hover,
  .close:focus {
    color: #000;
  }
  
  .modal-content h3 {
    margin-top: 0;
  }
  
  .modal-content p {
    margin: 10px 0;
  }
  
  .button {
    padding: 6px 12px;
    margin-right: 5px;
  }
  /* Ensure consistent button size for modal actions */
  .modal-content .button {
    width: 80px;
    height: 30px;
    box-sizing: border-box; /* Include padding and border in the element's total width and height */
    display: inline-flex; /* Use flex to vertically align text if needed */
    align-items: center;
    justify-content: center;
  }
</style>
