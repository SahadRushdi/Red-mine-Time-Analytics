<% html_title l(:label_titles) %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <style>
    /* Tabs (Active / Locked) — no Redmine theme bleed */
    .ta-titles-tab,
    .ta-titles-tab:hover,
    .ta-titles-tab:focus,
    .ta-titles-tab:focus-visible,
    .ta-titles-tab:active {
      border: 0 !important;
      outline: none !important;
      box-shadow: none !important;
      background: transparent !important;
      color: #6b7280 !important;
      -webkit-tap-highlight-color: transparent;
    }
    .ta-titles-tab.ta-titles-tab--active,
    .ta-titles-tab.ta-titles-tab--active:hover,
    .ta-titles-tab.ta-titles-tab--active:focus,
    .ta-titles-tab.ta-titles-tab--active:active {
      background: #eff6ff !important;
      color: #2563eb !important;
    }
    .ta-titles-tab-badge {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 22px; height: 20px; padding: 0 7px; margin-left: 6px;
      font-size: 11px; font-weight: 700; line-height: 1; border-radius: 9999px;
      background-color: #e5e7eb; color: #374151; box-sizing: border-box;
      font-variant-numeric: tabular-nums;
    }
    .ta-titles-tab.ta-titles-tab--active .ta-titles-tab-badge { background-color: #2563eb; color: #fff; }
    #ta-titles-locked-tab.ta-titles-tab--active .ta-titles-tab-badge { background-color: #d97706; }
    #ta-titles-locked-tab.ta-titles-tab--active { background: #fffbeb !important; color: #b45309 !important; }

    /* Sortable column headers — kill blue focus/active border + bg */
    .ta-titles-sort,
    .ta-titles-sort:hover,
    .ta-titles-sort:focus,
    .ta-titles-sort:focus-visible,
    .ta-titles-sort:active {
      border: 0 !important;
      outline: none !important;
      box-shadow: none !important;
      background: transparent !important;
      background-image: none !important;
      text-decoration: none !important;
      color: #6b7280 !important;
      cursor: pointer;
    }
    .ta-titles-sort:hover { color: #111827 !important; }

    /* Title selector (per-row + bulk) — Flowbite-style trigger, no theme bleed */
    .ta-title-trigger,
    .ta-title-trigger:hover,
    .ta-title-trigger:focus,
    .ta-title-trigger:focus-visible,
    .ta-title-trigger:active {
      display: inline-flex; align-items: center; justify-content: space-between; gap: 0.5rem;
      width: 320px; max-width: 100%; height: 40px; padding: 0 0.75rem;
      border: 1px solid #d1d5db !important; border-radius: 0.5rem !important;
      background: #ffffff !important; background-image: none !important;
      color: #111827 !important; font-size: 0.875rem !important; font-weight: 400 !important;
      box-shadow: none !important; outline: none !important; text-align: left; cursor: pointer;
    }
    .ta-title-trigger:hover { background: #f9fafb !important; }
    .ta-title-trigger:focus, .ta-title-trigger.is-open { border-color: #3b82f6 !important; }
    .ta-title-trigger-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ta-title-trigger--placeholder .ta-title-trigger-label { color: #6b7280 !important; }

    /* Shared floating menu + option items (titles, per-page) */
    #ta-titles-menu { box-sizing: border-box; }
    .ta-titles-menu-option,
    .ta-titles-menu-option:link,
    .ta-titles-menu-option:visited {
      display: block; width: 100%; text-align: left;
      padding: 0.5rem 1rem; font-size: 0.875rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      color: #374151 !important; background: #ffffff !important;
      border: 0 !important; box-shadow: none !important; outline: none !important;
      background-image: none !important; text-decoration: none !important; cursor: pointer;
    }
    .ta-titles-menu-option:hover,
    .ta-titles-menu-option:focus,
    .ta-titles-menu-option:focus-visible,
    .ta-titles-menu-option:active {
      background: #f3f4f6 !important; color: #111827 !important;
      border: 0 !important; box-shadow: none !important; outline: none !important;
    }
    .ta-titles-menu-option--active,
    .ta-titles-menu-option--active:hover,
    .ta-titles-menu-option--active:focus {
      background: #eff6ff !important; color: #2563eb !important; font-weight: 600;
    }

    /* Plain neutral button (per-page trigger) — no blue hover/active bleed */
    .ta-titles-plain-btn,
    .ta-titles-plain-btn:hover,
    .ta-titles-plain-btn:focus,
    .ta-titles-plain-btn:focus-visible,
    .ta-titles-plain-btn:active {
      background: #ffffff !important; background-image: none !important;
      color: #111827 !important; border: 1px solid #d1d5db !important;
      box-shadow: none !important; outline: none !important; text-decoration: none !important;
    }
    .ta-titles-plain-btn:hover { background: #f9fafb !important; }

    .ta-titles-search.ts-search-input { min-height: 42px; }

    /* Pagination links — neutral, no theme bleed */
    .ta-titles-pagination-link,
    .ta-titles-pagination-link:hover,
    .ta-titles-pagination-link:focus,
    .ta-titles-pagination-link:active {
      display: flex; align-items: center; justify-content: center;
      padding: 0 0.75rem; height: 2rem; line-height: 2rem;
      border: 1px solid #d1d5db !important; background: #fff !important; color: #6b7280 !important;
      background-image: none !important; box-shadow: none !important; outline: none !important;
    }
    .ta-titles-pagination-link:hover { background: #f3f4f6 !important; color: #374151 !important; }
    .ta-titles-pagination-link--current,
    .ta-titles-pagination-link--current:hover,
    .ta-titles-pagination-link--current:focus {
      color: #2563eb !important; background: #eff6ff !important;
    }
    .ta-titles-pagination-link--disabled,
    .ta-titles-pagination-link--disabled:hover {
      color: #d1d5db !important; background: #f9fafb !important; cursor: not-allowed;
    }

    /* Manage Titles modal — close button styled like the Create Hire modal */
    #taManageTitlesModal .tep-delete-close,
    #taManageTitlesModal .tep-delete-close:hover,
    #taManageTitlesModal .tep-delete-close:focus,
    #taManageTitlesModal .tep-delete-close:active {
      border: none !important; background: transparent !important; box-shadow: none !important; outline: none !important;
    }
    #taManageTitlesModal .tep-delete-close:hover { background-color: #f3f4f6 !important; color: #111827 !important; }
    /* Trash (delete) icon buttons — never show a blue border/outline */
    .ta-titles-delete-btn,
    .ta-titles-delete-btn:hover,
    .ta-titles-delete-btn:focus,
    .ta-titles-delete-btn:focus-visible,
    .ta-titles-delete-btn:active {
      border: 0 !important; outline: none !important; box-shadow: none !important;
      background: transparent !important; background-image: none !important;
    }
    /* Add-title input: soft blue focus, never a heavy blue border */
    #ta-titles-new-input:focus { border-color: #3b82f6 !important; box-shadow: none !important; outline: none !important; }
  </style>
<% end %>

<div class="space-y-6">
  <%# ---- Page header ---- %>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-0 text-2xl font-bold text-gray-900"><%= l(:label_titles) %></h2>
    </div>
    <div class="flex items-center gap-2">
      <button type="button"
              data-modal-target="taManageTitlesModal"
              data-modal-toggle="taManageTitlesModal"
              class="ta-btn-primary inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span><%= l(:label_manage_titles) %></span>
      </button>
    </div>
  </div>

  <%# ---- Assign titles card ---- %>
  <div class="rounded-2xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-gray-200 px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-50 text-blue-600">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H4v-2a4 4 0 015-3.87m5-4a4 4 0 100-8 4 4 0 000 8zm-7 0a4 4 0 100-8 4 4 0 000 8z"></path>
          </svg>
        </span>
        <div>
          <h3 class="text-base font-semibold text-gray-900"><%= l(:label_assign_titles) %></h3>
          <p class="text-xs text-gray-500">
            <span id="ta-titles-active-count"><%= @active_count %></span> <%= l(:label_active).downcase %> ·
            <span id="ta-titles-locked-count"><%= @locked_count %></span> <%= l(:label_locked).downcase %>
          </p>
        </div>
      </div>

      <div class="relative w-full" style="max-width: 340px;">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z"/></svg>
        </div>
        <input type="search" id="ta-titles-search" class="ta-titles-search ts-search-input block w-full border border-gray-300" placeholder="<%= l(:label_search) %> <%= l(:label_user).downcase %>s…">
      </div>
    </div>

    <%# ---- Tab row: tabs on the left, per-page dropdown on the right ---- %>
    <div class="flex flex-col gap-3 border-b border-gray-200 px-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
      <ul class="-mb-px flex flex-wrap gap-2 text-sm font-medium">
        <li>
          <button type="button" id="ta-titles-active-tab" data-titles-tab="active"
                  class="ta-titles-tab ta-titles-tab--active inline-flex items-center rounded-t-lg px-4 py-3">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span><%= l(:label_active) %></span>
            <span class="ta-titles-tab-badge"><%= @active_count %></span>
          </button>
        </li>
        <li>
          <button type="button" id="ta-titles-locked-tab" data-titles-tab="locked"
                  class="ta-titles-tab inline-flex items-center rounded-t-lg px-4 py-3">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span><%= l(:label_locked) %></span>
            <span class="ta-titles-tab-badge"><%= @locked_count %></span>
          </button>
        </li>
      </ul>

      <div class="pb-2 sm:pb-0">
        <button type="button" id="ta-titles-per-page-button" style="min-width:84px" class="ta-titles-plain-btn inline-flex h-9 items-center justify-between gap-2 rounded-lg px-3 text-sm font-medium">
          <span id="ta-titles-per-page-label">10</span>
          <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
      </div>
    </div>

    <div class="p-4">
      <%# Locked-accounts notice (locked tab only) %>
      <%# Bulk-assign bar (shown when rows are selected) %>
      <div id="ta-titles-bulk-bar" class="hidden mb-4 flex flex-wrap items-center gap-3 rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        <span id="ta-titles-bulk-count" class="font-semibold"></span>
        <label class="text-blue-800"><%= l(:label_set_title_for_selected) %>:</label>
        <button type="button" id="ta-titles-bulk-trigger" class="ta-title-trigger" data-title-id="">
          <span id="ta-titles-bulk-label" class="ta-title-trigger-label"></span>
          <svg class="h-4 w-4 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <button type="button" id="ta-titles-bulk-apply" class="ta-btn-primary inline-flex h-9 items-center rounded-lg px-4 text-sm font-semibold"><%= l(:button_apply) %></button>
        <button type="button" id="ta-titles-bulk-clear" class="ta-btn-secondary inline-flex h-9 items-center rounded-lg px-4 text-sm font-medium"><%= l(:button_clear) %></button>
      </div>

      <div class="overflow-x-auto rounded-xl border border-gray-200">
        <table class="w-full text-left text-sm text-gray-600">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-3 w-10">
                <input type="checkbox" id="ta-titles-select-all" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              </th>
              <th class="px-4 py-3">
                <button type="button" class="ta-titles-sort inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide" data-sort-key="login">
                  <span><%= l(:field_login) %></span><span class="ta-titles-sort-ind text-[10px]"></span>
                </button>
              </th>
              <th class="px-4 py-3">
                <button type="button" class="ta-titles-sort inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide" data-sort-key="name">
                  <span><%= l(:label_user) %></span><span class="ta-titles-sort-ind text-[10px]"></span>
                </button>
              </th>
              <th class="px-4 py-3">
                <button type="button" class="ta-titles-sort inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide" data-sort-key="status">
                  <span><%= l(:label_status) %></span><span class="ta-titles-sort-ind text-[10px]"></span>
                </button>
              </th>
              <th class="px-4 py-3">
                <button type="button" class="ta-titles-sort inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide" data-sort-key="title">
                  <span><%= l(:label_title) %></span><span class="ta-titles-sort-ind text-[10px]"></span>
                </button>
              </th>
            </tr>
          </thead>
          <tbody id="ta-titles-tbody" class="divide-y divide-gray-100"></tbody>
        </table>
      </div>

      <div class="flex flex-col gap-3 border-t border-gray-200 px-1 py-3 sm:flex-row sm:items-center sm:justify-between">
        <span id="ta-titles-info" class="text-sm text-gray-500"></span>
        <nav aria-label="Titles pagination">
          <ul id="ta-titles-pagination" class="inline-flex -space-x-px text-sm"></ul>
        </nav>
      </div>

      <span id="ta-titles-available" class="block px-1 pb-1 text-right text-xs text-gray-400"><%= l(:label_titles_available, count: @titles.size) %></span>
    </div>
  </div>
</div>

<%# ============================ Manage Titles modal (white header) ============================ %>
<div id="taManageTitlesModal" tabindex="-1" aria-hidden="true"
     class="hidden fixed top-0 right-0 left-0 z-[9999] justify-center items-center w-full h-full bg-gray-900/50"
     data-create-url="<%= admin_ta_hiring_titles_path %>"
     data-csrf-token="<%= form_authenticity_token %>">
  <div class="relative p-4 w-full max-w-xl">
    <div class="relative bg-white rounded-2xl shadow-xl overflow-hidden">
      <div class="flex items-center justify-between p-4 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900"><%= l(:label_manage_titles) %></h3>
        <button type="button" data-modal-hide="taManageTitlesModal"
                class="tep-delete-close text-gray-400 bg-transparent rounded-lg text-sm p-1.5 ml-auto inline-flex items-center">
          <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
          </svg>
          <span class="sr-only">Close modal</span>
        </button>
      </div>

      <div class="p-4 space-y-4">
        <div class="flex items-center gap-2">
          <input type="text" id="ta-titles-new-input" maxlength="255"
                 class="ts-search-input !h-[43px] !w-full !rounded-lg !border !border-gray-300 !pl-3 !text-sm"
                 placeholder="<%= l(:label_add_title) %>">
          <button type="button" id="ta-titles-add-btn"
                  class="ta-btn-primary inline-flex h-[43px] flex-shrink-0 items-center gap-2 rounded-lg px-4 text-sm font-semibold">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"></path></svg>
            <span><%= l(:button_add) %></span>
          </button>
        </div>

        <div class="max-h-80 overflow-y-auto rounded-lg border border-gray-200">
          <ul id="ta-titles-manage-list" class="divide-y divide-gray-100">
            <% @titles.each do |title| %>
              <li class="flex items-center justify-between px-4 py-3 hover:bg-gray-50">
                <span class="flex items-center gap-2 text-sm text-gray-700">
                  <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                  <%= h title.title %>
                </span>
                <button type="button" class="ta-titles-delete-btn ta-inline-icon-btn ta-inline-icon-btn--danger"
                        title="<%= l(:button_delete) %>"
                        data-delete-url="<%= admin_ta_hiring_title_path(title) %>"
                        data-title-label="<%= h title.title %>">
                  <span class="material-icons ta-inline-material-icon">delete</span>
                </button>
              </li>
            <% end %>
          </ul>
          <% if @titles.empty? %>
            <p class="px-4 py-6 text-center text-sm text-gray-500"><%= l(:label_no_data) %></p>
          <% end %>
        </div>
      </div>

      <div class="flex items-center justify-between gap-2 p-4 border-t border-gray-200">
        <span class="text-xs text-gray-400"><%= l(:label_titles_defined, count: @titles.size) %></span>
        <button type="button" data-modal-hide="taManageTitlesModal"
                class="ta-btn-primary inline-flex items-center rounded-lg px-5 py-2 text-sm font-semibold"><%= l(:button_close) %></button>
      </div>
    </div>
  </div>
</div>

<%# Confirm-delete modal for a title %>
<div id="taTitleDeleteModal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 right-0 left-0 z-[10060] justify-center items-center w-full h-full bg-gray-900/50">
  <div class="relative p-4 w-full max-w-md">
    <div class="relative p-4 text-center bg-white rounded-lg shadow sm:p-5">
      <svg class="text-gray-400 w-11 h-11 mb-3.5 mx-auto" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <p id="ta-titles-delete-message" class="mb-4 text-gray-500"><%= l(:text_are_you_sure) %></p>
      <div class="flex justify-center items-center space-x-4">
        <button type="button" id="ta-titles-delete-confirm" class="py-2 px-3 text-sm font-medium text-center text-white rounded-lg bg-red-600 hover:bg-red-700"><%= l(:button_delete) %></button>
        <button type="button" id="ta-titles-delete-cancel" class="ta-btn-secondary py-2 px-3 text-sm font-medium rounded-lg"><%= l(:button_cancel) %></button>
      </div>
    </div>
  </div>
</div>

<%# Shared floating dropdown for title + per-page selection %>
<div id="ta-titles-menu" class="hidden fixed z-[10080] max-h-64 overflow-y-auto overflow-x-hidden rounded-lg border border-gray-200 bg-white py-1 shadow-xl"></div>

<div id="ta-titles-toast" style="bottom:1.25rem;right:1.25rem" class="hidden fixed z-[10090] rounded-lg bg-gray-900 px-4 py-3 text-sm font-medium text-white shadow-lg"></div>

<script type="application/json" id="ta-titles-active-data"><%= raw @active_users_data.to_json %></script>
<script type="application/json" id="ta-titles-locked-data"><%= raw @locked_users_data.to_json %></script>
<script type="application/json" id="ta-titles-list"><%= raw @titles.map { |t| { id: t.id, name: t.title } }.to_json %></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var csrf = '<%= j form_authenticity_token %>';
  var assignUrl = '<%= j assign_admin_ta_titles_path %>';

  function readJSON(id) {
    var el = document.getElementById(id);
    try { return el ? JSON.parse(el.textContent) : []; } catch (e) { return []; }
  }

  var titles = readJSON('ta-titles-list');
  var titleNameById = {};
  titles.forEach(function (t) { titleNameById[t.id] = t.name; });

  var noTitleLabel = '<%= j l(:label_none_title) %>';
  var I18N = {
    activeShowing: '<%= j l(:label_showing_active_users, shown: "__S__", total: "__T__") %>',
    lockedShowing: '<%= j l(:label_showing_locked_users, shown: "__S__", total: "__T__") %>',
    noUsers: '<%= j l(:text_no_users_found) %>',
    statusActive: '<%= j l(:label_active) %>',
    statusLocked: '<%= j l(:label_locked) %>'
  };

  var data = {
    active: readJSON('ta-titles-active-data'),
    locked: readJSON('ta-titles-locked-data')
  };

  var state = {
    tab: 'active',
    perPage: 10,
    search: '',
    bulkTitleId: '',
    pages: { active: 1, locked: 1 },
    sortKey: { active: 'name', locked: 'name' },
    sortDir: { active: 'asc', locked: 'asc' },
    selected: { active: new Set(), locked: new Set() }
  };

  var els = {
    tbody: document.getElementById('ta-titles-tbody'),
    info: document.getElementById('ta-titles-info'),
    pagination: document.getElementById('ta-titles-pagination'),
    search: document.getElementById('ta-titles-search'),
    selectAll: document.getElementById('ta-titles-select-all'),
    bulkBar: document.getElementById('ta-titles-bulk-bar'),
    bulkCount: document.getElementById('ta-titles-bulk-count'),
    bulkTrigger: document.getElementById('ta-titles-bulk-trigger'),
    bulkLabel: document.getElementById('ta-titles-bulk-label'),
    bulkApply: document.getElementById('ta-titles-bulk-apply'),
    bulkClear: document.getElementById('ta-titles-bulk-clear'),
    perPageButton: document.getElementById('ta-titles-per-page-button'),
    perPageLabel: document.getElementById('ta-titles-per-page-label'),
    menu: document.getElementById('ta-titles-menu'),
    toast: document.getElementById('ta-titles-toast')
  };

  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function initials(name) {
    var parts = String(name || '').trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return '?';
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function titleNameFor(row) {
    return row.title_id ? (titleNameById[row.title_id] || '') : '';
  }

  function filteredSorted(tab) {
    var rows = data[tab].slice();
    var q = state.search.trim().toLowerCase();
    if (q) {
      rows = rows.filter(function (r) {
        return (r.login + ' ' + r.name + ' ' + r.email + ' ' + titleNameFor(r)).toLowerCase().indexOf(q) !== -1;
      });
    }
    var key = state.sortKey[tab];
    var dir = state.sortDir[tab] === 'asc' ? 1 : -1;
    rows.sort(function (a, b) {
      var av, bv;
      if (key === 'title') { av = titleNameFor(a); bv = titleNameFor(b); }
      else if (key === 'status') { av = bv = ''; }
      else { av = a[key]; bv = b[key]; }
      return String(av).localeCompare(String(bv), undefined, { numeric: true, sensitivity: 'base' }) * dir;
    });
    return rows;
  }

  function titleTrigger(row) {
    var name = titleNameFor(row);
    var placeholder = name ? '' : ' ta-title-trigger--placeholder';
    var label = name || noTitleLabel;
    return '<button type="button" class="ta-title-trigger ta-title-row-trigger' + placeholder + '" data-user-id="' + row.id + '" data-title-id="' + (row.title_id || '') + '">' +
      '<span class="ta-title-trigger-label">' + escapeHtml(label) + '</span>' +
      '<svg class="h-4 w-4 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>' +
    '</button>';
  }

  function statusBadge(tab) {
    if (tab === 'locked') {
      return '<span class="inline-flex items-center gap-1 rounded-md border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">' +
        '<svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>' +
        escapeHtml(I18N.statusLocked) + '</span>';
    }
    return '<span class="inline-flex items-center gap-1 rounded-md border border-green-200 bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">' +
      '<span class="h-1.5 w-1.5 rounded-full" style="background-color:#22c55e"></span>' + escapeHtml(I18N.statusActive) + '</span>';
  }

  function render() {
    var tab = state.tab;
    var rows = filteredSorted(tab);
    var total = rows.length;
    var totalPages = Math.max(1, Math.ceil(total / state.perPage));
    if (state.pages[tab] > totalPages) state.pages[tab] = totalPages;
    var page = state.pages[tab];
    var start = (page - 1) * state.perPage;
    var pageRows = rows.slice(start, start + state.perPage);

    var html = '';
    if (!pageRows.length) {
      html = '<tr><td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500">' + escapeHtml(I18N.noUsers) + '</td></tr>';
    } else {
      pageRows.forEach(function (row) {
        var checked = state.selected[tab].has(row.id) ? ' checked' : '';
        html += '<tr class="hover:bg-gray-50">' +
          '<td class="px-4 py-3"><input type="checkbox" class="ta-titles-row-check h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" data-user-id="' + row.id + '"' + checked + '></td>' +
          '<td class="px-4 py-3 font-mono text-sm text-gray-700">' + escapeHtml(row.login) + '</td>' +
          '<td class="px-4 py-3">' +
            '<div class="flex items-center gap-3">' +
              '<span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 text-xs font-semibold">' + escapeHtml(initials(row.name)) + '</span>' +
              '<div class="min-w-0"><div class="truncate text-sm font-semibold text-gray-900">' + escapeHtml(row.name) + '</div>' +
              '<div class="truncate text-xs text-gray-400">' + escapeHtml(row.email) + '</div></div>' +
            '</div>' +
          '</td>' +
          '<td class="px-4 py-3">' + statusBadge(tab) + '</td>' +
          '<td class="px-4 py-3">' + titleTrigger(row) + '</td>' +
        '</tr>';
      });
    }
    els.tbody.innerHTML = html;

    var shown = total ? (start + 1) + '–' + Math.min(start + state.perPage, total) : '0';
    var tpl = tab === 'locked' ? I18N.lockedShowing : I18N.activeShowing;
    els.info.textContent = tpl.replace('__S__', shown).replace('__T__', total);

    renderPagination(total, totalPages, page);
    updateSelectAll();
    updateBulkBar();
    updateSortIndicators();
  }

  function renderPagination(total, totalPages, page) {
    els.pagination.innerHTML = '';
    if (total === 0) return;

    function li(label, opts) {
      opts = opts || {};
      var item = document.createElement('li');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.className = 'ta-titles-pagination-link' +
        (opts.current ? ' ta-titles-pagination-link--current' : '') +
        (opts.disabled ? ' ta-titles-pagination-link--disabled' : '') +
        (opts.first ? ' rounded-s-lg' : '') + (opts.last ? ' rounded-e-lg' : '');
      if (opts.disabled) { btn.disabled = true; }
      else if (opts.onClick) { btn.addEventListener('click', opts.onClick); }
      item.appendChild(btn);
      els.pagination.appendChild(item);
    }

    li('Previous', { disabled: page === 1, first: true, onClick: function () { state.pages[state.tab] = page - 1; render(); } });
    for (var p = 1; p <= totalPages; p++) {
      (function (n) { li(String(n), { current: n === page, onClick: function () { state.pages[state.tab] = n; render(); } }); })(p);
    }
    li('Next', { disabled: page === totalPages, last: true, onClick: function () { state.pages[state.tab] = page + 1; render(); } });
  }

  function updateSortIndicators() {
    document.querySelectorAll('.ta-titles-sort').forEach(function (btn) {
      var ind = btn.querySelector('.ta-titles-sort-ind');
      if (!ind) return;
      if (btn.getAttribute('data-sort-key') === state.sortKey[state.tab]) {
        ind.textContent = state.sortDir[state.tab] === 'asc' ? '▲' : '▼';
      } else {
        ind.textContent = '';
      }
    });
  }

  function visibleIds() {
    return Array.prototype.map.call(els.tbody.querySelectorAll('.ta-titles-row-check'), function (cb) {
      return Number(cb.getAttribute('data-user-id'));
    });
  }

  function updateSelectAll() {
    var ids = visibleIds();
    var sel = state.selected[state.tab];
    els.selectAll.checked = ids.length > 0 && ids.every(function (id) { return sel.has(id); });
  }

  function updateBulkBar() {
    var count = state.selected[state.tab].size;
    if (count === 0) { els.bulkBar.classList.add('hidden'); return; }
    els.bulkBar.classList.remove('hidden');
    els.bulkCount.textContent = count + ' selected';
    setBulkLabel();
  }

  function setBulkLabel() {
    var name = state.bulkTitleId ? (titleNameById[state.bulkTitleId] || noTitleLabel) : noTitleLabel;
    els.bulkLabel.textContent = name;
    els.bulkTrigger.classList.toggle('ta-title-trigger--placeholder', !state.bulkTitleId);
    els.bulkTrigger.setAttribute('data-title-id', state.bulkTitleId || '');
  }

  function showToast(msg, isError) {
    els.toast.textContent = msg;
    els.toast.style.backgroundColor = isError ? '#dc2626' : '#111827';
    els.toast.classList.remove('hidden');
    clearTimeout(els.toast._t);
    els.toast._t = setTimeout(function () { els.toast.classList.add('hidden'); }, 2600);
  }

  function postAssign(userIds, titleId) {
    var body = new URLSearchParams();
    userIds.forEach(function (id) { body.append('user_ids[]', id); });
    body.append('title_id', titleId == null ? '' : titleId);
    return fetch(assignUrl, {
      method: 'POST',
      headers: {
        'X-CSRF-Token': csrf,
        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      },
      body: body.toString()
    }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); });
  }

  function applyAssignment(userIds, titleId) {
    var idSet = {};
    userIds.forEach(function (id) { idSet[Number(id)] = true; });
    ['active', 'locked'].forEach(function (tab) {
      data[tab].forEach(function (row) {
        if (idSet[Number(row.id)]) { row.title_id = titleId ? Number(titleId) : null; }
      });
    });
  }

  // ---- Shared floating menu (title selectors + per-page), keyboard-driven ----
  var menuCtx = null;
  var typeahead = { buffer: '', timer: null };

  function resetTypeahead() {
    typeahead.buffer = '';
    clearTimeout(typeahead.timer);
    typeahead.timer = null;
  }

  function menuOptionEls() {
    return Array.prototype.slice.call(els.menu.querySelectorAll('.ta-titles-menu-option'));
  }

  function buildMenuOptions(items, currentValue) {
    var cur = currentValue == null ? '' : String(currentValue);
    var html = '';
    items.forEach(function (it) {
      var active = (String(it.value) === cur) ? ' ta-titles-menu-option--active' : '';
      html += '<button type="button" class="ta-titles-menu-option' + active + '" data-value="' + escapeHtml(it.value) + '">' + escapeHtml(it.label) + '</button>';
    });
    return html;
  }

  function openMenu(anchor, items, currentValue, onSelect, minWidth) {
    menuCtx = { onSelect: onSelect, anchor: anchor };
    resetTypeahead();
    els.menu.innerHTML = buildMenuOptions(items, currentValue);
    els.menu.classList.remove('hidden');
    anchor.classList.add('is-open');

    var rect = anchor.getBoundingClientRect();
    // Default floor of 120px for the wide title selectors; callers (e.g. the narrow
    // per-page button) can pass a smaller floor so the menu matches the trigger width.
    var floor = (typeof minWidth === 'number') ? minWidth : 120;
    var width = Math.max(rect.width, floor);
    els.menu.style.width = width + 'px';
    var menuH = Math.min(els.menu.scrollHeight, 256);
    var spaceBelow = window.innerHeight - rect.bottom;
    var left = Math.min(rect.left, window.innerWidth - width - 8);
    els.menu.style.left = Math.max(8, left) + 'px';
    if (spaceBelow < menuH + 8 && rect.top > spaceBelow) {
      els.menu.style.top = Math.max(8, rect.top - menuH - 4) + 'px';
    } else {
      els.menu.style.top = (rect.bottom + 4) + 'px';
    }

    var focusOpt = els.menu.querySelector('.ta-titles-menu-option--active') || els.menu.querySelector('.ta-titles-menu-option');
    if (focusOpt) { try { focusOpt.focus({ preventScroll: true }); } catch (e) { focusOpt.focus(); } }
  }

  function closeMenu() {
    els.menu.classList.add('hidden');
    if (menuCtx && menuCtx.anchor) menuCtx.anchor.classList.remove('is-open');
    menuCtx = null;
    resetTypeahead();
  }

  function findMenuOption(query) {
    var n = query.toLowerCase();
    var opts = menuOptionEls();
    return opts.find(function (o) { return o.textContent.trim().toLowerCase().indexOf(n) === 0; }) ||
           opts.find(function (o) { return o.textContent.trim().toLowerCase().indexOf(n) !== -1; }) || null;
  }

  els.menu.addEventListener('click', function (e) {
    var btn = e.target.closest('.ta-titles-menu-option');
    if (!btn || !menuCtx) return;
    var val = btn.getAttribute('data-value') || null;
    var cb = menuCtx.onSelect;
    closeMenu();
    cb(val);
  });

  els.menu.addEventListener('keydown', function (e) {
    if (els.menu.classList.contains('hidden') || !menuCtx) return;
    var opts = menuOptionEls();
    if (!opts.length) return;
    var current = document.activeElement && document.activeElement.closest ? document.activeElement.closest('.ta-titles-menu-option') : null;

    if (e.key === 'Escape') { e.preventDefault(); closeMenu(); if (menuCtx && menuCtx.anchor) menuCtx.anchor.focus(); return; }

    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      var idx = Math.max(0, opts.indexOf(current));
      var next = e.key === 'ArrowDown' ? Math.min(opts.length - 1, idx + 1) : Math.max(0, idx - 1);
      opts[next].focus();
      opts[next].scrollIntoView({ block: 'nearest' });
      return;
    }

    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (current) current.click();
      return;
    }

    if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      typeahead.buffer += e.key.toLowerCase();
      clearTimeout(typeahead.timer);
      typeahead.timer = setTimeout(resetTypeahead, 900);
      var match = findMenuOption(typeahead.buffer);
      if (!match) { typeahead.buffer = e.key.toLowerCase(); match = findMenuOption(typeahead.buffer); }
      if (match) {
        match.focus();
        match.scrollIntoView({ block: 'nearest' });
        if (match.textContent.trim().toLowerCase() === typeahead.buffer) { match.click(); }
      }
    }
  });

  function titleItems() {
    var items = [{ value: '', label: noTitleLabel }];
    titles.forEach(function (t) { items.push({ value: String(t.id), label: t.name }); });
    return items;
  }

  // ---- Events ----

  // Tab switch
  document.querySelectorAll('[data-titles-tab]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.tab = btn.getAttribute('data-titles-tab');
      document.querySelectorAll('[data-titles-tab]').forEach(function (b) {
        b.classList.toggle('ta-titles-tab--active', b === btn);
      });
      render();
    });
  });

  // Sort
  document.querySelectorAll('.ta-titles-sort').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-sort-key');
      var tab = state.tab;
      if (state.sortKey[tab] === key) {
        state.sortDir[tab] = state.sortDir[tab] === 'asc' ? 'desc' : 'asc';
      } else {
        state.sortKey[tab] = key;
        state.sortDir[tab] = 'asc';
      }
      render();
    });
  });

  // Search
  var searchTimer;
  els.search.addEventListener('input', function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () {
      state.search = els.search.value;
      state.pages.active = 1; state.pages.locked = 1;
      render();
    }, 200);
  });

  // Per-page dropdown -> shared menu
  els.perPageButton.addEventListener('click', function () {
    var items = [10, 25, 50, 100].map(function (v) { return { value: String(v), label: String(v) }; });
    openMenu(els.perPageButton, items, String(state.perPage), function (val) {
      state.perPage = parseInt(val, 10) || 10;
      els.perPageLabel.textContent = String(state.perPage);
      state.pages.active = 1; state.pages.locked = 1;
      render();
    }, 0); // floor 0 → menu matches the per-page button width instead of the 120px default
  });

  // Per-row title trigger + checkbox (delegated)
  els.tbody.addEventListener('click', function (e) {
    var trig = e.target.closest('.ta-title-row-trigger');
    if (trig) {
      var uid = Number(trig.getAttribute('data-user-id'));
      var cur = trig.getAttribute('data-title-id') || '';
      openMenu(trig, titleItems(), cur, function (val) {
        postAssign([uid], val).then(function (res) {
          if (res.ok) {
            applyAssignment([uid], res.body.title_id);
            showToast(res.body.notice);
            render();
          } else {
            showToast((res.body && res.body.error) || 'Error', true);
          }
        });
      });
    }
  });

  els.tbody.addEventListener('change', function (e) {
    var cb = e.target.closest('.ta-titles-row-check');
    if (cb) {
      var id = Number(cb.getAttribute('data-user-id'));
      if (cb.checked) state.selected[state.tab].add(id); else state.selected[state.tab].delete(id);
      updateSelectAll();
      updateBulkBar();
    }
  });

  // Select all (current page)
  els.selectAll.addEventListener('change', function () {
    var ids = visibleIds();
    ids.forEach(function (id) {
      if (els.selectAll.checked) state.selected[state.tab].add(id); else state.selected[state.tab].delete(id);
    });
    els.tbody.querySelectorAll('.ta-titles-row-check').forEach(function (cb) { cb.checked = els.selectAll.checked; });
    updateBulkBar();
  });

  // Bulk title trigger -> shared menu
  els.bulkTrigger.addEventListener('click', function () {
    openMenu(els.bulkTrigger, titleItems(), state.bulkTitleId, function (val) {
      state.bulkTitleId = val || '';
      setBulkLabel();
    });
  });

  els.bulkApply.addEventListener('click', function () {
    var ids = Array.from(state.selected[state.tab]);
    if (!ids.length) return;
    var titleId = state.bulkTitleId || null;
    postAssign(ids, titleId).then(function (res) {
      if (res.ok) {
        applyAssignment(ids, res.body.title_id);
        state.selected[state.tab].clear();
        showToast(res.body.notice);
        render();
      } else {
        showToast((res.body && res.body.error) || 'Error', true);
      }
    });
  });

  els.bulkClear.addEventListener('click', function () {
    state.selected[state.tab].clear();
    render();
  });

  // Close the menu on outside click; ignore clicks on triggers / inside the menu
  document.addEventListener('click', function (e) {
    if (els.menu.classList.contains('hidden')) return;
    if (e.target.closest('#ta-titles-menu') ||
        e.target.closest('.ta-title-trigger') ||
        e.target.closest('#ta-titles-per-page-button')) return;
    closeMenu();
  });
  // Close on page scroll, but DON'T close when scrolling inside the menu itself
  window.addEventListener('scroll', function (e) {
    if (els.menu.classList.contains('hidden')) return;
    if (e.target && e.target.nodeType === 1 && els.menu.contains(e.target)) return;
    closeMenu();
  }, true);
  window.addEventListener('resize', closeMenu);

  // ---- Manage Titles modal: add / delete (reuses hiring-titles endpoints) ----
  var manageModal = document.getElementById('taManageTitlesModal');
  var createUrl = manageModal.getAttribute('data-create-url');

  function addTitle() {
    var input = document.getElementById('ta-titles-new-input');
    var value = (input.value || '').trim();
    if (!value) return;
    fetch(createUrl, {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ title: value })
    }).then(function (r) {
      if (r.ok) { window.location.reload(); }
      else { r.json().then(function (d) { showToast(d.error || 'Error', true); }); }
    });
  }
  document.getElementById('ta-titles-add-btn').addEventListener('click', addTitle);
  document.getElementById('ta-titles-new-input').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); addTitle(); }
  });

  var pendingDeleteUrl = null;
  var deleteModal = document.getElementById('taTitleDeleteModal');
  function openDeleteModal(url, label) {
    pendingDeleteUrl = url;
    document.getElementById('ta-titles-delete-message').textContent = 'Are you sure you want to delete "' + label + '"?';
    deleteModal.classList.remove('hidden'); deleteModal.classList.add('flex');
  }
  function closeDeleteModal() {
    pendingDeleteUrl = null;
    deleteModal.classList.add('hidden'); deleteModal.classList.remove('flex');
  }
  document.querySelectorAll('.ta-titles-delete-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openDeleteModal(btn.getAttribute('data-delete-url'), btn.getAttribute('data-title-label'));
    });
  });
  document.getElementById('ta-titles-delete-cancel').addEventListener('click', closeDeleteModal);
  document.getElementById('ta-titles-delete-confirm').addEventListener('click', function () {
    if (!pendingDeleteUrl) return;
    fetch(pendingDeleteUrl, {
      method: 'DELETE',
      headers: { 'X-CSRF-Token': csrf, 'X-Requested-With': 'XMLHttpRequest' }
    }).then(function (r) {
      if (r.ok) { window.location.reload(); }
      else { closeDeleteModal(); showToast('Error', true); }
    });
  });

  setBulkLabel();
  render();
});
</script>
