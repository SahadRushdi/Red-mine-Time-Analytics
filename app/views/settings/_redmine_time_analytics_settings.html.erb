<%# Redmine replaces the full settings hash on save. Preserve unrelated settings. %>
<% managed_keys = %w[missing_time_enabled missing_time_recipients missing_time_schedules missing_time_crons missing_time_cron missing_time_cron_fri missing_time_cron_sat missing_time_cron_mon] %>
<% preserved_fields = lambda do |name, value|
     case value
     when Hash
       safe_join(value.map { |key, entry| preserved_fields.call("#{name}[#{key}]", entry) })
     when Array
       safe_join(value.map { |entry| preserved_fields.call("#{name}[]", entry) })
     else
       hidden_field_tag(name, value)
     end
   end %>
<% (settings.keys - managed_keys).each do |key| %>
  <%= preserved_fields.call("settings[#{key}]", settings[key]) %>
<% end %>

<fieldset class="box tabular">
  <legend><strong><%= l(:label_missing_time_notifications) %></strong></legend>

  <p>
    <%= hidden_field_tag 'settings[missing_time_enabled]', '0' %>
    <%= check_box_tag 'settings[missing_time_enabled]', '1', settings['missing_time_enabled'].to_s != '0', id: 'settings_missing_time_enabled' %>
    <%= label_tag :settings_missing_time_enabled, l(:label_missing_time_enabled) %>
  </p>

  <p>
    <%= label_tag :settings_missing_time_recipients, l(:label_missing_time_recipients) %>
    <%= text_field_tag 'settings[missing_time_recipients]', settings['missing_time_recipients'], id: 'settings_missing_time_recipients', size: 60, placeholder: 'e.g. admin@example.com, manager@example.com' %>
    <br><em class="info"><%= l(:text_missing_time_recipients) %></em>
  </p>

  <p>
    <label><%= l(:label_missing_time_schedules) %></label>
    <span style="display:inline-block;vertical-align:top;">
      <%# A blank sentinel keeps the new key present even when all rows are removed. %>
      <%= hidden_field_tag 'settings[missing_time_schedules][_empty][cron]', '' %>
      <span id="missing-time-crons-list" style="display:block;">
        <% saved_schedules = TaTeamSetting.missing_time_schedules(settings) %>
        <% (saved_schedules.empty? ? [{ cron: '', weekly: true, daily: false }] : saved_schedules).each_with_index do |schedule, index| %>
          <span class="missing-time-cron-row" style="display:block;margin-bottom:4px;">
            <%= text_field_tag "settings[missing_time_schedules][#{index}][cron]", schedule[:cron], size: 28, placeholder: 'e.g. 0 18 * * 5', style: 'margin:0;vertical-align:middle;' %>
            <label style="float:none;width:auto;display:inline;margin-left:8px;">
              <%= hidden_field_tag "settings[missing_time_schedules][#{index}][weekly]", '0' %>
              <%= check_box_tag "settings[missing_time_schedules][#{index}][weekly]", '1', schedule[:weekly], id: "missing-time-weekly-#{index}" %>
              <%= l(:label_missing_time_check_week) %>
            </label>
            <label style="float:none;width:auto;display:inline;margin-left:8px;">
              <%= hidden_field_tag "settings[missing_time_schedules][#{index}][daily]", '0' %>
              <%= check_box_tag "settings[missing_time_schedules][#{index}][daily]", '1', schedule[:daily], id: "missing-time-daily-#{index}" %>
              <%= l(:label_missing_time_check_day) %>
            </label>
            <a href="#" class="missing-time-cron-remove icon icon-del" title="<%= l(:button_delete) %>" style="vertical-align:middle;"></a>
          </span>
        <% end %>
      </span>
      <a href="#" id="missing-time-cron-add" class="icon icon-add" style="display:inline-block;margin-top:2px;"><%= l(:label_missing_time_add_schedule) %></a>
      <em class="info" style="display:block;margin-top:4px;"><%= l(:text_missing_time_cron_help) %></em>
      <em class="info" style="display:block;margin-top:4px;"><%= l(:text_missing_time_coverage_help) %></em>
      <em class="info" style="display:block;margin-top:4px;"><%= l(:text_missing_time_monthly_help) %></em>
    </span>
  </p>
</fieldset>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var list = document.getElementById('missing-time-crons-list');
  var addBtn = document.getElementById('missing-time-cron-add');
  if (!list || !addBtn) return;
  var nextIndex = list.querySelectorAll('.missing-time-cron-row').length;
  // Clone the rendered row to keep labels and checkbox markup consistent with the server.
  var template = list.querySelector('.missing-time-cron-row').cloneNode(true);

  list.addEventListener('click', function (event) {
    var remove = event.target.closest('.missing-time-cron-remove');
    if (!remove) return;
    event.preventDefault();
    remove.closest('.missing-time-cron-row').remove();
  });

  addBtn.addEventListener('click', function (event) {
    event.preventDefault();
    var row = template.cloneNode(true);
    var index = nextIndex++;
    row.querySelectorAll('input').forEach(function (input) {
      input.name = input.name.replace(/\[missing_time_schedules\]\[\d+\]/, '[missing_time_schedules][' + index + ']');
      input.removeAttribute('id');
      if (input.type === 'text') input.value = '';
      if (input.type === 'checkbox') {
        input.checked = input.name.endsWith('[weekly]');
        input.id = 'missing-time-' + (input.checked ? 'weekly' : 'daily') + '-' + index;
      }
    });
    list.appendChild(row);
  });
});
</script>
