<% html_title "Assign Project" %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<% selected_project = @available_projects.find { |p| p.id == @team_project.project_id.to_i } %>
<% selected_project_text = selected_project ? "#{selected_project.name} (#{selected_project.identifier})" : '' %>
<% start_date_value = (@team_project.start_date || Date.current).strftime('%m/%d/%Y') %>
<% end_date_value = @team_project.end_date ? @team_project.end_date.strftime('%m/%d/%Y') : '' %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Add Project: <%= h(@team.name) %></h2>
      <p class="text-sm text-gray-500"><%= ta_team_breadcrumb(@team) %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'Back to Projects', admin_ta_team_team_projects_path(@team), class: 'ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm md:p-6">
    <%= form_for @team_project, url: admin_ta_team_team_projects_path(@team), html: { id: 'ta-team-project-form', class: 'space-y-6' } do |f| %>
      <%= error_messages_for 'ta_team_project' %>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <div class="md:col-span-2">
          <%= label_tag :ta_team_project_search, 'Project', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
          <div class="relative min-w-0" id="ta-team-project-wrapper">
            <input type="text"
                   id="ta-team-project-search"
                   value="<%= h(selected_project_text) %>"
                   placeholder="🔍 Search project... *"
                   autocomplete="off"
                   onclick="openTeamProjectDropdown()"
                   oninput="filterTeamProjects()"
                   onkeydown="handleTeamProjectKey(event)"
                   class="ta-team-settings-member-input block h-[34px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900"
                   required>
            <%= hidden_field_tag 'ta_team_project[project_id]', @team_project.project_id, id: 'ta-team-project-id' %>
            <div id="ta-team-project-list"
                 class="tep-issue-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                 style="min-width: 320px; max-height: 220px; top: calc(100% + 2px);">
              <% @available_projects.each do |project| %>
                <% project_text = "#{project.name} (#{project.identifier})" %>
                <div class="tep-issue-option px-3 py-2 text-sm cursor-pointer flex items-start gap-2 border-b border-gray-50 last:border-0"
                     tabindex="0"
                     data-id="<%= project.id %>"
                     data-text="<%= j(project_text) %>"
                     data-search="<%= j("#{project.name} #{project.identifier}".downcase) %>"
                     onclick="selectTeamProject(this.getAttribute('data-id'), this.getAttribute('data-text'))"
                     onkeydown="handleTeamProjectOptionKey(event, this.getAttribute('data-id'), this.getAttribute('data-text'))">
                  <span class="text-gray-700 leading-relaxed"><%= h(project.name) %> <span class="text-gray-400">(<%= h(project.identifier) %>)</span></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div>
          <%= label_tag :ta_team_project_start_date, 'Start Date', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
          <%= text_field_tag 'ta_team_project[start_date]',
                             start_date_value,
                             id: 'ta-team-project-start-date',
                             autocomplete: 'off',
                             placeholder: 'mm/dd/yyyy',
                             required: true,
                             datepicker: true,
                             'datepicker-format': 'mm/dd/yyyy',
                             'datepicker-autohide': true,
                             class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
        </div>

        <div>
          <%= label_tag :ta_team_project_end_date, 'End Date', class: 'mb-1 block text-sm font-medium text-gray-700' %>
          <%= text_field_tag 'ta_team_project[end_date]',
                             end_date_value,
                             id: 'ta-team-project-end-date',
                             autocomplete: 'off',
                             placeholder: 'mm/dd/yyyy',
                             datepicker: true,
                             'datepicker-format': 'mm/dd/yyyy',
                             'datepicker-autohide': true,
                             class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
          <p class="mt-1 text-xs text-gray-500">Leave empty for ongoing projects.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-100 pt-4">
        <%= link_to l(:button_cancel), admin_ta_team_team_projects_path(@team), class: 'ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
        <button type="submit"
                class="ta-btn-save-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">Create</button>
      </div>
    <% end %>
  </div>
</div>

<script>
  function normalizeTeamProjectDate(value) {
    if (!value) return value;
    var yyyymmdd = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (yyyymmdd) return value;
    var mmddyyyy = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!mmddyyyy) return value;
    return mmddyyyy[3] + '-' + mmddyyyy[1].padStart(2, '0') + '-' + mmddyyyy[2].padStart(2, '0');
  }

  function teamProjectElements() {
    return {
      wrapper: document.getElementById('ta-team-project-wrapper'),
      search: document.getElementById('ta-team-project-search'),
      hidden: document.getElementById('ta-team-project-id'),
      list: document.getElementById('ta-team-project-list')
    };
  }

  function openTeamProjectDropdown() {
    var els = teamProjectElements();
    if (!els.list) return;
    els.list.querySelectorAll('.tep-issue-option').forEach(function(opt) { opt.style.display = ''; });
    els.list.classList.remove('hidden');
  }

  function closeTeamProjectDropdown() {
    var els = teamProjectElements();
    if (!els.list) return;
    els.list.classList.add('hidden');
  }

  function filterTeamProjects() {
    var els = teamProjectElements();
    if (!els.search || !els.list) return;
    var query = els.search.value.toLowerCase().trim();
    els.list.classList.remove('hidden');
    els.list.querySelectorAll('.tep-issue-option').forEach(function(opt) {
      var text = (opt.getAttribute('data-search') || '').toLowerCase();
      opt.style.display = (!query || text.indexOf(query) >= 0) ? '' : 'none';
    });
    if (els.hidden) els.hidden.value = '';
  }

  function selectTeamProject(projectId, displayText) {
    var els = teamProjectElements();
    if (els.hidden) els.hidden.value = projectId;
    if (els.search) els.search.value = displayText;
    closeTeamProjectDropdown();
  }

  function handleTeamProjectKey(event) {
    var els = teamProjectElements();
    if (!els.list) return;
    if (event.key === 'Escape') {
      closeTeamProjectDropdown();
      return;
    }
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      var visible = Array.from(els.list.querySelectorAll('.tep-issue-option')).filter(function(opt) {
        return opt.style.display !== 'none';
      });
      if (visible.length) visible[0].focus();
    }
  }

  function handleTeamProjectOptionKey(event, projectId, displayText) {
    var els = teamProjectElements();
    if (!els.list) return;
    var visible = Array.from(els.list.querySelectorAll('.tep-issue-option')).filter(function(opt) {
      return opt.style.display !== 'none';
    });
    var current = event.target;
    var currentIdx = visible.indexOf(current);

    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      selectTeamProject(projectId, displayText);
      if (els.search) els.search.focus();
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      var next = visible[currentIdx + 1];
      if (next) next.focus();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (currentIdx === 0) {
        if (els.search) els.search.focus();
      } else {
        var prev = visible[currentIdx - 1];
        if (prev) prev.focus();
      }
    } else if (event.key === 'Escape') {
      closeTeamProjectDropdown();
      if (els.search) els.search.focus();
    }
  }

  document.addEventListener('click', function(event) {
    var els = teamProjectElements();
    if (els.wrapper && els.list) {
      var clickedInsideList = !!els.list.contains(event.target);
      if (!els.wrapper.contains(event.target) && !clickedInsideList) {
        closeTeamProjectDropdown();
      }
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    closeTeamProjectDropdown();

    ['ta-team-project-start-date', 'ta-team-project-end-date'].forEach(function(id) {
      var input = document.getElementById(id);
      if (!input) return;
      if (input.datepicker && input.datepicker.setOptions) {
        input.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true });
      } else if (window.Datepicker) {
        new window.Datepicker(input, { format: 'mm/dd/yyyy', autohide: true });
      }
    });

    var form = document.getElementById('ta-team-project-form');
    if (form) {
      form.addEventListener('submit', function() {
        var startInput = document.getElementById('ta-team-project-start-date');
        var endInput = document.getElementById('ta-team-project-end-date');
        if (startInput) startInput.value = normalizeTeamProjectDate(startInput.value.trim());
        if (endInput) endInput.value = normalizeTeamProjectDate(endInput.value.trim());
      });
    }
  });
</script>
