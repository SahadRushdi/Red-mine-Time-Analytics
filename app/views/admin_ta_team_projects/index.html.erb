<% html_title "Team Projects - #{@team.name}" %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<% selected_project = @available_projects.find { |p| p.id == @team_project.project_id.to_i } %>
<% selected_project_text = selected_project ? "#{selected_project.name} (#{selected_project.identifier})" : '' %>
<% selected_source_type = @team_project.source_type.presence || 'local' %>
<% selected_external_url = @team_project.external_project_url.to_s %>
<% start_date_value = (@team_project.start_date || Date.current).strftime('%m/%d/%Y') %>
<% end_date_value = @team_project.end_date ? @team_project.end_date.strftime('%m/%d/%Y') : '' %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Team Projects: <%= h(@team.name) %></h2>
      <p class="text-sm text-gray-500"><%= ta_team_breadcrumb(@team) %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button"
              onclick="teamProjectsOpenAddModal()"
              class="ta-btn-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">
        Add Project
      </button>
      <%= link_to 'Back to Teams', admin_ta_teams_path, class: 'ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-gray-200 px-6 py-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="font-semibold text-gray-900">Active Projects (<%= @active_projects.count %>)</h3>
        <p class="text-xs text-gray-500">Projects currently assigned to this team.</p>
      </div>
      <div class="flex w-full flex-col gap-2 md:w-auto md:flex-row md:items-center">
        <input type="text" id="ta-active-projects-search" placeholder="Search project name, identifier, or status..."
               class="ts-search-input !block !h-[44px] !w-full md:!w-80 !rounded-lg !border !border-gray-300 !px-3 !text-sm !text-gray-900 !shadow-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]"
               oninput="filterActiveProjectRows()">
      </div>
    </div>

    <% if @active_projects.any? %>
      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleTeamProjectsTableSort('active-projects', 'project', '.ta-team-project-row', ['project', 'start-date'], ['start-date']); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamProjectsTableSort('active-projects', 'project', '.ta-team-project-row', ['project', 'start-date'], ['start-date']); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Project</span>
                  <span id="ta-active-projects-sort-icon-project" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Identifier</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleTeamProjectsTableSort('active-projects', 'start-date', '.ta-team-project-row', ['project', 'start-date'], ['start-date']); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamProjectsTableSort('active-projects', 'start-date', '.ta-team-project-row', ['project', 'start-date'], ['start-date']); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Start Date</span>
                  <span id="ta-active-projects-sort-icon-start-date" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">End Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Status</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @active_projects.each do |team_project| %>
              <% form_id = "ta-team-project-form-#{team_project.id}" %>
              <% status_label = team_project.active? ? 'Active' : 'Inactive' %>
              <% project_name = team_project.local_source? ? team_project.project_name : "External Project (#{team_project.project_display_identifier})" %>
              <% project_identifier = team_project.local_source? ? team_project.project_display_identifier : team_project.project_display_identifier %>
              <% selected_source_type = team_project.source_type.presence || 'local' %>
              <% editable_projects = @available_projects.to_a.dup %>
              <% if team_project.project_linkable? && team_project.project.present? && editable_projects.none? { |project| project.id == team_project.project.id } %>
                <% editable_projects << team_project.project %>
              <% end %>
              <% editable_projects.sort_by! { |project| [project.name.to_s.downcase, project.identifier.to_s.downcase] } %>
              <% selected_project_label = team_project.project_linkable? && team_project.project.present? ? "#{team_project.project.name} (#{team_project.project.identifier})" : 'Select project...' %>
              <% editable_project_options = [['Select project...', '']] + editable_projects.map { |project| ["#{project.name} (#{project.identifier})", project.id] } %>
              <% search_text = [project_name, project_identifier, status_label, team_project.source_type].join(' ').downcase %>
              <tr class="ta-team-project-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                  data-search-text="<%= h(search_text) %>"
                  data-team-project-id="<%= team_project.id %>"
                  data-sort-project="<%= project_name.to_s.downcase %>"
                  data-sort-start-date="<%= team_project.start_date ? team_project.start_date.to_time.to_i : 0 %>">
                <td class="px-4 py-3">
                  <% if team_project.project_linkable? %>
                    <%= link_to project_name, project_path(team_project.project), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                  <% else %>
                    <span class="text-sm font-semibold text-gray-900"><%= h(project_name) %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  <div class="ta-team-project-view">
                    <code><%= h(project_identifier.presence || '—') %></code>
                    <% if team_project.external_source? %>
                      <div class="mt-1 text-xs text-gray-500"><%= h(team_project.external_project_url) %></div>
                    <% end %>
                  </div>
                  <div class="ta-team-project-edit hidden tep-inline-form w-full space-y-3">
                    <div class="md:col-span-2 relative min-w-0">
                      <%= label_tag "ta-team-project-source-button-#{team_project.id}", 'Project Source', class: 'mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500' %>
                      <button type="button"
                              id="ta-team-project-source-button-<%= team_project.id %>"
                              data-ta-dropdown-toggle="ta-team-project-source-list-<%= team_project.id %>"
                              class="inline-flex h-[43px] w-full items-center justify-between rounded-lg border border-gray-300 bg-white px-3 text-sm font-medium text-gray-900 shadow-none focus:outline-none focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6]">
                        <span id="ta-team-project-source-label-<%= team_project.id %>" class="truncate"><%= selected_source_type == 'external' ? 'External Support Redmine URL' : 'Internal Redmine Project' %></span>
                        <svg class="h-4 w-4 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </button>
                      <%= hidden_field_tag 'ta_team_project[source_type]', selected_source_type, form: form_id, id: "ta-team-project-source-value-#{team_project.id}" %>
                      <div id="ta-team-project-source-list-<%= team_project.id %>"
                           data-ta-dropdown-menu="true"
                           class="tep-activity-dropdown hidden absolute z-[10050] mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
                        <ul class="py-1 text-sm text-gray-700">
                          <li>
                            <button type="button"
                                    class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                    data-ta-team-project-source-value="local"
                                    data-ta-team-project-source-label="Internal Redmine Project">
                              Internal Redmine Project
                            </button>
                          </li>
                          <li>
                            <button type="button"
                                    class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                    data-ta-team-project-source-value="external"
                                    data-ta-team-project-source-label="External Support Redmine URL">
                              External Support Redmine URL
                            </button>
                          </li>
                        </ul>
                      </div>
                    </div>

                    <div class="md:col-span-2 <%= 'hidden' if selected_source_type == 'external' %>" id="ta-team-project-local-wrap-<%= team_project.id %>">
                      <%= label_tag "ta-team-project-project-button-#{team_project.id}", 'Project', class: 'mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500' %>
                      <button type="button"
                              id="ta-team-project-project-button-<%= team_project.id %>"
                              data-ta-dropdown-toggle="ta-team-project-project-list-<%= team_project.id %>"
                              class="inline-flex h-[43px] w-full items-center justify-between rounded-lg border border-gray-300 bg-white px-3 text-sm font-medium text-gray-900 shadow-none focus:outline-none focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6]">
                        <span id="ta-team-project-project-label-<%= team_project.id %>" class="truncate"><%= selected_project_label %></span>
                        <svg class="h-4 w-4 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </button>
                      <%= hidden_field_tag 'ta_team_project[project_id]', team_project.project_id, form: form_id, id: "ta-team-project-project-id-#{team_project.id}" %>
                      <div id="ta-team-project-project-list-<%= team_project.id %>"
                           data-ta-dropdown-menu="true"
                           class="tep-activity-dropdown hidden absolute z-[10050] mt-1 max-h-60 w-full overflow-y-auto rounded-lg border border-gray-300 bg-white py-1 shadow-xl">
                        <ul class="py-1 text-sm text-gray-700">
                          <% editable_project_options.each do |project_label, project_value| %>
                            <li>
                              <button type="button"
                                      class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                      data-ta-team-project-project-value="<%= project_value %>"
                                      data-ta-team-project-project-label="<%= h(project_label) %>">
                                <%= h(project_label) %>
                              </button>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    </div>

                    <div class="md:col-span-2 <%= 'hidden' if selected_source_type == 'local' %>" id="ta-team-project-external-wrap-<%= team_project.id %>">
                      <%= label_tag "ta-team-project-external-url-#{team_project.id}", 'External Project URL', class: 'mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500' %>
                      <%= text_field_tag 'ta_team_project[external_project_url]',
                                         team_project.external_project_url,
                                         id: "ta-team-project-external-url-#{team_project.id}",
                                         form: form_id,
                                         autocomplete: 'off',
                                         placeholder: 'https://support.example.com/projects/project-identifier',
                                         required: selected_source_type == 'external',
                                         disabled: selected_source_type != 'external',
                                         class: 'ta-team-field ta-team-project-inline-url ta-team-settings-member-input block h-[43px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900' %>
                      <p class="mt-1 text-xs text-gray-500">Must include <code>/projects/&lt;identifier&gt;</code>.</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  <div class="ta-team-project-view"><%= team_project.start_date ? format_date(team_project.start_date) : '—' %></div>
                  <div class="ta-team-project-edit hidden tep-inline-form">
                    <input type="text"
                           id="ta-team-project-start-date-<%= team_project.id %>"
                           name="ta_team_project[start_date]"
                           form="<%= form_id %>"
                           value="<%= team_project.start_date ? team_project.start_date.strftime('%m/%d/%Y') : '' %>"
                           autocomplete="off"
                           placeholder="mm/dd/yyyy"
                           datepicker
                           datepicker-format="mm/dd/yyyy"
                           datepicker-autohide
                           class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  <div class="ta-team-project-view"><%= team_project.end_date ? format_date(team_project.end_date) : 'Active' %></div>
                  <div class="ta-team-project-edit hidden tep-inline-form">
                    <input type="text"
                           id="ta-team-project-end-date-<%= team_project.id %>"
                           name="ta_team_project[end_date]"
                           form="<%= form_id %>"
                           value="<%= team_project.end_date ? team_project.end_date.strftime('%m/%d/%Y') : '' %>"
                           autocomplete="off"
                           placeholder="mm/dd/yyyy"
                           datepicker
                           datepicker-format="mm/dd/yyyy"
                           datepicker-autohide
                           class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Active</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="ta-team-project-view inline-flex items-center justify-end gap-1">
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); toggleTeamProjectInlineEdit(<%= team_project.id %>)"
                            class="ta-inline-icon-btn"
                            title="Edit"
                            aria-label="Edit project assignment">
                      <span class="material-icons ta-inline-material-icon">edit</span>
                    </button>
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); teamProjectsDelete(<%= team_project.id %>, '<%= admin_ta_team_team_project_path(@team, team_project) %>', '<%= form_authenticity_token %>')"
                            class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                            title="Delete"
                            aria-label="Delete project assignment">
                      <span class="material-icons ta-inline-material-icon">delete</span>
                    </button>
                  </div>
                  <div class="ta-team-project-edit hidden inline-flex items-center justify-end gap-2">
                    <button type="submit"
                            form="<%= form_id %>"
                            class="ta-btn-primary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Save</button>
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); toggleTeamProjectInlineEdit(<%= team_project.id %>)"
                            class="ta-btn-secondary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Cancel</button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="hidden">
        <% @active_projects.each do |team_project| %>
          <% form_id = "ta-team-project-form-#{team_project.id}" %>
          <%= form_tag admin_ta_team_team_project_path(@team, team_project), method: :patch, id: form_id, onsubmit: "return submitTeamProjectInlineEdit(#{team_project.id})" do %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-10 text-center text-sm text-gray-500">No active projects assigned.</div>
    <% end %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-gray-200 px-6 py-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="font-semibold text-gray-900">Inactive Projects (<%= @inactive_projects.count %>)</h3>
        <p class="text-xs text-gray-500">Project assignments that have ended.</p>
      </div>
    </div>

    <% if @inactive_projects.any? %>
      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleTeamProjectsTableSort('inactive-projects', 'project', '.ta-inactive-team-project-row', ['project', 'start-date'], ['start-date']); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamProjectsTableSort('inactive-projects', 'project', '.ta-inactive-team-project-row', ['project', 'start-date'], ['start-date']); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Project</span>
                  <span id="ta-inactive-projects-sort-icon-project" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Identifier</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleTeamProjectsTableSort('inactive-projects', 'start-date', '.ta-inactive-team-project-row', ['project', 'start-date'], ['start-date']); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamProjectsTableSort('inactive-projects', 'start-date', '.ta-inactive-team-project-row', ['project', 'start-date'], ['start-date']); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Start Date</span>
                  <span id="ta-inactive-projects-sort-icon-start-date" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">End Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Status</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @inactive_projects.each do |team_project| %>
              <% project_name = team_project.local_source? ? team_project.project_name : "External Project (#{team_project.project_display_identifier})" %>
              <% project_identifier = team_project.local_source? ? team_project.project_display_identifier : team_project.project_display_identifier %>
              <tr class="ta-inactive-team-project-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                  data-sort-project="<%= project_name.to_s.downcase %>"
                  data-sort-start-date="<%= team_project.start_date ? team_project.start_date.to_time.to_i : 0 %>">
                <td class="px-4 py-3">
                  <% if team_project.project_linkable? %>
                    <%= link_to project_name, project_path(team_project.project), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                  <% else %>
                    <span class="text-sm font-semibold text-gray-900"><%= h(project_name) %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  <code><%= h(project_identifier.presence || '—') %></code>
                  <% if team_project.external_source? %>
                    <div class="mt-1 text-xs text-gray-500"><%= h(team_project.external_project_url) %></div>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= team_project.start_date ? format_date(team_project.start_date) : '—' %></td>
                <td class="px-4 py-3 text-gray-600"><%= team_project.end_date ? format_date(team_project.end_date) : '—' %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500"><span class="h-2 w-2 rounded-full bg-gray-300"></span>Inactive</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="inline-flex items-center justify-end gap-1">
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); teamProjectsDelete(<%= team_project.id %>, '<%= admin_ta_team_team_project_path(@team, team_project) %>', '<%= form_authenticity_token %>')"
                            class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                            title="Delete"
                            aria-label="Delete project assignment">
                      <span class="material-icons ta-inline-material-icon">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-10 text-center text-sm text-gray-500">No inactive projects assigned.</div>
    <% end %>
  </div>

  <% if @inherited_projects.any? %>
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex flex-col gap-3 border-b border-gray-200 px-6 py-3 md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="font-semibold text-gray-900">Inherited Projects from Child Teams (<%= @inherited_projects.count %>)</h3>
          <p class="text-xs text-gray-500">Projects inherited from child teams in the hierarchy.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Project</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Identifier</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Start Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">End Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Inherited From</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @inherited_projects.each do |team_project| %>
              <% project_name = team_project.local_source? ? team_project.project_name : "External Project (#{team_project.project_display_identifier})" %>
              <% project_identifier = team_project.local_source? ? team_project.project_display_identifier : team_project.project_display_identifier %>
              <% inherited_team = team_project.inherited_from_team %>
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3">
                  <% if team_project.project_linkable? %>
                    <%= link_to project_name, project_path(team_project.project), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                  <% else %>
                    <span class="text-sm font-semibold text-gray-900"><%= h(project_name) %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  <code><%= h(project_identifier.presence || '—') %></code>
                  <% if team_project.external_source? %>
                    <div class="mt-1 text-xs text-gray-500"><%= h(team_project.external_project_url) %></div>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= team_project.start_date ? format_date(team_project.start_date) : '—' %></td>
                <td class="px-4 py-3 text-gray-600"><%= team_project.end_date ? format_date(team_project.end_date) : 'Active' %></td>
                <td class="px-4 py-3 text-gray-600">
                  <% if inherited_team %>
                    <%= link_to inherited_team.name, admin_ta_team_path(inherited_team), class: 'text-sm font-medium !text-blue-600 hover:!underline' %>
                  <% else %>
                    <span class="text-sm text-gray-500">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <% if team_project.active? %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Active</span>
                  <% else %>
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500"><span class="h-2 w-2 rounded-full bg-gray-300"></span>Inactive</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

