                <label class="inline-flex items-center gap-2 text-sm text-gray-800">
                  <%= radio_button_tag 'ta_team_project[source_type]', 'external', selected_source_type == 'external', id: 'ta-add-team-project-source-external', onclick: "toggleTeamProjectSource('external')" %>
                  <span>External Support Redmine URL</span>
                </label>
              </div>
            </div>

            <div class="md:col-span-2">
              <%= label_tag :ta_team_project_search_modal, 'Project', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
              <div class="relative min-w-0" id="ta-add-team-project-wrapper">
                <input type="text"
                       id="ta-add-team-project-search"
                       value="<%= h(selected_project_text) %>"
                       placeholder="🔍 Search project... *"
                       autocomplete="off"
                       onclick="teamProjectsOpenAddDropdown()"
                       oninput="teamProjectsFilterAddProjects()"
                       onkeydown="teamProjectsHandleAddProjectKey(event)"
                       class="ta-team-settings-member-input block h-[34px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900"
                       required>
                <%= hidden_field_tag 'ta_team_project[project_id]', @team_project.project_id, id: 'ta-add-team-project-id' %>
                <div id="ta-add-team-project-list"
                     class="tep-issue-dropdown hidden absolute left-0 z-[10050] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                     style="min-width: 320px; max-height: 220px; top: calc(100% + 2px);">
                  <% @available_projects.each do |project| %>
                    <% project_text = "#{project.name} (#{project.identifier})" %>
                    <div class="tep-issue-option px-3 py-2 text-sm cursor-pointer flex items-start gap-2 border-b border-gray-50 last:border-0"
                         tabindex="0"
                         data-id="<%= project.id %>"
                         data-text="<%= j(project_text) %>"
                         data-search="<%= j("#{project.name} #{project.identifier}".downcase) %>"
                         onclick="teamProjectsSelectAddProject(this.getAttribute('data-id'), this.getAttribute('data-text'))"
                         onkeydown="teamProjectsHandleAddProjectOptionKey(event, this.getAttribute('data-id'), this.getAttribute('data-text'))">
                      <span class="text-gray-700 leading-relaxed"><%= h(project.name) %> <span class="text-gray-400">(<%= h(project.identifier) %>)</span></span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="md:col-span-2 hidden" id="ta-add-external-project-url-wrap">
              <%= label_tag :ta_team_project_external_project_url_modal, 'External Project URL', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
              <%= text_field_tag 'ta_team_project[external_project_url]',
                                 selected_external_url,
                                 id: 'ta-add-team-project-external-url',
                                 autocomplete: 'off',
                                 placeholder: 'https://support.example.com/projects/project-identifier',
                                 class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
              <p class="mt-1 text-xs text-gray-500">Must include <code>/projects/&lt;identifier&gt;</code>.</p>
            </div>

            <div>
              <%= label_tag :ta_team_project_start_date_modal, 'Start Date', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
              <%= text_field_tag 'ta_team_project[start_date]',
                                 start_date_value,
                                 id: 'ta-add-team-project-start-date',
                                 autocomplete: 'off',
                                 placeholder: 'mm/dd/yyyy',
                                 required: true,
                                 datepicker: true,
                                 'datepicker-format': 'mm/dd/yyyy',
                                 'datepicker-autohide': true,
                                 class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
            </div>

            <div>
              <%= label_tag :ta_team_project_end_date_modal, 'End Date', class: 'mb-1 block text-sm font-medium text-gray-700' %>
              <%= text_field_tag 'ta_team_project[end_date]',
                                 end_date_value,
                                 id: 'ta-add-team-project-end-date',
                                 autocomplete: 'off',
                                 placeholder: 'mm/dd/yyyy',
                                 datepicker: true,
                                 'datepicker-format': 'mm/dd/yyyy',
                                 'datepicker-autohide': true,
                                 class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
              <p class="mt-1 text-xs text-gray-500">Leave empty for ongoing projects.</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-100 pt-4">
            <button type="button"
                    onclick="teamProjectsCloseAddModal()"
                    class="ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">
              <%= l(:button_cancel) %>
            </button>
            <button type="submit"
                    class="ta-btn-save-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">Create</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

