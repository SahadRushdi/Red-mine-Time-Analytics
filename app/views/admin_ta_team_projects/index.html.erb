<% html_title "Team Projects - #{@team.name}" %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Team Projects: <%= h(@team.name) %></h2>
      <p class="text-sm text-gray-500"><%= ta_team_breadcrumb(@team) %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'Assign Project', new_admin_ta_team_team_project_path(@team), class: 'ta-btn-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
      <%= link_to 'Back to Teams', admin_ta_teams_path, class: 'ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-gray-200 px-6 py-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="font-semibold text-gray-900">Active Projects (<%= @active_projects.count %>)</h3>
        <p class="text-xs text-gray-500">Projects currently assigned to this team.</p>
      </div>
      <div class="flex w-full flex-col gap-2 md:w-auto md:flex-row md:items-center">
        <input type="text" id="ta-active-projects-search" placeholder="Search project name, identifier, or status..."
               class="ts-search-input !block !h-[44px] !w-full md:!w-80 !rounded-lg !border !border-gray-300 !px-3 !text-sm !text-gray-900 !shadow-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]"
               oninput="filterActiveProjectRows()">
      </div>
    </div>

    <% if @active_projects.any? %>
      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Project</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Identifier</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Start Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">End Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Status</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @active_projects.each do |team_project| %>
              <% form_id = "ta-team-project-form-#{team_project.id}" %>
              <% status_label = team_project.active? ? 'Active' : 'Inactive' %>
              <% search_text = [team_project.project.name, team_project.project.identifier, status_label].join(' ').downcase %>
              <tr class="ta-team-project-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                  data-search-text="<%= h(search_text) %>"
                  data-team-project-id="<%= team_project.id %>">
                <td class="px-4 py-3">
                  <%= link_to team_project.project.name, project_path(team_project.project), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                  <%= hidden_field_tag 'ta_team_project[project_id]', team_project.project_id, form: form_id, id: "ta-team-project-project-id-#{team_project.id}" %>
                </td>
                <td class="px-4 py-3 text-gray-600"><code><%= h(team_project.project.identifier) %></code></td>
                <td class="px-4 py-3 text-gray-600">
                  <div class="ta-team-project-view"><%= team_project.start_date ? format_date(team_project.start_date) : '—' %></div>
                  <div class="ta-team-project-edit hidden tep-inline-form">
                    <input type="text"
                           id="ta-team-project-start-date-<%= team_project.id %>"
                           name="ta_team_project[start_date]"
                           form="<%= form_id %>"
                           value="<%= team_project.start_date ? team_project.start_date.strftime('%m/%d/%Y') : '' %>"
                           autocomplete="off"
                           placeholder="mm/dd/yyyy"
                           datepicker
                           datepicker-format="mm/dd/yyyy"
                           datepicker-autohide
                           class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  <div class="ta-team-project-view"><%= team_project.end_date ? format_date(team_project.end_date) : 'Active' %></div>
                  <div class="ta-team-project-edit hidden tep-inline-form">
                    <input type="text"
                           id="ta-team-project-end-date-<%= team_project.id %>"
                           name="ta_team_project[end_date]"
                           form="<%= form_id %>"
                           value="<%= team_project.end_date ? team_project.end_date.strftime('%m/%d/%Y') : '' %>"
                           autocomplete="off"
                           placeholder="mm/dd/yyyy"
                           datepicker
                           datepicker-format="mm/dd/yyyy"
                           datepicker-autohide
                           class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Active</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="ta-team-project-view inline-flex items-center justify-end gap-1">
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); toggleTeamProjectInlineEdit(<%= team_project.id %>)"
                            class="ta-inline-icon-btn"
                            title="Edit"
                            aria-label="Edit project assignment">
                      <span class="material-icons ta-inline-material-icon">edit</span>
                    </button>
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); teamProjectsDelete(<%= team_project.id %>, '<%= admin_ta_team_team_project_path(@team, team_project) %>', '<%= form_authenticity_token %>')"
                            class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                            title="Delete"
                            aria-label="Delete project assignment">
                      <span class="material-icons ta-inline-material-icon">delete</span>
                    </button>
                  </div>
                  <div class="ta-team-project-edit hidden inline-flex items-center justify-end gap-2">
                    <button type="submit"
                            form="<%= form_id %>"
                            class="ta-btn-primary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Save</button>
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); toggleTeamProjectInlineEdit(<%= team_project.id %>)"
                            class="ta-btn-secondary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Cancel</button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="hidden">
        <% @active_projects.each do |team_project| %>
          <% form_id = "ta-team-project-form-#{team_project.id}" %>
          <%= form_tag admin_ta_team_team_project_path(@team, team_project), method: :patch, id: form_id, onsubmit: "return submitTeamProjectInlineEdit(#{team_project.id})" do %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-10 text-center text-sm text-gray-500">No active projects assigned.</div>
    <% end %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-gray-200 px-6 py-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="font-semibold text-gray-900">Inactive Projects (<%= @inactive_projects.count %>)</h3>
        <p class="text-xs text-gray-500">Project assignments that have ended.</p>
      </div>
    </div>

    <% if @inactive_projects.any? %>
      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Project</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Identifier</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Start Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">End Date</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Status</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @inactive_projects.each do |team_project| %>
              <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3">
                  <%= link_to team_project.project.name, project_path(team_project.project), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                </td>
                <td class="px-4 py-3 text-gray-600"><code><%= h(team_project.project.identifier) %></code></td>
                <td class="px-4 py-3 text-gray-600"><%= team_project.start_date ? format_date(team_project.start_date) : '—' %></td>
                <td class="px-4 py-3 text-gray-600"><%= team_project.end_date ? format_date(team_project.end_date) : '—' %></td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500"><span class="h-2 w-2 rounded-full bg-gray-300"></span>Inactive</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="inline-flex items-center justify-end gap-1">
                    <button type="button"
                            onclick="event.stopPropagation(); this.blur(); teamProjectsDelete(<%= team_project.id %>, '<%= admin_ta_team_team_project_path(@team, team_project) %>', '<%= form_authenticity_token %>')"
                            class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                            title="Delete"
                            aria-label="Delete project assignment">
                      <span class="material-icons ta-inline-material-icon">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-10 text-center text-sm text-gray-500">No inactive projects assigned.</div>
    <% end %>
  </div>
</div>

<div id="taTeamProjectsDeleteModal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 right-0 left-0 z-[9999] justify-center items-center w-full h-full bg-gray-900/50">
  <div class="relative p-4 w-full max-w-md">
    <div class="relative p-4 text-center bg-white rounded-lg shadow sm:p-5">
      <button type="button"
              class="tep-delete-close text-gray-400 absolute top-2.5 right-2.5 bg-transparent rounded-lg text-sm p-1.5 inline-flex items-center"
              onclick="teamProjectsCloseDeleteModal()">
        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
        <span class="sr-only">Close modal</span>
      </button>
      <svg class="text-gray-400 w-11 h-11 mb-3.5 mx-auto" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <p class="mb-4 text-gray-500">Are you sure you want to delete this project assignment?</p>
      <div class="flex justify-center items-center space-x-4">
        <button type="button" onclick="teamProjectsConfirmDelete()" class="tep-delete-confirm py-2 px-3 text-sm font-medium text-center text-white rounded-lg bg-red-600">
          Delete
        </button>
        <button type="button"
                onclick="teamProjectsCloseDeleteModal()"
                class="tep-delete-cancel py-2 px-3 text-sm font-medium text-gray-500 bg-white rounded-lg border border-gray-200">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleTeamProjectInlineEdit(teamProjectId) {
    var row = document.querySelector('[data-team-project-id="' + teamProjectId + '"]');
    if (!row) return;
    var shouldOpen = !row.classList.contains('is-editing');

    document.querySelectorAll('.ta-team-project-row.is-editing').forEach(function(editRow) {
      editRow.classList.remove('is-editing');
      editRow.querySelectorAll('.ta-team-project-view').forEach(function(viewEl) {
        viewEl.classList.remove('hidden');
      });
      editRow.querySelectorAll('.ta-team-project-edit').forEach(function(editEl) {
        editEl.classList.add('hidden');
      });
    });

    if (shouldOpen) {
      row.classList.add('is-editing');
      row.querySelectorAll('.ta-team-project-view').forEach(function(viewEl) {
        viewEl.classList.add('hidden');
      });
      row.querySelectorAll('.ta-team-project-edit').forEach(function(editEl) {
        editEl.classList.remove('hidden');
      });
      initTeamProjectInlineDatepickers(teamProjectId);
    }
  }

  function normalizeTeamProjectDate(value) {
    if (!value) return value;
    var yyyymmdd = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (yyyymmdd) return value;
    var mmddyyyy = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!mmddyyyy) return value;
    return mmddyyyy[3] + '-' + mmddyyyy[1].padStart(2, '0') + '-' + mmddyyyy[2].padStart(2, '0');
  }

  function initTeamProjectInlineDatepickers(teamProjectId) {
    ['start', 'end'].forEach(function(part) {
      var input = document.getElementById('ta-team-project-' + part + '-date-' + teamProjectId);
      if (!input) return;
      if (input.datepicker && input.datepicker.setOptions) {
        input.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true });
        return;
      }
      if (window.Datepicker) {
        new window.Datepicker(input, {
          format: 'mm/dd/yyyy',
          autohide: true
        });
      }
    });
  }

  function submitTeamProjectInlineEdit(teamProjectId) {
    var startInput = document.getElementById('ta-team-project-start-date-' + teamProjectId);
    var endInput = document.getElementById('ta-team-project-end-date-' + teamProjectId);
    if (startInput) startInput.value = normalizeTeamProjectDate(startInput.value);
    if (endInput) endInput.value = normalizeTeamProjectDate(endInput.value);
    return true;
  }

  function filterActiveProjectRows() {
    var input = document.getElementById('ta-active-projects-search');
    var query = input ? input.value.toLowerCase().trim() : '';

    document.querySelectorAll('.ta-team-project-row').forEach(function(row) {
      var text = row.getAttribute('data-search-text') || '';
      row.style.display = !query || text.indexOf(query) !== -1 ? '' : 'none';
      if (row.style.display === 'none' && row.classList.contains('is-editing')) {
        row.classList.remove('is-editing');
        row.querySelectorAll('.ta-team-project-view').forEach(function(viewEl) {
          viewEl.classList.remove('hidden');
        });
        row.querySelectorAll('.ta-team-project-edit').forEach(function(editEl) {
          editEl.classList.add('hidden');
        });
      }
    });
  }

  var teamProjectsPendingDelete = null;

  function teamProjectsOpenDeleteModal() {
    var modal = document.getElementById('taTeamProjectsDeleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function teamProjectsCloseDeleteModal() {
    var modal = document.getElementById('taTeamProjectsDeleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  function teamProjectsDelete(teamProjectId, url, token) {
    teamProjectsPendingDelete = { teamProjectId: teamProjectId, url: url, token: token };
    teamProjectsOpenDeleteModal();
  }

  function teamProjectsConfirmDelete() {
    if (!teamProjectsPendingDelete) return;
    teamProjectsCloseDeleteModal();

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = teamProjectsPendingDelete.url;
    [['authenticity_token', teamProjectsPendingDelete.token], ['_method', 'DELETE']].forEach(function(pair) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = pair[0];
      input.value = pair[1];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }

  function teamProjectsCloseDeleteModalIfBackdrop(event) {
    var modal = document.getElementById('taTeamProjectsDeleteModal');
    if (modal && !modal.classList.contains('hidden') && event.target === modal) {
      teamProjectsCloseDeleteModal();
    }
  }

  if (!window.__teamProjectsDeleteModalListenersBound) {
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        teamProjectsCloseDeleteModal();
      }
    });
    document.addEventListener('click', teamProjectsCloseDeleteModalIfBackdrop);
    window.__teamProjectsDeleteModalListenersBound = true;
  }
</script>
