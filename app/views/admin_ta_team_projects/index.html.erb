<script>
  function toggleTeamProjectInlineEdit(teamProjectId) {
    var row = document.querySelector('[data-team-project-id="' + teamProjectId + '"]');
    if (!row) return;
    var shouldOpen = !row.classList.contains('is-editing');

    document.querySelectorAll('.ta-team-project-row.is-editing').forEach(function(editRow) {
      editRow.classList.remove('is-editing');
      editRow.querySelectorAll('.ta-team-project-view').forEach(function(viewEl) {
        viewEl.classList.remove('hidden');
      });
      editRow.querySelectorAll('.ta-team-project-edit').forEach(function(editEl) {
        editEl.classList.add('hidden');
      });
    });

    if (shouldOpen) {
      row.classList.add('is-editing');
      row.querySelectorAll('.ta-team-project-view').forEach(function(viewEl) {
        viewEl.classList.add('hidden');
      });
      row.querySelectorAll('.ta-team-project-edit').forEach(function(editEl) {
        editEl.classList.remove('hidden');
      });
      initTeamProjectInlineDatepickers(teamProjectId);
      teamProjectsSyncEditSource(teamProjectId);
    }
  }

  function normalizeTeamProjectDate(value) {
    if (!value) return value;
    var yyyymmdd = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (yyyymmdd) return value;
    var mmddyyyy = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!mmddyyyy) return value;
    return mmddyyyy[3] + '-' + mmddyyyy[1].padStart(2, '0') + '-' + mmddyyyy[2].padStart(2, '0');
  }

  function teamProjectsAddElements() {
    return {
      wrapper: document.getElementById('ta-add-team-project-wrapper'),
      search: document.getElementById('ta-add-team-project-search'),
      hidden: document.getElementById('ta-add-team-project-id'),
      list: document.getElementById('ta-add-team-project-list')
    };
  }

  function teamProjectsOpenAddDropdown() {
    var els = teamProjectsAddElements();
    if (!els.list) return;
    els.list.querySelectorAll('.tep-issue-option').forEach(function(opt) { opt.style.display = ''; });
    els.list.classList.remove('hidden');
  }

  function teamProjectsCloseAddDropdown() {
    var els = teamProjectsAddElements();
    if (!els.list) return;
    els.list.classList.add('hidden');
  }

  function teamProjectsFilterAddProjects() {
    var els = teamProjectsAddElements();
    if (!els.search || !els.list) return;
    var query = els.search.value.toLowerCase().trim();
    els.list.classList.remove('hidden');
    els.list.querySelectorAll('.tep-issue-option').forEach(function(opt) {
      var text = (opt.getAttribute('data-search') || '').toLowerCase();
      opt.style.display = (!query || text.indexOf(query) >= 0) ? '' : 'none';
    });
    if (els.hidden) els.hidden.value = '';
  }

  function teamProjectsSelectAddProject(projectId, displayText) {
    var els = teamProjectsAddElements();
    if (els.hidden) els.hidden.value = projectId;
    if (els.search) els.search.value = displayText;
    teamProjectsCloseAddDropdown();
  }

  function teamProjectsHandleAddProjectKey(event) {
    var els = teamProjectsAddElements();
    if (!els.list) return;
    if (event.key === 'Escape') {
      teamProjectsCloseAddDropdown();
      return;
    }
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      var visible = Array.from(els.list.querySelectorAll('.tep-issue-option')).filter(function(opt) {
        return opt.style.display !== 'none';
      });
      if (visible.length) visible[0].focus();
    }
  }

  function teamProjectsHandleAddProjectOptionKey(event, projectId, displayText) {
    var els = teamProjectsAddElements();
    if (!els.list) return;
    var visible = Array.from(els.list.querySelectorAll('.tep-issue-option')).filter(function(opt) {
      return opt.style.display !== 'none';
    });
    var current = event.target;
    var currentIdx = visible.indexOf(current);

    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      teamProjectsSelectAddProject(projectId, displayText);
      if (els.search) els.search.focus();
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      var next = visible[currentIdx + 1];
      if (next) next.focus();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (currentIdx === 0) {
        if (els.search) els.search.focus();
      } else {
        var prev = visible[currentIdx - 1];
        if (prev) prev.focus();
      }
    } else if (event.key === 'Escape') {
      teamProjectsCloseAddDropdown();
      if (els.search) els.search.focus();
    }
  }

  function initTeamProjectAddDatepickers() {
    ['ta-add-team-project-start-date', 'ta-add-team-project-end-date'].forEach(function(id) {
      var input = document.getElementById(id);
      if (!input) return;
      if (input.datepicker && input.datepicker.setOptions) {
        input.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
      } else if (window.Datepicker) {
        new window.Datepicker(input, { format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
      }
      if (!input.dataset.datepickerLayerBound) {
        ['focus', 'click'].forEach(function(eventName) {
          input.addEventListener(eventName, function() {
            setTimeout(teamProjectsRaiseDatepickerLayer, 0);
          });
        });
        input.dataset.datepickerLayerBound = '1';
      }
    });
  }

  function teamProjectsRaiseDatepickerLayer() {
    document.querySelectorAll('.datepicker, .datepicker-dropdown, .datepicker-picker').forEach(function(el) {
      el.style.zIndex = '12000';
    });
  }

  function teamProjectsSyncEditSource(teamProjectId, sourceType) {
    var sourceButton = document.getElementById('ta-team-project-source-button-' + teamProjectId);
    var sourceLabel = document.getElementById('ta-team-project-source-label-' + teamProjectId);
    var sourceValue = document.getElementById('ta-team-project-source-value-' + teamProjectId);
    var sourceList = document.getElementById('ta-team-project-source-list-' + teamProjectId);
    var localWrap = document.getElementById('ta-team-project-local-wrap-' + teamProjectId);
    var externalWrap = document.getElementById('ta-team-project-external-wrap-' + teamProjectId);
    var projectButton = document.getElementById('ta-team-project-project-button-' + teamProjectId);
    var projectLabel = document.getElementById('ta-team-project-project-label-' + teamProjectId);
    var projectValue = document.getElementById('ta-team-project-project-id-' + teamProjectId);
    var projectList = document.getElementById('ta-team-project-project-list-' + teamProjectId);
    var externalInput = document.getElementById('ta-team-project-external-url-' + teamProjectId);

    var selectedSource = sourceType || (sourceValue ? sourceValue.value : 'local');
    var showExternal = selectedSource === 'external';

    if (localWrap) localWrap.classList.toggle('hidden', showExternal);
    if (externalWrap) externalWrap.classList.toggle('hidden', !showExternal);

    if (sourceValue) sourceValue.value = selectedSource;
    if (sourceLabel) {
      sourceLabel.textContent = showExternal ? 'External Support Redmine URL' : 'Internal Redmine Project';
    }
    if (sourceButton) sourceButton.setAttribute('aria-expanded', 'false');
    if (sourceList) sourceList.classList.add('hidden');

    if (projectButton) projectButton.disabled = showExternal;
    if (projectValue) {
      projectValue.disabled = showExternal;
      projectValue.required = !showExternal;
    }
    if (projectList) projectList.classList.add('hidden');

    if (externalInput) {
      externalInput.disabled = !showExternal;
      externalInput.required = showExternal;
    }
    if (projectLabel && projectValue && !showExternal && !projectValue.value) {
      projectLabel.textContent = 'Select project...';
    }
  }

  function teamProjectsOpenAddModal() {
    var modal = document.getElementById('taTeamProjectsAddModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    toggleTeamProjectSource(teamProjectsSelectedSourceType());
    initTeamProjectAddDatepickers();
    teamProjectsRaiseDatepickerLayer();
    setTimeout(teamProjectsRaiseDatepickerLayer, 50);
    setTimeout(teamProjectsRaiseDatepickerLayer, 250);
    var focusId = teamProjectsSelectedSourceType() === 'external' ? 'ta-add-team-project-external-url' : 'ta-add-team-project-search';
    var focusEl = document.getElementById(focusId);
    if (focusEl) focusEl.focus();
  }

  function teamProjectsCloseAddModal() {
    var modal = document.getElementById('taTeamProjectsAddModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    teamProjectsCloseAddDropdown();
  }

  function teamProjectsCloseAddModalIfBackdrop(event) {
    var modal = document.getElementById('taTeamProjectsAddModal');
    if (modal && !modal.classList.contains('hidden') && event.target === modal) {
      teamProjectsCloseAddModal();
    }
  }

  function submitTeamProjectAddForm() {
    var startInput = document.getElementById('ta-add-team-project-start-date');
    var endInput = document.getElementById('ta-add-team-project-end-date');
    var sourceType = teamProjectsSelectedSourceType();
    var projectIdInput = document.getElementById('ta-add-team-project-id');
    var externalUrlInput = document.getElementById('ta-add-team-project-external-url');
    if (startInput) startInput.value = normalizeTeamProjectDate(startInput.value.trim());
    if (endInput) endInput.value = normalizeTeamProjectDate(endInput.value.trim());

    if (sourceType === 'external') {
      if (projectIdInput) projectIdInput.value = '';
      if (!externalUrlInput || !externalUrlInput.value.trim()) {
        alert('Please provide an external project URL.');
        return false;
      }
    } else {
      if (!projectIdInput || !projectIdInput.value) {
        alert('Please select an internal project.');
        return false;
      }
      if (externalUrlInput) externalUrlInput.value = '';
    }

    return true;
  }

  function teamProjectsSelectedSourceType() {
    var selected = document.querySelector('input[name="ta_team_project[source_type]"]:checked');
    return selected ? selected.value : 'local';
  }

  function toggleTeamProjectSource(sourceType) {
    var localWrap = document.getElementById('ta-add-team-project-wrapper');
    var localInput = document.getElementById('ta-add-team-project-search');
    var externalWrap = document.getElementById('ta-add-external-project-url-wrap');
    var externalInput = document.getElementById('ta-add-team-project-external-url');

    var showExternal = sourceType === 'external';
    if (externalWrap) externalWrap.classList.toggle('hidden', !showExternal);
    if (localWrap) localWrap.classList.toggle('hidden', showExternal);

    if (localInput) localInput.required = !showExternal;
    if (externalInput) externalInput.required = showExternal;
  }

  function initTeamProjectInlineDatepickers(teamProjectId) {
    ['start', 'end'].forEach(function(part) {
      var input = document.getElementById('ta-team-project-' + part + '-date-' + teamProjectId);
      if (!input) return;
      if (input.datepicker && input.datepicker.setOptions) {
        input.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
        return;
      }
      if (window.Datepicker) {
        new window.Datepicker(input, {
          format: 'mm/dd/yyyy',
          autohide: true,
          orientation: 'top auto'
        });
      }
    });
  }

  function submitTeamProjectInlineEdit(teamProjectId) {
    var sourceValue = document.getElementById('ta-team-project-source-value-' + teamProjectId);
    var projectValue = document.getElementById('ta-team-project-project-id-' + teamProjectId);
    var externalInput = document.getElementById('ta-team-project-external-url-' + teamProjectId);
    var startInput = document.getElementById('ta-team-project-start-date-' + teamProjectId);
    var endInput = document.getElementById('ta-team-project-end-date-' + teamProjectId);
    var selectedSource = sourceValue ? sourceValue.value : 'local';
    if (startInput) startInput.value = normalizeTeamProjectDate(startInput.value);
    if (endInput) endInput.value = normalizeTeamProjectDate(endInput.value);
    if (selectedSource === 'external') {
      if (projectValue) projectValue.value = '';
      if (!externalInput || !externalInput.value.trim()) {
        alert('Please provide an external project URL.');
        return false;
      }
    } else {
      if (externalInput) externalInput.value = '';
      if (!projectValue || !projectValue.value) {
        alert('Please select a project.');
        return false;
      }
    }
    return true;
  }

  function teamProjectsCloseInlineDropdowns() {
    document.querySelectorAll('[id^="ta-team-project-source-list-"], [id^="ta-team-project-project-list-"]').forEach(function(menu) {
      menu.classList.add('hidden');
    });
  }

  function teamProjectsHandleInlineDropdownToggleClick(event) {
    var button = event.target.closest('[data-ta-dropdown-toggle]');
    if (!button) return;
    var dropdownId = button.getAttribute('data-ta-dropdown-toggle');
    var dropdown = document.getElementById(dropdownId);
    if (!dropdown) return;
    event.preventDefault();
    event.stopPropagation();
    var willOpen = dropdown.classList.contains('hidden');
    teamProjectsCloseInlineDropdowns();
    if (willOpen) dropdown.classList.remove('hidden');
  }

  function teamProjectsHandleInlineDropdownSelect(event) {
    var sourceItem = event.target.closest('[data-ta-team-project-source-value]');
    if (sourceItem) {
      event.preventDefault();
      event.stopPropagation();
      var sourceList = sourceItem.closest('[id^="ta-team-project-source-list-"]');
      if (!sourceList) return;
      var teamProjectId = sourceList.id.replace('ta-team-project-source-list-', '');
      var sourceValue = document.getElementById('ta-team-project-source-value-' + teamProjectId);
      var sourceLabel = document.getElementById('ta-team-project-source-label-' + teamProjectId);
      if (sourceValue) sourceValue.value = sourceItem.getAttribute('data-ta-team-project-source-value') || 'local';
      if (sourceLabel) sourceLabel.textContent = sourceItem.getAttribute('data-ta-team-project-source-label') || 'Internal Redmine Project';
      teamProjectsSyncEditSource(teamProjectId, sourceValue ? sourceValue.value : 'local');
      return;
    }

    var projectItem = event.target.closest('[data-ta-team-project-project-value]');
    if (projectItem) {
      event.preventDefault();
      event.stopPropagation();
      var projectList = projectItem.closest('[id^="ta-team-project-project-list-"]');
      if (!projectList) return;
      var projectTeamProjectId = projectList.id.replace('ta-team-project-project-list-', '');
      var projectValue = document.getElementById('ta-team-project-project-id-' + projectTeamProjectId);
      var projectLabel = document.getElementById('ta-team-project-project-label-' + projectTeamProjectId);
      if (projectValue) projectValue.value = projectItem.getAttribute('data-ta-team-project-project-value') || '';
      if (projectLabel) projectLabel.textContent = projectItem.getAttribute('data-ta-team-project-project-label') || 'Select project...';
      teamProjectsCloseInlineDropdowns();
      teamProjectsSyncEditSource(projectTeamProjectId, 'local');
    }
  }

  if (!window.__teamProjectsInlineDropdownBound) {
    document.addEventListener('click', function(event) {
      teamProjectsHandleInlineDropdownToggleClick(event);
      teamProjectsHandleInlineDropdownSelect(event);
      if (event.target.closest('[data-ta-dropdown-toggle]') || event.target.closest('[data-ta-dropdown-menu="true"]')) return;
      teamProjectsCloseInlineDropdowns();
    });
    window.__teamProjectsInlineDropdownBound = true;
  }

  function filterActiveProjectRows() {
    var input = document.getElementById('ta-active-projects-search');
    var query = input ? input.value.toLowerCase().trim() : '';

    document.querySelectorAll('.ta-team-project-row').forEach(function(row) {
      var text = row.getAttribute('data-search-text') || '';
      row.style.display = !query || text.indexOf(query) !== -1 ? '' : 'none';
      if (row.style.display === 'none' && row.classList.contains('is-editing')) {
        row.classList.remove('is-editing');
        row.querySelectorAll('.ta-team-project-view').forEach(function(viewEl) {
          viewEl.classList.remove('hidden');
        });
        row.querySelectorAll('.ta-team-project-edit').forEach(function(editEl) {
          editEl.classList.add('hidden');
        });
      }
    });
  }

  function resetTeamProjectsTableSortIcons(tableKey, columns, activeColumn) {
    columns.forEach(function(column) {
      var icon = document.getElementById('ta-' + tableKey + '-sort-icon-' + column);
      if (!icon) return;

      if (column !== activeColumn) {
        delete icon.dataset.order;
      }
      var order = icon.dataset.order || 'desc';
      icon.className = order === 'asc' ? 'sort asc icon icon-sorted-desc' : 'sort desc icon icon-sorted-asc';
    });
  }

  function toggleTeamProjectsTableSort(tableKey, column, rowSelector, columns, numericColumns) {
    var rows = Array.from(document.querySelectorAll(rowSelector));
    if (!rows.length) return;

    var sortIcon = document.getElementById('ta-' + tableKey + '-sort-icon-' + column);
    if (!sortIcon) return;

    var currentOrder = sortIcon.dataset.order || 'desc';
    var nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';
    var numeric = numericColumns || [];
    var tbody = rows[0].parentNode;

    rows.sort(function(a, b) {
      var attrName = 'data-sort-' + column;
      var aValue = a.getAttribute(attrName) || '';
      var bValue = b.getAttribute(attrName) || '';

      if (numeric.indexOf(column) !== -1) {
        aValue = parseInt(aValue || '0', 10);
        bValue = parseInt(bValue || '0', 10);
        return nextOrder === 'asc' ? aValue - bValue : bValue - aValue;
      }

      var stringCompare = aValue.localeCompare(bValue);
      return nextOrder === 'asc' ? stringCompare : -stringCompare;
    });

    rows.forEach(function(row) { tbody.appendChild(row); });

    delete sortIcon.dataset.order;
    sortIcon.dataset.order = nextOrder;
    resetTeamProjectsTableSortIcons(tableKey, columns, column);
  }

  var teamProjectsPendingDelete = null;

  function teamProjectsOpenDeleteModal() {
    var modal = document.getElementById('taTeamProjectsDeleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function teamProjectsCloseDeleteModal() {
    var modal = document.getElementById('taTeamProjectsDeleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  function teamProjectsDelete(teamProjectId, url, token) {
    teamProjectsPendingDelete = { teamProjectId: teamProjectId, url: url, token: token };
    teamProjectsOpenDeleteModal();
  }

  function teamProjectsConfirmDelete() {
    if (!teamProjectsPendingDelete) return;
    teamProjectsCloseDeleteModal();

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = teamProjectsPendingDelete.url;
    [['authenticity_token', teamProjectsPendingDelete.token], ['_method', 'DELETE']].forEach(function(pair) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = pair[0];
      input.value = pair[1];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }

  function teamProjectsCloseDeleteModalIfBackdrop(event) {
    var modal = document.getElementById('taTeamProjectsDeleteModal');
    if (modal && !modal.classList.contains('hidden') && event.target === modal) {
      teamProjectsCloseDeleteModal();
    }
  }

  if (!window.__teamProjectsDeleteModalListenersBound) {
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        teamProjectsCloseAddModal();
        teamProjectsCloseDeleteModal();
      }
    });
    document.addEventListener('click', function(event) {
      teamProjectsCloseDeleteModalIfBackdrop(event);
      teamProjectsCloseAddModalIfBackdrop(event);
    });
    window.__teamProjectsDeleteModalListenersBound = true;
  }

  document.addEventListener('click', function(event) {
    var addEls = teamProjectsAddElements();
    if (addEls.wrapper && addEls.list) {
      var clickedInsideList = !!addEls.list.contains(event.target);
      if (!addEls.wrapper.contains(event.target) && !clickedInsideList) {
        teamProjectsCloseAddDropdown();
      }
    }
  });

  // Prevent default first-input autofocus from selecting the Active Projects search field on initial page load.
  function clearInitialActiveProjectsSearchFocus() {
    var activeProjectsSearchInput = document.getElementById('ta-active-projects-search');
    if (!activeProjectsSearchInput) return;
    if (document.activeElement === activeProjectsSearchInput) {
      activeProjectsSearchInput.blur();
    }
  }
  setTimeout(clearInitialActiveProjectsSearchFocus, 0);
  setTimeout(clearInitialActiveProjectsSearchFocus, 100);
  initTeamProjectAddDatepickers();
  toggleTeamProjectSource(teamProjectsSelectedSourceType());
  <% if @show_add_project_modal %>
    teamProjectsOpenAddModal();
  <% end %>
</script>
