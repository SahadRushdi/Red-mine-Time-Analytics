<% html_title l(:label_activity_groups) %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <%= javascript_include_tag 'ta_activity_group_board.js', plugin: 'redmine_time_analytics' %>
<% end %>

<h2 class="!mb-1 text-2xl font-bold text-gray-900"><%= l(:label_activity_groups) %></h2>

<p class="ta-activity-groups-intro" style="color: #6b7280; margin-bottom: 1rem;">
  Drag activities between groups to define the default grouping shown on the Team Dashboard's
  "Grouped" tab. Changes save immediately. Drag a group's header to reorder columns.
</p>

<div id="ta-activity-group-board" class="ta-group-board"></div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var csrf = '<%= j form_authenticity_token %>';
    var groups = <%= raw @groups.each_with_index.map { |g, i| { id: g.id, name: g.name, color: TaActivityGroup.tableau10_colors(@groups.size)[i], position: g.position } }.to_json %>;
    var activities = <%= raw @activities.map { |a| { id: a.id, name: a.name } }.to_json %>;
    var assignments = <%= raw @assignments.transform_keys(&:to_s).to_json %>;

    function sendJson(method, url, body) {
      return fetch(url, {
        method: method,
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrf,
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        },
        body: JSON.stringify(body)
      }).then(function (response) {
        return response.json().then(function (data) {
          if (!response.ok || data.ok === false) { throw new Error(data.error || 'Request failed'); }
          return data;
        });
      });
    }

    TaActivityGroupBoard(document.getElementById('ta-activity-group-board'), {
      groups: groups,
      activities: activities,
      assignments: assignments,
      persistImmediately: true,
      onAssign: function (activityId, groupId) {
        return sendJson('POST', '<%= assign_admin_ta_activity_groups_path %>', { activity_id: activityId, group_id: groupId });
      },
      onAddGroup: function (name) {
        return sendJson('POST', '<%= admin_ta_activity_groups_path %>', { ta_activity_group: { name: name } })
          .then(function (data) { return data.group; });
      },
      onRemoveGroup: function (groupId) {
        return sendJson('DELETE', '<%= admin_ta_activity_groups_path %>/' + groupId, {});
      },
      onRenameGroup: function (groupId, name) {
        return sendJson('PATCH', '<%= admin_ta_activity_groups_path %>/' + groupId, { ta_activity_group: { name: name } });
      },
      onReorderGroups: function (orderedGroupIds) {
        return sendJson('POST', '<%= reorder_admin_ta_activity_groups_path %>', { ids: orderedGroupIds });
      }
    });
  });
</script>
