                <th scope="col" class="px-6 py-3 border-r-2 border-gray-300"><%= l("label_#{@grouping}") %></th>
                <% @projects.each do |project| %>
                  <th scope="col" class="px-6 py-3 text-center border-r border-gray-200"><%= project %></th>
