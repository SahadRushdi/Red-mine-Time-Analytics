<!-- Chart.js loaded via includes partial -->

<script>
// Global chart instance
var timeAnalyticsChart = null;

// Format hours based on Redmine's timespan format setting
// This is passed from the server via data attribute
var timespanFormat = '<%= Setting.timespan_format %>';

function formatHours(hours) {
  if (!hours || hours === 0) {
    return timespanFormat === 'minutes' ? '0:00' : '0.00';
  }
  
  if (timespanFormat === 'minutes') {
    var h = Math.floor(hours);
    var m = Math.round((hours - h) * 60);
    return h + ':' + (m < 10 ? '0' : '') + m;
  } else {
    return hours.toFixed(2);
  }
}

// Get localized grouping label from chart element data attribute
function getGroupingLabel() {
  var chartElement = document.getElementById('time-chart');
  if (chartElement) {
    var label = chartElement.getAttribute('data-grouping-label');
    if (label) {
      return label;
    }
  }
  // Fallback to capitalizing grouping value if data attribute not found
  var groupingSelect = document.getElementById('grouping');
  return groupingSelect ? groupingSelect.value.charAt(0).toUpperCase() + groupingSelect.value.slice(1) : '';
}

function toggleVisualization() {
  var container = document.getElementById('chart-container');
  var btn = document.getElementById('toggle-chart-btn');
  
  if (container.style.display === 'none' || container.style.display === '') {
    container.style.display = 'block';
    btn.textContent = 'Hide Chart';
    // Initialize chart if not already done
    if (!timeAnalyticsChart) {
      initChart();
    }
  } else {
    container.style.display = 'none';
    btn.textContent = 'Show Chart';
  }
}

function initChart() {
  var chartElement = document.getElementById('time-chart');
  if (!chartElement) {
    return;
  }

  // Prevent multiple chart creation
  if (timeAnalyticsChart) {
    timeAnalyticsChart.destroy();
    timeAnalyticsChart = null;
  }

  try {
    var chartData = chartElement.getAttribute('data-chart');
    if (!chartData || chartData === 'null' || chartData === '') {
      chartElement.parentElement.innerHTML = '<p style="text-align: center; color: #666; padding: 20px;">No data available for chart</p>';
      return;
    }

    var config = JSON.parse(chartData);
    
    // Create gradient for bar charts
    if (config.type === 'bar' && config.data.datasets[0].backgroundColor === 'GRADIENT_PLACEHOLDER') {
      var ctx = chartElement.getContext('2d');
      var gradient = ctx.createLinearGradient(0, 0, 0, chartElement.height);
      gradient.addColorStop(0, '#36a2eb');
      gradient.addColorStop(1, '#007cba');
      config.data.datasets[0].backgroundColor = gradient;
    }
    
    // Ensure responsive configuration
    if (!config.options) {
      config.options = {};
    }
    config.options.responsive = true;
    config.options.maintainAspectRatio = false;

    // Add custom tooltip callback for weekly grouping (bar and line charts)
    if ((config.type === 'bar' || config.type === 'line') && config.data.datasets[0].tooltipLabels) {
      if (!config.options.plugins) config.options.plugins = {};
      if (!config.options.plugins.tooltip) config.options.plugins.tooltip = {};
      if (!config.options.plugins.tooltip.callbacks) config.options.plugins.tooltip.callbacks = {};
      
      config.options.plugins.tooltip.callbacks.title = function(context) {
        var index = context[0].dataIndex;
        var tooltipLabels = context[0].dataset.tooltipLabels;
        return tooltipLabels ? tooltipLabels[index] : context[0].label;
      };
    }
    
    // Add tooltip label callback for bar and line charts to show formatted hours
    if (config.type === 'bar' || config.type === 'line') {
      if (!config.options.plugins) config.options.plugins = {};
      if (!config.options.plugins.tooltip) config.options.plugins.tooltip = {};
      if (!config.options.plugins.tooltip.callbacks) config.options.plugins.tooltip.callbacks = {};
      
      config.options.plugins.tooltip.callbacks.label = function(context) {
        var formattedHours = context.dataset.formattedHours;
        return 'Hours: ' + (formattedHours ? formattedHours[context.dataIndex] : context.parsed.y);
      };
    }

    // Dynamically add tooltip callbacks on the client-side
    if (config.type === 'bar' || config.type === 'line') {
      if (!config.options.plugins) config.options.plugins = {};
      if (!config.options.plugins.tooltip) config.options.plugins.tooltip = {};
      if (!config.options.plugins.tooltip.callbacks) config.options.plugins.tooltip.callbacks = {};
      
      config.options.plugins.tooltip.callbacks.label = function(context) {
        var formattedHours = context.dataset.formattedHours;
        return 'Hours: ' + (formattedHours ? formattedHours[context.dataIndex] : context.parsed.y);
      };
    }
    
    timeAnalyticsChart = new Chart(chartElement, config);
    
  } catch (error) {
    chartElement.parentElement.innerHTML = '<p style="text-align: center; color: #red; padding: 20px;">Error loading chart</p>';
  }
}

function updateChart() {
  var chartTypeDropdown = document.getElementById('chart_type_select');
  
  if (!chartTypeDropdown) {
    return;
  }
  
  var chartType = chartTypeDropdown.value;
  
  // Update hidden field with new chart type
  var hiddenChartTypeField = document.getElementById('chart_type_hidden');
  if (hiddenChartTypeField) {
    hiddenChartTypeField.value = chartType;
  }
  
  // Get the current chart element and its data
  var chartElement = document.getElementById('time-chart');
  if (!chartElement) {
    return;
  }
  
  var currentChartData = chartElement.getAttribute('data-chart');
  if (!currentChartData) {
    return;
  }
  
  try {
    // Parse the current chart configuration
    var chartConfig = JSON.parse(currentChartData);
    
    // Transform the chart type while keeping the same data
    var newChartConfig = transformChartType(chartConfig, chartType);
    
    // Update the chart element with new configuration
    chartElement.setAttribute('data-chart', JSON.stringify(newChartConfig));
    
    // Reinitialize the chart
    initChart();
    
  } catch (error) {
    // Silent fail - chart remains as is
  }
}

function transformChartType(originalConfig, newType) {
  // Create a new config based on the original data but with different chart type
  var newConfig = JSON.parse(JSON.stringify(originalConfig)); // Deep copy
  
  // Change the chart type
  newConfig.type = newType;
  
  // Adjust configuration based on chart type
  if (newType === 'line') {
    // Restore original labels if they were modified
    if (newConfig.data && newConfig.data.labels && newConfig.data.labels.length > 0) {
      var currentLabels = newConfig.data.labels.slice();
      var restoredLabels = [];
      
      for (var i = 0; i < currentLabels.length; i++) {
        var label = currentLabels[i];
        // If label contains parentheses, extract original part
        if (label.indexOf(' (') !== -1) {
          restoredLabels.push(label.split(' (')[0]);
        } else {
          restoredLabels.push(label);
        }
      }
      
      newConfig.data.labels = restoredLabels;
    }
    
    // Ensure formattedHours exists for tooltips
    if (!newConfig.data.datasets[0].formattedHours) {
      var formattedHoursArray = [];
      for (var i = 0; i < newConfig.data.datasets[0].data.length; i++) {
        formattedHoursArray.push(formatHours(newConfig.data.datasets[0].data[i]));
      }
      newConfig.data.datasets[0].formattedHours = formattedHoursArray;
    }
    
    // Get localized grouping label from data attribute
    var grouping = getGroupingLabel();
    
    // Line chart specific configuration
    newConfig.options = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              var formattedHours = context.dataset.formattedHours;
              return 'Hours: ' + (formattedHours ? formattedHours[context.dataIndex] : context.parsed.y);
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Hours'
          }
        },
        x: {
          title: {
            display: true,
            text: grouping
          },
          ticks: {
            maxRotation: 45,
            minRotation: 45
          }
        }
      }
    };
    
    // Line chart styling
    if (newConfig.data && newConfig.data.datasets && newConfig.data.datasets[0]) {
      newConfig.data.datasets[0].borderColor = '#36a2eb';
      newConfig.data.datasets[0].backgroundColor = 'rgba(54, 162, 235, 0.1)';
      newConfig.data.datasets[0].fill = true;
      newConfig.data.datasets[0].tension = 0.2;
      newConfig.data.datasets[0].borderWidth = 2;
      newConfig.data.datasets[0].pointRadius = 3;
      newConfig.data.datasets[0].pointHoverRadius = 5;
    }
    
  } else {
    // Restore original labels if they were modified
    if (newConfig.data && newConfig.data.labels && newConfig.data.labels.length > 0) {
      var currentLabels = newConfig.data.labels.slice();
      var restoredLabels = [];
      
      for (var i = 0; i < currentLabels.length; i++) {
        var label = currentLabels[i];
        // If label contains parentheses, extract original part
        if (label.indexOf(' (') !== -1) {
          restoredLabels.push(label.split(' (')[0]);
        } else {
          restoredLabels.push(label);
        }
      }
      
      newConfig.data.labels = restoredLabels;
    }
    
    // Ensure formattedHours exists for tooltips
    if (!newConfig.data.datasets[0].formattedHours) {
      var formattedHoursArray = [];
      for (var i = 0; i < newConfig.data.datasets[0].data.length; i++) {
        formattedHoursArray.push(formatHours(newConfig.data.datasets[0].data[i]));
      }
      newConfig.data.datasets[0].formattedHours = formattedHoursArray;
    }
    
    // Get localized grouping label from data attribute
    var grouping = getGroupingLabel();
    
    // Bar chart (default) configuration
    newConfig.options = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              var formattedHours = context.dataset.formattedHours;
              return 'Hours: ' + (formattedHours ? formattedHours[context.dataIndex] : context.parsed.y);
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Hours'
          }
        },
        x: {
          title: {
            display: true,
            text: grouping
          },
          ticks: {
            maxRotation: 45,
            minRotation: 45
          }
        }
      }
    };
    
    // Bar chart styling - use gradient placeholder (will be replaced during chart init)
    if (newConfig.data && newConfig.data.datasets && newConfig.data.datasets[0]) {
      newConfig.data.datasets[0].backgroundColor = 'GRADIENT_PLACEHOLDER';
      newConfig.data.datasets[0].borderWidth = 1;
    }
  }
  
  return newConfig;
}

// Update pagination info text based on view state
function updatePaginationInfo(viewState) {
  var paginationInfo = document.getElementById('pagination-info-text');
  if (!paginationInfo) {
    return;
  }
  
  var detailedText = paginationInfo.getAttribute('data-detailed-text');
  var viewMode = paginationInfo.getAttribute('data-view-mode');
  
  if (viewState === 'detailed') {
    // Show detailed view pagination (based on time periods)
    paginationInfo.textContent = detailedText;
  } else {
    // Show summary view pagination (based on activities, projects, or issues)
    var count;
    if (viewMode === 'activity') {
      count = parseInt(paginationInfo.getAttribute('data-activity-count')) || 0;
    } else if (viewMode === 'project') {
      count = parseInt(paginationInfo.getAttribute('data-project-count')) || 0;
    } else if (viewMode === 'issue') {
      count = parseInt(paginationInfo.getAttribute('data-issue-count')) || 0;
    }
    
    // Format: Redmine native format "(1-X/X)"
    paginationInfo.textContent = '(1-' + count + '/' + count + ')';
  }
}

// Toggle between detailed and summary views for daily activity analysis
function toggleActivityView() {
  var detailedView = document.getElementById('daily-detailed-view');
  var summaryView = document.getElementById('daily-summary-view');
  var toggleText = document.getElementById('view-toggle-text');
  
  if (!detailedView || !summaryView || !toggleText) {
    return;
  }
  
  var newViewState;
  if (detailedView.style.display === 'none') {
    // Currently showing summary, switch to detailed
    detailedView.style.display = 'block';
    summaryView.style.display = 'none';
    toggleText.textContent = 'Show Summary View';
    localStorage.setItem('activity_view_mode', 'detailed');
    newViewState = 'detailed';
    updatePaginationInfo('detailed');
  } else {
    // Currently showing detailed, switch to summary
    detailedView.style.display = 'none';
    summaryView.style.display = 'block';
    toggleText.textContent = 'Show Detailed View';
    localStorage.setItem('activity_view_mode', 'summary');
    newViewState = 'summary';
    updatePaginationInfo('summary');
    
    // Auto-sort by hours (descending) when showing summary view
    initSummarySorting('daily-summary-view');
  }
  
  // Store scroll flag to trigger auto-scroll
  sessionStorage.setItem('scrollToTable', 'true');
  
  // Regenerate chart with new view state
  regenerateChartForViewState(newViewState);
}

