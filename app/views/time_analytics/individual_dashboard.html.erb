              </tr>
            </thead>
            <tbody>
              <% @paginated_periods.each_with_index do |period_display, index| %>
                <% period_key = @issue_pivot_data[:raw_periods][(@offset + index)] %>
                <% row_total = @period_totals[period_key] || 0 %>
                <tr class="bg-white border-b hover:bg-gray-50">
                  <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap" data-sort-value="<%= period_key %>"><%= period_display %></td>
                  <% @issues.each do |issue_info| %>
                    <% hours = @matrix_data[period_key][issue_info[:key]] || 0 %>
                    <td class="px-6 py-4 text-center text-gray-900" data-sort-value="<%= hours %>">
                      <%= hours > 0 ? format_hours(hours) : '—' %>
                    </td>
                  <% end %>
                  <td class="px-6 py-4 text-right font-semibold text-gray-900" data-sort-value="<%= row_total %>">
