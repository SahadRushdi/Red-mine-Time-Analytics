            </tbody>
          </table>
        </div>
        
        <%# Summary View: Simple Issue Table (Hidden by default) — cards render client-side from the embedded payload %>
        <div id="issue-summary-view" style="display: none;">
          <% issue_summary_payload = {
               grandTotal: @grand_total.to_f,
               items: @issues.map do |issue_info|
                 issue = issue_info[:issue]
                 {
                   name: issue_info[:display],
                   hours: (@issue_totals[issue_info[:key]] || 0).to_f,
                   hasIssue: issue.present?,
                   id: issue&.id,
                   trackerName: issue&.tracker&.name,
                   subject: issue&.subject,
                   url: issue ? issue_path(issue) : nil
