// Restore activity view preference (supports the extra "Grouped" state)
function restoreActivityViewState() {
  var detailedView = document.getElementById('daily-detailed-view');
  var summaryView = document.getElementById('daily-summary-view');

  if (!detailedView || !summaryView) {
    return;
  }

  var hiddenField = document.getElementById('activity_view_state_field');
  var serverMode = hiddenField ? hiddenField.value : null;
  var savedMode = localStorage.getItem('activity_view_mode');
  // Default to detailed view if no saved preference
  var currentMode = savedMode || serverMode || 'detailed';

  if (currentMode === 'grouped') {
    showGroupedView({ persist: false });
  } else if (currentMode === 'summary') {
    showSummaryView('activity', { persist: false });
  } else {
    showDetailedView('activity', { persist: false });
  }
}

// Restore project view preference
function restoreProjectViewState() {
  var savedMode = localStorage.getItem('project_view_mode');
  var detailedView = document.getElementById('project-detailed-view');
  var summaryView = document.getElementById('project-summary-view');
  
  if (!detailedView || !summaryView) {
    return;
  }
  
  // Default to detailed view if no saved preference
  var currentMode = savedMode || 'detailed';
  
  if (currentMode === 'summary') {
    showSummaryView('project');
  } else {
    showDetailedView('project');
  }
}

function restoreIssueViewState() {
  var savedMode = localStorage.getItem('issue_view_mode');
  var detailedView = document.getElementById('issue-detailed-view');
  var summaryView = document.getElementById('issue-summary-view');
  
  if (!detailedView || !summaryView) {
    return;
  }
  
  // Default to detailed view if no saved preference
  var currentMode = savedMode || 'detailed';
  
  if (currentMode === 'summary') {
    showSummaryView('issue');
  } else {
    showDetailedView('issue');
  }
}



// Sync chart type dropdown with actual chart type from backend
function syncChartTypeDropdown() {
  var chartElement = document.getElementById('time-chart');
  var chartTypeDropdown = document.getElementById('chart_type_select');
  
  if (!chartElement || !chartTypeDropdown) {
    return;
  }
  
  try {
    var chartData = chartElement.getAttribute('data-chart');
    if (chartData && chartData !== 'null' && chartData !== '') {
      var config = JSON.parse(chartData);
      var actualChartType = config.type || 'bar';
      
      // Update dropdown to match actual chart type
      if (chartTypeDropdown.value !== actualChartType) {
        chartTypeDropdown.value = actualChartType;
      }
      
      // Also update the hidden field in the form
      var hiddenChartTypeField = document.getElementById('chart_type_hidden');
      if (hiddenChartTypeField && hiddenChartTypeField.value !== actualChartType) {
        hiddenChartTypeField.value = actualChartType;
      }
    }
  } catch (e) {
    // Silent fail - sync not critical
  }
}

// Donut Chart for Activity/Project/Issue Distribution
var donutChartInstance = null;

var TA_DONUT_TABLEAU10 = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'];

function initDonutChart() {
  // Get data based on view mode and view state
  var chartLabels = [];
  var chartValues = [];

  // Collect data
  <% if @view_mode == 'activity' && @activity_totals %>
    <% sorted_activities = @activity_totals.sort_by { |_, hours| -hours } %>
    <% sorted_activities.each do |activity, hours| %>
      chartLabels.push('<%= j activity %>');
      chartValues.push(<%= hours.to_f %>);
    <% end %>
  <% elsif @view_mode == 'project' && @project_totals %>
    <% sorted_projects = @project_totals.sort_by { |_, hours| -hours } %>
    <% sorted_projects.each do |project, hours| %>
      chartLabels.push('<%= j project %>');
      chartValues.push(<%= hours.to_f %>);
    <% end %>
  <% elsif @view_mode == 'issue' && @issue_totals %>
    <% sorted_issues = @issue_totals.sort_by { |_, hours| -hours } %>
    <% sorted_issues.each do |issue_key, hours| %>
      <% issue_info = @issues.find { |i| i[:key] == issue_key } %>
      <% label = issue_info && issue_info[:issue] ? "##{issue_info[:issue].id}" : (issue_info ? issue_info[:display] : 'Unknown') %>
      chartLabels.push('<%= j label %>');
      chartValues.push(<%= hours.to_f %>);
    <% end %>
  <% end %>

  var chartColors = chartLabels.map(function(_, index) { return TA_DONUT_TABLEAU10[index % TA_DONUT_TABLEAU10.length]; });
  renderDonutFromArrays(chartLabels, chartValues, chartColors);
}

// Builds/replaces the donut chart + its legend from plain labels/values/colors arrays. Shared by
// initDonutChart (per-activity/project/issue, from server-rendered data) and the Activity tab's
// "Grouped" view (from the client-side regrouped pivot, see team_activity_groups.js).
function renderDonutFromArrays(labels, values, colors) {
  var donutCanvas = document.getElementById('donut-chart');
  if (!donutCanvas) return;

  if (donutChartInstance) {
    donutChartInstance.destroy();
    donutChartInstance = null;
  }

  if (labels.length === 0 || values.length === 0) {
    renderEmptyState(donutCanvas.closest('.ta-analysis-donut'), emptyChartMessage);
    return;
  }

  // Calculate total for percentages and center display
  var total = values.reduce(function(sum, val) { return sum + val; }, 0);

  // Update center text with total hours
  var centerText = document.getElementById('total-hours-display');
  if (centerText) {
    centerText.textContent = formatHours(total);
  }

  // Create donut chart
  var ctx = donutCanvas.getContext('2d');
  donutChartInstance = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels,
      datasets: [{
        data: values,
        backgroundColor: colors,
        borderColor: '#ffffff',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutoutPercentage: 65,
      legend: {
        display: false
      },
      tooltips: {
        backgroundColor: 'rgba(0, 0, 0, 0.8)',
        padding: 12,
        titleFontSize: 14,
        titleFontStyle: 'bold',
        bodyFontSize: 13,
        cornerRadius: 8,
        callbacks: {
          label: function(tooltipItem, data) {
            var label = data.labels[tooltipItem.index] || '';
            var value = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
            var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
            var formattedHours = formatHours(value);
            return label + ': ' + formattedHours + ' (' + percentage + '%)';
          }
        }
      }
    }
  });

  generateDonutLegend(labels, values, colors, total);
}

function generateDonutLegend(labels, values, colors, total) {
  var legendContainer = document.getElementById('donut-legend');
  if (!legendContainer) return;
  
  legendContainer.innerHTML = '';
  
  for (var i = 0; i < labels.length; i++) {
    var percentage = total > 0 ? ((values[i] / total) * 100).toFixed(1) : 0;
    var formattedHours = formatHours(values[i]);
    
    var legendItem = document.createElement('div');
    legendItem.className = 'flex items-center justify-between text-xs';
    
    legendItem.innerHTML = `
      <div class="flex items-center gap-1.5 flex-1 min-w-0">
        <div class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: ${colors[i]}"></div>
        <span class="text-gray-700 truncate">${labels[i]}</span>
      </div>
      <div class="flex items-center gap-1.5 ml-2 flex-shrink-0">
        <span class="font-semibold text-gray-900">${formattedHours}</span>
        <span class="font-semibold" style="color: ${colors[i]}">(${percentage}%)</span>
      </div>
    `;
    
    legendContainer.appendChild(legendItem);
  }
}

