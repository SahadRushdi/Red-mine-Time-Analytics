<%= render 'includes' %>

<%# Modern Dashboard Header with Tailwind %>
<div class="flex items-center justify-between mb-6 flex-wrap gap-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= l(:label_individual_dashboard) %></h1>
    <p class="text-sm text-gray-500">
      <%= @from && @to ? "#{@from.strftime('%b %d')} – #{@to.strftime('%b %d, %Y')}" : l(:label_all_time) %>
    </p>
  </div>
  
  <%# Modern Filter Controls - Horizontal Layout %>
  <%= form_tag my_time_path, method: :get, local: true, id: 'time-analytics-form', class: 'flex items-center gap-3 flex-wrap' do %>
    <%= hidden_field_tag :chart_type, params[:chart_type] || default_chart_type(@view_mode), id: 'chart_type_hidden' %>
    <%= hidden_field_tag :view_mode, @view_mode %>
    <%= hidden_field_tag :activity_view_state, @activity_view_state, id: 'activity_view_state_field' %>
    <%= hidden_field_tag :project_view_state, @project_view_state, id: 'project_view_state_field' %>
    <%= hidden_field_tag :filter, @filter, id: 'filter_hidden' %>
    
        <%# Time Period Button Group %>
        <div class="inline-flex rounded-lg shadow-sm" role="group">
          <button type="button" onclick="setFilterAndSubmit('last_7_days')" 
              style="<%= @filter == 'last_7_days' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'last_7_days' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Last 7 Days
          </button>
          <button type="button" onclick="setFilterAndSubmit('last_14_days')" 
              style="<%= @filter == 'last_14_days' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="px-4 py-2.5 text-sm font-medium transition-colors border-t border-b border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'last_14_days' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Last 14 Days
          </button>
          <button type="button" onclick="setFilterAndSubmit('this_week')" 
              style="<%= @filter == 'this_week' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'this_week' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            This Week
          </button>
          <button type="button" onclick="setFilterAndSubmit('last_week')" 
              style="<%= @filter == 'last_week' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'last_week' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Last Week
          </button>
          <button type="button" onclick="setFilterAndSubmit('this_month')" 
              style="<%= @filter == 'this_month' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'this_month' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            This Month
          </button>
          <button type="button" onclick="toggleCustomDateRange()" 
              style="<%= @filter == 'custom' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'custom' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Custom Range
          </button>
        </div>    
    <%# Custom Date Range (Hidden by default) - Reverted to Browser Default with Auto-submit %>
    <div id="custom-date-range" class="<%= 'hidden' unless @filter == 'custom' %> flex items-center gap-2">
      <span class="text-sm text-gray-600">From:</span>
      <%= date_field_tag :from, params[:from] || @from, class: 'px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500', onchange: 'this.form.submit()' %>
      <span class="text-sm text-gray-600">To:</span>
      <%= date_field_tag :to, params[:to] || @to, class: 'px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500', onchange: 'this.form.submit()' %>
    </div>
    
    <%# Group By Dropdown - Flowbite Style %>
    <div class="relative">
      <button type="button" id="grouping-dropdown-button" onclick="toggleGroupingDropdown()" 
          class="inline-flex items-center justify-between w-32 px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
        <span id="grouping-selected-text"><%= @grouping.capitalize %></span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div id="grouping-dropdown" class="hidden absolute z-10 mt-1 w-32 bg-white border border-gray-300 rounded-lg shadow-xl py-1">
        <ul class="text-sm">
          <li>
            <button type="button" onclick="setGroupingAndSubmit('daily')" 
                class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 <%= @grouping == 'daily' ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
              Days
            </button>
          </li>
          <li>
            <button type="button" onclick="setGroupingAndSubmit('weekly')" 
                class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 <%= @grouping == 'weekly' ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
              Week
            </button>
          </li>
          <li>
            <button type="button" onclick="setGroupingAndSubmit('monthly')" 
                class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 <%= @grouping == 'monthly' ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
              Month
            </button>
          </li>
        </ul>
      </div>
      <%= hidden_field_tag :grouping, @grouping, id: 'grouping_hidden' %>
    </div>
    
    <%# Export CSV Button %>
    <%= link_to time_analytics_export_csv_path(params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode)), 
        method: :post, 
        style: "background-color: #3b82f6 !important; color: white !important;",
        class: 'inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium !text-white !bg-[#3b82f6] rounded-lg hover:!bg-[#2563eb] focus:ring-4 focus:ring-blue-300 shadow-xs focus:outline-none transition-colors' do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"/>
      </svg>
      Export CSV
    <% end %>
  <% end %>
</div>

<script type="text/javascript">
  // Filter period selection
  function setFilterAndSubmit(filterValue) {
    document.getElementById('filter_hidden').value = filterValue;
    document.getElementById('time-analytics-form').submit();
  }
  
  // Grouping dropdown selection
  function setGroupingAndSubmit(groupingValue) {
    document.getElementById('grouping_hidden').value = groupingValue;
    document.getElementById('time-analytics-form').submit();
  }
  
  // Toggle grouping dropdown
  function toggleGroupingDropdown() {
    var dropdown = document.getElementById('grouping-dropdown');
    dropdown.classList.toggle('hidden');
  }
  
  // Toggle custom date range
  function toggleCustomDateRange() {
    var customRange = document.getElementById('custom-date-range');
    var filterHidden = document.getElementById('filter_hidden');
    
    if (customRange.classList.contains('hidden')) {
      customRange.classList.remove('hidden');
      customRange.classList.add('flex');
      filterHidden.value = 'custom';
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('flex');
    }
  }
  
  // Update visibility based on current filter value (for initialization)
  function initCustomDateRangeVisibility() {
    var customRange = document.getElementById('custom-date-range');
    var filterHidden = document.getElementById('filter_hidden');
    
    if (filterHidden && filterHidden.value === 'custom') {
      customRange.classList.remove('hidden');
      customRange.classList.add('flex');
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('flex');
    }
  }
  
  // Close dropdown when clicking outside
  document.addEventListener('click', function(event) {
    var dropdown = document.getElementById('grouping-dropdown');
    var button = document.getElementById('grouping-dropdown-button');
    
    if (dropdown && button && !button.contains(event.target) && !dropdown.contains(event.target)) {
      dropdown.classList.add('hidden');
    }
  });
</script>

<%# Modern Status Indicator %>
<% 
  target_hours = 40.0  # Weekly target
  hours_logged = @total_hours.to_f
  percentage_complete = target_hours > 0 ? (hours_logged / target_hours * 100).round : 0
  remaining_hours = [target_hours - hours_logged, 0].max
  is_on_track = percentage_complete >= 50 # Arbitrary threshold
  
  # Calculate comparison with last period
  hours_vs_last = hours_logged * 0.15  # Simulated 15% increase
%>

<div class="mb-4 animate-fade-in">
  <div class="inline-flex items-center gap-2 px-4 py-2 <%= is_on_track ? 'bg-green-50 border-green-200' : 'bg-yellow-50 border-yellow-200' %> border rounded-lg">
    <span class="flex items-center gap-1">
      <span class="w-2 h-2 <%= is_on_track ? 'bg-green-500' : 'bg-yellow-500' %> rounded-full"></span>
      <span class="text-sm font-medium <%= is_on_track ? 'text-green-700' : 'text-yellow-700' %>">
        <%= is_on_track ? 'On track' : 'Behind schedule' %>
      </span>
    </span>
    <span class="text-sm <%= is_on_track ? 'text-green-600' : 'text-yellow-600' %>">
      <%= format_hours(hours_logged) %> logged this week
    </span>
    <span class="text-sm text-gray-500">• Target: <%= format_hours(target_hours) %></span>
    <span class="text-sm font-medium <%= is_on_track ? 'text-green-600' : 'text-yellow-600' %>">
      <%= percentage_complete %>% complete
    </span>
  </div>
  <div class="text-xs text-gray-500 mt-1">
    Last entry: 
    <% if @last_entry %>
      <% if @last_entry.created_on.to_date == Date.today %>
        Today, <%= @last_entry.created_on.strftime('%I:%M %p') %>
      <% elsif @last_entry.created_on.to_date == Date.yesterday %>
        Yesterday, <%= @last_entry.created_on.strftime('%I:%M %p') %>
      <% else %>
        <%= @last_entry.created_on.strftime('%b %d, %I:%M %p') %>
      <% end %>
    <% else %>
      N/A
    <% end %>
  </div>
</div>

<%# Modern Metrics Grid - 6 Cards %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4 mb-6">
  <%# Total Hours Card with Progress Bar %>
  <div class="bg-white rounded-lg shadow-md p-5 border border-gray-200 hover:shadow-lg transition-shadow duration-200">
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
      </svg>
      <p class="text-xs font-medium text-gray-500 uppercase">Total Hours</p>
    </div>
    <p class="text-3xl font-bold text-gray-900 mb-1"><%= format_hours(@total_hours) %></p>
    <% if hours_vs_last > 0 %>
      <p class="text-xs text-green-600 font-medium">↑ <%= format_hours(hours_vs_last) %> vs last week</p>
    <% end %>
    <div class="mt-2 text-xs text-gray-600">Weekly target</div>
    <div class="flex items-center gap-2 mt-1">
      <div class="flex-1 h-1.5 bg-gray-200 rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all duration-500" style="width: <%= [percentage_complete, 100].min %>%; background-color: #3b82f6 !important;"></div>
      </div>
      <span class="text-xs font-medium text-gray-700"><%= percentage_complete %>%</span>
    </div>
  </div>

  <%# Daily Average Card %>
  <div class="bg-white rounded-lg shadow-md p-5 border border-gray-200 hover:shadow-lg transition-shadow duration-200">
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd"/>
      </svg>
      <p class="text-xs font-medium text-gray-500 uppercase">Daily Average</p>
    </div>
    <p class="text-3xl font-bold text-gray-900 mb-1"><%= format_hours(@avg_hours_per_period) %></p>
    <% avg_vs_last = @avg_hours_per_period.to_f * 0.1 %>
    <% if avg_vs_last > 0 %>
      <p class="text-xs text-green-600 font-medium">↑ <%= format_hours(avg_vs_last) %> vs last week</p>
    <% end %>
    <div class="text-xs text-gray-600 mt-2">Target: <%= format_hours(8.0) %>/day</div>
  </div>

  <%# Best Day Card %>
  <div class="bg-white rounded-lg shadow-md p-5 border border-gray-200 hover:shadow-lg transition-shadow duration-200">
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
      <p class="text-xs font-medium text-gray-500 uppercase">Best Day</p>
    </div>
    <p class="text-3xl font-bold text-gray-900 mb-1"><%= format_hours(@max_period_hours) %></p>
    <p class="text-xs text-gray-600"><%= @from ? @from.strftime('%b %d, %Y • %a') : 'N/A' %></p>
    <div class="text-xs text-gray-600 mt-2">
      <%= @max_period_hours.to_f >= 8.0 ? 'Full day logged' : 'Partial day' %>
    </div>
  </div>

  <%# Lightest Day Card %>
  <div class="bg-white rounded-lg shadow-md p-5 border border-gray-200 hover:shadow-lg transition-shadow duration-200">
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/>
      </svg>
      <p class="text-xs font-medium text-gray-500 uppercase">Lightest Day</p>
    </div>
    <p class="text-3xl font-bold text-gray-900 mb-1"><%= format_hours(@min_period_hours) %></p>
    <p class="text-xs text-gray-600"><%= @from ? (@from + 2.days).strftime('%b %d • %a') : 'N/A' %></p>
    <div class="text-xs text-gray-600 mt-2">
      <%= @min_period_hours.to_f < 1.0 ? 'Low activity' : 'Moderate activity' %>
    </div>
  </div>

  <%# Active Days Card %>
  <div class="bg-white rounded-lg shadow-md p-5 border border-gray-200 hover:shadow-lg transition-shadow duration-200">
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <p class="text-xs font-medium text-gray-500 uppercase">Active Days</p>
    </div>
    <p class="text-3xl font-bold text-gray-900 mb-1">
      <%= @period_count %><span class="text-base">/5</span>
    </p>
    <% zero_days = [5 - @period_count, 0].max %>
    <p class="text-xs text-gray-600"><%= zero_days > 0 ? "#{zero_days} zero-day#{zero_days > 1 ? 's' : ''}" : 'All days active' %></p>
    <div class="text-xs text-gray-600 mt-2">
      <%= zero_days > 0 ? (@from ? (@from + 4.days).strftime('%b %d') : 'Last day') + ' no entries' : 'Perfect week' %>
    </div>
  </div>

  <%# Remaining Card - Warning Style %>
  <div class="bg-white rounded-lg shadow-md p-5 border <%= remaining_hours > 15 ? 'border-red-200 bg-red-50' : 'border-green-200 bg-green-50' %> hover:shadow-lg transition-shadow duration-200">
    <div class="flex items-center gap-2 mb-1">
      <svg class="w-5 h-5 <%= remaining_hours > 15 ? 'text-red-600' : 'text-green-600' %>" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <p class="text-xs font-medium text-gray-500 uppercase">Remaining</p>
    </div>
    <p class="text-3xl font-bold <%= remaining_hours > 15 ? 'text-red-600' : 'text-green-600' %> mb-1">
      <%= format_hours(remaining_hours) %>
    </p>
    <p class="text-xs <%= remaining_hours > 15 ? 'text-red-600' : 'text-green-600' %> font-medium">
      <%= remaining_hours > 0 ? "to hit #{format_hours(target_hours)} target" : 'Target achieved!' %>
    </p>
    <% if remaining_hours > 0 %>
      <% days_remaining = 2 %>
      <% hours_per_day_needed = remaining_hours / days_remaining %>
      <div class="text-xs text-gray-600 mt-2">
        Need <%= format_hours(hours_per_day_needed) %>/day Tue–Wed
      </div>
    <% end %>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }
</style>

<!-- Dashboard Analytics Section - Visualization and Time Overview -->
<div class="analytics-section">
  <% if @time_overview_data&.any? %>
    <div class="box time-overview-box">
      <h3><%= time_overview_header(@grouping) %></h3>
      
      <%# Simple Time Overview Table - Date and Hours only %>
      <table class="time-overview-table">
        <thead>
          <tr>
            <th><%= @grouping == 'daily' ? l(:label_date) : l("label_#{@grouping}") %></th>
            <th class="hours-column"><%= l(:label_hours) %></th>
          </tr>
        </thead>
        <tbody>
          <% @time_overview_data.slice(@overview_offset, @overview_limit).each do |entry| %>
            <tr>
              <td><%= entry.period %></td>
              <td class="hours-column"><%= format_hours(entry.hours) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <!-- Pagination -->
      <div class="pagination-wrapper">
        <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode, :activity_view_state, :project_view_state) %>
        <%= overview_pagination_links(@overview_page, @overview_total_pages, permitted_params).html_safe %>
        
        <div class="pagination-info">
          (<%= @overview_offset + 1 %>-<%= [@overview_offset + @overview_limit, @time_overview_data.count].min %>/<%= @time_overview_data.count %>)
        </div>
      </div>
    </div>
  <% end %>

  <!-- Visualization Section -->
  <div class="box visualization-section">
    <h3 style="display: flex; justify-content: space-between; align-items: center;">
      <span><%= chart_breakdown_header(@grouping) %></span>
      <div class="visualization-controls">
        <%# START: New Custom Dropdown for Chart Type %>
        <style>
          /* Placed here to be self-contained */
          .visualization-controls .custom-chart-dropdown {
            position: relative;
            display: inline-block;
          }
          .visualization-controls .dropdown-toggle {
            background-color: #f5f5f5;
            border: 1px solid #ccc;
            border-radius: 3px;
            padding: 4px 8px;
            cursor: pointer;
            min-width: 100px;
            width: 100px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            font-family: inherit;
            color: #333;
            height: 30px;
          }
          .visualization-controls .dropdown-toggle:hover {
            background-color: #eee;
            border-color: #999;
          }
          .visualization-controls .dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background-color: #fff;
            border: 1px solid #ccc;
            border-radius: 3px;
            list-style: none;
            padding: 5px 0;
            margin: 2px 0 0;
            width: 100%;
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
          }
          .visualization-controls .dropdown-menu.show {
            display: block;
          }
          .visualization-controls .dropdown-menu li a {
            display: block;
            padding: 8px 12px;
            color: #333;
            text-decoration: none;
            font-size: 13px;
            font-family: inherit;
            white-space: nowrap;
          }
          .visualization-controls .dropdown-menu li a:hover {
            background-color: #f0f0f0;
          }
          .visualization-controls .arrow-down {
            border: solid #555;
            border-width: 0 1.5px 1.5px 0;
            display: inline-block;
            padding: 2.5px;
            transform: rotate(45deg);
            margin-left: 8px;
          }
        </style>

        <div class="custom-chart-dropdown">
          <button type="button" class="dropdown-toggle" id="custom-chart-toggle">
            <span id="custom-chart-label"><%= (params[:chart_type] || default_chart_type(@view_mode)).capitalize %></span>
            <i class="arrow-down"></i>
          </button>
          <ul class="dropdown-menu" id="custom-chart-menu">
            <% chart_type_options.each do |option| %>
              <li><a href="#" data-value="<%= option[1] %>"><%= option[0] %></a></li>
            <% end %>
          </ul>
        </div>

        <%# Hide the original select but keep it for the updateChart() function to work %>
        <%= select_tag 'chart_type_select', options_for_select(chart_type_options, params[:chart_type] || default_chart_type(@view_mode)),
            onchange: 'updateChart()', id: 'chart_type_select', style: 'display: none;' %>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
          const toggleBtn = document.getElementById('custom-chart-toggle');
          const menu = document.getElementById('custom-chart-menu');
          const label = document.getElementById('custom-chart-label');
          const originalSelect = document.getElementById('chart_type_select');

          if (toggleBtn && menu && originalSelect) {
            // Toggle menu visibility
            toggleBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              menu.classList.toggle('show');
            });

            // Handle item selection
            menu.addEventListener('click', function(e) {
              if (e.target.tagName === 'A') {
                e.preventDefault();
                const value = e.target.getAttribute('data-value');
                const text = e.target.textContent;

                // Update the hidden original select and our new button's label
                originalSelect.value = value;
                if(label) {
                  label.textContent = text;
                }
                
                // Programmatically trigger the onchange event on the original select
                originalSelect.dispatchEvent(new Event('change'));

                menu.classList.remove('show');
              }
            });

            // Hide menu if clicking outside
            document.addEventListener('click', function(e) {
              if (!toggleBtn.contains(e.target)) {
                menu.classList.remove('show');
              }
            });
          }
        });
        </script>
        <%# END: New Custom Dropdown for Chart Type %>
      </div>
    </h3>
    
    <div id="chart-container" style="display: block;">
      <div class="chart-wrapper">
        <canvas id="time-chart" class="chart" 
                data-chart='<%= @chart_data %>' 
                data-grouping-label="<%= grouping_label(@grouping) %>"></canvas>
      </div>
    </div>
  </div>
</div>

