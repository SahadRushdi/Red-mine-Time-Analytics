                </th>
                <th class="bar-column"></th>
              </tr>
            </thead>
            <tbody>
              <% @activities.each do |activity| %>
                <% hours = @activity_totals[activity] || 0 %>
                <% percentage = @grand_total > 0 ? (hours / @grand_total * 100) : 0 %>
                <tr>
                  <td><%= activity %></td>
                  <td class="hours-column" data-value="<%= hours %>"><%= format_hours(hours) %></td>
