             }.to_json %>
          <div id="<%= summary_view_id %>-payload" data-payload='<%= issue_summary_payload %>' style="display:none;"></div>
          <div id="<%= summary_view_id %>-cards" class="space-y-2 px-2 pt-4"></div>
          <div class="pagination-wrapper">
            <span id="<%= summary_view_id %>-pagination-links"></span>
            <div class="pagination-info" id="<%= summary_view_id %>-pagination-info"></div>
          </div>
        </div>
      <% end %>
    <% end %>

    </div>
    
    <!-- Flowbite Pagination (Detailed only — Summary paginates client-side within its own view) -->
    <% if @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'issue' %>
      <% current_view_state = case @view_mode
           when 'activity' then @activity_view_state
           when 'project' then @project_view_state
           when 'issue' then @issue_view_state
         end %>
      <% hide_detailed_pagination_bar = current_view_state == 'summary' ||
                                        (current_view_state == 'grouped' && @activity_groups.blank?) %>
      <div id="detailed-pagination-bar" class="px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3" style="<%= hide_detailed_pagination_bar ? 'display: none;' : '' %>">
        <div class="text-sm text-gray-700" id="pagination-info-text"
             data-detailed-text="(<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)">
          (<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)
        </div>
        <nav id="pagination-links-nav" class="flex gap-1 max-w-full overflow-x-auto">
          <% current_page = params[:page].to_i > 0 ? params[:page].to_i : 1 %>
          <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :view_mode, :user_id, :activity_view_state, :project_view_state, :issue_view_state, :hide_holidays) %>
          <%= pagination_links(current_page, @total_pages, permitted_params).html_safe %>
