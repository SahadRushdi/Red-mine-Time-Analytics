        </div>
        
        <%# Summary View: Simple Issue Table (Hidden by default) %>
        <div id="issue-summary-view" style="display: none;">
          <div class="space-y-6 px-2 pt-4">
            <% 
              # Sort issues by hours (highest to lowest)
              sorted_issues = @issues.sort_by { |issue_info| -(@issue_totals[issue_info[:key]] || 0) }
              sorted_issues.each_with_index do |issue_info, index| 
            %>
              <% hours = @issue_totals[issue_info[:key]] || 0 %>
              <% percentage = @grand_total > 0 ? (hours / @grand_total * 100) : 0 %>
              <% bar_color = summary_chart_colors[index % summary_chart_colors.length] %>
              <div class="bg-white hover:bg-gray-50 rounded-lg p-2 transition-colors duration-200">
                <!-- Issue name and hours -->
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-base font-medium text-gray-900 flex-1 mr-4">
                      <% if issue_info[:issue] %>
                        <span class="ts-tracker-badge"><%= issue_info[:issue].tracker.name %></span>
                        <%= link_to "##{issue_info[:issue].id}", issue_path(issue_info[:issue]), target: '_blank',
                              class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline mr-1 transition-colors' %>
                        <%= link_to ": #{h(issue_info[:issue].subject)}".html_safe, issue_path(issue_info[:issue]), target: '_blank',
                              class: 'text-sm !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                      <% else %>
                        <%= issue_info[:display] %>
                      <% end %>
                    </h3>
                  <div class="flex items-center gap-3 flex-shrink-0">
                    <span class="text-base font-semibold text-gray-900"><%= format_hours(hours) %></span>
                    <span class="text-sm font-medium text-gray-500 min-w-[45px] text-right"><%= number_with_precision(percentage, precision: 1) %>%</span>
                  </div>
                </div>
                <!-- Progress bar -->
                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-300" style="width: <%= percentage %>%; background-color: <%= bar_color %>;"></div>
                </div>
                <!-- Subtitle -->
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    </div>
    
    <!-- Flowbite Pagination -->
    <% if @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'issue' %>
      <div class="px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="text-sm text-gray-700" id="pagination-info-text" 
             data-detailed-text="(<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)"
             data-activity-count="<%= @activities&.count || 0 %>"
             data-project-count="<%= @projects&.count || 0 %>"
             data-issue-count="<%= @issues&.count || 0 %>"
             data-view-mode="<%= @view_mode %>">
          (<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)
        </div>
        <nav class="flex gap-1 max-w-full overflow-x-auto">
          <% current_page = params[:page].to_i > 0 ? params[:page].to_i : 1 %>
          <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :view_mode, :user_id) %>
