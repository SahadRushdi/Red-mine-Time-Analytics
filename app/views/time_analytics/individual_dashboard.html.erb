  <% else %>
    <div class="px-6 py-8 text-center">
      <p class="text-sm text-gray-500"><%= l(:label_no_data) %></p>
    </div>
  <% end %>
    </div>
    
    <!-- Donut Chart Section (fixed narrow width) -->
    <div class="ta-analysis-donut w-80 flex-shrink-0 bg-white rounded-lg shadow-md p-4 border border-gray-200">
      
      <div class="relative h-80 flex items-center justify-center">
        <canvas id="donut-chart" class="chart"></canvas>
        <!-- Center text for total hours -->
        <div id="donut-center-text" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
          <span class="text-3xl font-bold text-gray-900" id="total-hours-display">0h</span>
          <span class="text-xs text-gray-500">Total Hours</span>
        </div>
      </div>
      
      <!-- Legend -->
      <div id="donut-legend" class="mt-4 space-y-1.5 max-h-60 overflow-y-auto text-sm">
        <!-- Legend items will be generated by JavaScript -->
      </div>
    </div>
  </div>
<% end %>

<!-- Chart.js loaded via includes partial -->

<script>
// Global chart instance
var timeAnalyticsChart = null;

// Format hours based on Redmine's timespan format setting
// This is passed from the server via data attribute
var timespanFormat = '<%= Setting.timespan_format %>';

function formatHours(hours) {
  if (!hours || hours === 0) {
    return timespanFormat === 'minutes' ? '0:00' : '0.00';
  }
  
  if (timespanFormat === 'minutes') {
    var h = Math.floor(hours);
    var m = Math.round((hours - h) * 60);
    return h + ':' + (m < 10 ? '0' : '') + m;
  } else {
    return hours.toFixed(2);
  }
}

var emptyChartMessage = '<%= j(l(:label_no_chart_data_for_range, range: date_range_label)) %>';

function renderEmptyState(container, message, wrapperClass) {
  if (!container) return;

  var classes = wrapperClass || 'h-80 flex items-center justify-center';
  container.innerHTML = '<div class="' + classes + '"><p class="text-center text-gray-500 text-sm px-4">' + message + '</p></div>';
}

// Get localized grouping label from chart element data attribute
function getGroupingLabel() {
  var chartElement = document.getElementById('time-chart');
  if (chartElement) {
    var label = chartElement.getAttribute('data-grouping-label');
    if (label) {
      return label;
    }
  }
  // Fallback to capitalizing grouping value if data attribute not found
  var groupingSelect = document.getElementById('grouping');
  return groupingSelect ? groupingSelect.value.charAt(0).toUpperCase() + groupingSelect.value.slice(1) : '';
}

function toggleVisualization() {
  var container = document.getElementById('chart-container');
  var btn = document.getElementById('toggle-chart-btn');
  
  if (container.style.display === 'none' || container.style.display === '') {
    container.style.display = 'block';
    btn.textContent = 'Hide Chart';
    // Initialize chart if not already done
    if (!timeAnalyticsChart) {
      initChart();
    }
  } else {
    container.style.display = 'none';
    btn.textContent = 'Show Chart';
  }
}

function initChart() {
  var chartElement = document.getElementById('time-chart');
  if (!chartElement) {
    return;
  }

  // Prevent multiple chart creation
  if (timeAnalyticsChart) {
    timeAnalyticsChart.destroy();
    timeAnalyticsChart = null;
  }

  try {
    var chartData = chartElement.getAttribute('data-chart');
    if (!chartData || chartData === 'null' || chartData === '') {
      renderEmptyState(chartElement.parentElement, emptyChartMessage);
      return;
    }

    var config = JSON.parse(chartData);
    if (config && (config.empty || !config.data || !config.data.labels || config.data.labels.length === 0 || !config.data.datasets || config.data.datasets.length === 0)) {
      renderEmptyState(chartElement.parentElement, emptyChartMessage);
      return;
    }
    
    // Ensure responsive configuration
    if (!config.options) {
      config.options = {};
    }
    config.options.responsive = true;
    config.options.responsive = true;
    config.options.maintainAspectRatio = false;

    // Add tooltip label callback for line charts to show formatted hours
    // Add custom tooltip callbacks for Chart.js v2
    if (!config.options.tooltips) config.options.tooltips = {};
    if (!config.options.tooltips.callbacks) config.options.tooltips.callbacks = {};
    
    // Filter out zero-value items from tooltip (Chart.js v2)
    config.options.tooltips.filter = function(tooltipItem, data) {
      if (!tooltipItem || !data || !data.datasets) return false;
      var dataset = data.datasets[tooltipItem.datasetIndex];
      if (!dataset || !dataset.data) return false;
      var value = dataset.data[tooltipItem.index];
      return value !== 0 && value !== '0.00';
    };
    
    // Custom title callback for weekly format
    config.options.tooltips.callbacks.title = function(tooltipItems, data) {
      if (!tooltipItems || tooltipItems.length === 0 || !tooltipItems[0]) return '';
      var index = tooltipItems[0].index;
      if (index === undefined || index === null) return '';
      
      var dataset = data && data.datasets ? data.datasets[0] : null;
      // Use custom tooltip labels if available (for weekly format)
      if (dataset && dataset.tooltipLabels && dataset.tooltipLabels[index]) {
        return dataset.tooltipLabels[index];
      }
      
      if (data && data.labels && data.labels[index] !== undefined) {
        return data.labels[index];
      }
      return '';
    };
    
    // Custom label callback for formatted hours
    config.options.tooltips.callbacks.label = function(tooltipItem, data) {
      if (!tooltipItem || !data || !data.datasets) return '';
      var dataset = data.datasets[tooltipItem.datasetIndex];
      if (!dataset) return '';
      
      var label = dataset.label || '';
      
      // Use formatted hours if available
      if (dataset.formattedHours && dataset.formattedHours[tooltipItem.index]) {
        return label + ': ' + dataset.formattedHours[tooltipItem.index];
      }
      
      // For bar/line charts (v2 API)
      var value = tooltipItem.yLabel !== undefined ? tooltipItem.yLabel : (dataset.data && dataset.data[tooltipItem.index]);
      if (value !== undefined && typeof value === 'number') {
        return label + ': ' + formatHours(value);
      }
      
      return label;
    };
    
    timeAnalyticsChart = new Chart(chartElement, config);
    
  } catch (error) {
    console.error('Chart initialization error:', error);
    chartElement.parentElement.innerHTML = '<p style="text-align: center; color: #red; padding: 20px;">Error loading chart</p>';
  }
}

function updateChart() {
  var chartTypeDropdown = document.getElementById('chart_type_select');
  
  if (!chartTypeDropdown) {
    return;
  }
  
  var chartType = chartTypeDropdown.value;
  
  // Update hidden field with new chart type
  var hiddenChartTypeField = document.getElementById('chart_type_hidden');
  if (hiddenChartTypeField) {
    hiddenChartTypeField.value = chartType;
  }
  
  // Get the current chart element and its data
  var chartElement = document.getElementById('time-chart');
  if (!chartElement) {
    return;
  }
  
  var currentChartData = chartElement.getAttribute('data-chart');
  if (!currentChartData) {
    return;
  }
  
  try {
    // Parse the current chart configuration
    var chartConfig = JSON.parse(currentChartData);
    var currentChartType = chartConfig.type;
    
    // If switching between line and bar, we need to reload from server
    // because they have different data structures (line = simple totals, bar = activity breakdown)
    if ((currentChartType === 'line' && chartType === 'bar') || 
        (currentChartType === 'bar' && chartType === 'line')) {
      // Reload the page with the new chart type parameter
      var url = new URL(window.location.href);
      url.searchParams.set('chart_type', chartType);
      window.location.href = url.toString();
      return;
    }
    
    // For same type transitions (shouldn't happen), just reinit
    if (currentChartType === chartType) {
      return;
    }
    
    // This code shouldn't be reached anymore, but keep as fallback
    // Transform the chart type while keeping the same data
    var newChartConfig = transformChartType(chartConfig, chartType);
    
    // Update the chart element with new configuration
    chartElement.setAttribute('data-chart', JSON.stringify(newChartConfig));
    
    // Reinitialize the chart
    initChart();
    
  } catch (error) {
    console.error('Chart update error:', error);
    // On error, reload from server
    var url = new URL(window.location.href);
    url.searchParams.set('chart_type', chartType);
    window.location.href = url.toString();
  }
}

function transformChartType(originalConfig, newType) {
  // Create a new config based on the original data but with different chart type
  var newConfig = JSON.parse(JSON.stringify(originalConfig)); // Deep copy
  
  // Change the chart type
  newConfig.type = newType;
  
  // Adjust configuration based on chart type
  if (newType === 'line') {
    // Restore original labels if they were modified
    if (newConfig.data && newConfig.data.labels && newConfig.data.labels.length > 0) {
      var currentLabels = newConfig.data.labels.slice();
      var restoredLabels = [];
      
      for (var i = 0; i < currentLabels.length; i++) {
        var label = currentLabels[i];
        // If label contains parentheses, extract original part
        if (label.indexOf(' (') !== -1) {
          restoredLabels.push(label.split(' (')[0]);
        } else {
          restoredLabels.push(label);
        }
      }
      
      newConfig.data.labels = restoredLabels;
    }
    
    // Ensure formattedHours exists for tooltips
    if (!newConfig.data.datasets[0].formattedHours) {
      var formattedHoursArray = [];
      for (var i = 0; i < newConfig.data.datasets[0].data.length; i++) {
        formattedHoursArray.push(formatHours(newConfig.data.datasets[0].data[i]));
      }
      newConfig.data.datasets[0].formattedHours = formattedHoursArray;
    }
    
    // Get localized grouping label from data attribute
    var grouping = getGroupingLabel();
    
    // Line chart specific configuration
    newConfig.options = {
      responsive: true,
      maintainAspectRatio: false,
      legend: {
        display: false
      },
      tooltips: {
        mode: 'index',
        intersect: false,
        callbacks: {
          label: function(tooltipItem, data) {
            var dataset = data.datasets[tooltipItem.datasetIndex];
            var formattedHours = dataset.formattedHours;
            var value = tooltipItem.yLabel !== undefined ? tooltipItem.yLabel : (dataset.data && dataset.data[tooltipItem.index]);
            return 'Hours: ' + (formattedHours ? formattedHours[tooltipItem.index] : formatHours(value));
          }
        }
      },
      scales: {
        yAxes: [{
          ticks: {
            beginAtZero: true
          },
          scaleLabel: {
            display: true,
            labelString: 'Hours'
          }
        }],
        xAxes: [{
          scaleLabel: {
            display: true,
            labelString: grouping
          },
          ticks: {
            maxRotation: 45,
            minRotation: 45
          }
        }]
      }
    };
    
    // Line chart styling
    if (newConfig.data && newConfig.data.datasets && newConfig.data.datasets[0]) {
      newConfig.data.datasets[0].borderColor = '#36a2eb';
      newConfig.data.datasets[0].backgroundColor = 'rgba(54, 162, 235, 0.1)';
      newConfig.data.datasets[0].fill = true;
      newConfig.data.datasets[0].tension = 0.2;
      newConfig.data.datasets[0].borderWidth = 2;
      newConfig.data.datasets[0].pointRadius = 3;
      newConfig.data.datasets[0].pointHoverRadius = 5;
    }
    
  } else {
    // Restore original labels if they were modified
    if (newConfig.data && newConfig.data.labels && newConfig.data.labels.length > 0) {
      var currentLabels = newConfig.data.labels.slice();
      var restoredLabels = [];
      
      for (var i = 0; i < currentLabels.length; i++) {
        var label = currentLabels[i];
        // If label contains parentheses, extract original part
        if (label.indexOf(' (') !== -1) {
          restoredLabels.push(label.split(' (')[0]);
        } else {
          restoredLabels.push(label);
        }
      }
      
      newConfig.data.labels = restoredLabels;
    }
    
    // Ensure formattedHours exists for tooltips
    if (!newConfig.data.datasets[0].formattedHours) {
      var formattedHoursArray = [];
      for (var i = 0; i < newConfig.data.datasets[0].data.length; i++) {
        formattedHoursArray.push(formatHours(newConfig.data.datasets[0].data[i]));
      }
      newConfig.data.datasets[0].formattedHours = formattedHoursArray;
    }
    
    // Get localized grouping label from data attribute
    var grouping = getGroupingLabel();
    
    // Bar chart (default) configuration
    newConfig.options = {
      responsive: true,
      maintainAspectRatio: false,
      legend: {
        display: false
      },
      tooltips: {
        mode: 'index',
        intersect: false,
        callbacks: {
          label: function(tooltipItem, data) {
            var dataset = data.datasets[tooltipItem.datasetIndex];
            var formattedHours = dataset.formattedHours;
            var value = tooltipItem.yLabel !== undefined ? tooltipItem.yLabel : (dataset.data && dataset.data[tooltipItem.index]);
            return 'Hours: ' + (formattedHours ? formattedHours[tooltipItem.index] : formatHours(value));
          }
        }
      },
      scales: {
        yAxes: [{
          ticks: {
            beginAtZero: true
          },
          scaleLabel: {
            display: true,
            labelString: 'Hours'
          }
        }],
        xAxes: [{
          scaleLabel: {
            display: true,
            labelString: grouping
          },
          ticks: {
            maxRotation: 45,
            minRotation: 45
          }
        }]
      }
    };
    
    // Bar chart styling - use gradient placeholder (will be replaced during chart init)
    if (newConfig.data && newConfig.data.datasets && newConfig.data.datasets[0]) {
      newConfig.data.datasets[0].backgroundColor = 'GRADIENT_PLACEHOLDER';
      newConfig.data.datasets[0].borderWidth = 1;
    }
  }
  
  return newConfig;
}

// Update pagination info text based on view state
function updatePaginationInfo(viewState) {
  var paginationInfo = document.getElementById('pagination-info-text');
  if (!paginationInfo) {
    return;
  }
  
  var detailedText = paginationInfo.getAttribute('data-detailed-text');
  var viewMode = paginationInfo.getAttribute('data-view-mode');
  
  if (viewState === 'detailed') {
    // Show detailed view pagination (based on time periods)
    paginationInfo.textContent = detailedText;
  } else {
    // Show summary view pagination (based on activities, projects, or issues)
    var count;
    if (viewMode === 'activity') {
      count = parseInt(paginationInfo.getAttribute('data-activity-count')) || 0;
    } else if (viewMode === 'project') {
      count = parseInt(paginationInfo.getAttribute('data-project-count')) || 0;
    } else if (viewMode === 'issue') {
      count = parseInt(paginationInfo.getAttribute('data-issue-count')) || 0;
    }
    
    // Format: Redmine native format "(1-X/X)"
    paginationInfo.textContent = '(1-' + count + '/' + count + ')';
  }
}

// Simplified view toggle functions - toggle display AND update button styling
function showDetailedView(viewType) {
  // Map viewType to actual div IDs (activity uses 'daily' prefix)
  var viewPrefix = viewType === 'activity' ? 'daily' : viewType;
  var detailedView = document.getElementById(viewPrefix + '-detailed-view');
  var summaryView = document.getElementById(viewPrefix + '-summary-view');
  
  if (!detailedView || !summaryView) return;
  
  // Show detailed view, hide summary view
  detailedView.style.display = 'block';
  summaryView.style.display = 'none';
  
  // Update button styling - Detail button blue, Summary button white
  var detailBtn = document.getElementById('show-detailed-btn-' + viewType);
  var summaryBtn = document.getElementById('show-summary-btn-' + viewType);
  
  if (detailBtn && summaryBtn) {
    // Make detail button blue (selected)
    detailBtn.style.backgroundColor = '#3b82f6';
    detailBtn.style.color = 'white';
    detailBtn.className = detailBtn.className.replace(/!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900/g, '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]');
    
    // Make summary button white (unselected)
    summaryBtn.style.backgroundColor = '';
    summaryBtn.style.color = '';
    summaryBtn.className = summaryBtn.className.replace(/!text-white !bg-\[#3b82f6\] hover:!bg-\[#2563eb\]/g, '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900');
  }
  
  // Update hidden field
  var hiddenField = document.getElementById(viewType + '_view_state_field');
  if (hiddenField) hiddenField.value = 'detailed';
  
  // Update pagination info
  updatePaginationInfo('detailed');
  
  // Save preference
  localStorage.setItem(viewType + '_view_mode', 'detailed');
}

function showSummaryView(viewType) {
  // Map viewType to actual div IDs (activity uses 'daily' prefix)
  var viewPrefix = viewType === 'activity' ? 'daily' : viewType;
  var detailedView = document.getElementById(viewPrefix + '-detailed-view');
  var summaryView = document.getElementById(viewPrefix + '-summary-view');
  
  if (!detailedView || !summaryView) return;
  
  // Show summary view, hide detailed view
  detailedView.style.display = 'none';
  summaryView.style.display = 'block';
  
  // Update button styling - Summary button blue, Detail button white
  var detailBtn = document.getElementById('show-detailed-btn-' + viewType);
  var summaryBtn = document.getElementById('show-summary-btn-' + viewType);
  
  if (detailBtn && summaryBtn) {
    // Make summary button blue (selected)
    summaryBtn.style.backgroundColor = '#3b82f6';
    summaryBtn.style.color = 'white';
    summaryBtn.className = summaryBtn.className.replace(/!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900/g, '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]');
    
    // Make detail button white (unselected)
    detailBtn.style.backgroundColor = '';
    detailBtn.style.color = '';
    detailBtn.className = detailBtn.className.replace(/!text-white !bg-\[#3b82f6\] hover:!bg-\[#2563eb\]/g, '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900');
  }
  
  // Update hidden field
  var hiddenField = document.getElementById(viewType + '_view_state_field');
  if (hiddenField) hiddenField.value = 'summary';
  
  // Update pagination info
  updatePaginationInfo('summary');
  
  // Save preference
  localStorage.setItem(viewType + '_view_mode', 'summary');
  
  // Auto-sort summary table by hours (descending)
  var tableId = viewType === 'activity' ? 'daily-summary-view' : viewType + '-summary-view';
  initSummarySorting(tableId);
}

// Regenerate chart based on activity view state (summary vs detailed)
function regenerateChartForViewState(viewState) {
  // Get current URL parameters
  var urlParams = new URLSearchParams(window.location.search);
  
  // Add/update activity_view_state parameter
  urlParams.set('activity_view_state', viewState);
  
  // Build new URL
  var baseUrl = window.location.pathname;
  var newUrl = baseUrl + '?' + urlParams.toString();
  
  // Reload page with new view state parameter
  // This ensures proper authentication and chart regeneration
  window.location.href = newUrl;
}

// Regenerate chart based on project view state (summary vs detailed)
function regenerateChartForProjectViewState(viewState) {
  // Get current URL parameters
