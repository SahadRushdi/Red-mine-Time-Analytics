// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  initCustomDateRangeVisibility();
  <% if @view_mode == 'issue' %>
    initSummaryTable('<%= summary_view_id %>', taIssueSummaryCardHtml);
  <% elsif @view_mode == 'activity' || @view_mode == 'project' %>
    initSummaryTable('<%= summary_view_id %>', taSummaryCardHtml);
  <% end %>
  restoreActivityViewState();
  restoreProjectViewState();
  restoreIssueViewState();
  
  // Prevent page scroll on pagination clicks
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('pagination-link') || e.target.closest('.pagination-link')) {
      // Store current scroll position
      sessionStorage.setItem('scrollPosition', window.pageYOffset);
    }
  });
  
  // Restore scroll position after page load
  if (sessionStorage.getItem('scrollPosition')) {
    window.scrollTo(0, parseInt(sessionStorage.getItem('scrollPosition')));
    sessionStorage.removeItem('scrollPosition');
  }
  
  // Auto-scroll to table when switching views
  if (sessionStorage.getItem('scrollToTable') === 'true') {
    sessionStorage.removeItem('scrollToTable');
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        var tableElement = document.getElementById('view-mode-table');
        if (tableElement) {
          tableElement.scrollIntoView({ behavior: 'auto', block: 'start' });
        }
      });
    });
  }
  
  // Initialize chart after a small delay to ensure DOM is fully rendered
  setTimeout(function() {
    initChart();
    initDonutChart();
    // Sync chart type dropdown after chart is initialized
    syncChartTypeDropdown();
    
    // Auto-sort summary tables by hours (highest to lowest) on page load
    // AND set the sort icon to indicate descending sort
    if (document.getElementById('daily-summary-view') && document.getElementById('daily-summary-view').style.display !== 'none') {
      initSummarySorting('daily-summary-view');
    }
    if (document.getElementById('project-summary-view') && document.getElementById('project-summary-view').style.display !== 'none') {
      initSummarySorting('project-summary-view');
    }
    if (document.getElementById('issue-summary-view') && document.getElementById('issue-summary-view').style.display !== 'none') {
      initSummarySorting('issue-summary-view');
    }
  }, 100);
});

// Also initialize if page is already loaded
if (document.readyState === 'complete') {
  setTimeout(function() {
    initChart();
  }, 100);
}

// Client-side Summary card list: renders/sorts/paginates entirely in memory from the
// embedded payload, so a page never truncates the data (donut/legend code that reads the
// same full dataset is unaffected by whichever page the user happens to be viewing).
var taSummaryTable = null;

function taSummaryCardHtml(item, index, grandTotal, colors) {
  var percentage = grandTotal > 0 ? (item.hours / grandTotal * 100) : 0;
  var color = colors[index % colors.length];
  var name = taEscapeHtml(item.name);
  return '<div class="bg-white hover:bg-gray-50 rounded-lg px-2 py-1 transition-colors duration-200" data-hours="' + item.hours + '" data-name="' + name + '">' +
    '<div class="flex items-center justify-between mb-1 gap-3">' +
      '<h3 class="text-base font-medium text-gray-900">' + name + '</h3>' +
      '<div class="flex items-center gap-3">' +
        '<span class="text-base font-semibold text-gray-900">' + taFormatHours(item.hours) + '</span>' +
        '<span class="min-w-[45px] text-right">' + taShareBadgeHtml(color, percentage) + '</span>' +
      '</div>' +
    '</div>' +
    '<div class="h-2 bg-gray-200 rounded-full overflow-hidden">' +
      '<div class="h-full rounded-full transition-all duration-300" style="width: ' + percentage + '%; background-color: ' + color + ';"></div>' +
    '</div>' +
  '</div>';
}

function taIssueSummaryCardHtml(item, index, grandTotal, colors) {
  var percentage = grandTotal > 0 ? (item.hours / grandTotal * 100) : 0;
  var color = colors[index % colors.length];
  var titleHtml;
  if (item.hasIssue) {
    titleHtml = '<span class="ts-tracker-badge">' + taEscapeHtml(item.trackerName) + '</span> ' +
      '<a href="' + item.url + '" target="_blank" class="text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline mr-1 transition-colors">#' + item.id + '</a>' +
      '<a href="' + item.url + '" target="_blank" class="text-sm !text-black hover:!text-blue-600 hover:!underline transition-colors">: ' + taEscapeHtml(item.subject) + '</a>';
  } else {
    titleHtml = taEscapeHtml(item.name);
  }
  return '<div class="bg-white hover:bg-gray-50 rounded-lg px-2 py-1 transition-colors duration-200" data-hours="' + item.hours + '" data-name="' + taEscapeHtml(item.name) + '">' +
    '<div class="flex items-center justify-between mb-1 gap-3">' +
      '<h3 class="text-base font-medium text-gray-900 flex-1 mr-4">' + titleHtml + '</h3>' +
      '<div class="flex items-center gap-3 flex-shrink-0">' +
        '<span class="text-base font-semibold text-gray-900">' + taFormatHours(item.hours) + '</span>' +
        '<span class="min-w-[45px] text-right">' + taShareBadgeHtml(color, percentage) + '</span>' +
      '</div>' +
    '</div>' +
    '<div class="h-2 bg-gray-200 rounded-full overflow-hidden">' +
      '<div class="h-full rounded-full transition-all duration-300" style="width: ' + percentage + '%; background-color: ' + color + ';"></div>' +
    '</div>' +
  '</div>';
}

function taUpdateSummarySortButtonsUI(viewId) {
  if (!taSummaryTable) { return; }
  var state = taSummaryTable.getState();
  var active = 'background:#eff6ff;color:#1d4ed8;border-color:#93c5fd;';
  var inactive = 'background:#fff;color:#6b7280;border-color:#d1d5db;';
  var nameBtn = document.getElementById('sort-name-' + viewId);
  var hoursBtn = document.getElementById('sort-hours-' + viewId);
  if (nameBtn) {
    nameBtn.style.cssText = state.sortField === 'name' ? active : inactive;
    nameBtn.textContent = state.sortField === 'name' && state.sortDir === 'desc' ? 'Z–A ↓' : 'A–Z ↑';
  }
  if (hoursBtn) {
    hoursBtn.style.cssText = state.sortField === 'hours' ? active : inactive;
    hoursBtn.textContent = state.sortField === 'hours' && state.sortDir === 'asc' ? 'Hours ↑' : 'Hours ↓';
  }
}

function taSummarySortClick(field) {
  if (!taSummaryTable) { return; }
  taSummaryTable.setSort(field, field === 'name' ? 'asc' : 'desc');
}

function initSummaryTable(viewId, renderFn) {
  var payloadEl = document.getElementById(viewId + '-payload');
  var container = document.getElementById(viewId + '-cards');
  if (!payloadEl || !container) { return; }

  var payload = JSON.parse(payloadEl.getAttribute('data-payload'));
  var colors = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'];

  taSummaryTable = TaClientTable({
    getItems: function () { return payload.items; },
    sortValue: function (item, field) { return field === 'name' ? (item.name || '').toLowerCase() : item.hours; },
    renderRow: function (item, index) { return renderFn(item, index, payload.grandTotal, colors); },
    container: container,
    paginationInfo: document.getElementById(viewId + '-pagination-info'),
    paginationLinks: document.getElementById(viewId + '-pagination-links'),
    perPage: <%= @limit %>,
    sortField: 'hours',
    sortDir: 'desc',
    onRender: function () { taUpdateSummarySortButtonsUI(viewId); }
  });
  taSummaryTable.render();
}

// Initialize summary table sorting to default descending (highest to lowest)
function initSummarySorting(tableContainerId) {
  var container = document.getElementById(tableContainerId);
  if (!container) return;
  
  var table = container.querySelector('table');
  if (!table) return;
  
  var hoursHeader = table.querySelector('th.hours-column.sortable');
  if (!hoursHeader) return;
  
  // Set to 'desc' (already sorted by backend) and update indicator
  hoursHeader.setAttribute('data-sort', 'desc');
  var indicator = hoursHeader.querySelector('.sort-indicator');
  if (indicator) {
    indicator.textContent = '▼';
  }
}

// Table sorting function for summary views
function sortTable(header, columnIndex, tableContainerId) {
  var container = document.getElementById(tableContainerId);
  var table = container.querySelector('table');
  var tbody = table.querySelector('tbody');
  var rows = Array.from(tbody.querySelectorAll('tr'));
  
  // Determine current sort direction
  var currentSort = header.getAttribute('data-sort') || 'none';
  var newSort = currentSort === 'asc' ? 'desc' : 'asc';
  
  // Remove sort indicators from all headers
  var allHeaders = table.querySelectorAll('th.sortable');
  allHeaders.forEach(function(th) {
    th.setAttribute('data-sort', 'none');
    var indicator = th.querySelector('.sort-indicator');
    if (indicator) indicator.textContent = '⇅';
  });
  
  // Sort rows
  rows.sort(function(a, b) {
    var aCell = a.cells[columnIndex];
    var bCell = b.cells[columnIndex];
    
    // Get numeric value from data-value attribute
    var aVal = parseFloat(aCell.getAttribute('data-value') || aCell.textContent);
    var bVal = parseFloat(bCell.getAttribute('data-value') || bCell.textContent);
    
    if (newSort === 'asc') {
      return aVal - bVal;
    } else {
      return bVal - aVal;
    }
  });
  
  // Reappend sorted rows
  rows.forEach(function(row) {
    tbody.appendChild(row);
  });
  
  // Update sort indicator
  header.setAttribute('data-sort', newSort);
  var indicator = header.querySelector('.sort-indicator');
  if (indicator) {
    indicator.textContent = newSort === 'asc' ? '▲' : '▼';
  }
}
</script>

