// Sync chart type dropdown with actual chart type from backend
function syncChartTypeDropdown() {
  var chartElement = document.getElementById('time-chart');
  var chartTypeDropdown = document.getElementById('chart_type_select');
  
  if (!chartElement || !chartTypeDropdown) {
    return;
  }
  
  try {
    var chartData = chartElement.getAttribute('data-chart');
    if (chartData && chartData !== 'null' && chartData !== '') {
      var config = JSON.parse(chartData);
      var actualChartType = config.type || 'bar';
      
      // Update dropdown to match actual chart type
      if (chartTypeDropdown.value !== actualChartType) {
        chartTypeDropdown.value = actualChartType;
      }
      
      // Also update the hidden field in the form
      var hiddenChartTypeField = document.getElementById('chart_type_hidden');
      if (hiddenChartTypeField && hiddenChartTypeField.value !== actualChartType) {
        hiddenChartTypeField.value = actualChartType;
      }
    }
  } catch (e) {
    // Silent fail - sync not critical
  }
}

// Donut Chart for Activity/Project/Issue Distribution
var donutChartInstance = null;

function initDonutChart() {
  var donutCanvas = document.getElementById('donut-chart');
  if (!donutCanvas) {
    return;
  }
  
  // Destroy existing chart if any
  if (donutChartInstance) {
    donutChartInstance.destroy();
    donutChartInstance = null;
  }
  
  // Get data based on view mode and view state
  var viewMode = '<%= @view_mode %>';
  var chartData = null;
  var chartLabels = [];
  var chartValues = [];
  var chartColors = [
    '#5b21b6', // Purple
    '#3b82f6', // Blue  
    '#06b6d4', // Cyan
    '#10b981', // Green
    '#f59e0b', // Amber
    '#ef4444', // Red
    '#ec4899', // Pink
    '#8b5cf6', // Violet
    '#14b8a6', // Teal
    '#f97316'  // Orange
  ];
  
  // Collect data
  <% if @view_mode == 'activity' && @activity_totals %>
    <% sorted_activities = @activity_totals.sort_by { |_, hours| -hours } %>
    <% sorted_activities.each do |activity, hours| %>
      chartLabels.push('<%= j activity %>');
      chartValues.push(<%= hours.to_f %>);
    <% end %>
  <% elsif @view_mode == 'project' && @project_totals %>
    <% sorted_projects = @project_totals.sort_by { |_, hours| -hours } %>
    <% sorted_projects.each do |project, hours| %>
      chartLabels.push('<%= j project %>');
      chartValues.push(<%= hours.to_f %>);
    <% end %>
  <% elsif @view_mode == 'issue' && @issue_totals %>
    <% sorted_issues = @issue_totals.sort_by { |_, hours| -hours } %>
    <% sorted_issues.each do |issue_key, hours| %>
      <% issue_info = @issues.find { |i| i[:key] == issue_key } %>
      <% label = issue_info ? issue_info[:display] : 'Unknown' %>
      chartLabels.push('<%= j label %>');
      chartValues.push(<%= hours.to_f %>);
    <% end %>
  <% end %>
  
  if (chartLabels.length === 0 || chartValues.length === 0) {
    donutCanvas.parentElement.innerHTML = '<p class="text-center text-gray-500 text-sm">No data available</p>';
    return;
  }
  
  // Calculate total for percentages and center display
  var total = chartValues.reduce(function(sum, val) { return sum + val; }, 0);
  
  // Update center text with total hours
  var centerText = document.getElementById('total-hours-display');
  if (centerText) {
    centerText.textContent = formatHours(total);
  }
  
  // Create donut chart
  var ctx = donutCanvas.getContext('2d');
  donutChartInstance = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: chartLabels,
      datasets: [{
        data: chartValues,
        backgroundColor: chartColors,
        borderColor: '#ffffff',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '70%', // This makes it a donut (larger = bigger hole)
      plugins: {
        legend: {
          display: false
        },
        tooltip: {
          backgroundColor: 'rgba(0, 0, 0, 0.8)',
          padding: 12,
          titleFont: { size: 14, weight: '600' },
          bodyFont: { size: 13 },
          cornerRadius: 8,
          callbacks: {
            label: function(context) {
              var label = context.label || '';
              var value = context.parsed;
              var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              var formattedHours = formatHours(value);
              return label + ': ' + formattedHours + ' (' + percentage + '%)';
            }
          }
        }
      }
    }
  });
  
  // Generate custom legend
  generateDonutLegend(chartLabels, chartValues, chartColors, total);
}

function generateDonutLegend(labels, values, colors, total) {
  var legendContainer = document.getElementById('donut-legend');
  if (!legendContainer) return;
  
  legendContainer.innerHTML = '';
  
  for (var i = 0; i < labels.length; i++) {
    var percentage = total > 0 ? ((values[i] / total) * 100).toFixed(1) : 0;
    var formattedHours = formatHours(values[i]);
    
    var legendItem = document.createElement('div');
    legendItem.className = 'flex items-center justify-between text-xs';
    
    legendItem.innerHTML = `
      <div class="flex items-center gap-1.5 flex-1 min-w-0">
        <div class="w-2.5 h-2.5 rounded-sm flex-shrink-0" style="background-color: ${colors[i]}"></div>
        <span class="text-gray-700 truncate">${labels[i]}</span>
      </div>
      <div class="flex items-center gap-1.5 ml-2 flex-shrink-0">
        <span class="font-semibold text-gray-900">${formattedHours}</span>
        <span class="text-gray-500">(${percentage}%)</span>
      </div>
    `;
    
    legendContainer.appendChild(legendItem);
  }
}

// Initialize when DOM is ready
document.addEventListener('DOMContentLoaded', function() {
  initCustomDateRangeVisibility();
  restoreActivityViewState();
  restoreProjectViewState();
  restoreIssueViewState();
  
  // Auto-scroll to table when switching views
  if (sessionStorage.getItem('scrollToTable') === 'true') {
    sessionStorage.removeItem('scrollToTable');
    var tableElement = document.getElementById('view-mode-table');
    if (tableElement) {
      tableElement.scrollIntoView({ behavior: 'auto', block: 'start' });
    }
  }
  
  // Initialize chart after a small delay to ensure DOM is fully rendered
  setTimeout(function() {
    initChart();
    initDonutChart();
    // Sync chart type dropdown after chart is initialized
    syncChartTypeDropdown();
    
    // Auto-sort summary tables by hours (highest to lowest) on page load
    if (document.getElementById('daily-summary-view') && document.getElementById('daily-summary-view').style.display !== 'none') {
      sortTableByDefault('daily-summary-view', 1);
    }
    if (document.getElementById('project-summary-view') && document.getElementById('project-summary-view').style.display !== 'none') {
      sortTableByDefault('project-summary-view', 1);
    }
    if (document.getElementById('issue-summary-view') && document.getElementById('issue-summary-view').style.display !== 'none') {
      sortTableByDefault('issue-summary-view', 1);
    }
  }, 100);
});

// Also initialize if page is already loaded
if (document.readyState === 'complete') {
  setTimeout(function() {
    initChart();
  }, 100);
}

// Initialize summary table sorting to default descending (highest to lowest)
function initSummarySorting(tableContainerId) {
  var container = document.getElementById(tableContainerId);
  if (!container) return;
  
  var table = container.querySelector('table');
  if (!table) return;
  
  var hoursHeader = table.querySelector('th.hours-column.sortable');
  if (!hoursHeader) return;
  
  // Set to 'desc' (already sorted by backend) and update indicator
  hoursHeader.setAttribute('data-sort', 'desc');
  var indicator = hoursHeader.querySelector('.sort-indicator');
  if (indicator) {
    indicator.textContent = '▼';
  }
}

// Table sorting function for summary views
function sortTable(header, columnIndex, tableContainerId) {
  var container = document.getElementById(tableContainerId);
  var table = container.querySelector('table');
  var tbody = table.querySelector('tbody');
  var rows = Array.from(tbody.querySelectorAll('tr'));
  
  // Determine current sort direction
  var currentSort = header.getAttribute('data-sort') || 'none';
  var newSort = currentSort === 'asc' ? 'desc' : 'asc';
  
  // Remove sort indicators from all headers
  var allHeaders = table.querySelectorAll('th.sortable');
  allHeaders.forEach(function(th) {
    th.setAttribute('data-sort', 'none');
    var indicator = th.querySelector('.sort-indicator');
    if (indicator) indicator.textContent = '⇅';
  });
  
  // Sort rows
  rows.sort(function(a, b) {
    var aCell = a.cells[columnIndex];
    var bCell = b.cells[columnIndex];
    
    // Get numeric value from data-value attribute
    var aVal = parseFloat(aCell.getAttribute('data-value') || aCell.textContent);
    var bVal = parseFloat(bCell.getAttribute('data-value') || bCell.textContent);
    
    if (newSort === 'asc') {
      return aVal - bVal;
    } else {
      return bVal - aVal;
    }
  });
  
  // Reappend sorted rows
  rows.forEach(function(row) {
    tbody.appendChild(row);
  });
  
  // Update sort indicator
  header.setAttribute('data-sort', newSort);
  var indicator = header.querySelector('.sort-indicator');
  if (indicator) {
    indicator.textContent = newSort === 'asc' ? '▲' : '▼';
  }
}
</script>

