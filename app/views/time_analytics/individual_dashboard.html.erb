                <th scope="col" class="px-6 py-3 text-right border-l-2 border-gray-300 font-bold"><%= l(:label_hours) %></th>
              </tr>
            </thead>
            <tbody>
              <% @paginated_periods.each_with_index do |period_display, index| %>
                <% period_key = @issue_pivot_data[:raw_periods][(@offset + index)] %>
                <tr class="bg-white border-b hover:bg-gray-50">
                  <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap"><%= period_display %></td>
                  <% @issues.each do |issue_info| %>
                    <td class="px-6 py-4 text-center text-gray-900">
                      <% hours = @matrix_data[period_key][issue_info[:key]] || 0 %>
                      <%= hours > 0 ? format_hours(hours) : '—' %>
