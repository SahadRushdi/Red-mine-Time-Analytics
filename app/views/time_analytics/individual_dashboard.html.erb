          </table>
        </div>
        
        <%# Summary View: Simple Activity Table (Hidden by default) %>
        <div id="daily-summary-view" style="display: none;">
          <table class="list time-entries-grouped-table summary-with-bars">
            <thead>
              <tr>
                <th>Activity</th>
                <th class="hours-column sortable" onclick="sortTable(this, 1, 'daily-summary-view')" title="Click to sort">
