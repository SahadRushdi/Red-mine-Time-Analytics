<%= render 'includes' %>
<% date_range_label = @from && @to ? "#{@from.strftime('%b %d')} – #{@to.strftime('%b %d, %Y')}" : l(:label_all_time) %>

<%# Modern Dashboard Header with Tailwind %>
<div class="flex items-center justify-between mb-6 flex-wrap gap-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">
      <%= individual_dashboard_title %>
    </h1>
    <p class="text-sm text-gray-500">
      <%= date_range_label %>
    </p>
  </div>
  
  <%# Modern Filter Controls - Horizontal Layout %>
  <%= form_tag my_time_path, method: :get, local: true, id: 'time-analytics-form', class: 'ta-filter-form flex items-center gap-3 flex-wrap' do %>
    <%= hidden_field_tag :user_id, @user.id if @user && @user != User.current %>
    <%= hidden_field_tag :chart_type, params[:chart_type] || default_chart_type(@view_mode), id: 'chart_type_hidden' %>
    <%= hidden_field_tag :view_mode, @view_mode %>
    <%= hidden_field_tag :activity_view_state, @activity_view_state, id: 'activity_view_state_field' %>
    <%= hidden_field_tag :project_view_state, @project_view_state, id: 'project_view_state_field' %>
    <%= hidden_field_tag :filter, @filter, id: 'filter_hidden' %>
    
        <%# Time Period Button Group %>
        <div class="ta-period-group inline-flex rounded-lg shadow-sm" role="group">
          <button type="button" onclick="setFilterAndSubmit('last_7_days')" 
              style="<%= @filter == 'last_7_days' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'last_7_days' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Last 7 Days
          </button>
          <button type="button" onclick="setFilterAndSubmit('last_14_days')" 
              style="<%= @filter == 'last_14_days' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border-t border-b border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'last_14_days' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Last 14 Days
          </button>
          <button type="button" onclick="setFilterAndSubmit('this_week')" 
              style="<%= @filter == 'this_week' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'this_week' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            This Week
          </button>
          <button type="button" onclick="setFilterAndSubmit('last_week')" 
              style="<%= @filter == 'last_week' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'last_week' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Last Week
          </button>
          <button type="button" onclick="setFilterAndSubmit('this_month')" 
              style="<%= @filter == 'this_month' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'this_month' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            This Month
          </button>
          <button type="button" onclick="toggleCustomDateRange()" 
              style="<%= @filter == 'custom' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @filter == 'custom' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
            Custom Range
          </button>
        </div>    
    <%# Custom Date Range (Hidden by default) - Flowbite date range picker %>
    <div id="custom-date-range" class="ta-custom-range <%= 'hidden' unless @filter == 'custom' %> flex flex-nowrap items-center gap-2">
      <div id="my-time-date-range-picker" date-rangepicker datepicker-format="mm/dd/yyyy" datepicker-show-on-focus="false" class="flex flex-nowrap items-center gap-2">
        <span class="ta-custom-range-label text-sm text-gray-600">From:</span>
        <%= text_field_tag :from, (@filter == 'custom' && @from ? @from.strftime('%m/%d/%Y') : ''), id: 'my-time-date-range-start', autocomplete: 'off', placeholder: 'Select date start', class: 'ta-date-input block w-40 min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm placeholder:text-gray-400 focus:outline-none focus:ring-0 focus:border-[#3b82f6]', 'datepicker-format' => 'mm/dd/yyyy', 'datepicker-show-on-focus' => 'false', 'datepicker-autohide' => 'true' %>
        <span class="ta-custom-range-label text-sm text-gray-600">To:</span>
        <%= text_field_tag :to, (@filter == 'custom' && @to ? @to.strftime('%m/%d/%Y') : ''), id: 'my-time-date-range-end', autocomplete: 'off', placeholder: 'Select date end', class: 'ta-date-input block w-40 min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm placeholder:text-gray-400 focus:outline-none focus:ring-0 focus:border-[#3b82f6]', 'datepicker-format' => 'mm/dd/yyyy', 'datepicker-show-on-focus' => 'false', 'datepicker-autohide' => 'true' %>
      </div>
    </div>
    
    <%# Group By Dropdown - Flowbite Style %>
    <div class="relative tep-grouping-wrapper">
      <button type="button" id="grouping-dropdown-button" onclick="toggleGroupingDropdown()" 
          class="inline-flex items-center justify-between w-32 px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
        <span id="grouping-selected-text"><%= @grouping.capitalize %></span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div id="grouping-dropdown" class="hidden absolute z-10 mt-1 w-32 bg-white border border-gray-300 rounded-lg shadow-xl py-1">
        <% @grouping_options.each do |option| %>
          <button type="button" onclick="setGroupingAndSubmit('<%= option %>')" 
              class="w-full text-left px-4 py-2 text-sm hover:!bg-gray-100 hover:!text-gray-900 <%= @grouping == option ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
            <%= option.capitalize %>
          </button>
        <% end %>
      </div>
      <%= hidden_field_tag :grouping, @grouping, id: 'grouping_hidden' %>
    </div>
    
    <%# Log Time Button %>
    <% if @user == User.current %>
      <%= link_to time_entry_panel_path(filter: @filter, from: @from, to: @to, grouping: @grouping),
          style: "background-color: #16a34a !important; color: white !important;",
          class: 'inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium !text-white !bg-green-600 rounded-lg hover:!bg-green-700 focus:ring-4 focus:ring-green-300 shadow-xs focus:outline-none transition-colors' do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Log Time
      <% end %>
    <% end %>
    
    <%# Export CSV Button %>
    <%= link_to time_analytics_export_csv_path(params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode, :user_id)), 
        method: :post, 
        style: "background-color: #3b82f6 !important; color: white !important;",
        class: 'inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium !text-white !bg-[#3b82f6] rounded-lg hover:!bg-[#2563eb] focus:ring-4 focus:ring-blue-300 shadow-xs focus:outline-none transition-colors' do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"/>
      </svg>
      Export CSV
    <% end %>
  <% end %>
</div>

<script type="text/javascript">
  // Filter period selection
  function setFilterAndSubmit(filterValue) {
    document.getElementById('filter_hidden').value = filterValue;
    document.getElementById('time-analytics-form').submit();
  }
  
  // Grouping dropdown selection
  function setGroupingAndSubmit(groupingValue) {
    document.getElementById('grouping_hidden').value = groupingValue;
    document.getElementById('time-analytics-form').submit();
  }
  
  // Toggle grouping dropdown
  function toggleGroupingDropdown() {
    var dropdown = document.getElementById('grouping-dropdown');
    dropdown.classList.toggle('hidden');
  }
  
  // Toggle custom date range
  function toggleCustomDateRange() {
    var customRange = document.getElementById('custom-date-range');
    var filterHidden = document.getElementById('filter_hidden');
    var startInput = document.getElementById('my-time-date-range-start');
    var endInput = document.getElementById('my-time-date-range-end');
    
    if (customRange.classList.contains('hidden')) {
      customRange.classList.remove('hidden');
      customRange.classList.add('flex');
      filterHidden.value = 'custom';
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('flex');
      [startInput, endInput].forEach(function(input) {
        if (input && input.datepicker && input.datepicker.hide) input.datepicker.hide();
      });
    }
  }

  function submitCustomDateRangeIfComplete() {
    var startInput = document.getElementById('my-time-date-range-start');
    var endInput = document.getElementById('my-time-date-range-end');
    var filterHidden = document.getElementById('filter_hidden');
    var form = document.getElementById('time-analytics-form');

    if (filterHidden) {
      filterHidden.value = 'custom';
    }

    if (!(startInput && endInput)) return;
    if (!startInput.value || !endInput.value) return;
    if (!form || form.dataset.submitting === '1') return;
    form.dataset.submitting = '1';
    form.submit();
  }

  function bindCustomDateRangeEvents() {
    var startInput = document.getElementById('my-time-date-range-start');
    var endInput = document.getElementById('my-time-date-range-end');
    var picker = document.getElementById('my-time-date-range-picker');
    var datepickerInstances = [startInput && startInput.datepicker, endInput && endInput.datepicker].filter(Boolean);

    function handleDateRangeChange() {
      submitCustomDateRangeIfComplete();
    }

    [startInput, endInput, picker].forEach(function(element) {
      if (element) {
        element.addEventListener('changeDate', handleDateRangeChange);
      }
    });

    datepickerInstances.forEach(function(datepicker) {
      if (datepicker && datepicker.setOptions) {
        datepicker.setOptions({ todayHighlight: true, showOnFocus: false, showOnClick: false, autohide: true });
      }
    });

    function hideMyTimeRangePickers() {
      [startInput, endInput].forEach(function(input) {
        if (input && input.datepicker && input.datepicker.hide) input.datepicker.hide();
      });
    }

    function bindManualToggle(input, otherInput) {
      if (!input || input.dataset.manualToggleBound === '1') return;
      input.addEventListener('click', function(event) {
        event.preventDefault();
        event.stopPropagation();
        if (!input.datepicker) return;
        if (otherInput && otherInput.datepicker && otherInput.datepicker.active) {
          otherInput.datepicker.hide();
        }
        if (input.datepicker.active) {
          input.datepicker.hide();
        } else {
          input.datepicker.show();
        }
      });
      input.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && input.datepicker && input.datepicker.hide) {
          input.datepicker.hide();
          input.blur();
        }
      });
      input.dataset.manualToggleBound = '1';
    }

    bindManualToggle(startInput, endInput);
    bindManualToggle(endInput, startInput);

    function suppressAutoOpen() {
      [startInput, endInput].forEach(function(input) {
        if (!input) return;
        if (document.activeElement === input) input.blur();
      });
      hideMyTimeRangePickers();
    }

    setTimeout(suppressAutoOpen, 0);
    setTimeout(suppressAutoOpen, 120);

    if (!window.__myTimeRangeOutsideCloseBound) {
      document.addEventListener('mousedown', function(event) {
        var target = event.target;
        var isInsideRangeUi = (picker && picker.contains(target)) ||
          (startInput && target === startInput) ||
          (endInput && target === endInput) ||
          !!target.closest('.datepicker');
        if (isInsideRangeUi) return;
        hideMyTimeRangePickers();
      });
      window.__myTimeRangeOutsideCloseBound = true;
    }
  }
  
  // Update visibility based on current filter value (for initialization)
  function initCustomDateRangeVisibility() {
    var customRange = document.getElementById('custom-date-range');
    var filterHidden = document.getElementById('filter_hidden');
    
    if (filterHidden && filterHidden.value === 'custom') {
      customRange.classList.remove('hidden');
      customRange.classList.add('flex');
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('flex');
    }
  }
  
  // Close dropdown when clicking outside
  document.addEventListener('click', function(event) {
    var dropdown = document.getElementById('grouping-dropdown');
    var button = document.getElementById('grouping-dropdown-button');
    
    if (dropdown && button && !button.contains(event.target) && !dropdown.contains(event.target)) {
      dropdown.classList.add('hidden');
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindCustomDateRangeEvents);
  } else {
    bindCustomDateRangeEvents();
  }
</script>

<div class="mb-4 animate-fade-in text-right">
  <div class="text-base text-gray-600">
    <span class="font-medium">Last entry:</span> 
    <% if @last_entry %>
      <% local_time = @last_entry.created_on.in_time_zone(User.current.time_zone || 'UTC') %>
      <% if local_time.to_date == Date.today %>
        Today, <%= local_time.strftime('%I:%M %p') %>
      <% elsif local_time.to_date == Date.yesterday %>
        Yesterday, <%= local_time.strftime('%I:%M %p') %>
      <% else %>
        <%= local_time.strftime('%b %d, %I:%M %p') %>
      <% end %>
    <% else %>
      N/A
    <% end %>
  </div>
</div>

<%# My Time Summary Cards (aligned with My Work Log style) %>
<div class="ts-summary-cards-row mb-6">
  <div class="ts-summary-card ts-summary-card--total flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Total Hours</p>
      <p class="ts-summary-card-value"><%= format_hours(@total_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--active-days flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M8 7V3m8 4V3M4 10h16M6 5h12a2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Active Days</p>
      <p class="ts-summary-card-value"><%= @active_days_count %> <span class="ts-summary-card-unit">days</span></p>
      <p class="text-xs text-gray-500 mt-1">
        <%= l(:label_working_days) %>: <%= @working_days_count %> • <%= l(:label_leave_days) %>: <%= @leave_days_count %>
      </p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--average flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 19h16M7 16v-4m5 4V8m5 8v-6"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">
        <%= @grouping == 'daily' ? 'Daily Average' : (@grouping == 'weekly' ? 'Weekly Average' : (@grouping == 'monthly' ? 'Monthly Average' : 'Yearly Average')) %>
      </p>
      <p class="ts-summary-card-value"><%= format_hours(@avg_hours_per_period) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--issues flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M9 5h6M8 3h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V5a2 2 0 012-2zm2 7h6m-6 4h4"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Issues Worked</p>
      <p class="ts-summary-card-value"><%= @issues_worked_count %> <span class="ts-summary-card-unit">issues</span></p>
    </div>
  </div>
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out;
  }
</style>

<!-- Dashboard Analytics Section - Visualization and Time Overview -->
<div class="analytics-section">
  <% if @time_overview_data&.any? %>
    <div class="box time-overview-box">
      <h3 class="text-base font-semibold text-gray-900 mb-3 text-center"><%= time_overview_header(@grouping) %></h3>
      
      <%# Flowbite Default Table - Date and Hours only %>
      <div class="relative">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-sm text-gray-700 bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3">
                <%= @grouping == 'daily' ? l(:label_date) : l("label_#{@grouping}") %>
              </th>
              <th scope="col" class="px-6 py-3 text-right">
                <%= l(:label_hours) %>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @time_overview_data.slice(@overview_offset, @overview_limit).each do |entry| %>
              <tr class="bg-white border-b hover:bg-gray-50">
                <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
                  <%= entry.period %>
                </th>
                <td class="px-6 py-4 text-right font-mono text-gray-900">
                  <%= format_hours(entry.hours) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="pagination-wrapper">
        <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode, :activity_view_state, :project_view_state, :user_id) %>
        <%= overview_pagination_links(@overview_page, @overview_total_pages, permitted_params).html_safe %>
        
        <div class="pagination-info">
          (<%= @overview_offset + 1 %>-<%= [@overview_offset + @overview_limit, @time_overview_data.count].min %>/<%= @time_overview_data.count %>)
        </div>
      </div>
    </div>
  <% end %>

  <!-- Visualization Section -->
  <div class="box visualization-section">
    <h3 class="text-base font-semibold text-gray-900 mb-3" style="display: flex; justify-content: space-between; align-items: center;">
      <span><%= chart_breakdown_header(@grouping) %></span>
      <div class="inline-flex gap-2">
        <%# Two buttons for chart type selection - consistent with other Flowbite buttons %>
        <button type="button" 
                onclick="switchChartType('line')"
                style="<%= (params[:chart_type] || default_chart_type(@view_mode)) == 'line' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= (params[:chart_type] || default_chart_type(@view_mode)) == 'line' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
          Trend
        </button>
        <button type="button" 
                onclick="switchChartType('bar')"
                style="<%= (params[:chart_type] || default_chart_type(@view_mode)) == 'bar' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= (params[:chart_type] || default_chart_type(@view_mode)) == 'bar' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
          Stacked
        </button>
        
        <%# Hidden select kept for backend compatibility %>
        <%= select_tag 'chart_type_select', options_for_select(chart_type_options, params[:chart_type] || default_chart_type(@view_mode)),
            onchange: 'updateChart()', id: 'chart_type_select', style: 'display: none;' %>
      </div>
    </h3>
    
    <div id="chart-container" style="display: block;">
      <div class="chart-wrapper">
        <canvas id="time-chart" class="chart" 
                data-chart='<%= @chart_data %>' 
                data-grouping-label="<%= grouping_label(@grouping) %>"></canvas>
      </div>
    </div>
  </div>
</div>

<script>
// Function to switch chart type
function switchChartType(chartType) {
  var hiddenSelect = document.getElementById('chart_type_select');
  if (hiddenSelect) {
    hiddenSelect.value = chartType;
    // Trigger the change event to reload with new chart type
    var url = new URL(window.location.href);
    url.searchParams.set('chart_type', chartType);
    window.location.href = url.toString();
  }
}
</script>

<!-- Flowbite Default Tabs -->
<div class="mb-0" style="margin-bottom: -1px;">
  <ul class="flex flex-wrap text-sm font-medium text-center text-gray-500 border-b border-gray-200">
    <li class="me-2">
      <button type="button" onclick="toggleViewMode(event, 'issue')" 
              class="ta-view-tab inline-block p-4 rounded-t-lg <%= @view_mode == 'issue' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50' %>">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 18">
            <path d="M6.143 0H1.857A1.857 1.857 0 0 0 0 1.857v4.286C0 7.169.831 8 1.857 8h4.286A1.857 1.857 0 0 0 8 6.143V1.857A1.857 1.857 0 0 0 6.143 0Zm10 0h-4.286A1.857 1.857 0 0 0 10 1.857v4.286C10 7.169 10.831 8 11.857 8h4.286A1.857 1.857 0 0 0 18 6.143V1.857A1.857 1.857 0 0 0 16.143 0Zm-10 10H1.857A1.857 1.857 0 0 0 0 11.857v4.286C0 17.169.831 18 1.857 18h4.286A1.857 1.857 0 0 0 8 16.143v-4.286A1.857 1.857 0 0 0 6.143 10Zm10 0h-4.286A1.857 1.857 0 0 0 10 11.857v4.286c0 1.026.831 1.857 1.857 1.857h4.286A1.857 1.857 0 0 0 18 16.143v-4.286A1.857 1.857 0 0 0 16.143 10Z"/>
          </svg>
          Issue
        </div>
      </button>
    </li>
    <li class="me-2">
      <button type="button" onclick="toggleViewMode(event, 'activity')" 
              class="ta-view-tab inline-block p-4 rounded-t-lg <%= @view_mode == 'activity' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50' %>">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 13a8.949 8.949 0 0 1-4.951-1.488A3.987 3.987 0 0 1 9 13h2a3.987 3.987 0 0 1 3.951 3.512A8.949 8.949 0 0 1 10 18Z"/>
          </svg>
          Activity
        </div>
      </button>
    </li>
    <li class="me-2">
      <button type="button" onclick="toggleViewMode(event, 'project')" 
              class="ta-view-tab inline-block p-4 rounded-t-lg <%= @view_mode == 'project' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50' %>">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 20">
            <path d="M16 1h-3.278A1.992 1.992 0 0 0 11 0H7a1.993 1.993 0 0 0-1.722 1H2a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm-3 14H5a1 1 0 0 1 0-2h8a1 1 0 0 1 0 2Zm0-4H5a1 1 0 0 1 0-2h8a1 1 0 1 1 0 2Zm0-5H5a1 1 0 0 1 0-2h2V2h4v2h2a1 1 0 1 1 0 2Z"/>
          </svg>
          Project
        </div>
      </button>
    </li>
  </ul>
</div>

<!-- Activity/Project/Issue Analysis Tables with Donut Chart - Only shown for activity, project, and issue views -->
<% if @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'issue' %>
  <div class="ta-analysis-layout flex gap-6 mb-6">
    <!-- Table Section (flexible width) -->
    <div class="ta-analysis-table flex-1 bg-white rounded-lg shadow-md border border-gray-200" id="view-mode-table">
      <!-- Header with Title and Controls - All in One Line -->
      <div class="px-6 py-4 border-b border-gray-200">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3">
          <!-- Left: Title and View Toggle Buttons -->
          <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
            <h3 class="text-lg font-semibold text-gray-900 whitespace-nowrap">
    <% summary_chart_colors = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'] %>
    <% if @view_mode == 'activity' %>
                Time by Activity
              <% elsif @view_mode == 'project' %>
                Time by Project
              <% elsif @view_mode == 'issue' %>
                Time by Issue
              <% end %>
            </h3>
            
            <!-- View Toggle Buttons -->
            <div class="inline-flex rounded-md shadow-sm" role="group">
              <% if @view_mode == 'activity' %>
                <button type="button" id="show-summary-btn-activity" 
                        onclick="showSummaryView('activity');" 
                        style="<%= @activity_view_state == 'summary' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @activity_view_state == 'summary' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">summarize</span>
                  Summary
                </button>
                <button type="button" id="show-detailed-btn-activity" 
                        onclick="showDetailedView('activity');" 
                        style="<%= (@activity_view_state != 'summary') ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= (@activity_view_state != 'summary') ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">data_table</span>
                  Detailed
                </button>
              <% elsif @view_mode == 'project' %>
                <button type="button" id="show-summary-btn-project" 
                        onclick="showSummaryView('project');" 
                        style="<%= @project_view_state == 'summary' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @project_view_state == 'summary' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">summarize</span>
                  Summary
                </button>
                <button type="button" id="show-detailed-btn-project" 
                        onclick="showDetailedView('project');" 
                        style="<%= (@project_view_state != 'summary') ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= (@project_view_state != 'summary') ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">data_table</span>
                  Detailed
                </button>
              <% elsif @view_mode == 'issue' %>
                <button type="button" id="show-summary-btn-issue" 
                        onclick="showSummaryView('issue');" 
                        style="<%= @issue_view_state == 'summary' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @issue_view_state == 'summary' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">summarize</span>
                  Summary
                </button>
                <button type="button" id="show-detailed-btn-issue" 
                        onclick="showDetailedView('issue');" 
                        style="<%= (@issue_view_state != 'summary') ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= (@issue_view_state != 'summary') ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">data_table</span>
                  Detailed
                </button>
              <% end %>
            </div>
          </div>
          
          <!-- Right: Hours and Per Page -->
          <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
            <span class="text-sm text-gray-600 whitespace-nowrap">Hours: <strong class="text-gray-900"><%= format_hours(@grand_total || 0) %></strong></span>
            <%= form_tag my_time_path, method: :get, local: true, 
                class: 'flex items-center gap-2' do %>
              <%= hidden_field_tag :user_id, params[:user_id] if params[:user_id].present? %>
              <%= hidden_field_tag :filter, params[:filter] %>
              <%= hidden_field_tag :from, params[:from] %>
              <%= hidden_field_tag :to, params[:to] %>
              <%= hidden_field_tag :grouping, params[:grouping] %>
              <%= hidden_field_tag :chart_type, params[:chart_type] %>
              <%= hidden_field_tag :view_mode, @view_mode %>
              <%= label_tag :per_page, 'Per page:', class: 'text-sm text-gray-600 whitespace-nowrap' %>
              <%= select_tag :per_page, options_for_select(per_page_options, @limit),
                  onchange: 'this.form.submit()',
                  class: 'ts-per-page-select px-3 py-1.5 text-sm text-center border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500' %>
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Table Content -->

    <% # Check for data based on view mode %>
    <% has_data = @paginated_periods&.any? %>
  
  <% if has_data %>
    <!-- Flowbite Table with Modern Design -->
    <div class="ta-analysis-table-scroll overflow-x-auto">
      <% if @view_mode == 'activity' %>
      <% if ['weekly', 'monthly'].include?(@grouping) %>
        <%# Activity pivot table for cross-tabulation (Activity × Time Period matrix) - Dual View System %>
        
        <%# Detailed View: Pivot Table (Time Period × Activity matrix) - Default %>
        <div id="daily-detailed-view" class="pivot-table-wrapper">
          <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-sm text-gray-700 bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 border-r-2 border-gray-300"><%= l("label_#{@grouping}") %></th>
                <% @activities.each do |activity| %>
                  <th scope="col" class="px-6 py-3 text-center border-r border-gray-200"><%= activity %></th>
                <% end %>
                <th scope="col" class="px-6 py-3 text-right border-l-2 border-gray-300 font-bold"><%= l(:label_hours) %></th>
              </tr>
            </thead>
            <tbody>
              <% @paginated_periods.each_with_index do |period_display, index| %>
                <% period_key = @activity_pivot_data[:raw_periods][(@offset + index)] %>
                <tr class="bg-white border-b hover:bg-gray-50">
                  <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap"><%= period_display %></td>
                  <% @activities.each do |activity| %>
                    <td class="px-6 py-4 text-center text-gray-900">
                      <% hours = @matrix_data[period_key][activity] || 0 %>
                      <%= hours > 0 ? format_hours(hours) : '—' %>
                    </td>
                  <% end %>
                  <td class="px-6 py-4 text-right font-semibold text-gray-900">
                    <%= format_hours(@period_totals[period_key] || 0) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        
        <%# Summary View: Simple Activity Table (Hidden by default) %>
        <div id="daily-summary-view" style="display: none;">
          <div class="space-y-6 px-2 pt-4">
            <% 
              # Sort activities by hours (highest to lowest)
              sorted_activities = @activities.sort_by { |activity| -(@activity_totals[activity] || 0) }
              sorted_activities.each_with_index do |activity, index| 
            %>
              <% hours = @activity_totals[activity] || 0 %>
              <% percentage = @grand_total > 0 ? (hours / @grand_total * 100) : 0 %>
              <% bar_color = summary_chart_colors[index % summary_chart_colors.length] %>
              <div class="bg-white hover:bg-gray-50 rounded-lg p-2 transition-colors duration-200">
                <!-- Activity name and hours -->
                <div class="flex items-center justify-between mb-2">
                  <h3 class="text-base font-medium text-gray-900"><%= activity %></h3>
                  <div class="flex items-center gap-3">
                    <span class="text-base font-semibold text-gray-900"><%= format_hours(hours) %></span>
                    <span class="text-sm font-medium text-gray-500 min-w-[45px] text-right"><%= number_with_precision(percentage, precision: 1) %>%</span>
                  </div>
                </div>
                <!-- Progress bar -->
                <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                  <div class="h-full rounded-full transition-all duration-300" style="width: <%= percentage %>%; background-color: <%= bar_color %>;"></div>
                </div>
                <!-- Subtitle -->
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @grouping == 'daily' %>
        <%# Daily Activity Analysis - Dual View System %>
        
        <%# Detailed View: Daily Pivot Table (Date × Activity matrix) - Default %>
        <div id="daily-detailed-view" class="pivot-table-wrapper">
          <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-sm text-gray-700 bg-gray-50">
              <tr>
