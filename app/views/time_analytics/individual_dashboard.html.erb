                 title="Show only working days (hides weekends, holidays & full-day leaves; half-days kept)">
            <input type="checkbox" class="sr-only peer" <%= 'checked' if @hide_holidays %> onchange="toggleHolidays()">
            <div class="ta-custom-toggle-track"></div>
            <span class="text-sm font-medium text-gray-700 whitespace-nowrap">Show Active Days</span>
          </label>
          <span class="text-gray-300 select-none px-1">|</span>
        <% end %>

        <%# Chart type buttons %>
        <button type="button"
                onclick="switchChartType('line')"
                style="<%= chart_type == 'line' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= chart_type == 'line' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
          Trend
        </button>
        <button type="button"
                onclick="switchChartType('bar')"
                style="<%= chart_type == 'bar' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= chart_type == 'bar' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
          Stacked
        </button>

        <%# Hidden select kept for backend compatibility %>
        <%= select_tag 'chart_type_select', options_for_select(chart_type_options, chart_type),
            onchange: 'updateChart()', id: 'chart_type_select', style: 'display: none;' %>
      </div>
    </h3>

    <div id="chart-container" class="<%= chart_type == 'bar' ? 'has-chart-legend' : '' %>" style="display: block;">
      <div class="chart-wrapper">
        <canvas id="time-chart" class="chart"
                data-chart='<%= @chart_data %>'
                data-grouping-label="<%= grouping_label(@grouping) %>"></canvas>
      </div>
      <div id="individual-chart-legend" class="ta-chart-legend mt-4"></div>
    </div>
  </div>
</div>

<script>
// Function to switch chart type
function switchChartType(chartType) {
  var hiddenSelect = document.getElementById('chart_type_select');
  if (hiddenSelect) {
    hiddenSelect.value = chartType;
    // Trigger the change event to reload with new chart type
    var url = new URL(window.location.href);
    url.searchParams.set('chart_type', chartType);
    window.location.href = url.toString();
  }
}

// Toggle hiding weekends/holidays/full-day-leaves from the Trend chart + Time Overview.
function toggleHolidays() {
  var url = new URL(window.location.href);
  if (url.searchParams.get('hide_holidays') === '1') {
    url.searchParams.delete('hide_holidays');
  } else {
    url.searchParams.set('hide_holidays', '1');
  }
  window.location.href = url.toString();
}
</script>

