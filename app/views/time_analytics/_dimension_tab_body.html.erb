<%#
  The analysis card for a user-added "group by" tab: Summary/Detailed table plus donut, matching
  the pinned tabs' layout. Rendered by BOTH dashboards as a sibling of the pinned card, so no
  pinned code path is involved.

  Detailed reuses team_analytics/_activity_period_pivot_table (the same partial the pinned
  Activity/Project tabs use). Summary reuses TaClientTable + taExpandableSummaryCardHtml via
  ta_dimension_tabs.js, so rows drill down into issues exactly like the Project tab's do.

  Locals:
    base_path       - dashboard path, for the per-page form
    breakdown_path  - JSON endpoint for a row's issue drill-down
    hidden_params   - hash of hidden form fields to carry the current filter state
    view_id         - DOM id prefix, unique per dashboard
%>
<% pivot = @ta_dimension_pivot %>
<% summary_active = @ta_dimension_view_state == 'summary' %>

<div class="ta-analysis-layout flex gap-6 mb-6">
  <div class="ta-analysis-table flex-1 bg-white rounded-lg shadow-md border border-gray-200" id="view-mode-table">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
          <h3 class="text-lg font-semibold text-gray-900 whitespace-nowrap">
            <%= l(:label_time_by_field, field: @ta_dimension.label) %>
          </h3>

          <div class="inline-flex rounded-md shadow-sm" role="group">
            <button type="button" id="show-summary-btn-<%= view_id %>"
                    onclick="taDimensionShowView('summary');"
                    style="<%= summary_active ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= summary_active ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
              <span class="material-symbols-outlined mr-2" aria-hidden="true" style="font-size: 18px;">summarize</span>
              Summary
            </button>
            <button type="button" id="show-detailed-btn-<%= view_id %>"
                    onclick="taDimensionShowView('detailed');"
                    style="<%= summary_active ? '' : 'background-color: #3b82f6 !important; color: white !important;' %>"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= summary_active ? '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' : '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' %>">
              <span class="material-symbols-outlined mr-2" aria-hidden="true" style="font-size: 18px;">data_table</span>
              Detailed
            </button>
          </div>

          <div id="<%= view_id %>-collapse-all-wrapper" style="display: none;">
            <button type="button" id="<%= view_id %>-collapse-all-btn"
                    onclick="taDimensionCollapseAll();"
                    title="<%= l(:button_collapse_all) %>" aria-label="<%= l(:button_collapse_all) %>"
                    class="inline-flex items-center justify-center p-2 text-sm font-medium !text-gray-700 !bg-white !border !border-gray-300 rounded-lg hover:!bg-gray-50 !outline-none !shadow-none !ring-0 focus:!outline-none focus:!ring-0">
              <span class="material-symbols-outlined" aria-hidden='true' style="font-size: 18px;">keyboard_double_arrow_up</span>
            </button>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
          <div id="ta-dimension-sort-buttons" class="flex items-center gap-2" style="<%= summary_active ? '' : 'display: none;' %>">
            <button type="button" id="sort-name-<%= view_id %>" onclick="taDimensionSortClick('name')"
                    style="background:#fff;color:#6b7280;border-color:#d1d5db;"
                    class="text-xs px-2.5 py-1 font-medium rounded-lg border transition-colors">A–Z ↑</button>
            <button type="button" id="sort-hours-<%= view_id %>" onclick="taDimensionSortClick('hours')"
                    style="background:#eff6ff;color:#1d4ed8;border-color:#93c5fd;"
                    class="text-xs px-2.5 py-1 font-medium rounded-lg border transition-colors">Hours ↓</button>
          </div>

          <%= form_tag base_path, method: :get, local: true, class: 'flex items-center gap-2' do %>
            <% hidden_params.each do |name, value| %>
              <%= hidden_field_tag name, value %>
            <% end %>
            <%= hidden_field_tag :view_mode, @ta_dimension.key %>
            <%= hidden_field_tag :dim_view_state, @ta_dimension_view_state %>
            <%= render 'team_analytics/per_page_dropdown' %>
          <% end %>
        </div>
      </div>
    </div>

    <% if pivot[:categories].any? %>
      <div id="<%= view_id %>-detailed-view" class="pivot-table-wrapper" style="<%= summary_active ? 'display: none;' : '' %>">
        <%= render 'team_analytics/activity_period_pivot_table',
                   pivot_activities: pivot[:categories],
                   matrix: pivot[:matrix],
                   period_totals: pivot[:period_totals],
                   paginated_periods: @paginated_periods,
                   raw_periods: pivot[:raw_periods],
                   offset: @offset,
                   colors: [],
                   show_bars: false %>
      </div>

      <%# Cards render client-side from this payload, so the donut and the sort/paging controls
          always read the full dataset rather than whichever page is on screen. %>
      <%# The data-* attributes here are forwarded as query params by ta_client_table.js's
          rowRequestParams, so group_by and the current filter state reach group_breakdown
          without being repeated on every row. %>
      <div id="<%= view_id %>-summary-view" style="<%= summary_active ? '' : 'display: none;' %>"
           data-group-by="<%= @ta_dimension.key %>"
           <% row_context.each do |name, value| %>data-<%= name.to_s.dasherize %>="<%= value %>" <% end %>>
        <div id="<%= view_id %>-payload" data-payload='<%= ta_dimension_summary_payload.to_json %>' style="display:none;"></div>
        <div id="<%= view_id %>-cards" class="space-y-2 px-2 pt-4 ta-summary-cards-scroll"></div>
        <div class="pagination-wrapper">
          <span id="<%= view_id %>-pagination-links"></span>
          <div class="pagination-info" id="<%= view_id %>-pagination-info"></div>
        </div>
      </div>

      <div id="<%= view_id %>-detailed-pagination-bar"
           class="px-6 py-4 border-t border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
           style="<%= summary_active ? 'display: none;' : '' %>">
        <div class="text-sm text-gray-700">
          (<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)
        </div>
        <nav class="flex gap-1 max-w-full overflow-x-auto">
          <% current_page = params[:page].to_i > 0 ? params[:page].to_i : 1 %>
          <%= pagination_links(current_page, @total_pages, hidden_params.merge(view_mode: @ta_dimension.key, dim_view_state: @ta_dimension_view_state)).html_safe %>
        </nav>
      </div>
    <% else %>
      <div class="px-6 py-8 text-center">
        <p class="text-sm text-gray-500"><%= l(:label_no_data) %></p>
      </div>
    <% end %>
  </div>

  <div class="ta-analysis-donut w-80 flex-shrink-0 bg-white rounded-lg shadow-md p-4 border border-gray-200">
    <div class="relative h-80 flex items-center justify-center">
      <canvas id="<%= donut_canvas_id %>" class="chart"></canvas>
      <div id="<%= donut_center_id %>" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
        <span class="text-3xl font-bold text-gray-900" id="<%= donut_total_id %>">0h</span>
        <span class="text-xs text-gray-500">Total Hours</span>
      </div>
    </div>
    <div id="<%= donut_legend_id %>" class="mt-4 space-y-1.5 text-sm ta-summary-cards-scroll"></div>
  </div>
</div>

<script>
  window.taDimensionTabBody = {
    viewId: '<%= view_id %>',
    breakdownPath: '<%= breakdown_path %>',
    groupBy: '<%= @ta_dimension.key %>',
    perPage: <%= @limit.to_i %>,
    viewState: '<%= @ta_dimension_view_state %>',
    labels: {
      loading: '<%= j l(:label_ta_row_breakdown_loading) %>',
      error: '<%= j l(:label_ta_row_breakdown_error) %>',
      emptyIssues: '<%= j l(:label_ta_row_breakdown_empty_issues) %>'
    }
  };
</script>
