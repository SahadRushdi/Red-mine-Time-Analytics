<script>
  function switchTeamSettingsTab(tabName) {
    ['exclusions', 'super-users'].forEach(function(tab) {
      var panel = document.getElementById('panel-' + tab);
      var tabButton = document.getElementById('tab-' + tab);
      if (!panel || !tabButton) return;
      if (tab === tabName) {
        panel.classList.remove('hidden');
        tabButton.classList.add('ta-view-tab-active');
      } else {
        panel.classList.add('hidden');
        tabButton.classList.remove('ta-view-tab-active');
      }
    });
    filterTeamSettingsRows();
  }

  function filterTeamSettingsRows() {
    var activePanel = document.querySelector('#panel-exclusions:not(.hidden), #panel-super-users:not(.hidden)');
    if (!activePanel) return;
    var tabType = activePanel.id === 'panel-exclusions' ? 'exclusions' : 'super-users';
    applyTeamSettingsPagination(tabType, false);
  }

  var teamSettingsPagination = {
    'exclusions': { currentPage: 1, perPage: 10 },
    'super-users': { currentPage: 1, perPage: 10 }
  };

  function getTeamSettingsRows(tabType) {
    var panel = document.getElementById('panel-' + tabType);
    if (!panel) return [];
    return Array.from(panel.querySelectorAll('table.ts-table tbody tr.ta-team-settings-row'));
  }

  function createTeamSettingsPageButton(config) {
    var li = document.createElement('li');
    var button = document.createElement('button');
    button.type = 'button';
    button.textContent = config.label;
    button.className = config.className;
    button.setAttribute('aria-label', config.ariaLabel || config.label);
    if (config.current) button.setAttribute('aria-current', 'page');
    if (config.disabled) {
      button.disabled = true;
    } else {
      button.addEventListener('click', config.onClick);
    }
    li.appendChild(button);
    return li;
  }

  function renderTeamSettingsPaginationControls(tabType, totalMatched, totalPages, startIndex, endIndex) {
    var nav = document.getElementById('ta-team-settings-pagination-' + tabType);
    var info = document.getElementById('ta-team-settings-pagination-info-' + tabType);
    var links = document.getElementById('ta-team-settings-pagination-links-' + tabType);
    if (!nav || !info || !links) return;

    if (totalMatched === 0) {
      nav.classList.add('hidden');
      info.textContent = '';
      links.innerHTML = '';
      return;
    }

    var state = teamSettingsPagination[tabType];
    nav.classList.remove('hidden');
    info.textContent = 'Showing ' + startIndex + '-' + endIndex + ' of ' + totalMatched + ' users';
    links.innerHTML = '';

    var prevClass = 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 rounded-s-lg ' +
      (state.currentPage === 1
        ? 'text-gray-300 bg-gray-50 cursor-not-allowed'
        : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700');
    links.appendChild(createTeamSettingsPageButton({
      label: 'Previous',
      ariaLabel: 'Previous page',
      className: prevClass,
      disabled: state.currentPage === 1,
      onClick: function() {
        state.currentPage -= 1;
        applyTeamSettingsPagination(tabType, true);
      }
    }));

    for (var page = 1; page <= totalPages; page++) {
      (function(pageNumber) {
        var isCurrent = pageNumber === state.currentPage;
        var pageClass = 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 ' +
          (isCurrent
            ? 'text-blue-600 bg-blue-50 hover:bg-blue-100 hover:text-blue-700'
            : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700');
        links.appendChild(createTeamSettingsPageButton({
          label: String(pageNumber),
          ariaLabel: 'Page ' + pageNumber,
          className: pageClass,
          current: isCurrent,
          onClick: function() {
            state.currentPage = pageNumber;
            applyTeamSettingsPagination(tabType, true);
          }
        }));
      })(page);
    }

    var nextClass = 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 rounded-e-lg ' +
      (state.currentPage === totalPages
        ? 'text-gray-300 bg-gray-50 cursor-not-allowed'
        : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700');
    links.appendChild(createTeamSettingsPageButton({
      label: 'Next',
      ariaLabel: 'Next page',
      className: nextClass,
      disabled: state.currentPage === totalPages,
      onClick: function() {
        state.currentPage += 1;
        applyTeamSettingsPagination(tabType, true);
      }
    }));
  }

  function teamSettingsSortIconId(tabType, column) {
    return 'ta-team-settings-sort-icon-' + tabType + '-' + column;
  }

  function setTeamSettingsSortIconState(icon, order) {
    if (!icon) return;
    icon.dataset.order = order;
    icon.className = order === 'asc' ? 'sort asc icon icon-sorted-desc' : 'sort desc icon icon-sorted-asc';
  }

  var teamSettingsSortColumns = {
    'exclusions': ['user', 'start-date', 'end-date'],
    'super-users': ['user']
  };
  var teamSettingsSortNumericColumns = ['start-date', 'end-date'];

  function toggleTeamSettingsSort(tabType, column) {
    var panel = document.getElementById('panel-' + tabType);
    var tbody = panel ? panel.querySelector('table.ts-table tbody') : null;
    if (!tbody) return;

    var rows = getTeamSettingsRows(tabType);
    var icon = document.getElementById(teamSettingsSortIconId(tabType, column));
    var currentOrder = icon && icon.dataset.order ? icon.dataset.order : 'desc';
    var nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';

    rows.sort(function(a, b) {
      var attr = 'data-' + column + '-sort';
      var aValue = a.getAttribute(attr) || '';
      var bValue = b.getAttribute(attr) || '';
      if (teamSettingsSortNumericColumns.indexOf(column) !== -1) {
        aValue = parseInt(aValue || '0', 10);
        bValue = parseInt(bValue || '0', 10);
        return nextOrder === 'asc' ? aValue - bValue : bValue - aValue;
      }
      var cmp = aValue.toLowerCase().localeCompare(bValue.toLowerCase());
      return nextOrder === 'asc' ? cmp : -cmp;
    });

    rows.forEach(function(row) { tbody.appendChild(row); });

    var columns = teamSettingsSortColumns[tabType] || [];
    columns.forEach(function(col) {
      if (col === column) return;
      setTeamSettingsSortIconState(document.getElementById(teamSettingsSortIconId(tabType, col)), 'desc');
    });
    setTeamSettingsSortIconState(icon, nextOrder);

    applyTeamSettingsPagination(tabType, true);
  }

  function applyTeamSettingsPagination(tabType, preservePage) {
    var searchInput = document.getElementById('ta-team-settings-search-input');
    var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
    var rows = getTeamSettingsRows(tabType);
    var state = teamSettingsPagination[tabType];
    if (!state) return;

    var matchedRows = rows.filter(function(row) {
      var text = (row.getAttribute('data-search-text') || '').toLowerCase();
      return !query || text.indexOf(query) >= 0;
    });

    var totalPages = Math.max(1, Math.ceil(matchedRows.length / state.perPage));
    if (!preservePage) {
      state.currentPage = 1;
    } else if (state.currentPage > totalPages) {
      state.currentPage = totalPages;
    }

    var start = (state.currentPage - 1) * state.perPage;
    var end = start + state.perPage;
    var currentRows = matchedRows.slice(start, end);
    var visibleSet = new Set(currentRows);

    rows.forEach(function(row) {
      row.style.display = visibleSet.has(row) ? '' : 'none';
    });

    var startIndex = matchedRows.length ? (start + 1) : 0;
    var endIndex = matchedRows.length ? Math.min(end, matchedRows.length) : 0;
    renderTeamSettingsPaginationControls(tabType, matchedRows.length, totalPages, startIndex, endIndex);
  }

  var teamSettingsMultiSelectTypes = ['exclusion', 'super-user'];

  function teamSettingsMultiSelectElements(type) {
    return {
      wrapper: document.getElementById('ta-team-settings-multiselect-wrapper-' + type),
      button: document.getElementById('ta-team-settings-multiselect-button-' + type),
      buttonLabel: document.getElementById('ta-team-settings-multiselect-button-label-' + type),
      menu: document.getElementById('ta-team-settings-multiselect-menu-' + type),
      search: document.getElementById('ta-team-settings-multiselect-search-' + type),
      chips: document.getElementById('ta-team-settings-selected-chips-' + type),
      hiddenInputs: document.getElementById('ta-team-settings-selected-inputs-' + type),
      submitButton: document.getElementById('ta-team-settings-submit-' + type),
      submitLabel: document.getElementById('ta-team-settings-submit-label-' + type)
    };
  }

  function closeTeamSettingsMultiSelectMenu(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.menu || !els.button) return;
    els.menu.classList.add('hidden');
    els.button.setAttribute('aria-expanded', 'false');
  }

  function openTeamSettingsMultiSelectMenu(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.menu || !els.button) return;
    els.menu.classList.remove('hidden');
    els.button.setAttribute('aria-expanded', 'true');
    if (els.search) {
      setTimeout(function() {
        els.search.focus();
      }, 0);
    }
  }

  function toggleTeamSettingsMultiSelectMenu(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.menu || els.menu.classList.contains('hidden')) {
      teamSettingsMultiSelectTypes.forEach(function(otherType) {
        if (otherType !== type) closeTeamSettingsMultiSelectMenu(otherType);
      });
      openTeamSettingsMultiSelectMenu(type);
    } else {
      closeTeamSettingsMultiSelectMenu(type);
    }
  }

  function teamSettingsMultiSelectLabel(type, count) {
    var wrapper = document.getElementById('ta-team-settings-multiselect-wrapper-' + type);
    if (!wrapper) return '';
    if (count <= 0) return wrapper.getAttribute('data-default-label') || '';
    if (count === 1) return (wrapper.getAttribute('data-count-one-label') || '').replace('{count}', String(count));
    return (wrapper.getAttribute('data-count-many-label') || '').replace('{count}', String(count));
  }

  function teamSettingsSyncMultiSelect(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.wrapper || !els.menu || !els.hiddenInputs || !els.chips) return;

    var selected = [];
    els.menu.querySelectorAll('input[type="checkbox"][data-user-id]').forEach(function(checkbox) {
      var userId = checkbox.getAttribute('data-user-id');
      if (!userId || !checkbox.checked) return;
      selected.push({
        id: userId,
        name: checkbox.getAttribute('data-user-name') || '',
        email: checkbox.getAttribute('data-user-email') || ''
      });
    });

    els.hiddenInputs.innerHTML = '';
    selected.forEach(function(user) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'user_ids[]';
      input.value = user.id;
      els.hiddenInputs.appendChild(input);
    });

    els.chips.innerHTML = '';
    selected.forEach(function(user) {
      var chip = document.createElement('span');
      chip.className = 'inline-flex items-center gap-1 rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700';
      var chipLabel = document.createElement('span');
      chipLabel.className = 'truncate';
      chipLabel.textContent = user.name;
      chip.appendChild(chipLabel);

      var remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'inline-flex h-4 w-4 items-center justify-center rounded-full text-blue-500 hover:bg-blue-100 hover:text-blue-700';
      remove.setAttribute('aria-label', 'Remove ' + user.name);
      remove.innerHTML = '&times;';
      remove.addEventListener('click', function() {
        var checkbox = els.menu.querySelector('input[type="checkbox"][data-user-id="' + user.id + '"]');
        if (checkbox) {
          checkbox.checked = false;
          teamSettingsSyncMultiSelect(type);
        }
      });

      chip.appendChild(remove);
      els.chips.appendChild(chip);
    });

    if (els.buttonLabel) {
      els.buttonLabel.textContent = selected.length ? (selected.length + ' selected') : 'Select members';
    }
    if (els.submitLabel) {
      els.submitLabel.textContent = teamSettingsMultiSelectLabel(type, selected.length);
    }
    if (els.submitButton) {
      els.submitButton.disabled = selected.length === 0;
    }
  }

  function toggleTeamSettingsMultiSelectOption(type, checkbox) {
    if (!checkbox) return;
    teamSettingsSyncMultiSelect(type);
  }

  function filterTeamSettingsMultiSelect(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.menu || !els.search) return;
    var query = els.search.value.toLowerCase().trim();
    els.menu.querySelectorAll('[data-team-settings-multiselect-option="' + type + '"]').forEach(function(option) {
      var text = (option.getAttribute('data-search') || '').toLowerCase();
      option.style.display = !query || text.indexOf(query) !== -1 ? '' : 'none';
    });
  }

  function clearTeamSettingsMultiSelect(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.menu) return;
    els.menu.querySelectorAll('input[type="checkbox"][data-user-id]').forEach(function(checkbox) {
      checkbox.checked = false;
    });
    if (els.search) els.search.value = '';
    filterTeamSettingsMultiSelect(type);
    teamSettingsSyncMultiSelect(type);
  }

  function submitTeamSettingsMultiSelect(type) {
    var els = teamSettingsMultiSelectElements(type);
    if (!els.menu) return false;
    var selected = els.menu.querySelectorAll('input[type="checkbox"][data-user-id]:checked').length;
    return selected > 0;
  }

  document.addEventListener('click', function(event) {
    teamSettingsMultiSelectTypes.forEach(function(type) {
      var els = teamSettingsMultiSelectElements(type);
      if (els.wrapper && !els.wrapper.contains(event.target)) {
        closeTeamSettingsMultiSelectMenu(type);
      }
    });
  });

  document.addEventListener('DOMContentLoaded', function() {
    teamSettingsMultiSelectTypes.forEach(function(type) {
      teamSettingsSyncMultiSelect(type);
      filterTeamSettingsMultiSelect(type);
    });
    Object.keys(teamSettingsSortColumns).forEach(function(tabType) {
      teamSettingsSortColumns[tabType].forEach(function(column) {
        setTeamSettingsSortIconState(document.getElementById(teamSettingsSortIconId(tabType, column)), 'desc');
      });
    });
    switchTeamSettingsTab('<%= @active_tab %>');
    applyTeamSettingsPagination('exclusions', false);
    applyTeamSettingsPagination('super-users', false);
  });

  var teamSettingsPendingDelete = null;

  function teamSettingsOpenDeleteModal() {
    var modal = document.getElementById('taTeamSettingsDeleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function teamSettingsCloseDeleteModal() {
    var modal = document.getElementById('taTeamSettingsDeleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  function teamSettingsDelete(settingId, url, token, tabName) {
    teamSettingsPendingDelete = { settingId: settingId, url: url, token: token, tabName: tabName };
    var trigger = document.getElementById('teamSettingsDeleteButton');
    if (trigger) {
      trigger.click();
      setTimeout(function() {
        var modal = document.getElementById('taTeamSettingsDeleteModal');
        if (modal && modal.classList.contains('hidden')) teamSettingsOpenDeleteModal();
      }, 0);
    } else {
      teamSettingsOpenDeleteModal();
    }
  }

  function teamSettingsConfirmDelete() {
    if (!teamSettingsPendingDelete) return;
    var url = teamSettingsPendingDelete.url;
    var token = teamSettingsPendingDelete.token;
    teamSettingsCloseDeleteModal();

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = url;
    [['_method', 'DELETE'], ['authenticity_token', token]].forEach(function(pair) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = pair[0];
      input.value = pair[1];
      form.appendChild(input);
    });
    if (teamSettingsPendingDelete.tabName) {
      var tabInput = document.createElement('input');
      tabInput.type = 'hidden';
      tabInput.name = 'tab';
      tabInput.value = teamSettingsPendingDelete.tabName;
      form.appendChild(tabInput);
    }
    document.body.appendChild(form);
    form.submit();
  }

  function teamSettingsCloseDeleteModalIfBackdrop(event) {
    var modal = document.getElementById('taTeamSettingsDeleteModal');
    if (modal && !modal.classList.contains('hidden') && event.target === modal) {
      teamSettingsCloseDeleteModal();
    }
  }

  if (!window.__teamSettingsDeleteModalListenersBound) {
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        teamSettingsCloseDeleteModal();
      }
    });
    document.addEventListener('click', teamSettingsCloseDeleteModalIfBackdrop);
    window.__teamSettingsDeleteModalListenersBound = true;
  }
</script>
