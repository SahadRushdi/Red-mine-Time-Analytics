<% html_title "Team Analytics Settings" %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Team Analytics Settings</h2>
      <p class="text-sm text-gray-500">Configure users excluded from analytics and global super-user access.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'Back to Teams', admin_ta_teams_path, class: 'ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-base font-semibold text-gray-900">Dashboard Visibility</h3>
      <p class="mt-1 text-sm text-gray-500">Enable or disable specific dashboards globally.</p>
    </div>
    <div class="px-6 py-4">
      <%= form_tag admin_ta_team_settings_path, method: :post, id: 'my-team-visibility-form' do %>
        <%= hidden_field_tag :setting_type, 'my_team_visibility' %>
        <%= hidden_field_tag :tab, @active_tab %>
        <div class="flex items-center justify-between">
          <div>
            <span class="text-sm font-medium text-gray-900">My Team Page</span>
            <p class="text-xs text-gray-500">Toggle visibility of the "My Team" menu item for Team Leads and Super Users.</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <%= hidden_field_tag :my_team_enabled, '0' %>
            <%= check_box_tag :my_team_enabled, '1', @my_team_enabled,
                              class: 'sr-only peer',
                              onchange: 'this.form.submit()' %>
            <div class="ta-custom-toggle-track"></div>
          </label>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-base font-semibold text-gray-900">Support Redmine Integration</h3>
      <p class="mt-1 text-sm text-gray-500">
        Configure global external Redmine credentials for Effective Time calculation.
        <% if @support_redmine_configured %>
          <span class="text-emerald-600 font-medium">Configured</span>
        <% else %>
          <span class="text-amber-600 font-medium">Not configured</span>
        <% end %>
      </p>
    </div>
    <div class="px-6 py-4">
      <%= form_tag admin_ta_team_settings_path, method: :post, class: 'grid grid-cols-1 gap-4 md:grid-cols-2' do %>
        <%= hidden_field_tag :setting_type, 'support_redmine' %>
        <%= hidden_field_tag :tab, @active_tab %>
        <div class="md:col-span-1">
          <%= label_tag :support_redmine_base_url, 'Support Redmine Base URL', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
          <%= text_field_tag :support_redmine_base_url,
                             @support_redmine_settings[:base_url],
                             required: true,
                             placeholder: 'https://support.example.com',
                             class: 'ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
        </div>
        <div class="md:col-span-1">
          <%= label_tag :support_redmine_api_key, 'Support Redmine API Key', class: 'mb-1 block text-sm font-medium text-gray-700' %>
          <%= password_field_tag :support_redmine_api_key,
                                 '',
                                 placeholder: @support_redmine_settings[:api_key].present? ? 'Saved (leave blank to keep existing key)' : 'Enter API key',
                                 class: 'ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
        </div>
        <div class="md:col-span-2 flex justify-end">
          <%= button_tag 'Save Support Redmine Settings', type: 'submit', class: 'tep-action-btn inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0', style: 'background-color: #2563eb !important;' %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex items-end justify-between px-6 pt-2 pb-0 border-b border-gray-200 flex-wrap gap-3" style="margin-bottom: -1px;">
      <ul class="flex flex-wrap text-sm font-medium text-center text-gray-500 -mb-px">
        <li class="me-2">
          <button type="button" id="tab-exclusions" onclick="switchTeamSettingsTab('exclusions')"
                  class="ta-view-tab inline-block px-4 py-2.5 rounded-t-lg text-gray-500 hover:text-gray-600 hover:bg-gray-50 <%= @active_tab == 'exclusions' ? 'ta-view-tab-active' : '' %>">
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-1.414-1.414L12 9.172 7.05 4.222 5.636 5.636 10.586 10.586 5.636 15.536l1.414 1.414L12 12l4.95 4.95 1.414-1.414-4.95-4.95z"></path>
              </svg>
              Exclusion List
              <span class="ts-tab-badge"><%= @excluded_settings.count %></span>
            </span>
          </button>
        </li>
        <li class="me-2">
          <button type="button" id="tab-super-users" onclick="switchTeamSettingsTab('super-users')"
                  class="ta-view-tab inline-block px-4 py-2.5 rounded-t-lg text-gray-500 hover:text-gray-600 hover:bg-gray-50 <%= @active_tab == 'super-users' ? 'ta-view-tab-active' : '' %>">
            <span class="inline-flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5V4H2v16h5m10 0v-4a4 4 0 00-8 0v4m8 0H7m8-13a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Super Users
              <span class="ts-tab-badge"><%= @super_users.count %></span>
            </span>
          </button>
        </li>
      </ul>

      <div class="relative">
        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
          <svg class="w-4 h-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
          </svg>
        </div>
        <input type="search" id="ta-team-settings-search-input" placeholder="Search users..."
               class="ts-search-input block w-80 text-base border border-gray-300"
               oninput="filterTeamSettingsRows()">
      </div>
    </div>

    <div id="panel-exclusions" class="<%= 'hidden' unless @active_tab == 'exclusions' %>">
      <div class="px-6 py-2 text-sm text-gray-500 flex items-center gap-2 border-b border-gray-100">
        <span>Users in this list are excluded from team analytics reports for the selected date range.</span>
      </div>

      <div class="px-6 py-4 border-b border-gray-100">
        <%= form_tag admin_ta_team_settings_path, method: :post, class: 'grid grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.8fr)_minmax(0,0.8fr)_auto] lg:items-end', onsubmit: "return submitTeamSettingsMultiSelect('exclusion')" do %>
          <%= hidden_field_tag :setting_type, 'exclusion' %>
          <%= hidden_field_tag :tab, 'exclusions' %>
          <div class="min-w-0">
            <%= label_tag 'ta-team-settings-multiselect-button-exclusion', 'Add users to exclusion list', class: 'mb-1 block text-sm font-medium text-gray-700' %>
            <div class="relative min-w-0" id="ta-team-settings-multiselect-wrapper-exclusion"
                 data-team-settings-multiselect="exclusion"
                 data-default-label="Add to Exclusion List"
                 data-count-one-label="Add 1 to Exclusion List"
                 data-count-many-label="Add {count} to Exclusion List">
              <button type="button"
                      id="ta-team-settings-multiselect-button-exclusion"
                      onclick="toggleTeamSettingsMultiSelectMenu('exclusion')"
                      aria-expanded="false"
                      class="inline-flex h-[34px] w-full items-center justify-between gap-3 rounded-lg !border !border-slate-300 !bg-white px-3 text-sm font-medium !text-slate-900 shadow-sm hover:!bg-slate-50 hover:!text-slate-900 focus:!border-blue-500 focus:!ring-2 focus:!ring-blue-500/20 focus:outline-none focus:ring-0">
                <span class="truncate" id="ta-team-settings-multiselect-button-label-exclusion">Select members</span>
                <svg class="h-4 w-4 flex-shrink-0 !text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div id="ta-team-settings-multiselect-menu-exclusion"
                   class="hidden absolute left-0 bottom-full z-[9999] mb-2 w-full max-w-full rounded-lg !border !border-slate-300 !bg-white shadow-xl md:w-[420px]">
                <div class="p-3">
                  <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3">
                      <svg class="h-4 w-4 !text-slate-400" aria-hidden="true" fill="none" viewBox="0 0 24 24">
                       <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path>
                      </svg>
                    </div>
                    <input type="search"
                          id="ta-team-settings-multiselect-search-exclusion"
                          placeholder="Search member..."
                          autocomplete="off"
                          oninput="filterTeamSettingsMultiSelect('exclusion')"
                          class="ta-team-settings-multiselect-search block h-[38px] w-full rounded-lg !border !border-blue-500 !bg-white py-2 ps-12 pe-3 text-sm !text-slate-900 placeholder:!text-slate-400 focus:!border-blue-600 focus:!ring-2 focus:!ring-blue-500/20 focus:outline-none">
                  </div>
                </div>
                <div class="max-h-72 overflow-y-auto p-2">
                  <% @available_users.each do |user| %>
                    <label class="ta-team-settings-multiselect-option group flex cursor-pointer items-start gap-3 rounded-lg px-3 py-2 hover:!bg-slate-100 focus-within:!bg-slate-100"
                          data-team-settings-multiselect-option="exclusion"
                          data-search="<%= j("#{user.name} #{user.mail}".downcase) %>">
                      <span class="relative mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center">
                       <input type="checkbox"
                              class="peer h-4 w-4 cursor-pointer appearance-none rounded border !border-slate-300 !bg-white checked:!border-blue-600 checked:!bg-blue-600 focus:!ring-2 focus:!ring-blue-500/20 focus:outline-none"
                              data-user-id="<%= user.id %>"
                              data-user-name="<%= h(user.name) %>"
                              data-user-email="<%= h(user.mail) %>"
                              onchange="toggleTeamSettingsMultiSelectOption('exclusion', this)">
                       <svg class="pointer-events-none absolute h-3 w-3 text-white opacity-0 peer-checked:opacity-100" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                         <path d="M7.5 13.5L4.5 10.5L3.25 11.75L7.5 16L17 6.5L15.75 5.25L7.5 13.5Z" fill="currentColor"></path>
                       </svg>
                      </span>
                      <span class="min-w-0">
                      <span class="ta-team-settings-multiselect-option-name block text-sm font-medium !text-slate-900 group-hover:!text-slate-900 group-hover:!opacity-100"><%= h(user.name) %></span>
                      <span class="ta-team-settings-multiselect-option-email block text-xs !text-slate-600 group-hover:!text-slate-700 group-hover:!opacity-100"><%= h(user.mail) %></span>
                      </span>
                    </label>
                  <% end %>
                </div>
                <div class="border-t !border-slate-200 p-3">
                  <div id="ta-team-settings-selected-chips-exclusion" class="mb-3 flex flex-wrap gap-2"></div>
                  <div class="flex items-center justify-between gap-2">
                    <button type="button" onclick="clearTeamSettingsMultiSelect('exclusion')" class="ta-team-settings-multiselect-clear text-xs font-medium !text-slate-500 hover:!text-slate-700">Clear selection</button>
                    <span class="text-xs !text-slate-500">Select multiple members</span>
                  </div>
                </div>
              </div>
              <div id="ta-team-settings-selected-inputs-exclusion"></div>
            </div>
          </div>
          <div class="min-w-0">
            <%= label_tag :start_date, 'Start Date', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
            <%= text_field_tag :start_date,
                               Date.current.strftime('%m/%d/%Y'),
                               autocomplete: 'off',
                               required: true,
                               placeholder: 'Select start date',
                               class: 'ts-search-input block h-[34px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900 shadow-none focus:outline-none focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6]',
                               'datepicker' => true,
                               'datepicker-format' => 'mm/dd/yyyy',
                               'datepicker-show-on-focus' => 'false',
                               'datepicker-autohide' => 'true' %>
          </div>
          <div class="min-w-0">
            <%= label_tag :end_date, 'End Date', class: 'mb-1 block text-sm font-medium text-gray-700' %>
            <%= text_field_tag :end_date,
                               '',
                               autocomplete: 'off',
                               placeholder: 'Optional end date',
                               class: 'ts-search-input block h-[34px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900 shadow-none focus:outline-none focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6]',
                               'datepicker' => true,
                               'datepicker-format' => 'mm/dd/yyyy',
                               'datepicker-show-on-focus' => 'false',
                               'datepicker-autohide' => 'true' %>
          </div>
          <div class="lg:self-end">
            <%= button_tag type: 'submit', id: 'ta-team-settings-submit-exclusion', disabled: true, class: 'tep-action-btn w-full lg:w-auto flex-shrink-0 inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0 disabled:cursor-not-allowed disabled:opacity-50', style: 'background-color: #2563eb !important;' do %>
              <span id="ta-team-settings-submit-label-exclusion">Add to Exclusion List</span>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @excluded_settings.any? %>
        <div class="overflow-x-auto">
          <table class="ts-table w-full text-sm text-left">
            <thead class="bg-gray-50">
              <tr class="border-b border-gray-200">
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                  <span role="button" tabindex="0" onclick="toggleTeamSettingsSort('exclusions', 'user'); this.blur();"
                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamSettingsSort('exclusions', 'user'); }"
                        class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                    <span>User</span>
                    <span id="ta-team-settings-sort-icon-exclusions-user" class="sort desc icon icon-sorted-asc"></span>
                  </span>
                </th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Email</th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                  <span role="button" tabindex="0" onclick="toggleTeamSettingsSort('exclusions', 'start-date'); this.blur();"
                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamSettingsSort('exclusions', 'start-date'); }"
                        class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                    <span>Start Date</span>
                    <span id="ta-team-settings-sort-icon-exclusions-start-date" class="sort desc icon icon-sorted-asc"></span>
                  </span>
                </th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                  <span role="button" tabindex="0" onclick="toggleTeamSettingsSort('exclusions', 'end-date'); this.blur();"
                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamSettingsSort('exclusions', 'end-date'); }"
                        class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                    <span>End Date</span>
                    <span id="ta-team-settings-sort-icon-exclusions-end-date" class="sort desc icon icon-sorted-asc"></span>
                  </span>
                </th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @excluded_settings.each do |setting| %>
                <% user = setting.user %>
                <% next unless user %>
                <% setting_id = setting.id %>
                <tr class="ta-team-settings-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                    data-search-text="<%= "#{user.name} #{user.mail} #{setting.start_date} #{setting.end_date}".downcase %>"
                    data-user-sort="<%= user.name.to_s.downcase %>"
                    data-email-sort="<%= user.mail.to_s.downcase %>"
                    data-start-date-sort="<%= setting.start_date ? setting.start_date.to_time.to_i : 0 %>"
                    data-end-date-sort="<%= setting.end_date ? setting.end_date.to_time.to_i : 0 %>">
                  <td class="px-4 py-3">
                    <%= link_to user.name, user_path(user), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                  </td>
                  <td class="px-4 py-3 text-gray-600"><%= h(user.mail) %></td>
                  <td class="px-4 py-3 text-gray-600"><%= h(setting.start_date.strftime('%Y-%m-%d')) %></td>
                  <td class="px-4 py-3 text-gray-600"><%= h(setting.end_date.present? ? setting.end_date.strftime('%Y-%m-%d') : 'Ongoing') %></td>
                  <td class="px-4 py-3 text-right">
                    <% if setting_id.present? %>
                      <button type="button"
                              onclick="event.stopPropagation(); teamSettingsDelete(<%= setting_id %>, '<%= admin_ta_team_setting_path(setting_id) %>', '<%= form_authenticity_token %>', 'exclusions')"
                              class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                              title="Delete"
                              aria-label="Delete exclusion">
                        <span class="material-icons" style="font-size:18px;line-height:1;">delete</span>
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <nav id="ta-team-settings-pagination-exclusions" class="hidden px-4 py-3 border-t border-gray-200 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between" aria-label="Exclusion list pagination">
          <span id="ta-team-settings-pagination-info-exclusions" class="text-sm text-gray-700"></span>
          <ul id="ta-team-settings-pagination-links-exclusions" class="inline-flex -space-x-px text-sm h-8"></ul>
        </nav>
      <% else %>
        <div class="px-6 py-10 text-center text-sm text-gray-500">No users in exclusion list.</div>
      <% end %>
    </div>

    <div id="panel-super-users" class="<%= 'hidden' unless @active_tab == 'super-users' %>">
      <div class="px-6 py-2 text-sm text-gray-500 flex items-center gap-2 border-b border-gray-100">
        <span>Super users can access analytics across all teams, regardless of membership.</span>
      </div>

      <div class="px-6 py-4 border-b border-gray-100">
        <%= form_tag admin_ta_team_settings_path, method: :post, class: 'grid grid-cols-1 gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end', onsubmit: "return submitTeamSettingsMultiSelect('super-user')" do %>
          <%= hidden_field_tag :setting_type, 'super_user' %>
          <%= hidden_field_tag :tab, 'super-users' %>
          <div>
            <%= label_tag 'ta-team-settings-multiselect-button-super-user', 'Add super users', class: 'mb-1 block text-sm font-medium text-gray-700' %>
            <div class="relative min-w-0" id="ta-team-settings-multiselect-wrapper-super-user"
                 data-team-settings-multiselect="super-user"
                 data-default-label="Add as Super User"
                 data-count-one-label="Add 1 super user"
                 data-count-many-label="Add {count} super users">
              <button type="button"
                      id="ta-team-settings-multiselect-button-super-user"
                      onclick="toggleTeamSettingsMultiSelectMenu('super-user')"
                      aria-expanded="false"
                      class="inline-flex h-[34px] w-full items-center justify-between gap-3 rounded-lg !border !border-slate-300 !bg-white px-3 text-sm font-medium !text-slate-900 shadow-sm hover:!bg-slate-50 hover:!text-slate-900 focus:!border-blue-500 focus:!ring-2 focus:!ring-blue-500/20 focus:outline-none focus:ring-0">
                <span class="truncate" id="ta-team-settings-multiselect-button-label-super-user">Select members</span>
                <svg class="h-4 w-4 flex-shrink-0 !text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <div id="ta-team-settings-multiselect-menu-super-user"
                   class="hidden absolute left-0 bottom-full z-[9999] mb-2 w-full max-w-full rounded-lg !border !border-slate-300 !bg-white shadow-xl md:w-[420px]">
                <div class="p-3">
                  <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3">
                      <svg class="h-4 w-4 !text-slate-400" aria-hidden="true" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"></path>
                      </svg>
                    </div>
                    <input type="search"
                           id="ta-team-settings-multiselect-search-super-user"
                           placeholder="Search member..."
                           autocomplete="off"
                           oninput="filterTeamSettingsMultiSelect('super-user')"
                           class="ta-team-settings-multiselect-search block h-[38px] w-full rounded-lg !border !border-blue-500 !bg-white py-2 ps-12 pe-3 text-sm !text-slate-900 placeholder:!text-slate-400 focus:!border-blue-600 focus:!ring-2 focus:!ring-blue-500/20 focus:outline-none">
                  </div>
                </div>
                <div class="max-h-72 overflow-y-auto p-2">
                  <% @available_users.each do |user| %>
                    <label class="ta-team-settings-multiselect-option group flex cursor-pointer items-start gap-3 rounded-lg px-3 py-2 hover:!bg-slate-100 focus-within:!bg-slate-100"
                           data-team-settings-multiselect-option="super-user"
                           data-search="<%= j("#{user.name} #{user.mail}".downcase) %>">
                      <span class="relative mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center">
                        <input type="checkbox"
                              class="peer h-4 w-4 cursor-pointer appearance-none rounded border !border-slate-300 !bg-white checked:!border-blue-600 checked:!bg-blue-600 focus:!ring-2 focus:!ring-blue-500/20 focus:outline-none"
                              data-user-id="<%= user.id %>"
                              data-user-name="<%= h(user.name) %>"
                              data-user-email="<%= h(user.mail) %>"
                              onchange="toggleTeamSettingsMultiSelectOption('super-user', this)">
                        <svg class="pointer-events-none absolute h-3 w-3 text-white opacity-0 peer-checked:opacity-100" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                          <path d="M7.5 13.5L4.5 10.5L3.25 11.75L7.5 16L17 6.5L15.75 5.25L7.5 13.5Z" fill="currentColor"></path>
                        </svg>
                      </span>
                      <span class="min-w-0">
                       <span class="ta-team-settings-multiselect-option-name block text-sm font-medium !text-slate-900 group-hover:!text-slate-900 group-hover:!opacity-100"><%= h(user.name) %></span>
                       <span class="ta-team-settings-multiselect-option-email block text-xs !text-slate-600 group-hover:!text-slate-700 group-hover:!opacity-100"><%= h(user.mail) %></span>
                      </span>
                    </label>
                  <% end %>
                </div>
                <div class="border-t !border-slate-200 p-3">
                  <div id="ta-team-settings-selected-chips-super-user" class="mb-3 flex flex-wrap gap-2"></div>
                  <div class="flex items-center justify-between gap-2">
                    <button type="button" onclick="clearTeamSettingsMultiSelect('super-user')" class="ta-team-settings-multiselect-clear text-xs font-medium !text-slate-500 hover:!text-slate-700">Clear selection</button>
                    <span class="text-xs !text-slate-500">Select multiple members</span>
                  </div>
                </div>
              </div>
              <div id="ta-team-settings-selected-inputs-super-user"></div>
            </div>
          </div>
          <%= button_tag type: 'submit', id: 'ta-team-settings-submit-super-user', disabled: true, class: 'tep-action-btn flex-shrink-0 inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0 disabled:cursor-not-allowed disabled:opacity-50', style: 'background-color: #2563eb !important;' do %>
            <span id="ta-team-settings-submit-label-super-user">Add as Super User</span>
          <% end %>
        <% end %>
      </div>

      <% if @super_users.any? %>
        <div class="overflow-x-auto">
          <table class="ts-table w-full text-sm text-left">
            <thead class="bg-gray-50">
              <tr class="border-b border-gray-200">
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                  <span role="button" tabindex="0" onclick="toggleTeamSettingsSort('super-users', 'user'); this.blur();"
                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleTeamSettingsSort('super-users', 'user'); }"
                        class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                    <span>User</span>
                    <span id="ta-team-settings-sort-icon-super-users-user" class="sort desc icon icon-sorted-asc"></span>
                  </span>
                </th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Email</th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @super_users.each do |user| %>
                <% setting_id = @super_user_settings_by_user_id[user.id] %>
                <tr class="ta-team-settings-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                    data-search-text="<%= "#{user.name} #{user.mail}".downcase %>"
                    data-user-sort="<%= user.name.to_s.downcase %>"
                    data-email-sort="<%= user.mail.to_s.downcase %>">
                  <td class="px-4 py-3">
                    <%= link_to user.name, user_path(user), class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                  </td>
                  <td class="px-4 py-3 text-gray-600"><%= h(user.mail) %></td>
                  <td class="px-4 py-3 text-right">
                    <% if setting_id.present? %>
                      <button type="button"
                              onclick="event.stopPropagation(); teamSettingsDelete(<%= setting_id %>, '<%= admin_ta_team_setting_path(setting_id) %>', '<%= form_authenticity_token %>', 'super-users')"
                              class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                              title="Delete"
                              aria-label="Delete super user">
                        <span class="material-icons" style="font-size:18px;line-height:1;">delete</span>
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <nav id="ta-team-settings-pagination-super-users" class="hidden px-4 py-3 border-t border-gray-200 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between" aria-label="Super users pagination">
          <span id="ta-team-settings-pagination-info-super-users" class="text-sm text-gray-700"></span>
          <ul id="ta-team-settings-pagination-links-super-users" class="inline-flex -space-x-px text-sm h-8"></ul>
        </nav>
      <% else %>
        <div class="px-6 py-10 text-center text-sm text-gray-500">No super users configured.</div>
      <% end %>
    </div>
  </div>
</div>

