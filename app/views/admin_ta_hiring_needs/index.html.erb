<script type="text/javascript">
  var hiringPendingDelete = null;
  var hiringPendingTitleDelete = null;
  var hiringPagination = {
    open: { currentPage: 1, perPage: 10 },
    filled: { currentPage: 1, perPage: 10 }
  };
  var hiringInlineFloatingState = {};

  function hiringEnsureInlineMenuState(menu) {
    if (!menu || !menu.id) return null;
    if (!hiringInlineFloatingState[menu.id]) {
      hiringInlineFloatingState[menu.id] = {
        parent: menu.parentNode,
        nextSibling: menu.nextSibling,
        anchorId: null
      };
    }
    return hiringInlineFloatingState[menu.id];
  }

  function hiringPositionInlineMenu(menu, anchor) {
    if (!menu || !anchor) return;

    var rect = anchor.getBoundingClientRect();
    var targetWidth = Math.max(Math.round(rect.width), 220);
    var viewportPadding = 8;
    var preferredHeight = Math.min(menu.scrollHeight || 220, 320);
    var spaceBelow = Math.max(0, window.innerHeight - rect.bottom - viewportPadding);
    var spaceAbove = Math.max(0, rect.top - viewportPadding);
    var openUp = spaceBelow < 160 && spaceAbove > spaceBelow;
    var maxHeight = Math.max(120, openUp ? spaceAbove : spaceBelow);

    menu.style.position = 'fixed';
    var left = Math.max(viewportPadding, rect.left);
    if (left + targetWidth > window.innerWidth - viewportPadding) {
      left = Math.max(viewportPadding, window.innerWidth - viewportPadding - targetWidth);
    }
    menu.style.left = left + 'px';
    menu.style.width = targetWidth + 'px';
    menu.style.maxHeight = Math.min(preferredHeight, maxHeight) + 'px';
    menu.style.top = openUp ? 'auto' : (rect.bottom + 2) + 'px';
    menu.style.bottom = openUp ? (window.innerHeight - rect.top + 2) + 'px' : 'auto';
    menu.style.zIndex = '10050';
  }

  function hiringOpenInlineMenu(menu, anchor) {
    if (!menu || !anchor || !menu.id || !anchor.id) return;
    var state = hiringEnsureInlineMenuState(menu);
    if (!state) return;

    state.anchorId = anchor.id;
    if (menu.parentNode !== document.body) {
      document.body.appendChild(menu);
    }
    menu.classList.remove('hidden');
    hiringPositionInlineMenu(menu, anchor);
  }

  function hiringCloseInlineMenu(menu) {
    if (!menu || !menu.id) return;
    var state = hiringInlineFloatingState[menu.id];
    menu.classList.add('hidden');

    if (state && state.parent && menu.parentNode !== state.parent) {
      state.parent.insertBefore(menu, state.nextSibling);
    }
    if (state) state.anchorId = null;

    menu.style.position = '';
    menu.style.left = '';
    menu.style.top = '';
    menu.style.bottom = '';
    menu.style.width = '';
    menu.style.maxHeight = '';
    menu.style.zIndex = '';
  }

  function hiringSyncInlineMenuPositions() {
    Object.keys(hiringInlineFloatingState).forEach(function(menuId) {
      var menu = document.getElementById(menuId);
      var state = hiringInlineFloatingState[menuId];
      if (!menu || !state || menu.classList.contains('hidden') || !state.anchorId) return;
      var anchor = document.getElementById(state.anchorId);
      if (!anchor) {
        hiringCloseInlineMenu(menu);
        return;
      }
      hiringPositionInlineMenu(menu, anchor);
    });
  }

  if (!window.__hiringInlineFloatingListenersBound) {
    window.addEventListener('resize', hiringSyncInlineMenuPositions);
    document.addEventListener('scroll', hiringSyncInlineMenuPositions, true);
    window.__hiringInlineFloatingListenersBound = true;
  }

  function closeInlineHiringDropdowns() {
    document.querySelectorAll('[data-ta-hiring-inline-menu]').forEach(function(menu) {
      hiringCloseInlineMenu(menu);
    });
  }

  function toggleHiringInlineEdit(rowId) {
    var row = document.querySelector('[data-hiring-row-id="' + rowId + '"]');
    if (!row) return;
    var shouldOpen = !row.classList.contains('is-editing');
    closeInlineHiringDropdowns();
    row.classList.toggle('is-editing', shouldOpen);
    row.querySelectorAll('.ta-hiring-view').forEach(function(el) { el.classList.toggle('hidden', shouldOpen); });
    row.querySelectorAll('.ta-hiring-edit').forEach(function(el) { el.classList.toggle('hidden', !shouldOpen); });
  }

  function hiringOpenDeleteModal() {
    var modal = document.getElementById('taHiringDeleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function hiringCloseDeleteModal() {
    var modal = document.getElementById('taHiringDeleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  function hiringDelete(url, token) {
    hiringPendingDelete = { url: url, token: token };
    hiringOpenDeleteModal();
  }

  function hiringOpenTitleDeleteModal(titleLabel, titleDeleteUrl) {
    hiringPendingTitleDelete = { label: titleLabel, url: titleDeleteUrl };
    var message = document.getElementById('ta-hiring-title-delete-message');
    if (message) message.textContent = 'Are you sure you want to delete "' + titleLabel + '"?';

    var modal = document.getElementById('taHiringTitleDeleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function hiringCloseTitleDeleteModal() {
    var modal = document.getElementById('taHiringTitleDeleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    hiringPendingTitleDelete = null;
  }

  function hiringConfirmDelete() {
    if (!hiringPendingDelete) return;
    hiringCloseDeleteModal();
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = hiringPendingDelete.url;
    [['authenticity_token', hiringPendingDelete.token], ['_method', 'DELETE']].forEach(function(pair) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = pair[0];
      input.value = pair[1];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }

  function resetHiringSortIcons(tabKey, activeColumn) {
    ['title', 'team', 'priority', 'opened', 'filled', 'duration'].forEach(function(column) {
      var icon = document.getElementById('ta-hiring-' + tabKey + '-sort-icon-' + column);
      if (!icon) return;
      if (column !== activeColumn) delete icon.dataset.order;
      var order = icon.dataset.order || 'desc';
      icon.className = order === 'asc' ? 'sort asc icon icon-sorted-desc' : 'sort desc icon icon-sorted-asc';
    });
  }

  function toggleHiringSort(tabKey, column) {
    var panel = document.getElementById('ta-hiring-' + tabKey + '-panel');
    var tbody = panel ? panel.querySelector('table.ts-table tbody') : null;
    if (!tbody) return;
    var rows = Array.from(tbody.querySelectorAll('.ta-hiring-' + tabKey + '-row'));
    var sortIcon = document.getElementById('ta-hiring-' + tabKey + '-sort-icon-' + column);
    if (!sortIcon) return;

    var currentOrder = sortIcon.dataset.order || 'desc';
    var nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';
    var numericColumns = ['priority', 'opened', 'filled', 'duration'];

    rows.sort(function(a, b) {
      var attr = 'data-sort-' + column;
      var aValue = a.getAttribute(attr) || '';
      var bValue = b.getAttribute(attr) || '';
      if (numericColumns.indexOf(column) !== -1) {
        aValue = parseInt(aValue || '0', 10);
        bValue = parseInt(bValue || '0', 10);
        return nextOrder === 'asc' ? aValue - bValue : bValue - aValue;
      }
      var stringCompare = aValue.localeCompare(bValue);
      return nextOrder === 'asc' ? stringCompare : -stringCompare;
    });

    rows.forEach(function(row) { tbody.appendChild(row); });
    delete sortIcon.dataset.order;
    sortIcon.dataset.order = nextOrder;
    resetHiringSortIcons(tabKey, column);
    applyHiringPagination(tabKey, true);
  }

  function hiringRowsFor(tabKey) {
    return Array.from(document.querySelectorAll('#ta-hiring-' + tabKey + '-panel .ta-hiring-' + tabKey + '-row'));
  }

  function renderHiringPagination(tabKey, totalMatched, totalPages, startIndex, endIndex) {
    var nav = document.getElementById('ta-hiring-' + tabKey + '-pagination');
    var info = document.getElementById('ta-hiring-' + tabKey + '-pagination-info');
    var links = document.getElementById('ta-hiring-' + tabKey + '-pagination-links');
    if (!nav || !info || !links) return;

    if (totalMatched === 0) {
      nav.classList.add('hidden');
      info.textContent = '';
      links.innerHTML = '';
      return;
    }

    var state = hiringPagination[tabKey];
    nav.classList.remove('hidden');
    info.textContent = 'Showing ' + startIndex + '-' + endIndex + ' of ' + totalMatched + ' hires';
    links.innerHTML = '';

    function pageButton(label, disabled, handler, extraClass) {
      var li = document.createElement('li');
      var button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.className = extraClass;
      if (disabled) button.disabled = true;
      else button.addEventListener('click', handler);
      li.appendChild(button);
      return li;
    }

    links.appendChild(pageButton('Previous', state.currentPage === 1, function() {
      state.currentPage -= 1;
      applyHiringPagination(tabKey, true);
    }, 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 rounded-s-lg ' + (state.currentPage === 1 ? 'text-gray-300 bg-gray-50 cursor-not-allowed' : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700')));

    for (var page = 1; page <= totalPages; page++) {
      (function(pageNumber) {
        var isCurrent = pageNumber === state.currentPage;
        links.appendChild(pageButton(String(pageNumber), false, function() {
          state.currentPage = pageNumber;
          applyHiringPagination(tabKey, true);
        }, 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 ' + (isCurrent ? 'text-blue-600 bg-blue-50 hover:bg-blue-100 hover:text-blue-700' : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700')));
      })(page);
    }

    links.appendChild(pageButton('Next', state.currentPage === totalPages, function() {
      state.currentPage += 1;
      applyHiringPagination(tabKey, true);
    }, 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 rounded-e-lg ' + (state.currentPage === totalPages ? 'text-gray-300 bg-gray-50 cursor-not-allowed' : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700')));
  }

  function applyHiringPagination(tabKey, preservePage) {
    var state = hiringPagination[tabKey];
    if (!state) return;
    closeInlineHiringDropdowns();
    var rows = hiringRowsFor(tabKey);
    var totalPages = Math.max(1, Math.ceil(rows.length / state.perPage));
    if (!preservePage) state.currentPage = 1;
    else if (state.currentPage > totalPages) state.currentPage = totalPages;

    var start = (state.currentPage - 1) * state.perPage;
    var end = start + state.perPage;
    var visibleSet = new Set(rows.slice(start, end));
    rows.forEach(function(row) { row.style.display = visibleSet.has(row) ? '' : 'none'; });

    var startIndex = rows.length ? (start + 1) : 0;
    var endIndex = rows.length ? Math.min(end, rows.length) : 0;
    renderHiringPagination(tabKey, rows.length, totalPages, startIndex, endIndex);
  }

  document.addEventListener('DOMContentLoaded', function() {
    function closeCreateHiringDropdowns() {
      var titleDropdown = document.getElementById('ta-hiring-create-title-dropdown');
      var teamDropdown = document.getElementById('ta-hiring-create-team-dropdown');
      var priorityDropdown = document.getElementById('ta-hiring-create-priority-dropdown');
      if (titleDropdown) titleDropdown.classList.add('hidden');
      if (teamDropdown) teamDropdown.classList.add('hidden');
      if (priorityDropdown) priorityDropdown.classList.add('hidden');
    }

    function setCreateHiringTitle(title) {
      var titleLabel = document.getElementById('ta-hiring-create-title-label');
      var titleValue = document.getElementById('ta-hiring-create-title-value');
      if (titleLabel) titleLabel.textContent = title || 'Select Title';
      if (titleValue) titleValue.value = title || '';
    }

    function escapeHtml(text) {
      return (text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderCreateHiringTitleOptions(titles) {
      var list = document.getElementById('ta-hiring-create-title-options');
      if (!list) return;
      list.innerHTML = '';

      if (!titles.length) {
        list.insertAdjacentHTML('beforeend', '<li class="px-4 py-2 text-sm text-gray-500">No titles available. Add a new title below.</li>');
        return;
      }

      titles.forEach(function(item) {
        var safeTitle = escapeHtml(item.title);
        var safeDeleteUrl = escapeHtml(item.destroy_url);
        list.insertAdjacentHTML('beforeend',
          '<li class="flex items-center gap-1 px-1">' +
            '<button type="button" class="tep-activity-option w-full text-left px-3 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900 rounded-md" ' +
              'data-ta-hiring-create-title-id="' + item.id + '" ' +
              'data-ta-hiring-create-title-value="' + safeTitle + '" ' +
              'data-ta-hiring-create-title-label="' + safeTitle + '">' + safeTitle + '</button>' +
            '<button type="button" class="ta-inline-icon-btn ta-inline-icon-btn--danger" ' +
              'title="Delete title" ' +
              'data-ta-hiring-create-title-delete-id="' + item.id + '" ' +
              'data-ta-hiring-create-title-delete-label="' + safeTitle + '" ' +
              'data-ta-hiring-create-title-delete-url="' + safeDeleteUrl + '">' +
              '<span class="material-icons ta-inline-material-icon">delete</span>' +
            '</button>' +
          '</li>'
        );
      });
    }

    function fetchHiringTitle(url, method, payload, onSuccess) {
      var manager = document.getElementById('ta-hiring-title-manager');
      if (!manager) return;
      var csrfToken = manager.getAttribute('data-csrf-token');
      var options = {
        method: method,
        headers: {
          'X-CSRF-Token': csrfToken,
          'Accept': 'application/json'
        }
      };

      if (payload) {
        options.headers['Content-Type'] = 'application/json';
        options.body = JSON.stringify(payload);
      }

      fetch(url, options)
        .then(function(response) {
          return response.json().then(function(body) {
            if (!response.ok) {
              var message = body && body.error ? body.error : 'Unable to update titles.';
              throw new Error(message);
            }
            return body;
          });
        })
        .then(function(body) {
          if (body.titles) renderCreateHiringTitleOptions(body.titles);
          onSuccess(body);
        })
        .catch(function(error) {
          alert(error.message);
        });
    }

    function switchHiringTab(targetPanelId) {
      [
        { tab: document.getElementById('ta-hiring-open-tab'), panel: document.getElementById('ta-hiring-open-panel') },
        { tab: document.getElementById('ta-hiring-filled-tab'), panel: document.getElementById('ta-hiring-filled-panel') }
      ].forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        else item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
      });
    }

    document.querySelectorAll('[data-hiring-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchHiringTab(tabButton.getAttribute('data-hiring-tab-target'));
      });
    });

    document.addEventListener('click', function(event) {
      var inlineToggleButton = event.target.closest('[data-ta-hiring-inline-toggle]');
      if (inlineToggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var inlineTargetId = inlineToggleButton.getAttribute('data-ta-hiring-inline-target');
        var inlineMenu = inlineTargetId ? document.getElementById(inlineTargetId) : null;
        if (!inlineMenu) return;
        var isInlineHidden = inlineMenu.classList.contains('hidden');
        closeInlineHiringDropdowns();
        closeCreateHiringDropdowns();
        if (isInlineHidden) hiringOpenInlineMenu(inlineMenu, inlineToggleButton);
        return;
      }

      var inlineOptionButton = event.target.closest('[data-ta-hiring-inline-value]');
      if (inlineOptionButton) {
        event.preventDefault();
        var inputId = inlineOptionButton.getAttribute('data-ta-hiring-inline-input');
        var labelId = inlineOptionButton.getAttribute('data-ta-hiring-inline-label');
        var selectedValue = inlineOptionButton.getAttribute('data-ta-hiring-inline-value');
        var selectedText = inlineOptionButton.getAttribute('data-ta-hiring-inline-text');
        var hiddenInput = inputId ? document.getElementById(inputId) : null;
        var labelNode = labelId ? document.getElementById(labelId) : null;
        if (hiddenInput) hiddenInput.value = selectedValue;
        if (labelNode) labelNode.textContent = selectedText;
        closeInlineHiringDropdowns();
        return;
      }

      var titleToggleButton = event.target.closest('[data-ta-hiring-create-title-toggle]');
      if (titleToggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var titleDropdown = document.getElementById('ta-hiring-create-title-dropdown');
        if (!titleDropdown) return;
        var isTitleHidden = titleDropdown.classList.contains('hidden');
        closeCreateHiringDropdowns();
        if (isTitleHidden) titleDropdown.classList.remove('hidden');
        return;
      }

      var titleOptionButton = event.target.closest('[data-ta-hiring-create-title-value]');
      if (titleOptionButton) {
        event.preventDefault();
        var selectedTitleValue = titleOptionButton.getAttribute('data-ta-hiring-create-title-value');
        var selectedTitleLabel = titleOptionButton.getAttribute('data-ta-hiring-create-title-label');
        setCreateHiringTitle(selectedTitleValue || selectedTitleLabel);
        closeCreateHiringDropdowns();
        return;
      }

      var deleteTitleButton = event.target.closest('[data-ta-hiring-create-title-delete-id]');
      if (deleteTitleButton) {
        event.preventDefault();
        event.stopPropagation();
        var deleteTitleLabel = deleteTitleButton.getAttribute('data-ta-hiring-create-title-delete-label');
        var deleteTitleUrl = deleteTitleButton.getAttribute('data-ta-hiring-create-title-delete-url');
        if (!deleteTitleUrl) return;
        hiringOpenTitleDeleteModal(deleteTitleLabel, deleteTitleUrl);
        return;
      }

      var teamToggleButton = event.target.closest('[data-ta-hiring-create-team-toggle]');
      if (teamToggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var teamDropdown = document.getElementById('ta-hiring-create-team-dropdown');
        if (!teamDropdown) return;
        var isHidden = teamDropdown.classList.contains('hidden');
        closeCreateHiringDropdowns();
        if (isHidden) teamDropdown.classList.remove('hidden');
        return;
      }

      var teamOptionButton = event.target.closest('[data-ta-hiring-create-team-value]');
      if (teamOptionButton) {
        event.preventDefault();
        var selectedTeamId = teamOptionButton.getAttribute('data-ta-hiring-create-team-value');
        var selectedTeamLabel = teamOptionButton.getAttribute('data-ta-hiring-create-team-label');
        var teamHiddenInput = document.getElementById('ta-hiring-create-team-id');
        var teamButtonLabel = document.getElementById('ta-hiring-create-team-label');
        if (teamHiddenInput) teamHiddenInput.value = selectedTeamId;
        if (teamButtonLabel) teamButtonLabel.textContent = selectedTeamLabel;
        closeCreateHiringDropdowns();
        return;
      }

      var priorityToggleButton = event.target.closest('[data-ta-hiring-create-priority-toggle]');
      if (priorityToggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var priorityDropdown = document.getElementById('ta-hiring-create-priority-dropdown');
        if (!priorityDropdown) return;
        var isPriorityHidden = priorityDropdown.classList.contains('hidden');
        closeCreateHiringDropdowns();
        if (isPriorityHidden) priorityDropdown.classList.remove('hidden');
        return;
      }

      var priorityOptionButton = event.target.closest('[data-ta-hiring-create-priority-value]');
      if (priorityOptionButton) {
        event.preventDefault();
        var selectedPriorityValue = priorityOptionButton.getAttribute('data-ta-hiring-create-priority-value');
        var selectedPriorityLabel = priorityOptionButton.getAttribute('data-ta-hiring-create-priority-label');
        var priorityHiddenInput = document.getElementById('ta-hiring-create-priority-value');
        var priorityButtonLabel = document.getElementById('ta-hiring-create-priority-label');
        if (priorityHiddenInput) priorityHiddenInput.value = selectedPriorityValue;
        if (priorityButtonLabel) priorityButtonLabel.textContent = selectedPriorityLabel;
        closeCreateHiringDropdowns();
        return;
      }

      closeInlineHiringDropdowns();
      closeCreateHiringDropdowns();
    });

    var addTitleButton = document.getElementById('ta-hiring-create-title-add-button');
    var newTitleInput = document.getElementById('ta-hiring-create-title-new-input');
    var titleManager = document.getElementById('ta-hiring-title-manager');
    var createTitleUrl = titleManager ? titleManager.getAttribute('data-create-url') : null;

    function addCreateHiringTitle() {
      if (!createTitleUrl || !newTitleInput) return;
      var newTitle = newTitleInput.value.trim();
      if (!newTitle) return;

      fetchHiringTitle(createTitleUrl, 'POST', { title: newTitle }, function(responseBody) {
        var selectedTitle = responseBody.title && responseBody.title.title ? responseBody.title.title : newTitle;
        setCreateHiringTitle(selectedTitle);
        newTitleInput.value = '';
      });
    }

    if (addTitleButton) {
      addTitleButton.addEventListener('click', function(event) {
        event.preventDefault();
        addCreateHiringTitle();
      });
    }

    if (newTitleInput) {
      newTitleInput.addEventListener('keydown', function(event) {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        addCreateHiringTitle();
      });
    }

    var createHiringForm = document.querySelector('#taHiringCreateModal form');
    if (createHiringForm) {
      createHiringForm.addEventListener('submit', function(event) {
        var titleValue = document.getElementById('ta-hiring-create-title-value');
        if (titleValue && titleValue.value.trim()) return;
        event.preventDefault();
        alert('Please select a title.');
      });
    }

    window.hiringConfirmTitleDelete = function() {
      if (!hiringPendingTitleDelete || !hiringPendingTitleDelete.url) return;

      var pending = hiringPendingTitleDelete;
      hiringCloseTitleDeleteModal();
      var titleValue = document.getElementById('ta-hiring-create-title-value');

      fetchHiringTitle(pending.url, 'DELETE', null, function() {
        if (titleValue && titleValue.value === pending.label) setCreateHiringTitle('');
      });
    };

    if (!window.__hiringDeleteModalListenersBound) {
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
          hiringCloseDeleteModal();
          hiringCloseTitleDeleteModal();
        }
      });
      document.addEventListener('click', function(event) {
        var modal = document.getElementById('taHiringDeleteModal');
        if (modal && !modal.classList.contains('hidden') && event.target === modal) hiringCloseDeleteModal();
        var titleModal = document.getElementById('taHiringTitleDeleteModal');
        if (titleModal && !titleModal.classList.contains('hidden') && event.target === titleModal) hiringCloseTitleDeleteModal();
      });
      window.__hiringDeleteModalListenersBound = true;
    }

    resetHiringSortIcons('open', 'title');
    resetHiringSortIcons('filled', 'title');
    applyHiringPagination('open', false);
    applyHiringPagination('filled', false);
  });
</script>
