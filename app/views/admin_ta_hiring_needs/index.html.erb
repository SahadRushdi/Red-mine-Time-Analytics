<% html_title 'Positions & Hiring' %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
<% end %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Positions & Hiring</h2>
      <p class="text-sm text-gray-500">Manage hiring requests, priorities, and assignments.</p>
    </div>
    <button type="button"
            data-modal-target="taHiringCreateModal"
            data-modal-toggle="taHiringCreateModal"
            class="ta-btn-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">
      Create Hiring Request
    </button>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="border-b border-gray-200 px-4 pt-2">
      <ul class="-mb-px flex flex-wrap text-sm font-medium text-center">
        <li class="me-2">
          <button type="button"
                  id="ta-hiring-open-tab"
                  data-hiring-tab-target="ta-hiring-open-panel"
                  class="ta-view-tab inline-block rounded-t-lg p-4 ta-view-tab-active">
            <span class="inline-flex items-center gap-2">
              <span>Open Hires</span>
              <span class="ts-tab-badge"><%= @open_hiring_needs.size %></span>
            </span>
          </button>
        </li>
        <li class="me-2">
          <button type="button"
                  id="ta-hiring-filled-tab"
                  data-hiring-tab-target="ta-hiring-filled-panel"
                  class="ta-view-tab inline-block rounded-t-lg p-4 text-gray-500 hover:text-gray-600 hover:bg-gray-50">
            <span class="inline-flex items-center gap-2">
              <span>Filled Hires</span>
              <span class="ts-tab-badge"><%= @filled_hiring_needs.size %></span>
            </span>
          </button>
        </li>
      </ul>
    </div>

    <div id="ta-hiring-open-panel">
      <div class="overflow-x-auto overflow-y-visible">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="w-[420px] px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('open','title'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Title<span id="ta-hiring-open-sort-icon-title" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('open','team'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Team<span id="ta-hiring-open-sort-icon-team" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="w-[260px] px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('open','priority'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Priority<span id="ta-hiring-open-sort-icon-priority" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('open','opened'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Opened<span id="ta-hiring-open-sort-icon-opened" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('open','duration'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Duration<span id="ta-hiring-open-sort-icon-duration" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if @open_hiring_needs.any? %>
              <% @open_hiring_needs.each do |need| %>
                <% team_name = need.team&.name.presence || 'Deleted Team' %>
                <% duration_days = [(Date.current - need.created_at.to_date), 0].max.to_i %>
                <% form_id = "ta-hiring-form-#{need.id}" %>
                <% edit_team_button_id = "ta-hiring-edit-team-button-#{need.id}" %>
                <% edit_team_label_id = "ta-hiring-edit-team-label-#{need.id}" %>
                <% edit_team_list_id = "ta-hiring-edit-team-list-#{need.id}" %>
                <% edit_team_input_id = "ta-hiring-edit-team-input-#{need.id}" %>
                <% edit_title_button_id = "ta-hiring-edit-title-button-#{need.id}" %>
                <% edit_title_label_id = "ta-hiring-edit-title-label-#{need.id}" %>
                <% edit_title_list_id = "ta-hiring-edit-title-list-#{need.id}" %>
                <% edit_title_input_id = "ta-hiring-edit-title-input-#{need.id}" %>
                <% edit_priority_button_id = "ta-hiring-edit-priority-button-#{need.id}" %>
                <% edit_priority_label_id = "ta-hiring-edit-priority-label-#{need.id}" %>
                <% edit_priority_list_id = "ta-hiring-edit-priority-list-#{need.id}" %>
                <% edit_priority_input_id = "ta-hiring-edit-priority-input-#{need.id}" %>
                <tr class="ta-hiring-open-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                    data-hiring-row-id="<%= need.id %>"
                    data-sort-title="<%= need.title.to_s.downcase %>"
                    data-sort-team="<%= team_name.to_s.downcase %>"
                    data-sort-priority="<%= need.priority == 'high' ? 3 : (need.priority == 'medium' ? 2 : 1) %>"
                    data-sort-opened="<%= need.created_at.to_i %>"
                    data-sort-duration="<%= duration_days %>">
                  <td class="w-[420px] px-4 py-3 whitespace-nowrap">
                    <div class="ta-hiring-view"><span class="text-sm font-semibold text-gray-900"><%= h(need.title) %></span></div>
                    <div class="ta-hiring-edit hidden relative">
                      <input type="hidden" id="<%= edit_title_input_id %>" name="ta_hiring_need[title]" form="<%= form_id %>" value="<%= h(need.title) %>">
                      <button id="<%= edit_title_button_id %>"
                              type="button"
                              class="ts-filter-button inline-flex h-[38px] w-full items-center justify-between gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                              data-ta-hiring-inline-toggle="true"
                              data-ta-hiring-inline-target="<%= edit_title_list_id %>">
                        <span id="<%= edit_title_label_id %>" class="truncate"><%= h(need.title) %></span>
                        <span class="material-icons text-base text-gray-500">arrow_drop_down</span>
                      </button>
                      <div id="<%= edit_title_list_id %>" data-ta-hiring-inline-menu="true" class="hidden absolute left-0 top-full z-[10050] mt-1 max-h-56 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                        <% @hiring_titles.each do |hiring_title| %>
                          <% title = hiring_title.title %>
                          <button type="button"
                                  class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                                  data-ta-hiring-inline-value="<%= h(title) %>"
                                  data-ta-hiring-inline-input="<%= edit_title_input_id %>"
                                  data-ta-hiring-inline-label="<%= edit_title_label_id %>"
                                  data-ta-hiring-inline-text="<%= h(title) %>">
                            <%= h(title) %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="w-[260px] px-4 py-3 whitespace-nowrap">
                    <div class="ta-hiring-view text-gray-600"><%= h(team_name) %></div>
                    <div class="ta-hiring-edit hidden relative">
                      <input type="hidden" id="<%= edit_team_input_id %>" name="ta_hiring_need[team_id]" form="<%= form_id %>" value="<%= need.team_id %>">
                      <button id="<%= edit_team_button_id %>"
                              type="button"
                              class="ts-filter-button inline-flex h-[38px] w-full items-center justify-between gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                              data-ta-hiring-inline-toggle="true"
                              data-ta-hiring-inline-target="<%= edit_team_list_id %>">
                        <span id="<%= edit_team_label_id %>" class="truncate"><%= h(team_name) %></span>
                        <span class="material-icons text-base text-gray-500">arrow_drop_down</span>
                      </button>
                      <div id="<%= edit_team_list_id %>" data-ta-hiring-inline-menu="true" class="hidden absolute left-0 top-full z-[10050] mt-1 max-h-56 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                        <% @all_teams.each do |team| %>
                          <% indent = '&nbsp;&nbsp;' * team.all_ancestors.count %>
                          <button type="button"
                                  class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                                  data-ta-hiring-inline-value="<%= team.id %>"
                                  data-ta-hiring-inline-input="<%= edit_team_input_id %>"
                                  data-ta-hiring-inline-label="<%= edit_team_label_id %>"
                                  data-ta-hiring-inline-text="<%= h(team.name) %>">
                            <%= indent.html_safe %><%= h(team.name) %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="w-[220px] px-4 py-3 whitespace-nowrap">
                    <div class="ta-hiring-view">
                      <% priority_classes = need.priority == 'high' ? 'bg-red-100 text-red-700 border-red-200' : (need.priority == 'medium' ? 'bg-amber-100 text-amber-700 border-amber-200' : 'bg-green-100 text-green-700 border-green-200') %>
                      <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium <%= priority_classes %>"><%= need.priority.titleize %></span>
                    </div>
                    <div class="ta-hiring-edit hidden relative">
                      <input type="hidden" id="<%= edit_priority_input_id %>" name="ta_hiring_need[priority]" form="<%= form_id %>" value="<%= need.priority %>">
                      <button id="<%= edit_priority_button_id %>"
                              type="button"
                              class="ts-filter-button inline-flex h-[38px] w-full items-center justify-between gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                              data-ta-hiring-inline-toggle="true"
                              data-ta-hiring-inline-target="<%= edit_priority_list_id %>">
                        <span id="<%= edit_priority_label_id %>" class="truncate"><%= need.priority.titleize %></span>
                        <span class="material-icons text-base text-gray-500">arrow_drop_down</span>
                      </button>
                      <div id="<%= edit_priority_list_id %>" data-ta-hiring-inline-menu="true" class="hidden absolute left-0 top-full z-[10050] mt-1 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                        <% TaHiringNeed::PRIORITIES.each do |priority| %>
                          <button type="button"
                                  class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                                  data-ta-hiring-inline-value="<%= priority %>"
                                  data-ta-hiring-inline-input="<%= edit_priority_input_id %>"
                                  data-ta-hiring-inline-label="<%= edit_priority_label_id %>"
                                  data-ta-hiring-inline-text="<%= priority.titleize %>">
                            <%= priority.titleize %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-gray-600"><%= format_date(need.created_at.to_date) %></td>
                  <td class="px-4 py-3 text-gray-700"><%= duration_days %>d</td>
                  <td class="px-4 py-3 text-right">
                    <div class="ta-hiring-view inline-flex items-center justify-end gap-1">
                      <%= button_to mark_filled_admin_ta_hiring_need_path(need), method: :patch, class: 'ta-inline-icon-btn ta-inline-icon-btn--success', form_class: 'inline', title: 'Mark filled' do %>
                        <span class="material-icons ta-inline-material-icon">done</span>
                      <% end %>
                      <button type="button" onclick="toggleHiringInlineEdit(<%= need.id %>)" class="ta-inline-icon-btn" title="Edit">
                        <span class="material-icons ta-inline-material-icon">edit</span>
                      </button>
                      <button type="button" onclick="hiringDelete('<%= admin_ta_hiring_need_path(need) %>', '<%= form_authenticity_token %>')" class="ta-inline-icon-btn ta-inline-icon-btn--danger" title="Delete">
                        <span class="material-icons ta-inline-material-icon">delete</span>
                      </button>
                    </div>
                    <div class="ta-hiring-edit hidden inline-flex items-center justify-end gap-2">
                      <button type="submit" form="<%= form_id %>" class="ta-btn-save-primary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Save</button>
                      <button type="button" onclick="toggleHiringInlineEdit(<%= need.id %>)" class="ta-btn-secondary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Cancel</button>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="6" class="px-4 py-6 text-center text-sm text-gray-500">No open hires available.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="hidden">
        <% @open_hiring_needs.each do |need| %>
          <%= form_tag admin_ta_hiring_need_path(need), method: :patch, id: "ta-hiring-form-#{need.id}" do %><% end %>
        <% end %>
        <% @filled_hiring_needs.each do |need| %>
          <%= form_tag admin_ta_hiring_need_path(need), method: :patch, id: "ta-hiring-form-#{need.id}" do %><% end %>
        <% end %>
      </div>
      <nav id="ta-hiring-open-pagination" class="hidden px-4 py-3 border-t border-gray-200 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between" aria-label="Open hires pagination">
        <span id="ta-hiring-open-pagination-info" class="text-sm text-gray-700"></span>
        <ul id="ta-hiring-open-pagination-links" class="inline-flex -space-x-px text-sm h-8"></ul>
      </nav>
    </div>

    <div id="ta-hiring-filled-panel" class="hidden">
      <div class="overflow-x-auto overflow-y-visible">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="w-[420px] px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('filled','title'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Title<span id="ta-hiring-filled-sort-icon-title" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('filled','team'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Team<span id="ta-hiring-filled-sort-icon-team" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="w-[260px] px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('filled','priority'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Priority<span id="ta-hiring-filled-sort-icon-priority" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('filled','opened'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Opened<span id="ta-hiring-filled-sort-icon-opened" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('filled','filled'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Filled<span id="ta-hiring-filled-sort-icon-filled" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide"><span role="button" tabindex="0" onclick="toggleHiringSort('filled','duration'); this.blur();" class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">Duration<span id="ta-hiring-filled-sort-icon-duration" class="sort desc icon icon-sorted-asc"></span></span></th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if @filled_hiring_needs.any? %>
              <% @filled_hiring_needs.each do |need| %>
                <% team_name = need.team&.name.presence || 'Deleted Team' %>
                <% duration_days = [((need.filled_on || Date.current) - need.created_at.to_date), 0].max.to_i %>
                <% form_id = "ta-hiring-form-#{need.id}" %>
                <% edit_team_button_id = "ta-hiring-edit-team-button-#{need.id}" %>
                <% edit_team_label_id = "ta-hiring-edit-team-label-#{need.id}" %>
                <% edit_team_list_id = "ta-hiring-edit-team-list-#{need.id}" %>
                <% edit_team_input_id = "ta-hiring-edit-team-input-#{need.id}" %>
                <% edit_title_button_id = "ta-hiring-edit-title-button-#{need.id}" %>
                <% edit_title_label_id = "ta-hiring-edit-title-label-#{need.id}" %>
                <% edit_title_list_id = "ta-hiring-edit-title-list-#{need.id}" %>
                <% edit_title_input_id = "ta-hiring-edit-title-input-#{need.id}" %>
                <% edit_priority_button_id = "ta-hiring-edit-priority-button-#{need.id}" %>
                <% edit_priority_label_id = "ta-hiring-edit-priority-label-#{need.id}" %>
                <% edit_priority_list_id = "ta-hiring-edit-priority-list-#{need.id}" %>
                <% edit_priority_input_id = "ta-hiring-edit-priority-input-#{need.id}" %>
                <tr class="ta-hiring-filled-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                    data-hiring-row-id="<%= need.id %>"
                    data-sort-title="<%= need.title.to_s.downcase %>"
                    data-sort-team="<%= team_name.to_s.downcase %>"
                    data-sort-priority="<%= need.priority == 'high' ? 3 : (need.priority == 'medium' ? 2 : 1) %>"
                    data-sort-opened="<%= need.created_at.to_i %>"
                    data-sort-filled="<%= need.filled_on ? need.filled_on.to_time.to_i : 0 %>"
                    data-sort-duration="<%= duration_days %>">
                  <td class="w-[420px] px-4 py-3 whitespace-nowrap">
                    <div class="ta-hiring-view"><span class="text-sm font-semibold text-gray-900"><%= h(need.title) %></span></div>
                    <div class="ta-hiring-edit hidden relative">
                      <input type="hidden" id="<%= edit_title_input_id %>" name="ta_hiring_need[title]" form="<%= form_id %>" value="<%= h(need.title) %>">
                      <button id="<%= edit_title_button_id %>"
                              type="button"
                              class="ts-filter-button inline-flex h-[38px] w-full items-center justify-between gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                              data-ta-hiring-inline-toggle="true"
                              data-ta-hiring-inline-target="<%= edit_title_list_id %>">
                        <span id="<%= edit_title_label_id %>" class="truncate"><%= h(need.title) %></span>
                        <span class="material-icons text-base text-gray-500">arrow_drop_down</span>
                      </button>
                      <div id="<%= edit_title_list_id %>" data-ta-hiring-inline-menu="true" class="hidden absolute left-0 top-full z-[10050] mt-1 max-h-56 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                        <% @hiring_titles.each do |hiring_title| %>
                          <% title = hiring_title.title %>
                          <button type="button"
                                  class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                                  data-ta-hiring-inline-value="<%= h(title) %>"
                                  data-ta-hiring-inline-input="<%= edit_title_input_id %>"
                                  data-ta-hiring-inline-label="<%= edit_title_label_id %>"
                                  data-ta-hiring-inline-text="<%= h(title) %>">
                            <%= h(title) %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="w-[260px] px-4 py-3 whitespace-nowrap">
                    <div class="ta-hiring-view text-gray-600"><%= h(team_name) %></div>
                    <div class="ta-hiring-edit hidden relative">
                      <input type="hidden" id="<%= edit_team_input_id %>" name="ta_hiring_need[team_id]" form="<%= form_id %>" value="<%= need.team_id %>">
                      <button id="<%= edit_team_button_id %>"
                              type="button"
                              class="ts-filter-button inline-flex h-[38px] w-full items-center justify-between gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                              data-ta-hiring-inline-toggle="true"
                              data-ta-hiring-inline-target="<%= edit_team_list_id %>">
                        <span id="<%= edit_team_label_id %>" class="truncate"><%= h(team_name) %></span>
                        <span class="material-icons text-base text-gray-500">arrow_drop_down</span>
                      </button>
                      <div id="<%= edit_team_list_id %>" data-ta-hiring-inline-menu="true" class="hidden absolute left-0 top-full z-[10050] mt-1 max-h-56 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                        <% @all_teams.each do |team| %>
                          <% indent = '&nbsp;&nbsp;' * team.all_ancestors.count %>
                          <button type="button"
                                  class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                                  data-ta-hiring-inline-value="<%= team.id %>"
                                  data-ta-hiring-inline-input="<%= edit_team_input_id %>"
                                  data-ta-hiring-inline-label="<%= edit_team_label_id %>"
                                  data-ta-hiring-inline-text="<%= h(team.name) %>">
                            <%= indent.html_safe %><%= h(team.name) %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="w-[220px] px-4 py-3 whitespace-nowrap">
                    <div class="ta-hiring-view">
                      <% priority_classes = need.priority == 'high' ? 'bg-red-100 text-red-700 border-red-200' : (need.priority == 'medium' ? 'bg-amber-100 text-amber-700 border-amber-200' : 'bg-green-100 text-green-700 border-green-200') %>
                      <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium <%= priority_classes %>"><%= need.priority.titleize %></span>
                    </div>
                    <div class="ta-hiring-edit hidden relative">
                      <input type="hidden" id="<%= edit_priority_input_id %>" name="ta_hiring_need[priority]" form="<%= form_id %>" value="<%= need.priority %>">
                      <button id="<%= edit_priority_button_id %>"
                              type="button"
                              class="ts-filter-button inline-flex h-[38px] w-full items-center justify-between gap-2 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700"
                              data-ta-hiring-inline-toggle="true"
                              data-ta-hiring-inline-target="<%= edit_priority_list_id %>">
                        <span id="<%= edit_priority_label_id %>" class="truncate"><%= need.priority.titleize %></span>
                        <span class="material-icons text-base text-gray-500">arrow_drop_down</span>
                      </button>
                      <div id="<%= edit_priority_list_id %>" data-ta-hiring-inline-menu="true" class="hidden absolute left-0 top-full z-[10050] mt-1 w-full overflow-auto rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                        <% TaHiringNeed::PRIORITIES.each do |priority| %>
                          <button type="button"
                                  class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                                  data-ta-hiring-inline-value="<%= priority %>"
                                  data-ta-hiring-inline-input="<%= edit_priority_input_id %>"
                                  data-ta-hiring-inline-label="<%= edit_priority_label_id %>"
                                  data-ta-hiring-inline-text="<%= priority.titleize %>">
                            <%= priority.titleize %>
                          </button>
                        <% end %>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-gray-600"><%= format_date(need.created_at.to_date) %></td>
                  <td class="px-4 py-3 text-gray-600"><%= need.filled_on ? format_date(need.filled_on) : '—' %></td>
                  <td class="px-4 py-3 text-gray-700"><%= duration_days %>d</td>
                  <td class="px-4 py-3 text-right">
                    <div class="ta-hiring-view inline-flex items-center justify-end gap-1">
                      <%= button_to mark_open_admin_ta_hiring_need_path(need), method: :patch, class: 'ta-inline-icon-btn ta-inline-icon-btn--success', form_class: 'inline', title: 'Mark open' do %>
                        <span class="material-icons ta-inline-material-icon">undo</span>
                      <% end %>
                      <button type="button" onclick="toggleHiringInlineEdit(<%= need.id %>)" class="ta-inline-icon-btn" title="Edit">
                        <span class="material-icons ta-inline-material-icon">edit</span>
                      </button>
                      <button type="button" onclick="hiringDelete('<%= admin_ta_hiring_need_path(need) %>', '<%= form_authenticity_token %>')" class="ta-inline-icon-btn ta-inline-icon-btn--danger" title="Delete">
                        <span class="material-icons ta-inline-material-icon">delete</span>
                      </button>
                    </div>
                    <div class="ta-hiring-edit hidden inline-flex items-center justify-end gap-2">
                      <button type="submit" form="<%= form_id %>" class="ta-btn-save-primary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Save</button>
                      <button type="button" onclick="toggleHiringInlineEdit(<%= need.id %>)" class="ta-btn-secondary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Cancel</button>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="7" class="px-4 py-6 text-center text-sm text-gray-500">No filled hires available.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <nav id="ta-hiring-filled-pagination" class="hidden px-4 py-3 border-t border-gray-200 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between" aria-label="Filled hires pagination">
        <span id="ta-hiring-filled-pagination-info" class="text-sm text-gray-700"></span>
        <ul id="ta-hiring-filled-pagination-links" class="inline-flex -space-x-px text-sm h-8"></ul>
      </nav>
    </div>
  </div>
</div>

