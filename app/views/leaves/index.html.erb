          '</tr>';
          html += '<tr id="leaves-edit-row-' + record.id + '" data-leaves-edit-row="' + record.id + '" data-original-leave-date="' + leaveDateValue + '" data-original-leave-fraction="' + leaveFractionValue + '" class="hidden border-b border-blue-100 bg-blue-50">' +
            '<td colspan="6" class="px-4 py-4">' +
              '<div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">' +
                '<div class="flex flex-col gap-4 sm:flex-row sm:items-end">' +
                  '<div class="w-full sm:w-48">' +
                    '<label class="mb-1 block text-sm font-medium text-gray-700"><%= j l(:label_date) %></label>' +
                    '<input type="text" value="' + leaveDateValue + '" data-leaves-date-input="' + record.id + '" datepicker datepicker-format="mm/dd/yyyy" datepicker-show-on-focus="false" datepicker-autohide="true" placeholder="Select date" class="tep-field ta-date-input block h-[43px] w-full min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm placeholder:text-gray-400 focus:outline-none focus:ring-0 focus:border-[#3b82f6]">' +
                  '</div>' +
                  '<div class="relative w-full sm:w-40" id="leaves-fraction-wrapper-' + record.id + '">' +
                    '<label class="mb-1 block text-sm font-medium text-gray-700"><%= j l(:label_total) %></label>' +
                    '<button type="button" class="tep-field flex h-[40px] items-center justify-between gap-2 text-sm px-3 py-0 !border !border-gray-300 !rounded-lg !bg-white w-full text-left whitespace-nowrap !outline-none !shadow-none !ring-0" data-leaves-fraction-toggle="' + record.id + '">' +
                      '<span data-leaves-fraction-label="' + record.id + '" class="text-gray-700 truncate flex-1">' + leaveFractionValue + '</span>' +
                      '<svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">' +
                        '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>' +
                      '</svg>' +
                    '</button>' +
                    '<input type="hidden" value="' + leaveFractionValue + '" data-leaves-fraction-input="' + record.id + '">' +
                    '<div id="leaves-fraction-menu-' + record.id + '" data-leaves-fraction-menu="' + record.id + '" class="tep-activity-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto" style="min-width: 128px; max-height: 360px; top: calc(100% + 2px);">' +
                      '<button type="button" class="tep-activity-option tep-entry-act-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900' + (leaveFractionValue === '0.5' ? ' !font-semibold !bg-blue-50' : '') + '" data-leaves-fraction-option="' + record.id + '" data-fraction-value="0.5" data-fraction-label="0.5">0.5</button>' +
                      '<button type="button" class="tep-activity-option tep-entry-act-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900' + (leaveFractionValue === '1' ? ' !font-semibold !bg-blue-50' : '') + '" data-leaves-fraction-option="' + record.id + '" data-fraction-value="1" data-fraction-label="1">1</button>' +
                    '</div>' +
                  '</div>' +
                  '<div class="rounded-lg border border-blue-100 bg-blue-100/60 px-3 py-2 text-sm text-blue-800">' +
                    '<span class="font-medium"><%= j l(:label_leave_type) %>:</span> ' +
                    '<span data-leaves-type-preview="' + record.id + '">' + (record.leave_type || leaveTypeForFraction(record.leave_fraction)) + '</span>' +
                  '</div>' +
                '</div>' +
                '<div class="flex items-center gap-2">' +
                  '<button type="button" class="inline-flex items-center rounded-lg bg-[#3b82f6] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#2563eb]" data-leaves-save-id="' + record.id + '"><%= j l(:button_save) %></button>' +
                  '<button type="button" class="tep-entry-cancel-btn px-4 py-2 text-sm font-medium !text-gray-600 !bg-white rounded-lg" data-leaves-cancel-id="' + record.id + '">Cancel</button>' +
                '</div>' +
              '</div>' +
            '</td>' +
          '</tr>';
        });
      }

      elements.dailyBody.innerHTML = html;
      renderPagination(
        elements.dailyPagination,
        elements.dailyLinks,
        elements.dailyInfo,
        page.currentPage,
        page.totalPages,
        filtered.length,
        page.startIndex,
        page.endIndex,
        function (nextPage) {
          state.dailyPage = nextPage;
          renderDailyRows();
        }
      );
    }

    function renderSummaryRows() {
      var query = normalize(elements.search.value);
      var filtered = state.summaryRecords.filter(function (record) { return matchesSearch({ user_name: record.user_name }, query); });
      filtered.sort(function (a, b) { return compareRecords(a, b, state.summarySort, state.summaryDirection); });

      var page = paginate(filtered, state.summaryPage, state.perPage);
      state.summaryPage = page.currentPage;

      var html = '';
      if (!page.items.length) {
        html = '<tr><td colspan="2" class="px-4 py-8 text-center text-gray-500"><%= j l(:label_no_data) %></td></tr>';
      } else {
        page.items.forEach(function (record) {
          html += '<tr class="border-b border-gray-100 transition-colors hover:bg-gray-50">' +
            '<td class="px-4 py-3 text-gray-700">' + record.user_name + '</td>' +
            '<td class="px-4 py-3 text-right font-medium text-gray-900">' + formatNumber(record.total_leave_days) + '</td>' +
          '</tr>';
        });
      }

      elements.summaryBody.innerHTML = html;
      renderPagination(
        elements.summaryPagination,
        elements.summaryLinks,
        elements.summaryInfo,
        page.currentPage,
        page.totalPages,
        filtered.length,
        page.startIndex,
        page.endIndex,
        function (nextPage) {
          state.summaryPage = nextPage;
          renderSummaryRows();
        }
      );
    }

    function renderTables() {
      updateSortIndicators();
      renderDailyRows();
      renderSummaryRows();
    }

    function flattenDailyGroups(groups) {
      var rows = [];
      (groups || []).forEach(function (group) {
        (group.records || []).forEach(function (record) {
          rows.push(record);
        });
      });
      return rows;
    }

    function updateHistory() {
      var params = new URLSearchParams();
      if (elements.from.value) params.set('from', elements.from.value);
      if (elements.to.value) params.set('to', elements.to.value);
      if (elements.userInput.value) params.set('user_id', elements.userInput.value);
      if (elements.statusInput.value) params.set('status', elements.statusInput.value);
      var query = params.toString();
      var url = window.location.pathname + (query ? '?' + query : '');
      window.history.replaceState({}, '', url);
    }

    function loadData() {
      var params = new URLSearchParams({
        from: elements.from.value,
        to: elements.to.value,
        user_id: elements.userInput.value,
        status: elements.statusInput.value
      });

      return fetch('<%= leaves_data_path %>?' + params.toString(), { headers: { Accept: 'application/json' } })
        .then(function (response) { return response.json(); })
        .then(function (payload) {
          if (payload.error) throw new Error(payload.error);
          state.dailyRecords = flattenDailyGroups(payload.daily_groups || []);
          state.summaryRecords = payload.user_summary || [];
          state.dailyPage = 1;
          state.summaryPage = 1;
          updateHistory();
          renderTables();
          document.getElementById('leaves-card-overall').textContent = formatNumber((payload.totals && payload.totals.overall_leave_days) || 0);
          document.getElementById('leaves-card-users').textContent = formatNumber((payload.totals && payload.totals.users_with_leave) || 0);
          document.getElementById('leaves-card-flagged').textContent = formatNumber((payload.totals && payload.totals.flagged_records) || 0);
          document.getElementById('leaves-card-records').textContent = formatNumber((payload.totals && payload.totals.total_records) || 0);
        })
        .catch(function (error) {
          elements.dailyBody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-red-600">' + error.message + '</td></tr>';
          elements.summaryBody.innerHTML = '<tr><td colspan="2" class="px-4 py-8 text-center text-red-600">' + error.message + '</td></tr>';
        });
    }

    function hideDatePickers() {
      [elements.from, elements.to].forEach(function (input) {
        if (!input) return;
        if (input.datepicker && typeof input.datepicker.hide === 'function') {
          input.datepicker.hide();
        }
        input.blur();
      });
    }

    function deferHideDatePickers() {
      window.setTimeout(hideDatePickers, 0);
      window.setTimeout(hideDatePickers, 120);
    }

    function statusBadge(status) {
      if (status === 'confirmed') {
        return '<span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Confirmed</span>';
      }
      return '<span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Flagged</span>';
    }

    function leaveTypeForFraction(fraction) {
      var value = Number(fraction) || 0;
      if (value >= 1) return 'Full Day';
      if (value >= 0.5) return 'Half Day';
      return 'Unknown';
    }

    function formatLeaveDateForInput(value) {
      var text = String(value || '');
      if (!text) return '';
      if (text.indexOf('/') !== -1) return text;
      var parts = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (parts) return parts[2] + '/' + parts[3] + '/' + parts[1];
      return text;
    }

    function leaveFractionLabel(fraction) {
      return Number(fraction) >= 1 ? '1' : '0.5';
    }

    function closeFractionDropdowns(exceptId) {
      document.querySelectorAll('[data-leaves-fraction-menu]').forEach(function (menu) {
        if (exceptId && menu.getAttribute('data-leaves-fraction-menu') === String(exceptId)) return;
        menu.classList.add('hidden');
      });
    }

    function syncFractionLabel(recordId, fraction) {
      var label = document.querySelector('[data-leaves-fraction-label="' + recordId + '"]');
      var typeCell = document.getElementById('leaves-type-value-' + recordId);
      var typePreview = document.querySelector('[data-leaves-type-preview="' + recordId + '"]');
      var leaveType = leaveTypeForFraction(fraction);

      if (label) label.textContent = leaveFractionLabel(fraction);
      if (typeCell) typeCell.textContent = leaveType;
      if (typePreview) typePreview.textContent = leaveType;
    }

    function toggleFractionDropdown(recordId) {
      var menu = document.getElementById('leaves-fraction-menu-' + recordId);
      if (!menu) return;
      var shouldOpen = menu.classList.contains('hidden');
      closeFractionDropdowns(recordId);
      menu.classList.toggle('hidden', !shouldOpen);
    }

    function selectFraction(recordId, fraction) {
      var input = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      if (input) input.value = fraction;
      syncFractionLabel(recordId, fraction);
      closeFractionDropdowns();
    }

    function initLeavesEditDatepicker(recordId) {
      var input = document.querySelector('[data-leaves-date-input="' + recordId + '"]');
      if (!input) return;
      var picker = input.datepicker || input._leavesDatepicker || null;

      if (picker && picker.setOptions) {
          picker.setOptions({
          todayHighlight: true,
          showOnFocus: false,
          showOnClick: true,
          autohide: true
        });
      } else if (window.Datepicker && !input._leavesDatepicker) {
        input._leavesDatepicker = new window.Datepicker(input, {
          format: 'mm/dd/yyyy',
          autohide: true,
          showOnFocus: false,
          showOnClick: true
        });
        picker = input.datepicker || input._leavesDatepicker;
      }

      if (!input.dataset.leavesDatepickerBound) {
        input.addEventListener('keydown', function (event) {
          var activePicker = input.datepicker || input._leavesDatepicker;
          if (event.key === 'Escape' && activePicker && activePicker.hide) {
            activePicker.hide();
            input.blur();
          }
        });
        input.dataset.leavesDatepickerBound = '1';
      }
    }

    function closeAllEditRows(exceptId) {
      document.querySelectorAll('[data-leaves-edit-row]').forEach(function (row) {
        if (exceptId && row.getAttribute('data-leaves-edit-row') === String(exceptId)) return;
        resetRowPreview(row.getAttribute('data-leaves-edit-row'));
        row.classList.add('hidden');
      });
    }

    function resetRowPreview(recordId) {
      if (!recordId) return;
      var row = document.querySelector('[data-leaves-edit-row="' + recordId + '"]');
      if (!row) return;

      var originalDate = row.getAttribute('data-original-leave-date') || '';
      var originalFraction = row.getAttribute('data-original-leave-fraction') || '';
      var dateCell = document.getElementById('leaves-date-value-' + recordId);
      var fractionCell = document.getElementById('leaves-fraction-value-' + recordId);
      var typeCell = document.getElementById('leaves-type-value-' + recordId);
      var typePreview = document.querySelector('[data-leaves-type-preview="' + recordId + '"]');
      var fractionInput = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      var fractionLabel = document.querySelector('[data-leaves-fraction-label="' + recordId + '"]');
      var fractionValue = originalFraction || '0';
      var leaveType = leaveTypeForFraction(fractionValue);

      if (dateCell && originalDate) {
        dateCell.textContent = originalDate;
      }
      if (fractionCell && originalFraction) {
        fractionCell.textContent = formatNumber(originalFraction);
      }
      if (fractionInput && originalFraction) {
        fractionInput.value = originalFraction;
      }
      if (fractionLabel && originalFraction) {
        fractionLabel.textContent = originalFraction;
      }
      if (typeCell) {
        typeCell.textContent = leaveType;
      }
      if (typePreview) {
        typePreview.textContent = leaveType;
      }
    }

    function updateRowPreview(recordId) {
      var dateInput = document.querySelector('[data-leaves-date-input="' + recordId + '"]');
      var fractionSelect = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      var dateCell = document.getElementById('leaves-date-value-' + recordId);
      var fractionCell = document.getElementById('leaves-fraction-value-' + recordId);
      if (!fractionSelect || !dateInput) return;

      var leaveFraction = Number(fractionSelect.value) || 0;
      var leaveDate = dateInput.value || '';
      if (dateCell && leaveDate) {
        dateCell.textContent = leaveDate;
      }
      if (fractionCell) {
        fractionCell.textContent = formatNumber(leaveFraction);
      }
      syncFractionLabel(recordId, leaveFraction);
    }

    function toggleEditRow(recordId) {
      var row = document.getElementById('leaves-edit-row-' + recordId);
      if (!row) return;
      if (row.classList.contains('hidden')) {
        closeAllEditRows(recordId);
        closeFractionDropdowns(recordId);
        row.classList.remove('hidden');
        initLeavesEditDatepicker(recordId);
        return;
      }

      resetRowPreview(recordId);
      row.classList.add('hidden');
      closeFractionDropdowns();
    }

    function saveEditRow(recordId) {
      var dateInput = document.querySelector('[data-leaves-date-input="' + recordId + '"]');
      var fractionSelect = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      if (!dateInput || !fractionSelect) return;

      fetch('/leaves/' + recordId, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json'
        },
        body: JSON.stringify({
          leave_date: dateInput.value,
          leave_fraction: fractionSelect.value
        })
      }).then(function (response) { return response.json(); })
        .then(function (payload) {
          if (payload.error) throw new Error(payload.error);
          loadData();
        })
        .catch(function (error) { alert(error.message); });
    }

    function setUserFilter(userId, userLabel) {
      elements.userInput.value = userId || '';
      elements.userLabel.textContent = selectedText(userLabel, '<%= j l(:label_all_users) %>');
      syncDropdownActiveState('leaves-user-dropdown', 'data-user-id', elements.userInput.value);
      closeDropdowns();
      loadData();
    }

    function setStatusFilter(status, statusLabel) {
      elements.statusInput.value = status || '';
      elements.statusLabel.textContent = selectedText(statusLabel, '<%= j l(:label_all_statuses) %>');
      syncDropdownActiveState('leaves-status-dropdown', 'data-status', elements.statusInput.value);
      closeDropdowns();
      loadData();
    }

    function setPerPage(value) {
      state.perPage = parseInt(value, 10) || 10;
      elements.perPageLabel.textContent = String(state.perPage);
      syncDropdownActiveState('leaves-per-page-dropdown', 'data-per-page', String(state.perPage));
      closeDropdowns();
      state.dailyPage = 1;
      state.summaryPage = 1;
      renderTables();
    }

    function handleSortClick(event) {
      var button = event.currentTarget;
      var table = button.getAttribute('data-table-sort');
      var sortKey = button.getAttribute('data-sort-key');
      if (state[table + 'Sort'] === sortKey) {
        state[table + 'Direction'] = state[table + 'Direction'] === 'asc' ? 'desc' : 'asc';
      } else {
        state[table + 'Sort'] = sortKey;
        state[table + 'Direction'] = 'asc';
      }
      renderTables();
    }

    elements.dailyTab.addEventListener('click', function () { setTab('daily'); });
    elements.summaryTab.addEventListener('click', function () { setTab('summary'); });
    elements.userButton.addEventListener('click', function () { toggleDropdown('leaves-user-dropdown'); });
    elements.statusButton.addEventListener('click', function () { toggleDropdown('leaves-status-dropdown'); });
    elements.perPageButton.addEventListener('click', function () { toggleDropdown('leaves-per-page-dropdown'); });
    elements.userButton.addEventListener('keydown', function (event) { handleDropdownButtonKeydown(event, 'leaves-user-dropdown', 'data-user-label'); });
    elements.statusButton.addEventListener('keydown', function (event) { handleDropdownButtonKeydown(event, 'leaves-status-dropdown', 'data-status-label'); });
    elements.perPageButton.addEventListener('keydown', function (event) { handleDropdownButtonKeydown(event, 'leaves-per-page-dropdown', 'data-per-page'); });

    bindDropdownKeyboard('leaves-user-dropdown', 'data-user-label', function (button) {
      setUserFilter(button.getAttribute('data-user-id'), button.getAttribute('data-user-label'));
    });
    bindDropdownKeyboard('leaves-status-dropdown', 'data-status-label', function (button) {
      setStatusFilter(button.getAttribute('data-status'), button.getAttribute('data-status-label'));
    });
    bindDropdownKeyboard('leaves-per-page-dropdown', 'data-per-page', function (button) {
      setPerPage(button.getAttribute('data-per-page'));
    });

    document.querySelectorAll('[data-table-sort]').forEach(function (button) {
      button.addEventListener('click', handleSortClick);
    });

    function bindDateAutoReload(input) {
      input.addEventListener('change', scheduleLoadData);
      input.addEventListener('changeDate', function () {
        scheduleLoadData();
        hideDatePickers();
      });
    }

    bindDateAutoReload(elements.from);
    bindDateAutoReload(elements.to);

    window.addEventListener('pageshow', deferHideDatePickers);

    elements.search.addEventListener('input', function () {
      state.dailyPage = 1;
      state.summaryPage = 1;
      renderTables();
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('#leaves-user-dropdown-button') && !event.target.closest('#leaves-user-dropdown') &&
          !event.target.closest('#leaves-status-dropdown-button') && !event.target.closest('#leaves-status-dropdown') &&
          !event.target.closest('#leaves-per-page-dropdown-button') && !event.target.closest('#leaves-per-page-dropdown')) {
        closeDropdowns();
      }
      if (!event.target.closest('[data-leaves-fraction-toggle]') &&
          !event.target.closest('[data-leaves-fraction-menu]')) {
        closeFractionDropdowns();
      }
    });

    document.getElementById('leaves-daily-tbody').addEventListener('click', function (event) {
      var editButton = event.target.closest('[data-edit-id]');
      var fractionToggle = event.target.closest('[data-leaves-fraction-toggle]');
      var fractionOption = event.target.closest('[data-leaves-fraction-option]');
      var unflagButton = event.target.closest('[data-unflag-id]');
      var deleteButton = event.target.closest('[data-delete-id]');
      var saveButton = event.target.closest('[data-leaves-save-id]');
      var cancelButton = event.target.closest('[data-leaves-cancel-id]');

      if (editButton) {
        toggleEditRow(editButton.getAttribute('data-edit-id'));
      }
      if (fractionToggle) {
        toggleFractionDropdown(fractionToggle.getAttribute('data-leaves-fraction-toggle'));
      }
      if (fractionOption) {
        selectFraction(
          fractionOption.getAttribute('data-leaves-fraction-option'),
          fractionOption.getAttribute('data-fraction-value')
        );
      }
      if (unflagButton) {
        fetch('/leaves/' + unflagButton.getAttribute('data-unflag-id') + '/status', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            Accept: 'application/json'
          },
          body: JSON.stringify({ status: 'confirmed' })
        }).then(function (response) { return response.json(); })
          .then(function (payload) {
            if (payload.error) throw new Error(payload.error);
            loadData();
          })
          .catch(function (error) { alert(error.message); });
      }
      if (deleteButton) {
        openDeleteModal(deleteButton.getAttribute('data-delete-id'));
      }
      if (saveButton) {
        saveEditRow(saveButton.getAttribute('data-leaves-save-id'));
      }
      if (cancelButton) {
        resetRowPreview(cancelButton.getAttribute('data-leaves-cancel-id'));
        var cancelRow = document.getElementById('leaves-edit-row-' + cancelButton.getAttribute('data-leaves-cancel-id'));
        if (cancelRow) cancelRow.classList.add('hidden');
        closeFractionDropdowns();
      }
    });

    document.getElementById('leaves-daily-tbody').addEventListener('change', function (event) {
      var fractionInput = event.target.closest('[data-leaves-fraction-input]');
      var dateInput = event.target.closest('[data-leaves-date-input]');
      var recordId = null;
      if (fractionInput) {
        recordId = fractionInput.getAttribute('data-leaves-fraction-input');
      } else if (dateInput) {
        recordId = dateInput.getAttribute('data-leaves-date-input');
      }
      if (!recordId) return;
      updateRowPreview(recordId);
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('[data-leaves-fraction-toggle]') &&
          !event.target.closest('[data-leaves-fraction-menu]')) {
        closeFractionDropdowns();
      }
    });

    var deleteConfirmButton = document.getElementById('leaves-delete-confirm');
    var deleteCancelButton = document.getElementById('leaves-delete-cancel');
    var deleteCloseButtons = document.querySelectorAll('[data-modal-hide="leaves-delete-modal"]');
    if (deleteConfirmButton) deleteConfirmButton.addEventListener('click', confirmDelete);
    if (deleteCancelButton) deleteCancelButton.addEventListener('click', closeDeleteModal);
    deleteCloseButtons.forEach(function (button) {
      button.addEventListener('click', closeDeleteModal);
    });

    elements.from.value = initialFilters.from;
    elements.to.value = initialFilters.to;
    elements.userInput.value = initialFilters.user_id;
    elements.statusInput.value = initialFilters.status;
    elements.userLabel.textContent = initialFilters.user_id ? elements.userLabel.textContent : '<%= j l(:label_all_users) %>';
    elements.statusLabel.textContent = initialFilters.status === 'confirmed' ? '<%= j l(:label_confirmed) %>' : (initialFilters.status === 'flagged' ? '<%= j l(:label_flagged) %>' : '<%= j l(:label_all_statuses) %>');
    elements.perPageLabel.textContent = String(state.perPage);
    syncDropdownActiveState('leaves-user-dropdown', 'data-user-id', elements.userInput.value);
    syncDropdownActiveState('leaves-status-dropdown', 'data-status', elements.statusInput.value);
    syncDropdownActiveState('leaves-per-page-dropdown', 'data-per-page', String(state.perPage));
    updateSortIndicators();
    setTab('daily');
    deferHideDatePickers();
    loadData();
  });
</script>
