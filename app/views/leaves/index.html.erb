              '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4h2M4 20h16M6 16l10.5-10.5a1.5 1.5 0 112.12 2.12L8.12 18.12 4 20l1.88-4.12z"></path></svg>' +
