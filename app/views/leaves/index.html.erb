              '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>' +
            '</button>' +
            '<button type="button" title="<%= j l(:button_delete) %>" class="leaves-entry-icon-btn leaves-entry-icon-btn--delete inline-flex h-8 w-8 items-center justify-center" data-delete-id="' + record.id + '">' +
              '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16"></path></svg>' +
            '</button>';
          } else if (record.status === 'flagged') {
            actionHtml += '<button type="button" title="<%= j l(:button_delete) %>" class="leaves-entry-icon-btn leaves-entry-icon-btn--delete inline-flex h-8 w-8 items-center justify-center" data-delete-id="' + record.id + '">' +
              '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3M4 7h16"></path></svg>' +
            '</button>' +
            '<span class="text-xs text-amber-700"><%= j l(:text_unmapped_sender_cannot_unflag) %></span>';
          }
          actionHtml += '</div>';

          html += '<tr class="border-b border-gray-100 transition-colors hover:bg-gray-50" data-leaves-row="' + record.id + '">' +
            '<td id="leaves-date-value-' + record.id + '" class="px-4 py-3 whitespace-nowrap text-gray-900">' + leaveDateValue + '</td>' +
            '<td class="px-4 py-3 text-gray-700">' + (record.user_name || '') + '</td>' +
            '<td id="leaves-type-value-' + record.id + '" class="px-4 py-3 text-gray-700">' + (record.leave_type || leaveTypeForFraction(record.leave_fraction)) + '</td>' +
            '<td id="leaves-fraction-value-' + record.id + '" class="px-4 py-3 text-right font-medium text-gray-900">' + formatNumber(record.leave_fraction) + '</td>' +
            '<td class="px-4 py-3">' + statusBadge(record.status) + '</td>' +
