    // Month columns for the Summary-by-User pivot, taken from the current month-bar selection.
    function summaryMonthKeys() {
      return sortedSelectedMonths().map(function (monthIndex) {
        return {
          index: monthIndex,
          key: monthState.year + '-' + String(monthIndex + 1).padStart(2, '0'),
          label: monthLabels[monthIndex] + ' ' + monthState.year
        };
      });
    }

    // Aggregate confirmed leave records into a user × month/date pivot.
    // Each user keeps per-month totals (+ their dates) and per-date totals, so the same
    // structure drives both the multi-month and the single-month (date columns) layouts.
    function buildSummaryPivot(query) {
      var monthCols = summaryMonthKeys();
      var singleMonth = monthCols.length === 1;
      var users = {};

      state.dailyRecords.forEach(function (record) {
        if (record.status !== 'confirmed') return;
        if (record.user_id === null || record.user_id === undefined || record.user_id === '') return;
        var fraction = Number(record.leave_fraction) || 0;
        if (fraction <= 0) return;
        var name = record.user_name || '';
        if (query && name.toLowerCase().indexOf(query) === -1) return;

        var iso = formatLeaveDateForDisplay(record.leave_date);
        var monthKey = iso.slice(0, 7);
        var user = users[name] || (users[name] = { name: name, byMonth: {}, byDate: {}, total: 0 });
        user.total += fraction;
        user.byDate[iso] = (user.byDate[iso] || 0) + fraction;
        var bucket = user.byMonth[monthKey] || (user.byMonth[monthKey] = { total: 0 });
        bucket.total += fraction;
      });

      var userList = Object.keys(users).map(function (name) { return users[name]; });
      userList.sort(function (a, b) { return (b.total - a.total) || a.name.localeCompare(b.name); });

      var dateCols = [];
      if (singleMonth) {
        var dateSet = {};
        userList.forEach(function (user) {
          Object.keys(user.byDate).forEach(function (date) { dateSet[date] = true; });
        });
        dateCols = Object.keys(dateSet).sort();
      }

      return { monthCols: monthCols, dateCols: dateCols, singleMonth: singleMonth, users: userList };
    }

    function summaryInfoButton(userName, monthKey, monthLabel) {
      return ' <button type="button" class="leaves-cell-info-btn" title="<%= j l(:label_date) %>"' +
        ' data-summary-info-user="' + escapeHtmlAttr(userName) + '"' +
        ' data-summary-info-month="' + monthKey + '"' +
        ' data-summary-info-label="' + escapeHtmlAttr(monthLabel) + '">' +
        '<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">' +
        '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' +
        '</button>';
    }

    function escapeHtmlAttr(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Per-user value for a given summary sort key (column key, 'total', or 'user_name').
    function summarySortValue(user, sortKey, singleMonth) {
      if (sortKey === 'total') return user.total;
      if (singleMonth) return user.byDate[sortKey] || 0;
      return (user.byMonth[sortKey] || {}).total || 0;
    }

    // A sortable column header button styled like the Daily Leaves headers.
    function summarySortHeader(sortKey, label) {
      return '<button type="button" class="inline-flex items-center gap-1 text-[0.95rem] font-semibold text-gray-700 transition-colors hover:text-gray-900 focus:outline-none focus:ring-0" data-table-sort="summary" data-sort-key="' + escapeHtmlAttr(sortKey) + '" data-sort-label="' + escapeHtmlAttr(label) + '">' +
        '<span>' + escapeHtmlAttr(label) + '</span>' +
        '<span class="leaves-sort-indicator text-[10px] text-gray-400"></span>' +
        '</button>';
    }

    function renderSummaryRows() {
      var query = normalize(elements.search.value);
      var pivot = buildSummaryPivot(query);
      var columns = pivot.singleMonth
        ? pivot.dateCols.map(function (date) { return { key: date, label: date }; })
        : pivot.monthCols;
      var totalColumns = columns.length + 2; // user + value columns + total

      // Keep the active sort key valid as the column set changes (e.g. month bar edits).
      var validKeys = ['user_name', 'total'].concat(columns.map(function (column) { return column.key; }));
      if (validKeys.indexOf(state.summarySort) === -1) {
        state.summarySort = 'total';
        state.summaryDirection = 'desc';
      }

      // Sort users by the active column/direction (numeric columns tiebreak by name asc).
      var direction = state.summaryDirection === 'asc' ? 1 : -1;
      pivot.users.sort(function (a, b) {
        if (state.summarySort === 'user_name') {
          return a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }) * direction;
        }
        var av = summarySortValue(a, state.summarySort, pivot.singleMonth);
        var bv = summarySortValue(b, state.summarySort, pivot.singleMonth);
        if (av !== bv) return (av - bv) * direction;
        return a.name.localeCompare(b.name, undefined, { sensitivity: 'base' });
      });

      // Header
      var headerHtml = '<tr>' +
        '<th scope="col" class="px-6 py-3 border-r-2 border-gray-300">' + summarySortHeader('user_name', '<%= j l(:label_user) %>') + '</th>';
      columns.forEach(function (column) {
        headerHtml += '<th scope="col" class="px-6 py-3 text-center border-r border-gray-200">' + summarySortHeader(column.key, column.label) + '</th>';
      });
      headerHtml += '<th scope="col" class="px-6 py-3 text-right border-l-2 border-gray-300 font-bold">' + summarySortHeader('total', '<%= j l(:label_total) %>') + '</th></tr>';
      elements.summaryHead.innerHTML = headerHtml;
      updateSortIndicators();

      // Body (paginated users)
      var page = paginate(pivot.users, state.summaryPage, state.perPage);
      state.summaryPage = page.currentPage;

      var bodyHtml = '';
      if (!page.items.length) {
        bodyHtml = '<tr><td colspan="' + totalColumns + '" class="px-6 py-8 text-center text-gray-500"><%= j l(:label_no_data) %></td></tr>';
        elements.summaryFoot.innerHTML = '';
      } else {
        page.items.forEach(function (user) {
          var row = '<tr class="bg-white border-b hover:bg-gray-50 transition-colors">' +
            '<td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">' + escapeHtmlAttr(user.name) + '</td>';
          columns.forEach(function (column) {
            var value = pivot.singleMonth ? (user.byDate[column.key] || 0) : ((user.byMonth[column.key] || {}).total || 0);
            if (value > 0) {
              var info = pivot.singleMonth ? '' : summaryInfoButton(user.name, column.key, column.label);
              row += '<td class="px-6 py-4 text-center text-gray-900"><div class="inline-flex items-center justify-center gap-1"><span>' + formatNumber(value) + '</span>' + info + '</div></td>';
            } else {
              row += '<td class="px-6 py-4 text-center text-gray-400">—</td>';
            }
          });
          row += '<td class="px-6 py-4 text-right font-semibold text-gray-900">' + formatNumber(user.total) + '</td></tr>';
          bodyHtml += row;
        });

        // Footer totals across all filtered users (not just the current page)
        var columnTotals = columns.map(function (column) {
          return pivot.users.reduce(function (sum, user) {
            return sum + (pivot.singleMonth ? (user.byDate[column.key] || 0) : ((user.byMonth[column.key] || {}).total || 0));
          }, 0);
        });
        var grandTotal = pivot.users.reduce(function (sum, user) { return sum + user.total; }, 0);
        var footHtml = '<tr class="bg-gray-50"><td class="px-6 py-4 font-bold text-gray-900 whitespace-nowrap"><%= j l(:label_total) %></td>';
        columnTotals.forEach(function (total) {
          footHtml += '<td class="px-6 py-4 text-center font-bold text-gray-900">' + (total > 0 ? formatNumber(total) : '—') + '</td>';
        });
        footHtml += '<td class="px-6 py-4 text-right font-bold text-gray-900 border-l-2 border-gray-300">' + formatNumber(grandTotal) + '</td></tr>';
        elements.summaryFoot.innerHTML = footHtml;
      }

      elements.summaryBody.innerHTML = bodyHtml;
      renderPagination(
        elements.summaryPagination,
        elements.summaryLinks,
        elements.summaryInfo,
        page.currentPage,
        page.totalPages,
        pivot.users.length,
        page.startIndex,
        page.endIndex,
        function (nextPage) {
          state.summaryPage = nextPage;
          renderSummaryRows();
        }
      );
    }

    function openLeaveDatesModal(userName, monthKey, monthLabel) {
      var modal = document.getElementById('leaves-dates-modal');
      var body = document.getElementById('leaves-dates-modal-body');
      var title = document.getElementById('leaves-dates-modal-title');
      var subtitle = document.getElementById('leaves-dates-modal-subtitle');
      if (!modal || !body) return;

      var rows = state.dailyRecords.filter(function (record) {
        if (record.status !== 'confirmed') return false;
        if ((record.user_name || '') !== userName) return false;
        if ((Number(record.leave_fraction) || 0) <= 0) return false;
        return formatLeaveDateForDisplay(record.leave_date).slice(0, 7) === monthKey;
      }).map(function (record) {
        return { date: formatLeaveDateForDisplay(record.leave_date), fraction: Number(record.leave_fraction) || 0 };
      }).sort(function (a, b) { return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0); });

      if (title) title.textContent = userName;
      if (subtitle) subtitle.textContent = monthLabel;
      if (!rows.length) {
        body.innerHTML = '<tr><td colspan="2" class="px-6 py-8 text-center text-gray-500"><%= j l(:label_no_data) %></td></tr>';
      } else {
        body.innerHTML = rows.map(function (row) {
          return '<tr class="bg-white hover:bg-gray-50 transition-colors">' +
            '<td class="px-6 py-3 font-medium text-gray-900 whitespace-nowrap">' + row.date + '</td>' +
            '<td class="px-6 py-3 text-right text-gray-900">' + formatNumber(row.fraction) + '</td></tr>';
        }).join('');
      }

      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeLeaveDatesModal() {
      var modal = document.getElementById('leaves-dates-modal');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
    }

    function renderTables() {
      updateSortIndicators();
      renderDailyRows();
      renderSummaryRows();
    }

    function flattenDailyGroups(groups) {
      var rows = [];
      (groups || []).forEach(function (group) {
        (group.records || []).forEach(function (record) {
          rows.push(record);
        });
      });
      return rows;
    }

    function updateHistory() {
      var params = new URLSearchParams();
      if (elements.from.value) params.set('from', elements.from.value);
      if (elements.to.value) params.set('to', elements.to.value);
      if (elements.userInput.value) params.set('user_id', elements.userInput.value);
      if (elements.statusInput.value) params.set('status', elements.statusInput.value);
      var query = params.toString();
      var url = window.location.pathname + (query ? '?' + query : '');
      window.history.replaceState({}, '', url);
    }

    function setDeleteAllButtonState(totalRecords) {
      if (!elements.deleteAllButton) return;
      var disabled = Number(totalRecords || 0) === 0;
      elements.deleteAllButton.disabled = disabled;
      elements.deleteAllButton.classList.toggle('opacity-50', disabled);
    }

    var refreshHideTimer = null;

    function showRefreshBar() {
      var bar = document.getElementById('leaves-refresh-bar');
      var text = document.getElementById('leaves-refresh-text');
      var fill = document.getElementById('leaves-refresh-fill');
      if (!bar || !text || !fill) return;
      if (refreshHideTimer) { window.clearTimeout(refreshHideTimer); refreshHideTimer = null; }
      text.textContent = 'Refreshing…';
      text.className = 'text-xs font-medium text-blue-700';
      fill.className = 'h-full rounded-full bg-blue-600 leaves-refresh-indeterminate';
      fill.style.width = '';
      fill.style.marginLeft = '';
      bar.classList.remove('hidden');
    }

    function finishRefreshBar(startedAt, ok) {
      var bar = document.getElementById('leaves-refresh-bar');
      var text = document.getElementById('leaves-refresh-text');
      var fill = document.getElementById('leaves-refresh-fill');
      if (!bar || !text || !fill) return;
      // Keep the bar visible for a short minimum so very fast loads still register visually.
      var elapsed = Date.now() - (startedAt || Date.now());
      var delay = Math.max(0, 400 - elapsed);
      window.setTimeout(function () {
        if (ok) {
          text.textContent = 'Refreshed ✓';
          text.className = 'text-xs font-medium text-emerald-600';
          fill.className = 'h-full rounded-full bg-emerald-500';
        } else {
          text.textContent = 'Refresh failed';
          text.className = 'text-xs font-medium text-red-600';
          fill.className = 'h-full rounded-full bg-red-500';
        }
        fill.style.width = '100%';
        fill.style.marginLeft = '0';
        refreshHideTimer = window.setTimeout(function () {
          bar.classList.add('hidden');
          fill.style.width = '';
          fill.style.marginLeft = '';
        }, 1000);
      }, delay);
    }

    function loadData() {
      var params = new URLSearchParams({
        from: elements.from.value,
        to: elements.to.value,
        user_id: elements.userInput.value,
        status: elements.statusInput.value,
        months: selectedMonthsParam()
      });

      showRefreshBar();
      var refreshStartedAt = Date.now();
      var refreshOk = true;

      return fetch('<%= leaves_data_path %>?' + params.toString(), { headers: { Accept: 'application/json' } })
        .then(function (response) { return response.json(); })
        .then(function (payload) {
          if (payload.error) throw new Error(payload.error);
          state.dailyRecords = flattenDailyGroups(payload.daily_groups || []);
          state.summaryRecords = payload.user_summary || [];
          state.totalCount = (payload.totals && payload.totals.total_records) || 0;
          state.dailyPage = 1;
          state.summaryPage = 1;
          state.selectedIds.clear();
          state.selectAllPages = false;
          updateSelectionBanner();
          updateBulkDeleteButton();
          updateHistory();
          renderTables();
          document.getElementById('leaves-card-overall').textContent = formatNumber((payload.totals && payload.totals.overall_leave_days) || 0);
          document.getElementById('leaves-card-users').textContent = formatNumber((payload.totals && payload.totals.users_with_leave) || 0);
          document.getElementById('leaves-card-flagged').textContent = formatNumber((payload.totals && payload.totals.flagged_records) || 0);
          document.getElementById('leaves-card-records').textContent = formatNumber(state.totalCount);
          setDeleteAllButtonState(state.totalCount);
        })
        .catch(function (error) {
          refreshOk = false;
          elements.dailyBody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-red-600">' + error.message + '</td></tr>';
          elements.summaryBody.innerHTML = '<tr><td colspan="2" class="px-4 py-8 text-center text-red-600">' + error.message + '</td></tr>';
        })
        .then(function () {
          finishRefreshBar(refreshStartedAt, refreshOk);
        });
    }

    function hideDatePickers() {
      [elements.from, elements.to].forEach(function (input) {
        if (!input) return;
        if (input.datepicker && typeof input.datepicker.hide === 'function') {
          input.datepicker.hide();
        }
        input.blur();
      });
    }

    function deferHideDatePickers() {
      window.setTimeout(hideDatePickers, 0);
      window.setTimeout(hideDatePickers, 120);
    }

    function statusBadge(status, flaggedReason, aiAnalyzed) {
      if (status === 'confirmed') {
        return '<div><span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Confirmed</span></div>';
      }
      var reasonHtml = flaggedReason ? '<div class="mt-1 text-xs text-amber-700">' + flaggedReason + '</div>' : '';
      return '<div><span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-700">Flagged</span>' + reasonHtml + '</div>';
    }

    function formatLeaveDateForInput(value) {
      var text = String(value || '');
      if (!text) return '';
      if (text.indexOf('/') !== -1) return text;
      var parts = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (parts) return parts[2] + '/' + parts[3] + '/' + parts[1];
      return text;
    }

    // Display format for the table: YYYY-MM-DD. Server already sends ISO dates;
    // convert any MM/DD/YYYY value defensively.
    function formatLeaveDateForDisplay(value) {
      var text = String(value || '');
      if (!text) return '';
      var iso = text.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (iso) return text;
      var us = text.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
      if (us) return us[3] + '-' + us[1] + '-' + us[2];
      return text;
    }

    function leaveFractionLabel(fraction) {
      return Number(fraction) >= 1 ? '1' : '0.5';
    }

    function closeFractionDropdowns(exceptId) {
      document.querySelectorAll('[data-leaves-fraction-menu]').forEach(function (menu) {
        if (exceptId && menu.getAttribute('data-leaves-fraction-menu') === String(exceptId)) return;
        menu.classList.add('hidden');
      });
    }

    function syncFractionLabel(recordId, fraction) {
      var label = document.querySelector('[data-leaves-fraction-label="' + recordId + '"]');

      if (label) label.textContent = leaveFractionLabel(fraction);
    }

    function toggleFractionDropdown(recordId) {
      var menu = document.getElementById('leaves-fraction-menu-' + recordId);
      if (!menu) return;
      var shouldOpen = menu.classList.contains('hidden');
      closeFractionDropdowns(recordId);
      menu.classList.toggle('hidden', !shouldOpen);
    }

    function selectFraction(recordId, fraction) {
      var input = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      if (input) input.value = fraction;
      syncFractionLabel(recordId, fraction);
      closeFractionDropdowns();
    }

    function initLeavesEditDatepicker(recordId) {
      var input = document.querySelector('[data-leaves-date-input="' + recordId + '"]');
      if (!input) return;
      var picker = input.datepicker || input._leavesDatepicker || null;

      if (picker && picker.setOptions) {
          picker.setOptions({
          todayHighlight: true,
          showOnFocus: false,
          showOnClick: true,
          autohide: true
        });
      } else if (window.Datepicker && !input._leavesDatepicker) {
        input._leavesDatepicker = new window.Datepicker(input, {
          format: 'mm/dd/yyyy',
          autohide: true,
          showOnFocus: false,
          showOnClick: true
        });
        picker = input.datepicker || input._leavesDatepicker;
      }

      if (!input.dataset.leavesDatepickerBound) {
        input.addEventListener('keydown', function (event) {
          var activePicker = input.datepicker || input._leavesDatepicker;
          if (event.key === 'Escape' && activePicker && activePicker.hide) {
            activePicker.hide();
            input.blur();
          }
        });
        input.dataset.leavesDatepickerBound = '1';
      }
    }

    function closeAllEditRows(exceptId) {
      document.querySelectorAll('[data-leaves-edit-row]').forEach(function (row) {
        if (exceptId && row.getAttribute('data-leaves-edit-row') === String(exceptId)) return;
        resetRowPreview(row.getAttribute('data-leaves-edit-row'));
        row.classList.add('hidden');
      });
    }

    function resetRowPreview(recordId) {
      if (!recordId) return;
      var row = document.querySelector('[data-leaves-edit-row="' + recordId + '"]');
      if (!row) return;

      var originalDate = row.getAttribute('data-original-leave-date') || '';
      var originalFraction = row.getAttribute('data-original-leave-fraction') || '';
      var dateCell = document.getElementById('leaves-date-value-' + recordId);
      var fractionCell = document.getElementById('leaves-fraction-value-' + recordId);
      var fractionInput = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      var fractionLabel = document.querySelector('[data-leaves-fraction-label="' + recordId + '"]');
      var fractionValue = originalFraction || '0';

      if (dateCell && originalDate) {
        dateCell.textContent = originalDate;
      }
      if (fractionCell && originalFraction) {
        fractionCell.textContent = formatNumber(originalFraction);
      }
      if (fractionInput && originalFraction) {
        fractionInput.value = originalFraction;
      }
      if (fractionLabel && originalFraction) {
        fractionLabel.textContent = originalFraction;
      }
    }

    function updateRowPreview(recordId) {
      var dateInput = document.querySelector('[data-leaves-date-input="' + recordId + '"]');
      var fractionSelect = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      var dateCell = document.getElementById('leaves-date-value-' + recordId);
      var fractionCell = document.getElementById('leaves-fraction-value-' + recordId);
      if (!fractionSelect || !dateInput) return;

      var leaveFraction = Number(fractionSelect.value) || 0;
      var leaveDate = dateInput.value || '';
      if (dateCell && leaveDate) {
        dateCell.textContent = leaveDate;
      }
      if (fractionCell) {
        fractionCell.textContent = formatNumber(leaveFraction);
      }
      syncFractionLabel(recordId, leaveFraction);
    }

    function toggleEditRow(recordId) {
      var row = document.getElementById('leaves-edit-row-' + recordId);
      if (!row) return;
      if (row.classList.contains('hidden')) {
        closeAllEditRows(recordId);
        closeFractionDropdowns(recordId);
        row.classList.remove('hidden');
        initLeavesEditDatepicker(recordId);
        return;
      }

      resetRowPreview(recordId);
      row.classList.add('hidden');
      closeFractionDropdowns();
    }

    function saveEditRow(recordId) {
      var dateInput = document.querySelector('[data-leaves-date-input="' + recordId + '"]');
      var fractionSelect = document.querySelector('[data-leaves-fraction-input="' + recordId + '"]');
      if (!dateInput || !fractionSelect) return;

      fetch('/leaves/' + recordId, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json'
        },
        body: JSON.stringify({
          leave_date: dateInput.value,
          leave_fraction: fractionSelect.value
        })
      }).then(function (response) { return response.json(); })
        .then(function (payload) {
          if (payload.error) throw new Error(payload.error);
          loadData();
        })
        .catch(function (error) { alert(error.message); });
    }

    function setUserFilter(userId, userLabel) {
      elements.userInput.value = userId || '';
      elements.userLabel.textContent = selectedText(userLabel, '<%= j l(:label_all_users) %>');
      syncDropdownActiveState('leaves-user-dropdown', 'data-user-id', elements.userInput.value);
      closeDropdowns();
      loadData();
    }

    function setStatusFilter(status, statusLabel) {
      elements.statusInput.value = status || '';
      elements.statusLabel.textContent = selectedText(statusLabel, '<%= j l(:label_all_statuses) %>');
      syncDropdownActiveState('leaves-status-dropdown', 'data-status', elements.statusInput.value);
      closeDropdowns();
      loadData();
    }

    function setPerPage(value) {
      state.perPage = parseInt(value, 10) || 10;
      elements.perPageLabel.textContent = String(state.perPage);
      syncDropdownActiveState('leaves-per-page-dropdown', 'data-per-page', String(state.perPage));
      closeDropdowns();
      state.dailyPage = 1;
      state.summaryPage = 1;
      state.selectedIds.clear();
      updateBulkDeleteButton();
      renderTables();
    }

    function handleSortClick(event) {
      // Works both when bound directly to a header button (Daily) and via delegation on the
      // dynamic Summary <thead> (where headers are rebuilt on every render).
      var button = (event.currentTarget && event.currentTarget.getAttribute && event.currentTarget.getAttribute('data-table-sort'))
        ? event.currentTarget
        : (event.target.closest ? event.target.closest('[data-table-sort]') : null);
      if (!button) return;
      var table = button.getAttribute('data-table-sort');
      var sortKey = button.getAttribute('data-sort-key');
      if (state[table + 'Sort'] === sortKey) {
        state[table + 'Direction'] = state[table + 'Direction'] === 'asc' ? 'desc' : 'asc';
      } else {
        state[table + 'Sort'] = sortKey;
        state[table + 'Direction'] = 'asc';
      }
      renderTables();
    }

    elements.dailyTab.addEventListener('click', function () { setTab('daily'); });
    elements.summaryTab.addEventListener('click', function () { setTab('summary'); });

    // Summary pivot: info icon opens the user's leave dates for that month.
    elements.summaryBody.addEventListener('click', function (event) {
      var button = event.target.closest('[data-summary-info-user]');
      if (!button) return;
      openLeaveDatesModal(
        button.getAttribute('data-summary-info-user'),
        button.getAttribute('data-summary-info-month'),
        button.getAttribute('data-summary-info-label')
      );
    });

    // Summary pivot: column sorting (headers are rebuilt each render, so delegate on <thead>).
    if (elements.summaryHead) {
      elements.summaryHead.addEventListener('click', function (event) {
        if (event.target.closest('[data-table-sort]')) handleSortClick(event);
      });
    }

    var leaveDatesModal = document.getElementById('leaves-dates-modal');
    var leaveDatesClose = document.getElementById('leaves-dates-modal-close');
    var leaveDatesCloseFooter = document.getElementById('leaves-dates-modal-close-footer');
    if (leaveDatesClose) leaveDatesClose.addEventListener('click', closeLeaveDatesModal);
    if (leaveDatesCloseFooter) leaveDatesCloseFooter.addEventListener('click', closeLeaveDatesModal);
    if (leaveDatesModal) {
      leaveDatesModal.addEventListener('click', function (event) {
        if (event.target === leaveDatesModal) closeLeaveDatesModal();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !leaveDatesModal.classList.contains('hidden')) closeLeaveDatesModal();
      });
    }
    elements.userButton.addEventListener('click', function () { toggleDropdown('leaves-user-dropdown'); });
    elements.statusButton.addEventListener('click', function () { toggleDropdown('leaves-status-dropdown'); });
    elements.perPageButton.addEventListener('click', function () { toggleDropdown('leaves-per-page-dropdown'); });
    elements.userButton.addEventListener('keydown', function (event) { handleDropdownButtonKeydown(event, 'leaves-user-dropdown', 'data-user-label'); });
    elements.statusButton.addEventListener('keydown', function (event) { handleDropdownButtonKeydown(event, 'leaves-status-dropdown', 'data-status-label'); });
    elements.perPageButton.addEventListener('keydown', function (event) { handleDropdownButtonKeydown(event, 'leaves-per-page-dropdown', 'data-per-page'); });

    var lockedUsersToggle = document.getElementById('leaves-locked-users-toggle');
    var lockedUsersList = document.getElementById('leaves-locked-users-list');
    var lockedUsersChevron = document.getElementById('leaves-locked-users-chevron');
    if (lockedUsersToggle && lockedUsersList) {
      lockedUsersToggle.addEventListener('click', function () {
        var expanded = lockedUsersList.classList.toggle('hidden') === false;
        if (lockedUsersChevron) lockedUsersChevron.classList.toggle('-rotate-90', !expanded);
      });
    }

    bindDropdownKeyboard('leaves-user-dropdown', 'data-user-label', function (button) {
      setUserFilter(button.getAttribute('data-user-id'), button.getAttribute('data-user-label'));
    });
    bindDropdownKeyboard('leaves-status-dropdown', 'data-status-label', function (button) {
      setStatusFilter(button.getAttribute('data-status'), button.getAttribute('data-status-label'));
    });
    bindDropdownKeyboard('leaves-per-page-dropdown', 'data-per-page', function (button) {
      setPerPage(button.getAttribute('data-per-page'));
    });

    document.querySelectorAll('[data-table-sort]').forEach(function (button) {
      button.addEventListener('click', handleSortClick);
    });

    function bindDateAutoReload(input) {
      input.addEventListener('change', scheduleLoadData);
      input.addEventListener('changeDate', function () {
        // Re-sync the month bar before the (debounced) reload so selectedMonthsParam() reflects
        // the newly picked range rather than the previous selection.
        syncMonthPickerFromInputs();
        scheduleLoadData();
        hideDatePickers();
      });
      input.addEventListener('change', syncMonthPickerFromInputs);
    }

    bindDateAutoReload(elements.from);
    bindDateAutoReload(elements.to);

    window.addEventListener('pageshow', deferHideDatePickers);

    elements.search.addEventListener('input', function () {
      state.dailyPage = 1;
      state.summaryPage = 1;
      state.selectedIds.clear();
      state.selectAllPages = false;
      updateBulkDeleteButton();
      updateSelectionBanner();
      renderTables();
    });

    if (elements.bulkDeleteButton) {
      elements.bulkDeleteButton.addEventListener('click', function () {
        if (state.selectedIds.size > 0) {
          openDeleteModal(null, 'bulk_selected');
        }
      });
    }

    if (elements.selectAllPagesBtn) {
      elements.selectAllPagesBtn.addEventListener('click', function() {
        state.selectAllPages = true;
        updateSelectionBanner();
        updateBulkDeleteButton();
      });
    }

    if (elements.clearSelectionBtn) {
      elements.clearSelectionBtn.addEventListener('click', function() {
        state.selectedIds.clear();
        state.selectAllPages = false;
        elements.selectAllCheckbox.checked = false;
        document.querySelectorAll('.leaves-row-checkbox').forEach(function(cb) { cb.checked = false; });
        updateSelectionBanner();
        updateBulkDeleteButton();
      });
    }

    if (elements.selectAllCheckbox) {
      elements.selectAllCheckbox.addEventListener('change', function () {
        var isChecked = elements.selectAllCheckbox.checked;
        state.selectAllPages = false; // Reset global selection on any change
        document.querySelectorAll('.leaves-row-checkbox').forEach(function (cb) {
          cb.checked = isChecked;
          var recordId = String(cb.getAttribute('data-record-id'));
          if (isChecked) {
            state.selectedIds.add(recordId);
          } else {
            state.selectedIds.delete(recordId);
          }
        });
        updateSelectionBanner();
        updateBulkDeleteButton();
      });
    }

    document.getElementById('leaves-daily-tbody').addEventListener('change', function (event) {
      var rowCheckbox = event.target.closest('.leaves-row-checkbox');
      if (rowCheckbox) {
        var recordId = String(rowCheckbox.getAttribute('data-record-id'));
        if (rowCheckbox.checked) {
          state.selectedIds.add(recordId);
        } else {
          state.selectedIds.delete(recordId);
          state.selectAllPages = false;
        }
        updateBulkDeleteButton();
        updateSelectAllCheckbox();
      }
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('#leaves-user-dropdown-button') && !event.target.closest('#leaves-user-dropdown') &&
          !event.target.closest('#leaves-status-dropdown-button') && !event.target.closest('#leaves-status-dropdown') &&
          !event.target.closest('#leaves-per-page-dropdown-button') && !event.target.closest('#leaves-per-page-dropdown')) {
        closeDropdowns();
      }
      if (!event.target.closest('[data-leaves-fraction-toggle]') &&
          !event.target.closest('[data-leaves-fraction-menu]')) {
        closeFractionDropdowns();
      }
    });

    document.getElementById('leaves-daily-tbody').addEventListener('click', function (event) {
      var editButton = event.target.closest('[data-edit-id]');
      var fractionToggle = event.target.closest('[data-leaves-fraction-toggle]');
      var fractionOption = event.target.closest('[data-leaves-fraction-option]');
      var unflagButton = event.target.closest('[data-unflag-id]');
      var deleteButton = event.target.closest('[data-delete-id]');
      var saveButton = event.target.closest('[data-leaves-save-id]');
      var cancelButton = event.target.closest('[data-leaves-cancel-id]');

      if (editButton) {
        toggleEditRow(editButton.getAttribute('data-edit-id'));
      }
      if (fractionToggle) {
        toggleFractionDropdown(fractionToggle.getAttribute('data-leaves-fraction-toggle'));
      }
      if (fractionOption) {
        selectFraction(
          fractionOption.getAttribute('data-leaves-fraction-option'),
          fractionOption.getAttribute('data-fraction-value')
        );
      }
      if (unflagButton) {
        fetch('/leaves/' + unflagButton.getAttribute('data-unflag-id') + '/status', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            Accept: 'application/json'
          },
          body: JSON.stringify({ status: 'confirmed' })
        }).then(function (response) { return response.json(); })
          .then(function (payload) {
            if (payload.error) throw new Error(payload.error);
            loadData();
          })
          .catch(function (error) { alert(error.message); });
      }
      if (deleteButton) {
        openDeleteModal(deleteButton.getAttribute('data-delete-id'), 'single');
      }
      if (saveButton) {
        saveEditRow(saveButton.getAttribute('data-leaves-save-id'));
      }
      if (cancelButton) {
        resetRowPreview(cancelButton.getAttribute('data-leaves-cancel-id'));
        var cancelRow = document.getElementById('leaves-edit-row-' + cancelButton.getAttribute('data-leaves-cancel-id'));
        if (cancelRow) cancelRow.classList.add('hidden');
        closeFractionDropdowns();
      }
    });

    document.getElementById('leaves-daily-tbody').addEventListener('change', function (event) {
      var fractionInput = event.target.closest('[data-leaves-fraction-input]');
      var dateInput = event.target.closest('[data-leaves-date-input]');
      var recordId = null;
      if (fractionInput) {
        recordId = fractionInput.getAttribute('data-leaves-fraction-input');
      } else if (dateInput) {
        recordId = dateInput.getAttribute('data-leaves-date-input');
      }
      if (!recordId) return;
      updateRowPreview(recordId);
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('[data-leaves-fraction-toggle]') &&
          !event.target.closest('[data-leaves-fraction-menu]')) {
        closeFractionDropdowns();
      }
    });

    var deleteConfirmButton = document.getElementById('leaves-delete-confirm');
    var deleteCancelButton = document.getElementById('leaves-delete-cancel');
    var deleteCloseButtons = document.querySelectorAll('[data-leaves-delete-close="true"]');
    if (deleteConfirmButton) deleteConfirmButton.addEventListener('click', confirmDelete);
    if (deleteCancelButton) deleteCancelButton.addEventListener('click', closeDeleteModal);
    deleteCloseButtons.forEach(function (button) {
      button.addEventListener('click', closeDeleteModal);
    });
    if (elements.deleteAllButton) {
      elements.deleteAllButton.addEventListener('click', function () {
        if (elements.deleteAllButton.disabled) return;
        openDeleteModal(null, 'all');
      });
    }

    function openManualModal() {
      if (!manualElements.modal) return;
      manualElements.modal.classList.remove('hidden');
      manualElements.modal.classList.add('flex');
      manualElements.modal.setAttribute('aria-hidden', 'false');
      if (manualElements.from) manualElements.from.value = formatDateForInput(new Date());
      if (manualElements.to) manualElements.to.value = '';
      setManualLeaveTypeMode('single');
      if (manualElements.userSearch) manualElements.userSearch.value = '';
      if (manualElements.userId) manualElements.userId.value = '';
      closeManualUserDropdown();
      closeManualFractionMenu();
      if (manualElements.userSearch) manualElements.userSearch.focus();
    }

    function closeManualModal() {
      if (!manualElements.modal) return;
      manualElements.modal.classList.add('hidden');
      manualElements.modal.classList.remove('flex');
      manualElements.modal.setAttribute('aria-hidden', 'true');
    }

    function filterManualUsers() {
      if (!manualElements.userList || !manualElements.userSearch) return;
      var query = normalize(manualElements.userSearch.value);
      manualElements.userList.querySelectorAll('.leaves-modal-option').forEach(function (option) {
        var searchValue = option.getAttribute('data-user-search') || '';
        option.style.display = searchValue.indexOf(query) !== -1 ? '' : 'none';
      });
      manualUserState.activeIndex = -1;
      setManualUserActiveOption(-1);
    }

    function openManualUserDropdown() {
      if (!manualElements.userList) return;
      manualElements.userList.classList.remove('hidden');
      filterManualUsers();
    }

    function closeManualUserDropdown() {
      if (!manualElements.userList) return;
      manualElements.userList.classList.add('hidden');
      manualUserState.activeIndex = -1;
      setManualUserActiveOption(-1);
    }

    function selectManualUser(option) {
      if (!manualElements.userId || !manualElements.userSearch) return;
      manualElements.userId.value = option.getAttribute('data-user-id') || '';
      manualElements.userSearch.value = option.getAttribute('data-user-text') || option.textContent.trim();
      closeManualUserDropdown();
    }

    function setManualLeaveTypeMode(mode) {
      if (!manualElements.fraction || !manualElements.fractionButton || !manualElements.fractionLabel || !manualElements.fractionMenu) return;
      var isRange = mode === 'range';
      manualElements.fraction.value = isRange ? '1' : '0.5';
      manualElements.fractionLabel.textContent = isRange ? '1' : '0.5';
      manualElements.fractionButton.disabled = isRange;
      manualElements.fractionButton.classList.toggle('cursor-not-allowed', isRange);
      manualElements.fractionButton.classList.toggle('opacity-70', isRange);
      manualElements.fractionButton.classList.toggle('pointer-events-none', isRange);
      manualElements.fractionMenu.classList.toggle('hidden', isRange);
    }

    function syncManualLeaveTypeMode() {
      if (!manualElements.to) return;
      if (manualElements.to.value && manualElements.to.value.trim()) {
        setManualLeaveTypeMode('range');
      } else {
        setManualLeaveTypeMode('single');
      }
    }

    function getVisibleManualUserOptions() {
      if (!manualElements.userList) return [];
      return Array.from(manualElements.userList.querySelectorAll('.leaves-modal-option')).filter(function (option) {
        return option.style.display !== 'none';
      });
    }

    function setManualUserActiveOption(index) {
      var options = getVisibleManualUserOptions();
      options.forEach(function (option, optionIndex) {
        option.classList.toggle('leaves-modal-option--active', optionIndex === index);
      });
      if (index >= 0 && options[index]) {
        options[index].scrollIntoView({ block: 'nearest' });
      }
    }

    function moveManualUserActiveOption(step) {
      var options = getVisibleManualUserOptions();
      if (!options.length) return;
      if (manualUserState.activeIndex < 0) {
        manualUserState.activeIndex = step > 0 ? 0 : options.length - 1;
      } else {
        manualUserState.activeIndex = Math.max(0, Math.min(options.length - 1, manualUserState.activeIndex + step));
      }
      setManualUserActiveOption(manualUserState.activeIndex);
    }

    function toggleManualFractionMenu() {
      if (!manualElements.fractionMenu || (manualElements.fractionButton && manualElements.fractionButton.disabled)) return;
      var shouldOpen = manualElements.fractionMenu.classList.contains('hidden');
      manualElements.fractionMenu.classList.toggle('hidden', !shouldOpen);
    }

    function closeManualFractionMenu() {
      if (!manualElements.fractionMenu) return;
      manualElements.fractionMenu.classList.add('hidden');
    }

    function selectManualFraction(value) {
      if (manualElements.fractionButton && manualElements.fractionButton.disabled) return;
      if (manualElements.fraction) manualElements.fraction.value = value;
      if (manualElements.fractionLabel) manualElements.fractionLabel.textContent = value;
      closeManualFractionMenu();
    }

    function submitManualLeave() {
      if (!manualElements.userId || !manualElements.from || !manualElements.to || !manualElements.fraction) return false;
      if (!manualElements.userId.value) {
        alert('Please select a user.');
        return false;
      }
      syncManualLeaveTypeMode();

      fetch('<%= leaves_create_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json'
        },
        body: JSON.stringify({
          user_id: manualElements.userId.value,
          from: manualElements.from.value,
          to: manualElements.to.value,
          leave_fraction: manualElements.fraction.value
        })
      }).then(function (response) { return response.json(); })
        .then(function (payload) {
          if (payload.error) throw new Error(payload.error);
          closeManualModal();
          loadData();
        })
        .catch(function (error) { alert(error.message); });

      return false;
    }

    elements.from.value = initialFilters.from;
    elements.to.value = initialFilters.to;
    elements.userInput.value = initialFilters.user_id;
    elements.statusInput.value = initialFilters.status;
    elements.userLabel.textContent = initialFilters.user_id ? elements.userLabel.textContent : '<%= j l(:label_all_users) %>';
    elements.statusLabel.textContent = initialFilters.status === 'confirmed' ? '<%= j l(:label_confirmed) %>' : (initialFilters.status === 'flagged' ? '<%= j l(:label_flagged) %>' : '<%= j l(:label_all_statuses) %>');
    elements.perPageLabel.textContent = String(state.perPage);
    syncDropdownActiveState('leaves-user-dropdown', 'data-user-id', elements.userInput.value);
    syncDropdownActiveState('leaves-status-dropdown', 'data-status', elements.statusInput.value);
    syncDropdownActiveState('leaves-per-page-dropdown', 'data-per-page', String(state.perPage));
    updateSortIndicators();
    syncMonthPickerFromInputs();
    setTab('daily');
    deferHideDatePickers();
    loadData();

    if (elements.monthButtons.length) {
      elements.monthButtons.forEach(function (button) {
        button.addEventListener('click', function (event) {
          var month = parseInt(button.getAttribute('data-leaves-month'), 10);

          if (event.shiftKey) {
            // Contiguous range from the anchor to the clicked month (anchor unchanged).
            var anchor = monthState.anchor == null ? month : monthState.anchor;
            var start = Math.min(anchor, month);
            var end = Math.max(anchor, month);
            monthState.months = new Set();
            for (var m = start; m <= end; m += 1) monthState.months.add(m);
          } else if (event.ctrlKey || event.metaKey) {
            // Toggle the clicked month, but never allow an empty selection.
            if (monthState.months.has(month)) {
              if (monthState.months.size > 1) monthState.months.delete(month);
            } else {
              monthState.months.add(month);
            }
            monthState.anchor = month;
          } else {
            // Plain click: single-month selection.
            monthState.months = new Set([month]);
            monthState.anchor = month;
          }

          applyMonthSelection();
        });
      });
    }

    if (elements.yearLabel) {
      elements.yearLabel.style.cursor = 'pointer';
      elements.yearLabel.setAttribute('title', 'Select all months');
      elements.yearLabel.addEventListener('click', function () {
        // Select all 12 months of the displayed year.
        monthState.months = new Set();
        for (var m = 0; m < 12; m += 1) monthState.months.add(m);
        monthState.anchor = 0;
        applyMonthSelection();
      });
    }

    if (elements.yearPrev) {
      elements.yearPrev.addEventListener('click', function () {
        // Keep the same selected month set, shift to the previous year.
        monthState.year -= 1;
        applyMonthSelection();
      });
    }

    if (elements.yearNext) {
      elements.yearNext.addEventListener('click', function () {
        monthState.year += 1;
        applyMonthSelection();
      });
    }

    if (manualElements.openButton) manualElements.openButton.addEventListener('click', openManualModal);
    if (manualElements.closeButton) manualElements.closeButton.addEventListener('click', closeManualModal);
    if (manualElements.cancelButton) manualElements.cancelButton.addEventListener('click', closeManualModal);
    if (manualElements.modal) {
      manualElements.modal.addEventListener('click', function (event) {
        if (event.target === manualElements.modal) closeManualModal();
      });
    }
    if (manualElements.userSearch) {
      manualElements.userSearch.addEventListener('click', openManualUserDropdown);
      manualElements.userSearch.addEventListener('input', function () {
        openManualUserDropdown();
        filterManualUsers();
      });
      manualElements.userSearch.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          closeManualUserDropdown();
          return;
        }
        if (event.key === 'ArrowDown') {
          event.preventDefault();
          if (manualElements.userList && manualElements.userList.classList.contains('hidden')) openManualUserDropdown();
          moveManualUserActiveOption(1);
          return;
        }
        if (event.key === 'ArrowUp') {
          event.preventDefault();
          if (manualElements.userList && manualElements.userList.classList.contains('hidden')) openManualUserDropdown();
          moveManualUserActiveOption(-1);
          return;
        }
        if (event.key === 'Enter') {
          var options = getVisibleManualUserOptions();
          if (manualUserState.activeIndex >= 0 && options[manualUserState.activeIndex]) {
            event.preventDefault();
            selectManualUser(options[manualUserState.activeIndex]);
          }
        }
      });
    }
    if (manualElements.userList) {
      manualElements.userList.addEventListener('click', function (event) {
        var option = event.target.closest('.leaves-modal-option');
        if (option) selectManualUser(option);
      });
    }
    if (manualElements.fractionButton) {
      manualElements.fractionButton.addEventListener('click', function () {
        toggleManualFractionMenu();
      });
    }
    if (manualElements.fractionMenu) {
      manualElements.fractionMenu.addEventListener('click', function (event) {
        var option = event.target.closest('[data-fraction-value]');
        if (!option) return;
        selectManualFraction(option.getAttribute('data-fraction-value'));
      });
    }
    if (manualElements.form) {
      manualElements.form.addEventListener('submit', function (event) {
        event.preventDefault();
        submitManualLeave();
      });
    }
    if (manualElements.to) {
      manualElements.to.addEventListener('input', syncManualLeaveTypeMode);
      manualElements.to.addEventListener('change', syncManualLeaveTypeMode);
      manualElements.to.addEventListener('changeDate', syncManualLeaveTypeMode);
    }
    document.addEventListener('click', function (event) {
      if (!event.target.closest('#leaves-manual-user-wrapper')) {
        closeManualUserDropdown();
      }
      if (!event.target.closest('#leaves-manual-fraction-wrapper')) {
        closeManualFractionMenu();
      }
    });
    syncManualLeaveTypeMode();
  });
</script>
