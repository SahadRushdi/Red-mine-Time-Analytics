                      '<button type="button" class="tep-activity-option tep-entry-act-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900' + (leaveFractionValue === '0.5' ? ' !font-semibold !bg-blue-50' : '') + '" data-leaves-fraction-option="' + record.id + '" data-fraction-value="0.5" data-fraction-label="0.5">0.5</button>' +
                      '<button type="button" class="tep-activity-option tep-entry-act-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900' + (leaveFractionValue === '1' ? ' !font-semibold !bg-blue-50' : '') + '" data-leaves-fraction-option="' + record.id + '" data-fraction-value="1" data-fraction-label="1">1</button>' +
                    '</div>' +
                  '</div>' +
                '</div>' +
                '<div class="flex items-center gap-2">' +
                  '<button type="button" class="inline-flex items-center rounded-lg bg-[#3b82f6] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#2563eb]" data-leaves-save-id="' + record.id + '"><%= j l(:button_save) %></button>' +
                  '<button type="button" class="tep-entry-cancel-btn px-4 py-2 text-sm font-medium !text-gray-600 !bg-white rounded-lg" data-leaves-cancel-id="' + record.id + '">Cancel</button>' +
                '</div>' +
              '</div>' +
            '</td>' +
          '</tr>';
        });
      }

      elements.dailyBody.innerHTML = html;
      updateSelectAllCheckbox();
      renderPagination(
        elements.dailyPagination,
        elements.dailyLinks,
        elements.dailyInfo,
        page.currentPage,
        page.totalPages,
        filtered.length,
        page.startIndex,
        page.endIndex,
        function (nextPage) {
          state.dailyPage = nextPage;
          state.selectedIds.clear();
          state.selectAllPages = false;
          updateBulkDeleteButton();
          updateSelectionBanner();
          renderDailyRows();
        }
      );
