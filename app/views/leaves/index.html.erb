<script>
  document.addEventListener('DOMContentLoaded', function () {
    var csrfToken = '<%= form_authenticity_token %>';
    var initialFilters = <%= {
      from: @default_from.strftime('%m/%d/%Y'),
      to: @default_to.strftime('%m/%d/%Y'),
      user_id: @filter_user_id.to_s,
      status: @filter_status.to_s
    }.to_json.html_safe %>;

    var state = {
      activeTab: 'daily',
      perPage: 10,
      search: '',
      dailyPage: 1,
      summaryPage: 1,
      dailySort: 'leave_date',
      dailyDirection: 'desc',
      summarySort: 'total',
      summaryDirection: 'desc',
      dailyRecords: [],
      summaryRecords: [],
      selectedIds: new Set(),
      selectAllPages: false,
      totalCount: 0
    };

    var elements = {
      from: document.getElementById('leaves-filter-from'),
      to: document.getElementById('leaves-filter-to'),
      yearLabel: document.getElementById('leaves-year-label'),
      yearPrev: document.getElementById('leaves-year-prev'),
      yearNext: document.getElementById('leaves-year-next'),
      selectedLabel: document.getElementById('leaves-selected-label'),
      monthButtons: document.querySelectorAll('[data-leaves-month]'),
      userButton: document.getElementById('leaves-user-dropdown-button'),
      userLabel: document.getElementById('leaves-user-dropdown-label'),
      userMenu: document.getElementById('leaves-user-dropdown'),
      userInput: document.getElementById('leaves-filter-user'),
      statusButton: document.getElementById('leaves-status-dropdown-button'),
      statusLabel: document.getElementById('leaves-status-dropdown-label'),
      statusMenu: document.getElementById('leaves-status-dropdown'),
      statusInput: document.getElementById('leaves-filter-status'),
      perPageButton: document.getElementById('leaves-per-page-dropdown-button'),
      perPageLabel: document.getElementById('leaves-per-page-label'),
      perPageMenu: document.getElementById('leaves-per-page-dropdown'),
      deleteAllButton: document.getElementById('leaves-delete-all-button'),
      bulkDeleteButton: document.getElementById('leaves-bulk-delete-button'),
      bulkDeleteLabel: document.getElementById('leaves-bulk-delete-label'),
      selectAllCheckbox: document.getElementById('leaves-select-all'),
      selectionBanner: document.getElementById('leaves-global-selection-banner'),
      selectionText: document.getElementById('leaves-selection-text'),
      selectAllPagesBtn: document.getElementById('leaves-select-all-pages-btn'),
      clearSelectionBtn: document.getElementById('leaves-clear-selection-btn'),
      search: document.getElementById('ts-search-input'),
      dailyTab: document.getElementById('leaves-tab-daily'),
      summaryTab: document.getElementById('leaves-tab-summary'),
      dailyPanel: document.getElementById('leaves-daily-panel'),
      summaryPanel: document.getElementById('leaves-summary-panel'),
      dailyBody: document.getElementById('leaves-daily-tbody'),
      summaryBody: document.getElementById('leaves-summary-tbody'),
      summaryHead: document.getElementById('leaves-summary-thead'),
      summaryFoot: document.getElementById('leaves-summary-tfoot'),
      dailyInfo: document.getElementById('leaves-daily-pagination-info'),
      summaryInfo: document.getElementById('leaves-summary-pagination-info'),
      dailyPagination: document.getElementById('leaves-daily-pagination'),
      summaryPagination: document.getElementById('leaves-summary-pagination'),
      dailyLinks: document.getElementById('leaves-daily-pagination-links'),
      summaryLinks: document.getElementById('leaves-summary-pagination-links')
    };

    var dropdownIds = ['leaves-user-dropdown', 'leaves-status-dropdown', 'leaves-per-page-dropdown'];
    var deleteState = { id: null, mode: 'single' };
    var monthLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    // months: Set of selected month indices (0-11) within `year`; anchor: last plain/ctrl-clicked
    // month, used as the base for Shift+Click range selection.
    var monthState = { year: null, months: new Set(), anchor: null };
    var manualUserState = { activeIndex: -1 };
    var manualElements = {
      modal: document.getElementById('leaves-manual-modal'),
      openButton: document.getElementById('leaves-add-button'),
      closeButton: document.getElementById('leaves-manual-close'),
      cancelButton: document.getElementById('leaves-manual-cancel'),
      form: document.getElementById('leaves-manual-form'),
      userSearch: document.getElementById('leaves-manual-user-search'),
      userList: document.getElementById('leaves-manual-user-list'),
      userId: document.getElementById('leaves-manual-user-id'),
      from: document.getElementById('leaves-manual-from'),
      to: document.getElementById('leaves-manual-to'),
      fraction: document.getElementById('leaves-manual-fraction'),
      fractionButton: document.getElementById('leaves-manual-fraction-button'),
      fractionLabel: document.getElementById('leaves-manual-fraction-label'),
      fractionMenu: document.getElementById('leaves-manual-fraction-menu')
    };

    function closeDropdowns(exceptId) {
      dropdownIds.forEach(function (id) {
        if (id !== exceptId) {
          var menu = document.getElementById(id);
          if (menu) menu.classList.add('hidden');
        }
      });
    }

    function toggleDropdown(menuId) {
      var menu = document.getElementById(menuId);
      if (!menu) return;
      var shouldOpen = menu.classList.contains('hidden');
      closeDropdowns(menuId);
      menu.classList.toggle('hidden', !shouldOpen);
      if (shouldOpen) {
        syncDropdownWidth(menuId);
        var firstOption = menu.querySelector('.leaves-dropdown-option:not([disabled])');
        if (firstOption) firstOption.focus();
      }
    }

    function openDropdown(menuId) {
      var menu = document.getElementById(menuId);
      if (!menu) return;
      closeDropdowns(menuId);
      menu.classList.remove('hidden');
      syncDropdownWidth(menuId);
      var firstOption = menu.querySelector('.leaves-dropdown-option:not([disabled])');
      if (firstOption) firstOption.focus();
    }

    function syncDropdownWidth(menuId) {
      var menu = document.getElementById(menuId);
      if (!menu) return;
      var buttonId = menuId.replace('-dropdown', '-dropdown-button');
      var button = document.getElementById(buttonId);
      if (!button) return;
      var width = Math.max(button.offsetWidth, button.getBoundingClientRect().width);
      if (menuId === 'leaves-user-dropdown') {
        width = Math.max(width, 300);
      }
      menu.style.width = width + 'px';
      menu.style.minWidth = width + 'px';
    }

    function closeDeleteModal() {
      var modal = document.getElementById('leaves-delete-modal');
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
      deleteState.id = null;
      deleteState.mode = 'single';
    }

    function updateDeleteMessage(mode) {
      var message = document.getElementById('leaves-delete-message');
      if (!message) return;
      var nextMessage = message.dataset.singleMessage;
      if (mode === 'all') {
        nextMessage = message.dataset.bulkMessage;
      } else if (mode === 'bulk_selected') {
        var count = state.selectedIds.size;
        nextMessage = 'Are you sure you want to delete ' + count + ' selected leave records?';
      }
      if (nextMessage) message.textContent = nextMessage;
    }

    function openDeleteModal(id, mode) {
      deleteState.id = id || null;
      deleteState.mode = mode || (id ? 'single' : 'all');
      updateDeleteMessage(deleteState.mode);
      var modal = document.getElementById('leaves-delete-modal');
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
    }

    function confirmDelete() {
      var mode = deleteState.mode;
      var id = deleteState.id;
      closeDeleteModal();
      if (mode === 'all') {
        var payload = {
          from: elements.from.value,
          to: elements.to.value,
          user_id: elements.userInput.value,
          status: elements.statusInput.value,
          months: selectedMonthsParam()
        };
        fetch('<%= leaves_destroy_all_path %>', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        }).then(function (response) { return response.json(); })
          .then(function (responsePayload) {
            if (responsePayload.error) throw new Error(responsePayload.error);
            loadData();
          })
          .catch(function (error) { alert(error.message); });
        return;
      }

      if (mode === 'bulk_selected') {
        var payload = {
          ids: Array.from(state.selectedIds),
          select_all_pages: state.selectAllPages,
          from: elements.from.value,
          to: elements.to.value,
          user_id: elements.userInput.value,
          status: elements.statusInput.value,
          months: selectedMonthsParam()
        };
        fetch('<%= leaves_bulk_destroy_path %>', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        }).then(function (response) { return response.json(); })
          .then(function (payload) {
            if (payload.error) throw new Error(payload.error);
            state.selectedIds.clear();
            state.selectAllPages = false;
            updateBulkDeleteButton();
            loadData();
          })
          .catch(function (error) { alert(error.message); });
        return;
      }

      if (!id) return;
      fetch('/leaves/' + id, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken,
          Accept: 'application/json'
        }
      }).then(function (response) { return response.json(); })
        .then(function (payload) {
          if (payload.error) throw new Error(payload.error);
          loadData();
        })
        .catch(function (error) { alert(error.message); });
    }

    function parseDateFromInput(value) {
      if (!value) return null;
      var parts = String(value).split('/');
      if (parts.length !== 3) return null;
      var month = parseInt(parts[0], 10) - 1;
      var day = parseInt(parts[1], 10);
      var year = parseInt(parts[2], 10);
      if (Number.isNaN(month) || Number.isNaN(day) || Number.isNaN(year)) return null;
      var date = new Date(year, month, day);
      if (Number.isNaN(date.getTime())) return null;
      return date;
    }

    function formatDateForInput(date) {
      var month = String(date.getMonth() + 1).padStart(2, '0');
      var day = String(date.getDate()).padStart(2, '0');
      return month + '/' + day + '/' + date.getFullYear();
    }

    function setDateRange(fromDate, toDate) {
      if (elements.from) elements.from.value = formatDateForInput(fromDate);
      if (elements.to) elements.to.value = formatDateForInput(toDate);
    }

    function sortedSelectedMonths() {
      return Array.from(monthState.months).sort(function (a, b) { return a - b; });
    }

    // Comma-separated "YYYY-MM" list of the currently selected months, sent to the server
    // so non-contiguous selections (e.g. Feb + Aug) are filtered exactly.
    function selectedMonthsParam() {
      return sortedSelectedMonths().map(function (month) {
        return monthState.year + '-' + String(month + 1).padStart(2, '0');
      }).join(',');
    }

    // Derive the selected month set from the current From/To inputs. Does NOT overwrite the
    // inputs, so a manual fine-grained range (e.g. Jun 5-20) is preserved while the bar
    // highlights the months it spans.
    function syncMonthPickerFromInputs() {
      var fromDate = parseDateFromInput(elements.from.value);
      var toDate = parseDateFromInput(elements.to.value);
      var baseDate = fromDate || new Date();
      monthState.year = baseDate.getFullYear();

      var startMonth = baseDate.getMonth();
      var endMonth = startMonth;
      if (toDate && toDate.getFullYear() === monthState.year) {
        endMonth = toDate.getMonth();
      } else if (toDate && toDate.getFullYear() > monthState.year) {
        endMonth = 11;
      }
      if (endMonth < startMonth) endMonth = startMonth;

      monthState.months = new Set();
      for (var month = startMonth; month <= endMonth; month += 1) {
        monthState.months.add(month);
      }
      monthState.anchor = startMonth;
      updateMonthPickerUI();
    }

    function isContiguousSelection(months) {
      if (months.length <= 1) return true;
      return months[months.length - 1] - months[0] === months.length - 1;
    }

    function selectedMonthsLabel() {
      var months = sortedSelectedMonths();
      if (!months.length) return String(monthState.year);
      if (months.length === 1) {
        return monthLabels[months[0]] + ' ' + monthState.year;
      }
      if (isContiguousSelection(months)) {
        return monthLabels[months[0]] + ' – ' + monthLabels[months[months.length - 1]] + ' ' + monthState.year;
      }
      return months.length + ' months · ' + monthState.year;
    }

    function updateMonthPickerUI() {
      if (!elements.yearLabel || !elements.selectedLabel || !elements.monthButtons.length) return;
      var current = new Date();
      elements.yearLabel.textContent = String(monthState.year);
      elements.selectedLabel.textContent = selectedMonthsLabel();

      elements.monthButtons.forEach(function (button) {
        var buttonMonth = parseInt(button.getAttribute('data-leaves-month'), 10);
        var isActive = monthState.months.has(buttonMonth);
        var dot = button.querySelector('.leaves-month-dot');
        button.classList.toggle('leaves-month-button--active', isActive);
        if (dot) {
          var showDot = monthState.year === current.getFullYear() && buttonMonth === current.getMonth();
          dot.classList.toggle('leaves-month-dot--visible', showDot);
        }
      });
    }

    // Sync the From/To inputs to the bounding box of the selected months, refresh the UI,
    // and (optionally) reload. The exact selected set travels separately via selectedMonthsParam().
    function applyMonthSelection(shouldLoad) {
      var months = sortedSelectedMonths();
      if (!months.length) return;
      var fromDate = new Date(monthState.year, months[0], 1);
      var toDate = new Date(monthState.year, months[months.length - 1] + 1, 0);
      setDateRange(fromDate, toDate);
      updateMonthPickerUI();
      if (shouldLoad !== false) {
        scheduleLoadData();
      }
    }

    function findDropdownOption(menu, query, attrName) {
      if (!menu) return;
      var options = Array.from(menu.querySelectorAll('.leaves-dropdown-option'))
        .filter(function (btn) { return btn.offsetParent !== null; });
      if (!options.length) return;
      var normalized = normalize(query);
      return options.find(function (btn) {
        var label = normalize(btn.getAttribute(attrName) || btn.textContent || '');
        return label.indexOf(normalized) === 0;
      }) || options.find(function (btn) {
        var label = normalize(btn.getAttribute(attrName) || btn.textContent || '');
        return label.indexOf(normalized) !== -1;
      }) || null;
    }

    var userDropdownTypeahead = {
      buffer: '',
      timer: null
    };

    function resetUserDropdownTypeahead() {
      userDropdownTypeahead.buffer = '';
      window.clearTimeout(userDropdownTypeahead.timer);
      userDropdownTypeahead.timer = null;
    }

    function handleUserDropdownTypeahead(menu, query, attrName, selectFn) {
      var typed = normalize(query);
      if (!typed) return;

      userDropdownTypeahead.buffer += typed;
      window.clearTimeout(userDropdownTypeahead.timer);
      userDropdownTypeahead.timer = window.setTimeout(function () {
        resetUserDropdownTypeahead();
      }, 900);

      var match = findDropdownOption(menu, userDropdownTypeahead.buffer, attrName);
      if (!match) {
        userDropdownTypeahead.buffer = typed;
        match = findDropdownOption(menu, typed, attrName);
      }
      if (!match) return;

      match.focus();
      if (normalize(match.getAttribute(attrName) || match.textContent || '') === userDropdownTypeahead.buffer) {
        selectFn(match);
        resetUserDropdownTypeahead();
      }
    }

    function bindDropdownKeyboard(menuId, attrName, selectFn) {
      var menu = document.getElementById(menuId);
      if (!menu) return;

      menu.addEventListener('keydown', function (event) {
        var target = event.target.closest('.leaves-dropdown-option');
        var options = Array.from(menu.querySelectorAll('.leaves-dropdown-option')).filter(function (btn) {
          return btn.offsetParent !== null;
        });
        if (!options.length) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closeDropdowns();
          return;
        }

        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          var currentIndex = Math.max(0, options.indexOf(target));
          var nextIndex = event.key === 'ArrowDown' ? Math.min(options.length - 1, currentIndex + 1) : Math.max(0, currentIndex - 1);
          (options[nextIndex] || options[0]).focus();
          return;
        }

        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (target) target.click();
          return;
        }

        if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
          event.preventDefault();
          if (menuId === 'leaves-user-dropdown') {
            handleUserDropdownTypeahead(menu, event.key, attrName, selectFn);
            return;
          }
          var match = findDropdownOption(menu, event.key, attrName);
          if (match) match.focus();
        }
      });

      menu.querySelectorAll('.leaves-dropdown-option').forEach(function (button) {
        button.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            button.click();
          }
        });
        button.addEventListener('click', function () {
          if (menuId === 'leaves-user-dropdown') resetUserDropdownTypeahead();
          selectFn(button);
        });
      });
    }

    function syncDropdownActiveState(menuId, attrName, currentValue) {
      var menu = document.getElementById(menuId);
      if (!menu) return;
      menu.querySelectorAll('.leaves-dropdown-option').forEach(function (button) {
        var optionValue = button.getAttribute(attrName) || '';
        button.classList.toggle('leaves-dropdown-option--active', String(optionValue) === String(currentValue || ''));
      });
    }

    function handleDropdownButtonKeydown(event, menuId, attrName) {
      if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
        event.preventDefault();
        openDropdown(menuId);
        return;
      }
      if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
        event.preventDefault();
        openDropdown(menuId);
        if (menuId === 'leaves-user-dropdown') {
          handleUserDropdownTypeahead(document.getElementById(menuId), event.key, attrName, function (button) {
            button.click();
          });
        } else {
          var match = findDropdownOption(document.getElementById(menuId), event.key, attrName);
          if (match) match.focus();
        }
      }
    }

    function setTab(tab) {
      state.activeTab = tab;
      var dailyActive = tab === 'daily';
      elements.dailyPanel.classList.toggle('hidden', !dailyActive);
      elements.summaryPanel.classList.toggle('hidden', dailyActive);
      elements.dailyTab.classList.toggle('leaves-tab-active', dailyActive);
      elements.summaryTab.classList.toggle('leaves-tab-active', !dailyActive);
      state.selectedIds.clear();
      updateBulkDeleteButton();
    }

    function selectedText(value, fallback) {
      return value && value.length ? value : fallback;
    }

    function normalize(value) {
      return String(value || '').toLowerCase().trim();
    }

    function formatNumber(value) {
      var numeric = Number(value) || 0;
      return numeric % 1 === 0 ? String(numeric.toFixed(0)) : numeric.toFixed(1).replace(/\.0$/, '');
    }

    function matchesSearch(record, query) {
      if (!query) return true;
      var haystack = [
        record.user_name,
        record.sender_email,
        record.leave_type,
        record.status,
        record.flagged_reason,
        record.leave_date,
        record.subject
      ].join(' ').toLowerCase();
      return haystack.indexOf(query) !== -1;
    }

    function sortValue(record, sortKey) {
      switch (sortKey) {
        case 'leave_date':
          return record.leave_date || '';
        case 'user_name':
          return record.user_name || '';
        case 'leave_fraction':
          return Number(record.leave_fraction) || 0;
        case 'status':
          return record.status || '';
        case 'total_leave_days':
          return Number(record.total_leave_days) || 0;
        default:
          return record[sortKey];
      }
    }

    function compareRecords(a, b, sortKey, direction) {
      var av = sortValue(a, sortKey);
      var bv = sortValue(b, sortKey);
      var result = 0;

      if (typeof av === 'number' && typeof bv === 'number') {
        result = av - bv;
      } else {
        result = String(av).localeCompare(String(bv), undefined, { numeric: true, sensitivity: 'base' });
      }

      return direction === 'asc' ? result : -result;
    }

    function paginate(items, page, perPage) {
      var totalPages = Math.max(1, Math.ceil(items.length / perPage));
      var currentPage = Math.min(Math.max(page, 1), totalPages);
      var start = (currentPage - 1) * perPage;
      var end = start + perPage;
      return {
        currentPage: currentPage,
        totalPages: totalPages,
        items: items.slice(start, end),
        startIndex: items.length ? start + 1 : 0,
        endIndex: items.length ? Math.min(end, items.length) : 0
      };
    }

    function paginationButton(label, className, disabled, onClick, ariaLabel) {
      var button = document.createElement('button');
      button.type = 'button';
      button.className = className;
      button.textContent = label;
      if (ariaLabel) button.setAttribute('aria-label', ariaLabel);
      if (disabled) {
        button.disabled = true;
      } else {
        button.addEventListener('click', onClick);
      }
      return button;
    }

    function renderPagination(target, linksTarget, infoTarget, currentPage, totalPages, totalItems, startIndex, endIndex, onChange) {
      if (!target || !linksTarget || !infoTarget) return;

      if (totalItems === 0) {
        target.classList.add('hidden');
        linksTarget.innerHTML = '';
        infoTarget.textContent = '<%= j l(:label_no_data) %>';
        return;
      }

      target.classList.remove('hidden');
      infoTarget.textContent = startIndex + '-' + endIndex + ' of ' + totalItems + ' leaves';
      linksTarget.innerHTML = '';

      linksTarget.appendChild(paginationButton(
        'Previous',
        'flex h-8 items-center justify-center rounded-l-lg border border-gray-300 bg-white px-3 leading-tight text-gray-500 hover:bg-gray-100 hover:text-gray-700',
        currentPage === 1,
        function () { onChange(currentPage - 1); },
        'Previous page'
      ));

      for (var page = 1; page <= totalPages; page += 1) {
        (function (pageNumber) {
          var isCurrent = pageNumber === currentPage;
          var className = 'flex h-8 items-center justify-center border border-gray-300 px-3 leading-tight ' +
            (isCurrent ? 'bg-blue-50 text-blue-600 hover:bg-blue-100 hover:text-blue-700' : 'bg-white text-gray-500 hover:bg-gray-100 hover:text-gray-700');
          linksTarget.appendChild(paginationButton(
            String(pageNumber),
            className,
            false,
            function () { onChange(pageNumber); },
            'Page ' + pageNumber
          ));
        })(page);
      }

      linksTarget.appendChild(paginationButton(
        'Next',
        'flex h-8 items-center justify-center rounded-r-lg border border-gray-300 bg-white px-3 leading-tight text-gray-500 hover:bg-gray-100 hover:text-gray-700',
        currentPage === totalPages,
        function () { onChange(currentPage + 1); },
        'Next page'
      ));
    }

    function updateSortIndicators() {
      document.querySelectorAll('[data-table-sort]').forEach(function (button) {
        var table = button.getAttribute('data-table-sort');
        var sortKey = button.getAttribute('data-sort-key');
        var indicator = button.querySelector('.leaves-sort-indicator');
        var isActive = state[table + 'Sort'] === sortKey;
        var direction = state[table + 'Direction'];
        button.classList.toggle('text-gray-900', isActive);
        button.classList.toggle('text-gray-700', !isActive);
        if (indicator) {
          indicator.textContent = isActive ? (direction === 'asc' ? '▲' : '▼') : '';
          indicator.classList.toggle('text-gray-500', isActive);
        }
      });
    }

    function updateBulkDeleteButton() {
      if (!elements.bulkDeleteButton || !elements.bulkDeleteLabel) return;
      var count = state.selectAllPages ? state.totalCount : state.selectedIds.size;
      elements.bulkDeleteLabel.textContent = 'Delete (' + count + ')';
      elements.bulkDeleteButton.classList.toggle('hidden', count === 0);
      elements.bulkDeleteButton.disabled = count === 0;
    }

    function updateSelectionBanner() {
      if (!elements.selectionBanner) return;
      
      var query = normalize(elements.search.value);
      var filtered = state.dailyRecords.filter(function (record) { return matchesSearch(record, query); });
      var totalFiltered = filtered.length;
      var pageCount = Math.min(totalFiltered, state.perPage);
      
      // If selectAllPages is TRUE, show "All X records selected. Clear selection"
      if (state.selectAllPages) {
        elements.selectionBanner.classList.remove('hidden');
        elements.selectionText.textContent = 'All ' + state.totalCount + ' records in Leaves are selected.';
        elements.selectAllPagesBtn.classList.add('hidden');
        elements.clearSelectionBtn.classList.remove('hidden');
        return;
      }

      // If all records ON THIS PAGE are selected AND there are more records in total
      var allOnPageSelected = document.querySelectorAll('.leaves-row-checkbox').length > 0 && 
                              document.querySelectorAll('.leaves-row-checkbox:not(:checked)').length === 0;

      if (allOnPageSelected && state.totalCount > document.querySelectorAll('.leaves-row-checkbox').length) {
        elements.selectionBanner.classList.remove('hidden');
        elements.selectionText.textContent = 'All ' + document.querySelectorAll('.leaves-row-checkbox').length + ' records on this page are selected.';
        elements.selectAllPagesBtn.classList.remove('hidden');
        elements.selectAllPagesBtn.textContent = 'Select all ' + state.totalCount + ' records in Leaves';
        elements.clearSelectionBtn.classList.add('hidden');
      } else {
        elements.selectionBanner.classList.add('hidden');
      }
    }

    function updateSelectAllCheckbox() {
      if (!elements.selectAllCheckbox) return;
      var checkboxes = document.querySelectorAll('.leaves-row-checkbox');
      if (checkboxes.length === 0) {
        elements.selectAllCheckbox.checked = false;
        elements.selectAllCheckbox.indeterminate = false;
        return;
      }
      var checkedCount = 0;
      checkboxes.forEach(function (cb) { if (cb.checked) checkedCount += 1; });
      elements.selectAllCheckbox.checked = checkedCount === checkboxes.length;
      elements.selectAllCheckbox.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
      updateSelectionBanner();
    }

    function scheduleLoadData() {
      window.clearTimeout(scheduleLoadData.timer);
      scheduleLoadData.timer = window.setTimeout(function () {
        loadData();
      }, 80);
    }

    function renderDailyRows() {
      var query = normalize(elements.search.value);
      var filtered = state.dailyRecords.filter(function (record) { return matchesSearch(record, query); });
      filtered.sort(function (a, b) { return compareRecords(a, b, state.dailySort, state.dailyDirection); });

      var page = paginate(filtered, state.dailyPage, state.perPage);
      state.dailyPage = page.currentPage;

      var html = '';
