  // Restore activity view preference
  // Restore activity view preference (supports the extra "Grouped" state)
  function restoreActivityViewState() {
    var hiddenField = document.getElementById('activity_view_state_field');
    var serverMode = hiddenField ? hiddenField.value : null;
    var savedMode = localStorage.getItem('team_activity_view_mode');
    var mode = savedMode || serverMode || 'detailed';

    if (mode === 'grouped') {
      showGroupedView({ persist: false });
    } else if (mode === 'summary') {
      showSummaryView('activity', { persist: false });
    } else {
      showDetailedView('activity', { persist: false });
    }
  }

  // Restore project view preference
  function restoreProjectViewState() {
    restoreTeamViewState('project');
  }

  // Restore member view preference (supports the extra "Monthly avg" state)
  function restoreMemberViewState() {
    var hiddenField = document.getElementById('member_view_state_field');
    var serverMode = hiddenField ? hiddenField.value : null;
    var savedMode = localStorage.getItem('team_member_view_mode');
    var mode = savedMode || serverMode || 'detailed';
    var monthlyBtn = document.getElementById('show-monthly-avg-btn-member');

    // Safety: if 'detailed' would show an empty pivot table but excluded members exist in
    // the summary view, auto-switch to 'summary' so the re-include toggles are always reachable.
    if (mode === 'detailed') {
      var hasActive = document.querySelectorAll('#team-member-summary-view [data-name]:not([data-excluded="true"])').length > 0;
      var hasExcluded = document.querySelectorAll('#team-member-summary-view [data-excluded="true"]').length > 0;
      if (!hasActive && hasExcluded) { mode = 'summary'; }
    }

    if (mode === 'monthly_avg' && monthlyBtn) {
      showMemberMonthlyAvgView({ persist: false });
    } else if (mode === 'summary') {
      showSummaryView('member', { reload: false, persist: false });
    } else {
      showDetailedView('member', { reload: false, persist: false });
    }
  }

  function restoreTeamViewState(viewType) {
    var config = TEAM_VIEW_CONFIG[viewType];
    if (!config) return;
    var detailedView = document.getElementById(config.prefix + '-detailed-view');
    var summaryView = document.getElementById(config.prefix + '-summary-view');
    if (!detailedView || !summaryView) return;

    var hiddenField = document.getElementById(config.hiddenFieldId);
    var serverMode = hiddenField ? hiddenField.value : null;
    var savedMode = localStorage.getItem(config.storageKey);
    var currentMode = savedMode || serverMode || 'detailed';

    if (currentMode === 'summary') {
      showSummaryView(viewType, { reload: false, persist: false });
    } else {
      showDetailedView(viewType, { reload: false, persist: false });
    }
  }

