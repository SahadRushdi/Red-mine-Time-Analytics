    <div class="ta-analysis-layout flex gap-6 mb-6">
      <div class="ta-analysis-table flex-1 bg-white rounded-lg shadow-md border border-gray-200 min-w-0">
        <div class="px-6 py-8 text-center">
          <p class="text-sm text-gray-500"><%= no_table_data_message %></p>
        </div>
      </div>
      <div class="ta-analysis-donut bg-white rounded-lg shadow-md p-4 border border-gray-200">
        <div class="h-80 flex items-center justify-center">
          <p class="text-center text-gray-500 text-sm px-4"><%= no_chart_data_message %></p>
        </div>
      </div>
    </div>
  <% end %>
<% elsif @view_mode == 'members' %>
  <%# Member Analysis Tables - Show pivot table for Member × Time Period %>
  <%# Keep rendering when only temp-excluded members remain so their toggles stay reachable %>
  <% if @members&.any? || Array(@temp_excluded_members).any? %>
    <div class="ta-analysis-layout flex gap-6 mb-6">
      <div class="ta-analysis-table flex-1 bg-white rounded-lg shadow-md border border-gray-200 min-w-0">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
              <h3 class="text-lg font-semibold text-gray-900 whitespace-nowrap">Time by Members</h3>
              <div class="inline-flex rounded-md shadow-sm" role="group">
                <button type="button" id="show-summary-btn-member" 
                        onclick="showSummaryView('member');" 
                        style="<%= @member_view_state == 'summary' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg order-1 focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @member_view_state == 'summary' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">summarize</span>
                  Summary
                </button>
                <% detailed_active = @member_view_state == 'detailed' || (@member_view_state != 'summary' && @member_view_state != 'monthly_avg') %>
                <button type="button" id="show-detailed-btn-member"
                        onclick="showDetailedView('member');"
                        style="<%= detailed_active ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 order-2 <%= @grouping == 'monthly' ? '' : 'rounded-r-lg' %> focus:outline-none focus:ring-4 focus:ring-blue-300 <%= detailed_active ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">data_table</span>
                  Detailed
                </button>
                <% if @grouping == 'monthly' %>
                  <button type="button" id="show-monthly-avg-btn-member"
                          onclick="showMemberMonthlyAvgView();"
                          style="order: 3; <%= @member_view_state == 'monthly_avg' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                          class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @member_view_state == 'monthly_avg' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                    <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">calendar_month</span>
                    Monthly avg
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        </div>

      <%# Detailed View: Pivot Table (Time Period × Member matrix) - Default %>
      <div id="team-member-detailed-view" style="display: <%= (@member_view_state == 'summary' || @member_view_state == 'monthly_avg') ? 'none' : 'block' %>;" class="pivot-table-wrapper ta-analysis-table-scroll overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-sm text-gray-700 bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 border-r-2 border-gray-300"><%= @grouping == 'daily' ? l(:label_date) : l("label_#{@grouping}") %></th>
              <% @members.each do |member| %>
                <th scope="col" class="px-6 py-3 text-center border-r border-gray-200">
                  <%= link_to member[:name], my_time_path(@member_dashboard_params.merge(user_id: member[:id])), target: "_blank", class: "text-blue-600 hover:underline" %>
                </th>
              <% end %>
              <th scope="col" class="px-6 py-3 text-right border-l-2 border-gray-300 font-bold"><%= l(:label_hours) %></th>
            </tr>
          </thead>
          <tbody>
            <% @paginated_periods.each_with_index do |period_display, index| %>
              <% period_key = @member_pivot_data[:raw_periods][(@offset + index)] %>
              <tr class="bg-white border-b hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap"><%= period_display %></td>
                <% @members.each do |member| %>
                  <td class="px-6 py-4 text-center text-gray-900">
                    <% hours = @matrix_data[period_key][member[:name]] || 0 %>
                    <%= hours > 0 ? format_hours(hours) : '—' %>
                  </td>
                <% end %>
                <td class="px-6 py-4 text-right font-semibold text-gray-900"><%= format_hours(@period_totals[period_key] || 0) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <%# Summary View: Simple Member Table (Hidden by default) — cards render client-side from the embedded payload %>
      <div id="team-member-summary-view" style="display: none;" class="px-4 py-4">
        <% member_summary_payload = {
             grandTotal: @grand_total.to_f,
             items: @member_totals.map do |member_name, hours|
               member = @members.find { |m| m[:name] == member_name }
               {
                 name: member_name,
                 hours: hours.to_f,
                 memberId: member && member[:id],
                 url: member ? my_time_path(@member_dashboard_params.merge(user_id: member[:id])) : nil,
                 activeDaysHtml: (member && @member_active_days) ? ta_active_days_text(@member_active_days[member[:id]].to_f, @active_days_count) : nil
               }
             end
           }.to_json %>
        <div id="team-member-summary-payload" data-payload='<%= member_summary_payload %>' style="display:none;"></div>
        <div class="space-y-2 px-2">
          <div id="team-member-summary-cards"></div>
        </div>
        <div class="pagination-wrapper">
          <span id="team-member-summary-pagination-links"></span>
          <div class="pagination-info" id="team-member-summary-pagination-info"></div>
        </div>

        <div class="space-y-2 px-2">
          <%# Temporarily-excluded members: still listed (struck-through) but counted in no aggregate %>
          <% Array(@temp_excluded_members).each do |member| %>
            <div class="ta-member-excluded bg-white hover:bg-gray-50 rounded-lg px-2 py-1 transition-colors duration-200" data-hours="<%= member[:hours].to_f %>" data-name="<%= h(member[:name]) %>" data-excluded="true">
              <div class="flex items-center justify-between mb-1 gap-3">
                <h3 class="text-base font-medium text-gray-400 line-through flex items-center gap-2">
                  <%= member[:name] %>
                  <span class="ta-member-excluded-badge no-underline">EXCLUDED</span>
                </h3>
                <div class="flex items-center gap-3">
                  <span class="text-base font-semibold text-gray-400"><%= format_hours(member[:hours]) %></span>
                  <span class="text-sm font-medium text-gray-400 min-w-[45px] text-right">—</span>
                  <label class="relative inline-flex items-center cursor-pointer" title="Include in team analytics">
                    <input type="checkbox" class="sr-only peer member-exclusion-toggle" data-user-id="<%= member[:id] %>">
                    <div class="ta-custom-toggle-track"></div>
                  </label>
                </div>
              </div>
              <div class="h-2 bg-gray-200 rounded-full overflow-hidden">
                <div class="h-full rounded-full bg-gray-300" style="width: 100%;"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Monthly avg View: per-member daily average per month (monthly grouping only) — client-side sort+paginate %>
      <% if @member_monthly_avg %>
        <div id="team-member-monthly-avg-view" style="display: <%= @member_view_state == 'monthly_avg' ? 'block' : 'none' %>;" class="ta-analysis-table-scroll overflow-x-auto">
          <% monthly_avg_payload = {
               months: @member_monthly_avg[:months],
               items: @member_monthly_avg[:rows].map do |row|
                 {
                   id: row[:id],
                   name: row[:name],
                   url: my_time_path(@member_dashboard_params.merge(user_id: row[:id])),
                   monthly: row[:monthly],
                   overall: row[:overall]
                 }
               end
             }.to_json %>
          <div id="team-member-monthly-avg-payload" data-payload='<%= monthly_avg_payload %>' style="display:none;"></div>
          <table id="team-member-monthly-avg-table" class="w-full text-sm text-left text-gray-500">
            <thead class="text-sm text-gray-700 bg-gray-50">
              <tr class="border-b border-gray-200">
                <th class="px-6 py-3 cursor-pointer select-none hover:text-gray-900" onclick="taMonthlyAvgSortClick('name')">Member <span class="ta-mavg-sort-ind text-gray-400" id="mavg-sort-ind-name"></span></th>
                <% @member_monthly_avg[:months].each do |mo| %>
                  <th class="px-6 py-3 text-right cursor-pointer select-none hover:text-gray-900" onclick="taMonthlyAvgSortClick('<%= mo[:key] %>')"><%= mo[:label] %> <span class="ta-mavg-sort-ind text-gray-400" id="mavg-sort-ind-<%= mo[:key] %>"></span></th>
                <% end %>
                <th class="px-6 py-3 text-right cursor-pointer select-none hover:text-gray-900 border-l-2 border-gray-300 font-bold" onclick="taMonthlyAvgSortClick('overall')">Overall avg <span class="ta-mavg-sort-ind text-gray-400" id="mavg-sort-ind-overall"></span></th>
              </tr>
            </thead>
            <tbody id="team-member-monthly-avg-cards"></tbody>
          </table>
          <div class="pagination-wrapper">
            <span id="team-member-monthly-avg-pagination-links"></span>
            <div class="pagination-info" id="team-member-monthly-avg-pagination-info"></div>
          </div>
        </div>
      <% end %>

      <%# Pagination for Member view (Detailed only — Summary/Monthly avg paginate client-side above) %>
      <div id="team-member-detailed-pagination-bar" class="pagination-wrapper" style="<%= (@member_view_state == 'summary' || @member_view_state == 'monthly_avg') ? 'display: none;' : '' %>">
        <span id="team-member-pagination-links">
          <% current_page = params[:page].to_i > 0 ? params[:page].to_i : 1 %>
          <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :view_mode, :team_id, :member_view_state, temp_excluded_ids: []) %>
          <%= pagination_links(current_page, @total_pages, permitted_params).html_safe %>
        </span>

        <div class="pagination-info" id="team-member-pagination-info">
          (<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)
        </div>
      </div>
      </div>

      <div class="ta-analysis-donut bg-white rounded-lg shadow-md p-4 border border-gray-200">
        <div class="relative h-80 flex items-center justify-center">
          <canvas id="team-donut-chart" class="chart"></canvas>
          <div id="team-donut-center-text" class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
            <span class="text-3xl font-bold text-gray-900" id="team-total-hours-display">0.00</span>
            <span class="text-xs text-gray-500">Total Hours</span>
          </div>
        </div>
        <div id="team-donut-legend" class="mt-4 space-y-1.5 max-h-[28rem] overflow-y-auto text-sm"></div>
      </div>
    </div>
  <% else %>
    <div class="ta-analysis-layout flex gap-6 mb-6">
      <div class="ta-analysis-table flex-1 bg-white rounded-lg shadow-md border border-gray-200 min-w-0">
        <div class="px-6 py-8 text-center">
          <p class="text-sm text-gray-500"><%= no_table_data_message %></p>
        </div>
      </div>
      <div class="ta-analysis-donut bg-white rounded-lg shadow-md p-4 border border-gray-200">
        <div class="h-80 flex items-center justify-center">
          <p class="text-center text-gray-500 text-sm px-4"><%= no_chart_data_message %></p>
        </div>
      </div>
    </div>
  <% end %>
<% end %>

<%# ===== Member Breakdown: per-member second-level grouping (Issue/Activity/Project), lazy-loaded ===== %>
<%# Visible in all view modes so users can inspect member commitment regardless of which tab is active. %>
<% if @selected_team %>
<div class="ta-member-breakdown bg-white rounded-lg shadow-md border border-gray-200 mb-6"
     data-breakdown-url="<%= team_analytics_member_breakdown_path %>"
     data-team-id="<%= @selected_team&.id %>"
     data-filter="<%= @filter %>"
     data-from="<%= @from %>"
     data-to="<%= @to %>">
  <button type="button" id="member-breakdown-toggle"
          aria-expanded="false" aria-controls="member-breakdown-body"
          class="ta-bd-header-btn w-full flex items-center gap-2 px-6 py-4 text-left rounded-lg hover:bg-gray-50 transition-colors">
    <svg id="member-breakdown-chevron" class="w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200 -rotate-90" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
    <span class="text-lg font-semibold text-gray-900"><%= l(:label_member_breakdown) %></span>
  </button>

  <div id="member-breakdown-body" class="hidden border-t border-gray-200">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-start gap-3 px-6 py-3 bg-gray-50 border-b border-gray-100">
      <div class="inline-flex rounded-md shadow-sm" role="group" id="member-breakdown-grouping">
        <button type="button" data-grouping="issue"
                class="member-bd-group-btn inline-flex items-center px-4 py-2 text-sm font-medium border border-gray-300 rounded-l-lg focus:outline-none !bg-[#3b82f6] !text-white">
          <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
          </svg>
          <%= l(:label_issue) %>
        </button>
        <button type="button" data-grouping="activity"
                class="member-bd-group-btn inline-flex items-center px-4 py-2 text-sm font-medium border-y border-gray-300 focus:outline-none !bg-white !text-gray-700 hover:!bg-gray-50">
          <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 10a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-7 8a7 7 0 0 1 14 0H3Zm14.5-9.5a2.5 2.5 0 1 0-2.5-2.5 2.5 2.5 0 0 0 2.5 2.5Zm-1.795 3.704A6.96 6.96 0 0 1 20 18h-2a4.96 4.96 0 0 0-2.295-4.296Z"/>
          </svg>
          <%= l(:label_activity) %>
        </button>
        <button type="button" data-grouping="project"
                class="member-bd-group-btn inline-flex items-center px-4 py-2 text-sm font-medium border border-gray-300 rounded-r-lg focus:outline-none !bg-white !text-gray-700 hover:!bg-gray-50">
          <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 20">
            <path d="M16 1h-3.278A1.992 1.992 0 0 0 11 0H7a1.993 1.993 0 0 0-1.722 1H2a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm-3 14H5a1 1 0 0 1 0-2h8a1 1 0 0 1 0 2Zm0-4H5a1 1 0 0 1 0-2h8a1 1 0 1 1 0 2Zm0-5H5a1 1 0 0 1 0-2h2V2h4v2h2a1 1 0 1 1 0 2Z"/>
          </svg>
          <%= l(:label_project) %>
        </button>
      </div>
    </div>

    <div id="member-breakdown-loading" class="hidden px-6 py-12 text-center text-gray-500 text-sm">
      <span class="material-symbols-outlined align-middle animate-spin" aria-hidden="true">progress_activity</span>
      <span class="align-middle ml-2"><%= l(:label_member_breakdown_loading) %></span>
    </div>
    <div id="member-breakdown-error" class="hidden px-6 py-12 text-center text-sm">
      <span class="material-symbols-outlined align-middle text-red-400" aria-hidden="true">error_outline</span>
      <span class="align-middle ml-2 text-red-500"><%= l(:label_member_breakdown_error) %></span>
    </div>
    <div id="member-breakdown-empty" class="hidden px-6 py-12 text-center text-gray-500 text-sm"><%= l(:label_member_breakdown_empty) %></div>
    <%# Show ~6 cards (2 rows × 3 on lg) by default; the rest scroll within this section
        only (not the whole page). %>
    <div id="member-breakdown-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 p-6 overflow-y-auto" style="max-height: 30rem;"></div>
  </div>
</div>
<% end %>
</div>

<script>
  // Auto-submit team selector on change
  function switchTeamChartType(chartType) {
    const hiddenField = document.getElementById('chart_type_hidden');
    const form = document.getElementById('team-analytics-form');
    if (hiddenField && form) {
      hiddenField.value = chartType;
      if (typeof appendExclusionFieldsToForm === 'function') { appendExclusionFieldsToForm(form); }
      form.submit();
    }
  }

  // Toggle hiding weekend/holiday days from the Trend chart + Time Overview table.
  function toggleHolidays() {
    var url = new URL(window.location.href);
    if (url.searchParams.get('hide_holidays') === '1') {
      url.searchParams.delete('hide_holidays');
    } else {
      url.searchParams.set('hide_holidays', '1');
    }
    window.location.href = url.toString();
  }

  function scrollTeamTableIntoView() {
    var tableElement = document.querySelector('.ta-analysis-table');
    if (!tableElement) return;
    tableElement.scrollIntoView({ behavior: 'auto', block: 'start' });
  }

  document.addEventListener('DOMContentLoaded', function() {
    <% if @view_mode == 'activity' %>
      initTeamSummaryTable('team-activity-summary', taTeamSummaryCardHtml);
    <% elsif @view_mode == 'project' %>
      initTeamSummaryTable('team-project-summary', taTeamSummaryCardHtml);
    <% elsif @view_mode == 'members' %>
      initTeamSummaryTable('team-member-summary', taTeamMemberSummaryCardHtml);
      initTeamMonthlyAvgTable();
    <% end %>

    // Initialize chart
    initChart();
    initTeamDonutChart();

    // Persist scroll intent for Team tab navigation, matching My Time behavior.
    document.addEventListener('click', function(e) {
      if (e.target.closest('a[data-team-tab-nav="true"]')) {
        sessionStorage.setItem('teamScrollPosition', String(window.pageYOffset || document.documentElement.scrollTop || 0));
        sessionStorage.setItem('scrollToTeamTable', 'true');
      }
    });
    
    // Restore activity view state
    restoreActivityViewState();
    
    // Restore project view state
    restoreProjectViewState();
    
    // Restore member view state
    restoreMemberViewState();
  });

  window.addEventListener('load', function() {
    if (sessionStorage.getItem('scrollToTeamTable') === 'true') {
      sessionStorage.removeItem('scrollToTeamTable');
      sessionStorage.removeItem('teamScrollPosition');
      requestAnimationFrame(function() {
        requestAnimationFrame(scrollTeamTableIntoView);
      });
      return;
    }

    var savedScrollPosition = sessionStorage.getItem('teamScrollPosition');
    if (savedScrollPosition !== null) {
      sessionStorage.removeItem('teamScrollPosition');
      window.scrollTo(0, parseInt(savedScrollPosition, 10) || 0);
    }
  });

  var teamDonutChart = null;
  var TEAM_TABLEAU10 = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'];
  var noChartDataMessage = '<%= j no_chart_data_message %>';

  function renderTeamEmptyState(container, message) {
    if (!container) return;
    container.innerHTML = '<div class="h-80 flex items-center justify-center"><p class="text-center text-gray-500 text-sm px-4">' + message + '</p></div>';
  }

  function formatTeamHours(hours) {
    var value = parseFloat(hours || 0);
    var h = Math.floor(value);
    var m = Math.round((value - h) * 60);
    return h + ':' + (m < 10 ? '0' : '') + m;
  }

  function initTeamDonutChart() {
    var donutCanvas = document.getElementById('team-donut-chart');
    if (!donutCanvas) return;

    var labels = [];
    var values = [];
    <% if @view_mode == 'activity' && @activity_totals.present? %>
      <% @activity_totals.sort_by { |_, hours| -hours }.each do |activity, hours| %>
        labels.push('<%= j activity %>');
        values.push(<%= hours.to_f %>);
      <% end %>
    <% elsif @view_mode == 'project' && @project_totals.present? %>
      <% @project_totals.sort_by { |_, hours| -hours }.each do |project, hours| %>
        labels.push('<%= j project %>');
        values.push(<%= hours.to_f %>);
      <% end %>
    <% elsif @view_mode == 'members' %>
      // Build from the full member payload (not the paginated Summary DOM), so the donut
      // always reflects every included member regardless of which page is on screen.
      // Temporarily-excluded members are never part of this payload to begin with.
      var memberPayloadEl = document.getElementById('team-member-summary-payload');
      var memberData = memberPayloadEl
        ? JSON.parse(memberPayloadEl.getAttribute('data-payload')).items.filter(function(m) { return m.hours > 0; })
        : [];
      memberData.sort(function(a, b) {
        if (b.hours !== a.hours) { return b.hours - a.hours; }
        return a.name.localeCompare(b.name);
      });
      memberData.forEach(function(m) { labels.push(m.name); values.push(m.hours); });
    <% end %>

    var colors = labels.map(function(_, index) { return TEAM_TABLEAU10[index % TEAM_TABLEAU10.length]; });
    renderTeamDonutFromArrays(labels, values, colors);
  }

  // Builds/replaces the team donut chart + its legend from plain labels/values/colors arrays.
  // Shared by initTeamDonutChart (per-activity/project/member, from server-rendered data) and
  // the Activity tab's "Grouped" view (from the client-side regrouped pivot, see
  // team_activity_groups.js + rebuildTeamChartsForGroups below).
  function renderTeamDonutFromArrays(labels, values, colors) {
    var donutCanvas = document.getElementById('team-donut-chart');
    if (!donutCanvas) return;

    // The canvas's parent (div.relative.h-80) is a positioned element that sits above the
    // static member-list column in z-order. Re-enable pointer events in case we previously
    // disabled them (e.g., navigating from all-excluded back to partial-excluded).
    var donutInner = donutCanvas.parentNode;
    if (donutInner) donutInner.style.pointerEvents = '';

    if (teamDonutChart) {
      teamDonutChart.destroy();
      teamDonutChart = null;
    }

    if (!labels.length || !values.length) {
      // No active members (e.g. all temporarily excluded): zero the centre total and disable
      // pointer events on the empty canvas container so it doesn't block the member-list toggles
      // below it in z-order.
      var emptyTotal = document.getElementById('team-total-hours-display');
      if (emptyTotal) emptyTotal.textContent = formatTeamHours(0);
      if (donutInner) donutInner.style.pointerEvents = 'none';
      return;
    }

    var total = values.reduce(function(sum, val) { return sum + val; }, 0);
    var totalDisplay = document.getElementById('team-total-hours-display');
    if (totalDisplay) totalDisplay.textContent = formatTeamHours(total);

    teamDonutChart = new Chart(donutCanvas.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: colors,
          borderColor: '#ffffff',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutoutPercentage: 65,
        legend: { display: false },
        tooltips: {
          callbacks: {
            label: function(tooltipItem, data) {
              var label = data.labels[tooltipItem.index] || '';
              var value = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index] || 0;
              var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return label + ': ' + formatTeamHours(value) + ' (' + percentage + '%)';
            }
          }
        }
      }
    });

    var legend = document.getElementById('team-donut-legend');
    if (!legend) return;
    legend.innerHTML = '';

    labels.forEach(function(label, index) {
      var value = values[index];
      var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
      var item = document.createElement('div');
      item.className = 'flex items-center justify-between text-xs';
      item.innerHTML = '<div class="flex items-center gap-1.5 flex-1 min-w-0">' +
        '<div class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: ' + colors[index] + '"></div>' +
        '<span class="text-gray-700 truncate">' + label + '</span>' +
        '</div>' +
        '<div class="flex items-center gap-1.5 ml-2 flex-shrink-0">' +
        '<span class="font-semibold text-gray-900">' + formatTeamHours(value) + '</span>' +
        '<span class="font-semibold" style="color: ' + colors[index] + '">(' + percentage + '%)</span>' +
        '</div>';
      legend.appendChild(item);
    });
  }

  // Chart initialization
  var teamChart = null;

  function initChart() {
    var chartElement = document.getElementById('time-chart');
    if (!chartElement) {
      console.log('Chart element not found');
      return;
    }

    // Prevent multiple chart creation
    if (teamChart) {
      teamChart.destroy();
      teamChart = null;
    }

    try {
      var chartData = chartElement.getAttribute('data-chart');
      if (!chartData || chartData === 'null' || chartData === '') {
        console.log('No chart data available');
        return;
      }

      var config = JSON.parse(chartData);

      var hasDatasets = config && config.data && Array.isArray(config.data.datasets) && config.data.datasets.length > 0;
      var hasLabels = config && config.data && Array.isArray(config.data.labels) && config.data.labels.length > 0;
      var allValuesZero = hasDatasets && config.data.datasets.every(function(dataset) {
        if (!dataset || !Array.isArray(dataset.data) || dataset.data.length === 0) return true;
        return dataset.data.every(function(value) {
          var numeric = parseFloat(value || 0);
          return isNaN(numeric) || numeric === 0;
        });
      });

      if (config.empty || !hasDatasets || !hasLabels || allValuesZero) {
        renderTeamEmptyState(chartElement.parentElement, noChartDataMessage);
        return;
      }
      
      // Weekend/holiday points keep their amber colour when the dataset carries holidayFlags.
      if (config.type === 'line' && Array.isArray(config.data.datasets)) {
        config.data.datasets.forEach(function (ds) {
          if (ds && ds.holidayFlags && ds.holidayFlags.length) {
            var pointColors = ds.holidayFlags.map(function (h) { return h ? '#f59e0b' : '#1d4ed8'; });
            ds.pointBackgroundColor = pointColors;
            ds.pointBorderColor = pointColors;
            ds.pointBorderWidth = 1;
          }
        });
      }

      // Ensure responsive configuration
      if (!config.options) {
        config.options = {};
      }
      config.options.responsive = true;
      config.options.maintainAspectRatio = false;

      // Match My Time chart tooltip behavior (Chart.js v2)
      if (!config.options.tooltips) config.options.tooltips = {};
      if (!config.options.tooltips.callbacks) config.options.tooltips.callbacks = {};

      config.options.tooltips.filter = function(tooltipItem, data) {
        if (!tooltipItem || !data || !data.datasets) return false;
        var dataset = data.datasets[tooltipItem.datasetIndex];
        if (!dataset || !dataset.data) return false;
        var value = dataset.data[tooltipItem.index];
        return value !== 0 && value !== '0.00';
      };

      config.options.tooltips.callbacks.title = function(tooltipItems, data) {
        if (!tooltipItems || tooltipItems.length === 0 || !tooltipItems[0]) return '';
        var index = tooltipItems[0].index;
        if (index === undefined || index === null) return '';

        var dataset = data && data.datasets ? data.datasets[0] : null;
        if (dataset && dataset.tooltipLabels && dataset.tooltipLabels[index]) {
          return dataset.tooltipLabels[index];
        }

        if (data && data.labels && data.labels[index] !== undefined) {
          return data.labels[index];
        }
        return '';
      };

      config.options.tooltips.callbacks.label = function(tooltipItem, data) {
        if (!tooltipItem || !data || !data.datasets) return '';
        var dataset = data.datasets[tooltipItem.datasetIndex];
        if (!dataset) return '';

        var label = dataset.label || '';
        if (dataset.formattedHours && dataset.formattedHours[tooltipItem.index]) {
          return label + ': ' + dataset.formattedHours[tooltipItem.index];
        }

        var value = tooltipItem.yLabel !== undefined ? tooltipItem.yLabel : (dataset.data && dataset.data[tooltipItem.index]);
        if (value !== undefined && typeof value === 'number') {
          return label + ': ' + formatTeamHours(value);
        }
        return label;
      }

      if (window.TaChartPlugins) {
        TaChartPlugins.applyHolidayLegend(config);
      }

      console.log('Creating chart with config:', config);
      teamChart = new Chart(chartElement, config);
      console.log('Chart created successfully');
      
      // Render custom legend for bar charts (Stacked views)
      if (config.type === 'bar' && window.TaChartPlugins) {
        TaChartPlugins.renderChartLegend(teamChart, 'team-chart-legend');
      }

    } catch (error) {
      console.error('Error creating chart:', error);
    }
  }

