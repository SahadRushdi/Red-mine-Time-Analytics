<%= render 'time_analytics/includes' %>
<%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
<%= javascript_include_tag 'ta_activity_group_board.js', plugin: 'redmine_time_analytics' %>
<%= javascript_include_tag 'team_activity_groups.js', plugin: 'redmine_time_analytics' %>
<% date_range_label = @from && @to ? "#{@from.strftime('%b %d')} – #{@to.strftime('%b %d, %Y')}" : l(:label_all_time) %>
<% no_table_data_message = "No data available for the selected period" %>
<% no_chart_data_message = "No data available for #{date_range_label}. Try adjusting filters or selecting a different date range." %>

<!-- jsTree CSS and JS from CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.16/themes/default/style.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.16/jstree.min.js"></script>

<!-- Material Icons from Google Fonts -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
  .team-dashboard-shell {
    display: flex;
    align-items: stretch;
    gap: 16px;
    width: 100%;
  }

  .team-tree-sidebar {
    position: relative;
    flex: 0 0 360px;
    width: 360px;
    min-width: 280px;
    max-width: 420px;
    display: flex;
    align-self: stretch;
    transition: flex-basis 0.24s ease, width 0.24s ease, min-width 0.24s ease;
  }

  .team-tree-sidebar.is-collapsed {
    flex-basis: 56px;
    width: 56px;
    min-width: 56px;
  }

  .team-tree-sidebar__panel {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    width: 100%;
    min-height: 0;
  }

  .team-tree-sidebar__panel {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Override Redmine theme blue hover for modal close icon */
  [data-modal-hide="team-member-details-modal"]:hover {
    color: #111827 !important;
    background-color: #f3f4f6 !important;
  }
  [data-modal-hide="team-member-details-modal"]:hover svg,
  [data-modal-hide="team-member-details-modal"]:hover svg path {
    stroke: #111827 !important;
  }

  .team-tree-sidebar.is-collapsed .team-tree-sidebar__panel {
    display: flex;
    overflow: hidden;
  }

  .team-tree-sidebar.is-collapsed .tree-view-content {
    display: none;
  }

  .team-tree-sidebar__toggle-row {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: flex-start;
    padding: 0 12px;
    pointer-events: none;
    z-index: 3;
  }

  .tree-view-content {
    padding: 46px 18px 22px;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }

  #team-tree-container {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 12px 10px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 8px 22px rgba(148, 163, 184, 0.16);
  }

  .tree-view-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 4px;
    color: #1d4ed8;
    font-size: 22px;
    transition: color 0.2s, background-color 0.2s, transform 0.2s;
    border-radius: 10px;
    vertical-align: middle;
    text-decoration: none;
    outline: none;
    line-height: 1;
    appearance: none;
    -webkit-appearance: none;
    -webkit-tap-highlight-color: transparent;
  }

  .tree-view-toggle-btn:hover,
  .tree-view-toggle-btn:focus,
  .tree-view-toggle-btn:active,
  .tree-view-toggle-btn:focus-visible,
  .tree-view-toggle-btn:visited {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    border-color: transparent !important;
    box-shadow: none !important;
    color: #1e40af;
    outline: none !important;
    text-decoration: none !important;
  }

  .tree-view-toggle-btn:active {
    transform: none;
  }

  .tree-view-toggle-btn .material-symbols-outlined {
    font-size: 24px;
    vertical-align: middle;
    display: block;
  }

  .team-tree-sidebar-toggle {
    position: relative;
    top: auto;
    right: auto;
    left: auto;
    z-index: 4;
    margin-right: 0;
    border-radius: 9999px;
    pointer-events: auto;
  }

  .team-dashboard-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (max-width: 1279px) {
    .team-dashboard-shell {
      flex-direction: column;
    }

    .team-tree-sidebar {
      width: 100%;
      flex: 1 1 auto;
      min-width: 0;
      max-width: none;
    }

    .team-tree-sidebar.is-collapsed {
      width: 100%;
      flex-basis: auto;
      min-width: 0;
    }
  }

  /* jsTree customization */
  #team-tree-container .jstree-default .jstree-anchor {
    height: auto;
    line-height: 24px;
    padding: 7px 10px;
    border-radius: 10px;
    transition: all 0.15s ease;
    color: #1e293b;
  }

  #team-tree-container .jstree-default .jstree-node {
    margin-bottom: 4px;
  }

  #team-tree-container .jstree-default .jstree-clicked {
    background-color: #dbeafe !important;
    border: 1px solid #93c5fd;
    color: #1e3a8a !important;
  }

  #team-tree-container .jstree-anchor[data-node-type="member"].jstree-clicked {
    background-color: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
    color: #1d4ed8 !important;
    font-weight: 500 !important;
  }

  #team-tree-container li.team-tree-active-row > .jstree-wholerow {
    background: linear-gradient(90deg, #eff6ff 0%, #dbeafe 100%) !important;
    border: 1px solid #93c5fd !important;
    box-shadow: none !important;
    border-radius: 10px !important;
  }

  #team-tree-container li.team-tree-active-row > a.jstree-anchor {
    color: #1d4ed8 !important;
    font-weight: 800 !important;
  }

  /* Team composition count badge shown after each team name in the tree */
  #team-tree-container .team-tree-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 18px;
    margin-left: 8px;
    padding: 0 7px;
    border-radius: 9999px;
    background-color: #eff6ff;
    color: #2563eb;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    vertical-align: middle;
  }

  #team-tree-container li.team-tree-active-row > a.jstree-anchor .team-tree-count-badge {
    background-color: #bfdbfe;
    color: #1e3a8a;
  }

  #team-tree-container li.team-tree-active-row > a.jstree-anchor:hover {
    color: #1d4ed8 !important;
  }

  #team-tree-container .jstree-default .jstree-hovered {
    background-color: #eff6ff !important;
    color: #1e40af !important;
  }

  #team-tree-container .jstree-default .jstree-icon.jstree-ocl {
    margin-top: 2px;
  }

  /* Team nodes are primary selection targets */
  #team-tree-container .jstree-anchor[data-node-type="team"] {
    font-weight: 700;
    color: #0f172a;
    letter-spacing: 0.01em;
  }

  /* Members navigate to individual dashboard in new tab */
  #team-tree-container .jstree-anchor[data-node-type="member"] {
    color: #1d4ed8;
    font-weight: 500;
  }

  #team-tree-container .jstree-anchor[data-node-type="member"]:hover {
    text-decoration: underline;
  }

  #team-tree-container .jstree-anchor[data-node-type="member"][data-excluded="true"] {
    color: #b45309;
    font-weight: 600;
  }

  #team-tree-container .jstree-anchor[data-node-type="member"][data-excluded="true"]::after {
    content: "★";
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 9999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #92400e;
    background: #fef3c7;
    border: 1px solid #fcd34d;
    vertical-align: middle;
  }

  /* Projects node styling */
  #team-tree-container .jstree-anchor[data-node-type="projects"] {
    color: #64748b;
    font-style: italic;
    font-size: 12px;
  }

  /* Unified card: view tabs + analysis table + pie chart read as one bordered card */
  .ta-team-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }

  /* Tabs sit flush at the top of the card with a divider beneath them */
  .ta-team-card .ta-team-tabs-row {
    border-bottom: 1px solid #e2e8f0;
  }

  /* Drop the inner cards' own chrome so table + donut merge into the parent card */
  .ta-team-card .ta-analysis-layout {
    margin-bottom: 0;
    gap: 0;
  }

  .ta-team-card .ta-analysis-table,
  .ta-team-card .ta-analysis-donut {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .ta-team-card .ta-analysis-donut {
    border-left: 1px solid #e2e8f0;
  }

  @media (max-width: 1123px) {
    .ta-team-card .ta-analysis-donut {
      border-left: 0;
      border-top: 1px solid #e2e8f0;
    }
  }

</style>

<script type="text/javascript">
  const teamDashboardBaseUrl = '<%= team_analytics_path(params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :view_mode, :activity_view_state, :project_view_state, :member_view_state, temp_excluded_ids: []).to_h) %>';
  const currentTeamId = '<%= @selected_team&.id %>';
  const teamTreeSidebarStorageKey = 'team_tree_sidebar_state';
  let teamTreeLoaded = false;
  let teamTreeLoading = false;

  function getTreeSidebarState() {
    try {
      const saved = localStorage.getItem(teamTreeSidebarStorageKey);
      return saved || 'expanded';
    } catch (error) {
      return 'expanded';
    }
  }

  function setTreeSidebarState(state) {
    try {
      localStorage.setItem(teamTreeSidebarStorageKey, state);
    } catch (error) {
      // Ignore storage failures and keep the current UI state.
    }
  }

  function updateTreeSidebarToggleButtons(isCollapsed) {
    const toggleLabel = isCollapsed ? 'Expand team hierarchy' : 'Collapse team hierarchy';

    document.querySelectorAll('[data-tree-sidebar-toggle]').forEach(function(button) {
      button.setAttribute('aria-expanded', String(!isCollapsed));
      button.setAttribute('aria-label', toggleLabel);
      button.setAttribute('title', toggleLabel);

      const icon = button.querySelector('.material-symbols-outlined');
      if (icon) {
        icon.textContent = isCollapsed ? 'chevron_right' : 'chevron_left';
      }
    });
  }

  function setTreeSidebarCollapsed(isCollapsed, options) {
    const sidebar = document.getElementById('team-tree-sidebar');
    if (!sidebar) return;

    sidebar.classList.toggle('is-collapsed', isCollapsed);
    sidebar.classList.toggle('is-expanded', !isCollapsed);
    updateTreeSidebarToggleButtons(isCollapsed);

    if (!(options && options.persist === false)) {
      setTreeSidebarState(isCollapsed ? 'collapsed' : 'expanded');
    }

    if (!isCollapsed) {
      loadTreeData();
    }
  }

  function toggleTreeSidebar() {
    const sidebar = document.getElementById('team-tree-sidebar');
    if (!sidebar) return;
    setTreeSidebarCollapsed(!sidebar.classList.contains('is-collapsed'));
  }

  function highlightActiveTeamNode() {
    if (!currentTeamId) return;

    const activeAnchor = $('#team-tree-container .jstree-anchor[data-team-id="' + currentTeamId + '"]');
    if (!activeAnchor.length) return;

    $('#team-tree-container li.team-tree-active-row')
      .removeClass('team-tree-active-row')
      .removeAttr('aria-current');

    const activeRow = activeAnchor.closest('li');
    activeRow.addClass('team-tree-active-row');
    activeRow.attr('aria-current', 'true');
  }

  function loadTreeData() {
    if (teamTreeLoading || teamTreeLoaded) return;

    teamTreeLoading = true;
    var fromDate = '<%= @from %>';
    var toDate = '<%= @to %>';
    
    $.ajax({
      url: '<%= team_analytics_tree_data_path %>',
      type: 'GET',
      data: { from: fromDate, to: toDate },
      dataType: 'json',
      success: function(data) {
        teamTreeLoaded = true;
        initializeTree(data);
      },
      error: function(xhr, status, error) {
        console.error('Error loading tree data:', error);
        $('#team-tree-container').html('<p style="color: red;">Error loading tree view. Please try again.</p>');
        teamTreeLoaded = false;
      },
      complete: function() {
        teamTreeLoading = false;
      }
    });
  }
  
  function initializeTree(treeData) {
    $('#team-tree-container').jstree('destroy');
    
    // Load saved node states from localStorage
    const savedNodeStates = getSavedTreeNodeStates();
    
    // Merge saved states with tree data
    treeData = treeData.map(function(node) {
      return mergeNodeState(node, savedNodeStates);
    });
    
    $('#team-tree-container').jstree({
      'core': {
        'data': treeData,
        'themes': {
          'name': 'default',
          'responsive': true,
          'dots': false,
          'icons': false
        }
      },
      'plugins': ['types', 'wholerow', 'state'],
      'state': {
        'key': 'jstree_tree_state',
        'events': 'changed.jstree open_node.jstree close_node.jstree'
      }
    });

    $('#team-tree-container').off('select_node.jstree');
    $('#team-tree-container').off('ready.jstree');
    $('#team-tree-container').off('open_node.jstree');
    $('#team-tree-container').off('close_node.jstree');

    // Team node switches dashboard team; member node opens individual dashboard.
    $('#team-tree-container').on('select_node.jstree', function (e, data) {
      if (data.node.data && data.node.data.team_id) {
        var teamId = String(data.node.data.team_id);
        highlightActiveTeamNode();
        if (teamId === currentTeamId) {
          setTreeSidebarCollapsed(true);
          return;
        }

        var targetUrl = new URL(window.location.href);
        targetUrl.searchParams.set('team_id', teamId);
        targetUrl.searchParams.delete('page');
        // Temporary exclusions are per-team — never carry one team's excluded members
        // into another team (otherwise the other team would adopt them as its own).
        targetUrl.searchParams.delete('temp_excluded_ids[]');
        window.location.assign(targetUrl.toString());
        return;
      }

      if (data.node.data && data.node.data.user_id) {
        var userId = data.node.data.user_id;
        var url = '<%= my_time_path %>' + '?user_id=' + userId + '&<%= @member_dashboard_query %>';
        window.open(url, '_blank');
        setTimeout(function() {
          data.instance.deselect_all(true);
        }, 0);
      }
    });

    // Save node state when expanding/collapsing
    $('#team-tree-container').on('open_node.jstree', function (e, data) {
      if (data.node.data && data.node.data.team_id) {
        saveTreeNodeState(data.node.id, true);
      }
    });

    $('#team-tree-container').on('close_node.jstree', function (e, data) {
      if (data.node.data && data.node.data.team_id) {
        saveTreeNodeState(data.node.id, false);
      }
    });

    $('#team-tree-container').on('ready.jstree', function () {
      highlightActiveTeamNode();
    });

    setTimeout(highlightActiveTeamNode, 0);
  }

  // Get saved tree node states from localStorage
  function getSavedTreeNodeStates() {
    try {
      const saved = localStorage.getItem('team_tree_node_states');
      return saved ? JSON.parse(saved) : {};
    } catch (error) {
      return {};
    }
  }

  // Save tree node state to localStorage
  function saveTreeNodeState(nodeId, isOpen) {
    try {
      const states = getSavedTreeNodeStates();
      states[nodeId] = isOpen;
      localStorage.setItem('team_tree_node_states', JSON.stringify(states));
    } catch (error) {
      // Ignore storage failures
    }
  }

  // Merge saved node state with tree data recursively
  function mergeNodeState(node, savedStates) {
    if (node.data && node.data.team_id) {
      const nodeId = node.id;
      const isSaved = savedStates[nodeId];
      
      // If there's a saved state, use it; otherwise keep the default
      if (isSaved !== undefined) {
        node.state = node.state || {};
        node.state.opened = isSaved;
      }
    }
    
    // Recursively process children
    if (node.children && node.children.length > 0) {
      node.children = node.children.map(function(child) {
        return mergeNodeState(child, savedStates);
      });
    }
    
    return node;
  }
  
  $(document).ready(function() {
    // Restore saved sidebar state on page load
    const savedSidebarState = getTreeSidebarState();
    const isCollapsed = savedSidebarState === 'collapsed';
    setTreeSidebarCollapsed(isCollapsed, { persist: false });
  });
</script>

<div class="team-dashboard-shell">
  <aside id="team-tree-sidebar" class="team-tree-sidebar is-expanded" aria-label="Team hierarchy sidebar">
    <div class="team-tree-sidebar__panel">
      <div class="team-tree-sidebar__toggle-row">
        <button type="button" class="tree-view-toggle-btn team-tree-sidebar-toggle" data-tree-sidebar-toggle onclick="toggleTreeSidebar()" aria-label="Collapse team hierarchy" title="Collapse team hierarchy">
          <span class="material-symbols-outlined">chevron_left</span>
        </button>
      </div>
      <div class="tree-view-content">
        <div id="team-tree-container">
          <p style="text-align: center; color: #999; padding: 20px;">Loading team structure...</p>
        </div>
      </div>
    </div>
  </aside>
  <div class="team-dashboard-main">
<div class="flex items-start justify-between mb-6 flex-wrap gap-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 mb-1">
        <%= @selected_team&.name || l(:label_team_dashboard) || "Team Dashboard" %>
      </h1>
    <p class="text-sm text-gray-500">
      <%= "#{@from.strftime('%b %d')} – #{@to.strftime('%b %d, %Y')}" %>
    </p>
  </div>

  <div class="flex items-center justify-end gap-3 flex-wrap">
    <div id="filters" class="m-0">
      <%= render(partial: 'team_analytics/filters_panel') %>
    </div>

    <%= link_to team_analytics_export_csv_path(params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode, :team_id)),
        method: :post,
        id: 'team-export-csv-btn',
        style: 'background-color: #3b82f6 !important; color: white !important;',
        class: 'inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium !text-white !bg-[#3b82f6] rounded-lg hover:!bg-[#2563eb] focus:ring-4 focus:ring-blue-300 shadow-xs focus:outline-none transition-colors' do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"/>
      </svg>
      <%= l(:label_export_csv) %>
    <% end %>
  </div>
</div>

<div id="ts-summary-cards-row" class="ts-summary-cards-row mb-6">
  <div class="ts-summary-card ts-summary-card--total flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Total Hours</p>
      <p class="ts-summary-card-value"><%= format_hours(@total_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>
  <div class="ts-summary-card ts-summary-card--active-days flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M8 7V3m8 4V3M4 10h16M6 5h12a2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V7a2 2 0 012-2z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Working Days</p>
      <p class="ts-summary-card-value"><%= @active_days_count %> <span class="ts-summary-card-unit">days</span></p>
      <p class="text-xs text-gray-500 mt-1">
        Leave Days: <%= number_with_precision(@team_leave_days || 0, precision: 1) %>
      </p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--average flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 19h16M7 16v-4m5 4V8m5 8v-6"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label"><%= max_label_for_grouping(@grouping) %></p>
      <p class="ts-summary-card-value"><%= format_hours(@max_period_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--issues flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M9 5h6M8 3h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V5a2 2 0 012-2zm2 7h6m-6 4h4"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label"><%= min_label_for_grouping(@grouping) %></p>
      <p class="ts-summary-card-value"><%= format_hours(@min_period_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>
</div>

<%# Dashboard Analytics Section - Summary, Time Overview, and Visualization %>
<div class="analytics-section">

  <%# Time Overview Box (Middle) - Shows Date, Team Member Count, Hours %>
  <% if (@view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members') && @time_overview_data&.any? %>
    <div id="team-time-overview-box" class="box time-overview-box">
      <div class="relative mb-3 flex items-center">
        <h3 class="text-base font-semibold text-gray-900"><%= time_overview_header(@grouping) %></h3>
        <% if @show_effective_time_column %>
          <%# Toggle to reveal the Support Time & Support Time (%) columns (hidden by default). %>
          <label class="absolute right-0 inline-flex items-center gap-2 cursor-pointer select-none"
                 title="Show Support Time &amp; Support Time (%)">
            <span class="text-xs font-medium text-gray-600">Support Time</span>
            <input type="checkbox" class="sr-only peer" onchange="toggleSupportTimeColumns(this)">
            <div class="ta-custom-toggle-track"></div>
          </label>
        <% end %>
      </div>
      <% if @effective_time_error_message.present? %>
        <div class="mb-3 rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-800">
          Effective Time data unavailable: <%= h(@effective_time_error_message) %>
        </div>
      <% end %>
      
      <div class="relative team-overview-table-wrap">
        <table class="w-full table-auto text-sm text-left text-gray-500">
          <thead class="text-sm text-gray-700 bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3">
                <%= @grouping == 'daily' ? l(:label_date) : l("label_#{@grouping}") %>
              </th>
              <th scope="col" class="px-2 py-3 text-center">Team<br/>Size</th>
              <th scope="col" class="px-2 py-3 text-right">Team<br/>Time</th>
              <th scope="col" class="px-6 py-3 text-right">Average</th>
              <% if @show_effective_time_column %>
                <th scope="col" class="ta-support-col px-2 py-3 text-right">Support<br/>Time</th>
                <th scope="col" class="ta-support-col px-2 py-3 text-right">Support<br/>Time (%)</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @time_overview_data.slice(@overview_offset, @overview_limit).each do |entry| %>
              <% is_holiday = entry.respond_to?(:holiday) && entry.holiday %>
              <% cell_color = is_holiday ? '#b45309' : '#111827' %>
              <tr class="bg-white border-b hover:bg-gray-50">
                <th scope="row" class="px-6 py-3 font-medium text-gray-700 whitespace-nowrap" style="color: <%= cell_color %>;">
                  <%= entry.period %>
                  <% if is_holiday %><span class="ml-1 text-xs" title="Weekend or holiday" style="color:#f59e0b;">&#9679;</span><% end %>
                </th>
                <td class="px-2 py-3 text-center text-gray-700" style="color: <%= cell_color %>;">
                  <div class="flex items-center justify-center gap-1.5">
                    <span><%= entry.member_count %></span>
                    <button type="button"
                            onclick="showTeamMemberDetails('<%= @selected_team.id %>', '<%= entry.raw_period %>', '<%= @grouping %>')"
                            class="ta-info-icon-btn flex items-center justify-center cursor-pointer"
                            title="View members">
                      <span class="material-symbols-outlined !text-[16px] leading-none select-none">info</span>
                    </button>
                  </div>
                </td>
                <td class="px-2 py-3 text-right font-mono text-gray-700" style="color: <%= cell_color %>;"><%= format_hours(entry.hours) %></td>
                <td class="px-6 py-3 text-right font-mono text-gray-700" style="color: <%= cell_color %>;"><%= format_hours(entry.average) %></td>
                <% if @show_effective_time_column %>
                  <td class="ta-support-col px-2 py-3 text-right font-mono text-gray-900"><%= format_hours(entry.support_hours || 0) %></td>
                  <td class="ta-support-col px-2 py-3 text-right font-mono text-gray-900">
                    <% if entry.effective_time_available %>
                      <%= number_with_precision(entry.effective_time_percentage, precision: 2) %>%
                    <% else %>
                      N/A
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <%# Pagination %>
      <div class="pagination-wrapper">
        <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode, :team_id, :hide_holidays, :activity_view_state, :project_view_state, :member_view_state, temp_excluded_ids: []) %>
        <%= overview_pagination_links(@overview_page, @overview_total_pages, permitted_params).html_safe %>
        
        <div class="pagination-info">
          (<%= @overview_offset + 1 %>-<%= [@overview_offset + @overview_limit, @time_overview_data.count].min %>/<%= @time_overview_data.count %>)
        </div>
      </div>
    </div>
    <script type="text/javascript">
      // Show/hide the Support Time & Support Time (%) columns (hidden by default).
      function toggleSupportTimeColumns(input) {
        var box = input.closest('#team-time-overview-box');
        var table = box && box.querySelector('table');
        if (table) { table.classList.toggle('ta-support-cols-visible', input.checked); }
      }
    </script>
  <% end %>

  <%# Visualization Section (Right Side) %>
  <div class="box visualization-section">
    <h3 style="display: flex; justify-content: flex-end;">
      <div class="visualization-controls flex items-center gap-3">
        <%# Toggle: hide weekend/holiday days from the Trend chart + Time Overview (daily grouping only). %>
        <% if @grouping == 'daily' && (@view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members') %>
          <label class="relative inline-flex items-center gap-2 cursor-pointer select-none"
                 title="Show only working days (hides weekends &amp; holidays without logged time and amber-flagged days)">
            <input type="checkbox" class="sr-only peer" <%= 'checked' if @hide_holidays %> onchange="toggleHolidays()">
            <div class="ta-custom-toggle-track"></div>
            <span class="text-sm font-medium text-gray-700 whitespace-nowrap">Show Active Days</span>
          </label>
        <% end %>
        <% if @view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members' %>
          <% chart_type = %w[line bar].include?(params[:chart_type]) ? params[:chart_type] : 'line' %>
          <div class="inline-flex gap-2">
            <button type="button"
                    onclick="switchTeamChartType('line')"
                    style="<%= chart_type == 'line' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= chart_type == 'line' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
              Trend
            </button>
            <button type="button"
                    onclick="switchTeamChartType('bar')"
                    style="<%= chart_type == 'bar' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= chart_type == 'bar' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
              Stacked
            </button>
          </div>
        <% end %>
      </div>
    </h3>
    
    <% if (@view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members') && @chart_data.present? && @entry_count > 0 %>
      <div id="chart-container" class="<%= chart_type == 'bar' ? 'has-chart-legend' : '' %>" style="display: block;">
        <div class="chart-wrapper">
          <canvas id="time-chart" class="chart"
                  data-chart='<%= @chart_data %>'
                  data-grouping-label="<%= grouping_label(@grouping) %>"></canvas>
        </div>
        <div id="team-chart-legend" class="ts-chart-legend-scroll mt-4"></div>
      </div>
    <% else %>
      <div id="chart-container" style="display: block;">
        <div class="chart-wrapper">
          <div class="h-80 flex items-center justify-center">
            <p class="text-center text-gray-500 text-sm px-4"><%= no_chart_data_message %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="ta-team-card">
<%= render(partial: 'team_analytics/view_togglers') %>
<% summary_chart_colors = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'] %>

