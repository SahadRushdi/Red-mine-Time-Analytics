  // ── Activity "Grouped" tab + session-only "Customize groups" popup ──────────────────────────
  // The raw per-activity payload is parsed once; customGroupState (null = server defaults) holds
  // the in-memory-only working copy after "Apply" in the Customize-groups modal. Nothing here is
  // ever persisted — a reload always reverts to the admin's real defaults.
  // Parsed eagerly (not inside a DOMContentLoaded listener) because restoreActivityViewState()
  // runs from the page's main DOMContentLoaded handler above, which is registered earlier in this
  // script and therefore fires first — the payload must already be available by then. Safe to
  // read synchronously here since this <script> executes after the payload <div> above it in the
  // document has already been parsed into the DOM.
  var activityGroupPayloadEl = document.getElementById('team-activity-group-payload');
  var activityGroupPayload = activityGroupPayloadEl ? JSON.parse(activityGroupPayloadEl.getAttribute('data-payload')) : null;
  var customGroupState = null;
  var customizeGroupsModal = null;
  var customizeGroupsBoard = null;

  function currentGroupsAndAssignments() {
    if (customGroupState) { return customGroupState; }
    return { groups: activityGroupPayload.groups, assignments: activityGroupPayload.assignments };
  }

  function computeCurrentGroupedPivot() {
    var gs = currentGroupsAndAssignments();
    return window.TeamActivityGroups.computeGroupedPivot(activityGroupPayload, gs.groups, gs.assignments);
  }

  function renderGroupedTableFromPivot(pivot) {
    var container = document.getElementById('team-activity-grouped-view');
    if (!container || !activityGroupPayload) return;
    var firstTh = container.querySelector('thead th');
    var periodLabel = firstTh ? firstTh.textContent : '';
    container.innerHTML = window.TeamActivityGroups.renderGroupedTableHtml(pivot, activityGroupPayload, periodLabel, taFormatHours);
  }

  function rebuildTeamChartsForGroups() {
    if (!activityGroupPayload) return;
    var pivot = computeCurrentGroupedPivot();
    renderGroupedTableFromPivot(pivot);

    var donut = window.TeamActivityGroups.buildDonutDatasets(pivot);
    renderTeamDonutFromArrays(donut.labels, donut.values, donut.colors);

    if (teamChart && teamChart.config && teamChart.config.type === 'bar') {
      var chartElement = document.getElementById('time-chart');
      var barData = window.TeamActivityGroups.buildStackedBarChartData(pivot, activityGroupPayload);
      teamChart.destroy();
      teamChart = new Chart(chartElement, {
        type: 'bar',
        data: barData,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: { xAxes: [{ stacked: true }], yAxes: [{ stacked: true }] }
        }
      });
    }
  }

  // Re-shows the original per-activity chart data (untouched by any grouping), used when leaving
  // the Grouped tab back to Summary/Detailed.
  function restoreTeamChartsToActivities() {
    initChart();
    initTeamDonutChart();
  }

  function hideGroupedView() {
    var gv = document.getElementById('team-activity-grouped-view');
    if (gv) gv.style.display = 'none';
    setTeamMemberButtonStyle(document.getElementById('show-grouped-btn-activity'), false);
    var wrapper = document.getElementById('team-activity-customize-groups-wrapper');
    if (wrapper) wrapper.style.display = 'none';
  }

  function showGroupedView(options) {
    var grouped = document.getElementById('team-activity-grouped-view');
    if (!grouped) return;
    var detailed = document.getElementById('team-activity-detailed-view');
    var summary = document.getElementById('team-activity-summary-view');
    if (detailed) detailed.style.display = 'none';
    if (summary) summary.style.display = 'none';
    grouped.style.display = 'block';

    setTeamMemberButtonStyle(document.getElementById('show-summary-btn-activity'), false);
    setTeamMemberButtonStyle(document.getElementById('show-detailed-btn-activity'), false);
    setTeamMemberButtonStyle(document.getElementById('show-grouped-btn-activity'), true);

    var sortButtons = document.getElementById('summary-sort-buttons');
    if (sortButtons) sortButtons.style.display = 'none';

    updateTeamPaginationInfo('activity', 'grouped');

    var wrapper = document.getElementById('team-activity-customize-groups-wrapper');
    if (wrapper) wrapper.style.display = '';

    var hiddenField = document.getElementById('activity_view_state_field');
    if (hiddenField) hiddenField.value = 'grouped';
    if (!(options && options.persist === false)) {
      localStorage.setItem('team_activity_view_mode', 'grouped');
    }

    rebuildTeamChartsForGroups();
  }

  function openCustomizeGroupsModal() {
    if (!activityGroupPayload) return;

    if (!customizeGroupsModal) {
      var modalEl = document.getElementById('customize-groups-modal');
      if (!modalEl || !window.Modal) return;
      customizeGroupsModal = new Modal(modalEl, {
        placement: 'center',
        backdrop: 'dynamic',
        backdropClasses: 'bg-gray-900/50 fixed inset-0 z-40',
        closable: true
      });
    }

    var gs = currentGroupsAndAssignments();
    var activities = Object.keys(activityGroupPayload.activityIds)
      .map(function (name) { return { id: activityGroupPayload.activityIds[name], name: name }; })
      .filter(function (a) { return a.id !== null && a.id !== undefined; });

    var boardEl = document.getElementById('customize-groups-board');
    boardEl.innerHTML = '';
    customizeGroupsBoard = TaActivityGroupBoard(boardEl, {
      groups: gs.groups,
      activities: activities,
      assignments: gs.assignments,
      ungroupedColor: activityGroupPayload.ungroupedColor,
      persistImmediately: false
    });

    customizeGroupsModal.show();
  }

  document.addEventListener('DOMContentLoaded', function () {
    var resetBtn = document.getElementById('customize-groups-reset-btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (!customizeGroupsBoard || !activityGroupPayload) return;
        customizeGroupsBoard.reset(activityGroupPayload.groups, activityGroupPayload.assignments);
      });
    }

    var applyBtn = document.getElementById('customize-groups-apply-btn');
    if (applyBtn) {
      applyBtn.addEventListener('click', function () {
        if (!customizeGroupsBoard) return;
        customGroupState = customizeGroupsBoard.getState();
        rebuildTeamChartsForGroups();
        if (customizeGroupsModal) customizeGroupsModal.hide();
      });
    }
  });

  function csvEscape(value) {
    return /[",\n]/.test(value) ? '"' + value.replace(/"/g, '""') + '"' : value;
  }

  // Exports the full payload (all members, all months), not just the currently-visible
  // page — the table itself only ever renders one page of rows at a time.
  function exportMonthlyAvgCsv() {
    var payloadEl = document.getElementById('team-member-monthly-avg-payload');
    if (!payloadEl) { return; }
    var payload = JSON.parse(payloadEl.getAttribute('data-payload'));
    var lines = [];
    var header = ['Member'].concat(payload.months.map(function (mo) { return mo.label; })).concat(['Overall avg']);
    lines.push(header.map(csvEscape).join(','));
    payload.items.forEach(function (item) {
      var row = [item.name].concat(payload.months.map(function (mo) {
        return taFormatHours(item.monthly[mo.key]);
      })).concat([taFormatHours(item.overall)]);
      lines.push(row.map(csvEscape).join(','));
    });
    var blob = new Blob(["\uFEFF" + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'team_monthly_avg.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var exportBtn = document.getElementById('team-export-csv-btn');
    if (!exportBtn) return;
    // When the Monthly avg view is active, export that table client-side instead of the
    // server CSV (which only knows view_mode/grouping). Capture phase + stopPropagation
    // prevents Rails UJS from also firing the server POST.
    exportBtn.addEventListener('click', function (e) {
      var mv = document.getElementById('team-member-monthly-avg-view');
      if (mv && mv.style.display !== 'none') {
        e.preventDefault();
        e.stopPropagation();
        exportMonthlyAvgCsv();
      }
    }, true);
  });

  var teamMemberDetailsModal = null;

  function showTeamMemberDetails(teamId, periodStart, grouping) {
    const modal = document.getElementById('team-member-details-modal');
    const tableBody = document.getElementById('team-member-details-table-body');
    const title = document.getElementById('team-member-details-title');
    const subtitle = document.getElementById('team-member-details-subtitle');

    if (!modal || !tableBody) return;

    // Show loading state
    title.textContent = 'Loading...';
    subtitle.textContent = '';
    tableBody.innerHTML = '<tr><td class="px-6 py-8 text-center text-gray-500">Fetching member details...</td></tr>';

    if (teamMemberDetailsModal) teamMemberDetailsModal.show();

    // Build fetch URL, including any temporary exclusions so the modal matches the table count.
    var fetchParams = new URLSearchParams({ team_id: teamId, period_start: periodStart, grouping: grouping });
    getUrlExclusions().forEach(function(id) { fetchParams.append('temp_excluded_ids[]', id); });

    fetch(`<%= team_analytics_period_members_path %>?${fetchParams.toString()}`)
      .then(response => response.json())
      .then(data => {
        if (data.error) {
          tableBody.innerHTML = `<tr><td class="px-6 py-8 text-center text-red-500">${data.error}</td></tr>`;
          return;
        }

        title.textContent = `${data.team_name} Members`;
        subtitle.textContent = data.period_label;

        function memberRow(m, indentStyle, extraClass, hidden) {
          const hiddenAttr = hidden ? ' style="display:none"' : '';
          if (m.temp_excluded) {
            return `<tr class="bg-white border-b ${extraClass || ''}"${hiddenAttr}>
              <td style="${indentStyle}" class="text-gray-400">
                <span class="line-through">${m.name}</span>
                <span class="ml-2 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 border border-amber-200">Excluded</span>
              </td>
            </tr>`;
          }
          return `<tr class="bg-white border-b hover:bg-gray-50 transition-colors ${extraClass || ''}"${hiddenAttr}>
            <td style="${indentStyle}" class="font-medium text-gray-900">${m.name}</td>
          </tr>`;
        }

        if (data.grouped) {
          if (!data.groups || data.groups.length === 0) {
            tableBody.innerHTML = '<tr><td class="px-6 py-8 text-center text-gray-500">No members found for this period.</td></tr>';
            return;
          }
          tableBody.innerHTML = data.groups.map((group, gIdx) => {
            const memberRows = group.members.map(m =>
              memberRow(m, 'padding-left:52px;padding-right:24px;padding-top:12px;padding-bottom:12px;', `tm-group-row-${gIdx}`, true)
            ).join('');
            // Count only active (non-temp-excluded) members for the header badge
            const activeCount = group.members.filter(m => !m.temp_excluded).length;
            const totalCount = group.members.length;
            const countLabel = activeCount === totalCount
              ? `${activeCount} member${activeCount !== 1 ? 's' : ''}`
              : `${activeCount} of ${totalCount}`;
            return `<tr class="bg-gray-50 cursor-pointer hover:bg-gray-100 transition-colors" onclick="toggleTeamMemberGroup(${gIdx})">
              <td class="px-6 py-3 font-semibold text-gray-800">
                <span class="flex items-center gap-2">
                  <span class="material-symbols-outlined !text-[16px] leading-none select-none tm-group-icon-${gIdx}">chevron_right</span>
                  ${group.team_name}
                  <span class="ml-1 text-xs font-normal text-gray-500">(${countLabel})</span>
                </span>
              </td>
            </tr>${memberRows}`;
          }).join('');
        } else {
          if (!data.members || data.members.length === 0) {
            tableBody.innerHTML = '<tr><td class="px-6 py-8 text-center text-gray-500">No members found for this period.</td></tr>';
            return;
          }
          tableBody.innerHTML = data.members.map(m => memberRow(m, 'padding:16px 24px;')).join('');
        }
      })
      .catch(error => {
        console.error('Error fetching member details:', error);
        tableBody.innerHTML = '<tr><td class="px-6 py-8 text-center text-red-500">Error loading member details.</td></tr>';
      });
  }

  function toggleTeamMemberGroup(gIdx) {
    var rows = document.querySelectorAll('.tm-group-row-' + gIdx);
    var icon = document.querySelector('.tm-group-icon-' + gIdx);
    var isCollapsed = rows.length > 0 && rows[0].style.display === 'none';
    rows.forEach(function(row) { row.style.display = isCollapsed ? '' : 'none'; });
    if (icon) icon.textContent = isCollapsed ? 'expand_more' : 'chevron_right';
  }

  // Per-summary sort state: which field is active + each field's remembered direction.
  var summarySortState = {};

  function getSummarySortState(containerId) {
    return summarySortState[containerId] ||
      (summarySortState[containerId] = { field: 'hours', dir: { name: 'asc', hours: 'desc' } });
  }

  // Toggle-style summary sort: clicking the active field flips its direction (so it can
  // go Low→High or Z→A); clicking the other field switches to it in its own direction.
  function sortSummaryCards(containerId, sortBy) {
    var state = getSummarySortState(containerId);
    if (state.field === sortBy) {
      state.dir[sortBy] = state.dir[sortBy] === 'asc' ? 'desc' : 'asc';
    }
    state.field = sortBy;
    applySummarySort(containerId);
  }

  // Re-orders the cards using the container's current sort state (no direction flip).
  function applySummarySort(containerId) {
    var container = document.getElementById(containerId);
    if (!container) return;
    var cardsContainer = container.querySelector('.space-y-2');
    if (!cardsContainer) return;
    var state = getSummarySortState(containerId);
    var field = state.field, dir = state.dir[field];
    var cards = Array.from(cardsContainer.querySelectorAll('[data-hours]'));
    cards.sort(function(a, b) {
      var r;
      if (field === 'name') {
        r = (a.getAttribute('data-name') || '').toLowerCase()
          .localeCompare((b.getAttribute('data-name') || '').toLowerCase());
      } else {
        r = parseFloat(a.getAttribute('data-hours') || '0') - parseFloat(b.getAttribute('data-hours') || '0');
      }
      return dir === 'asc' ? r : -r;
    });
    cards.forEach(function(card) { cardsContainer.appendChild(card); });
    updateSummarySortButtons(containerId, state);
  }

  // Active button blue, the other gray; each label carries a flipping arrow
  // (A–Z ↑ / Z–A ↓, Hours ↓ / Hours ↑) — ↑ = ascending, ↓ = descending.
  function updateSummarySortButtons(containerId, state) {
    var hoursBtn = document.getElementById('sort-hours-' + containerId);
    var nameBtn  = document.getElementById('sort-name-'  + containerId);
    var active   = 'background:#eff6ff;color:#1d4ed8;border-color:#93c5fd;';
    var inactive = 'background:#fff;color:#6b7280;border-color:#d1d5db;';
    if (hoursBtn) {
      hoursBtn.style.cssText = state.field === 'hours' ? active : inactive;
      hoursBtn.textContent = 'Hours ' + (state.dir.hours === 'asc' ? '↑' : '↓');
    }
    if (nameBtn) {
      nameBtn.style.cssText = state.field === 'name' ? active : inactive;
      nameBtn.textContent = state.dir.name === 'asc' ? 'A–Z ↑' : 'Z–A ↓';
    }
  }

  // --- Temporary member exclusion (Members summary toggles) ---------------------
  // Exclusions are EPHEMERAL and live ONLY in the URL (temp_excluded_ids[]). They are
  // intentionally not persisted: changing the time period or team, or navigating away
  // to another Redmine page, drops them (all members return as included). They survive
  // only the controls that explicitly carry the param forward — the Members/Activity/
  // Project tabs, Summary/Detailed, grouping, per-page and pagination.
  var exclusionNavTimer = null;
  var EXCLUSION_NAV_DELAY = 350;

  function getUrlExclusions(urlObj) {
    return (urlObj || new URL(window.location.href)).searchParams.getAll('temp_excluded_ids[]').map(String);
  }

  // Inject the current URL exclusions into a GET form as hidden fields so that a form
  // submit PRESERVES them (used by the grouping dropdown). Controls that must CLEAR
  // exclusions (time period, team) never call this, so the param is dropped on submit.
  function appendExclusionFieldsToForm(form) {
    if (!form) { return; }
    form.querySelectorAll('input[data-ta-exclusion="1"]').forEach(function(el) { el.remove(); });
    getUrlExclusions().forEach(function(id) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'temp_excluded_ids[]';
      input.value = id;
      input.setAttribute('data-ta-exclusion', '1');
      form.appendChild(input);
    });
  }

  function buildExclusionUrl(ids) {
    var url = new URL(window.location.href);
    url.searchParams.delete('temp_excluded_ids[]');
    ids.forEach(function(id) { url.searchParams.append('temp_excluded_ids[]', id); });
    // Preserve the active member-view state so the reload restores Summary/Detailed correctly.
    try {
      var state = localStorage.getItem('team_member_view_mode');
      if (state) { url.searchParams.set('member_view_state', state); }
    } catch (_) {}
    return url;
  }

  // Current excluded set as reflected by the on-page toggles (Members summary).
  function collectExcludedMemberIds() {
    var ids = [];
    document.querySelectorAll('.member-exclusion-toggle').forEach(function(input) {
      if (!input.checked) {
        var id = input.getAttribute('data-user-id');
        if (id && ids.indexOf(id) === -1) { ids.push(id); }
      }
    });
    return ids;
  }

  // Dim the member section for instant "working…" feedback while the debounced reload
  // settles. The reload renders the authoritative state, so there is nothing to un-dim.
  function dimMemberSection(on) {
    ['ts-summary-cards-row', 'team-member-summary-view', 'team-donut-chart'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) { el.style.opacity = on ? '0.5' : ''; }
    });
  }

  // Toggling a member reflects in the URL immediately and dims the section for feedback.
  // The AUTHORITATIVE update is a real navigation to the exclusion URL — the same reliable
  // mechanism as changing the time period — DEBOUNCED so toggling many members in a row
  // reloads only once. A full render (instead of an in-place swap) guarantees the member
  // rows, donut and totals are always correct, and the donut renders exactly once.
  document.addEventListener('change', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('member-exclusion-toggle')) {
      window.history.replaceState({}, '', buildExclusionUrl(collectExcludedMemberIds()).toString());
      dimMemberSection(true);

      if (exclusionNavTimer) { clearTimeout(exclusionNavTimer); }
      exclusionNavTimer = setTimeout(function() {
        exclusionNavTimer = null;
        var latest = collectExcludedMemberIds();
        // Preserve scroll across the reload (reuses the load-time restore handler).
        try { sessionStorage.setItem('teamScrollPosition', String(window.pageYOffset || document.documentElement.scrollTop || 0)); } catch (e2) {}
        window.location.assign(buildExclusionUrl(latest).toString());
      }, EXCLUSION_NAV_DELAY);
    }
  });

  // The Members/Activity/Project tab links are rendered server-side at load, so their href
  // can be stale if members were toggled afterwards. Rewrite the href to the LIVE exclusion
  // set just before navigation (capture phase) so switching views preserves exclusions.
  document.addEventListener('click', function(e) {
    var link = e.target && e.target.closest && e.target.closest('a[data-team-tab-nav]');
    if (!link) { return; }
    try {
      var dest = new URL(link.getAttribute('href'), window.location.href);
      dest.searchParams.delete('temp_excluded_ids[]');
      getUrlExclusions().forEach(function(id) { dest.searchParams.append('temp_excluded_ids[]', id); });
      link.setAttribute('href', dest.toString());
    } catch (err) {}
  }, true);

  // ===== Member Breakdown: per-member second-level grouping (lazy-loaded) =====
  var memberBreakdownData = null;
  var memberBreakdownLoaded = false;
  var memberBreakdownLoading = false;
  var memberBreakdownCharts = [];
  var memberBreakdownModalChart = null;
  var memberBreakdownModal = null;
  var currentBreakdownGrouping = 'issue';

  var BREAKDOWN_GROUPING_LABEL = {
    issue: '<%= j l(:label_issue) %>',
    activity: '<%= j l(:label_activity) %>',
    project: '<%= j l(:label_project) %>'
  };
  var BREAKDOWN_TOTAL_LABEL = '<%= j l(:label_member_breakdown_total) %>';
  var BREAKDOWN_EXPAND_TITLE = '<%= j l(:label_member_breakdown_expand) %>';
  var BREAKDOWN_SCROLL_UP = '<%= j l(:label_member_breakdown_scroll_up) %>';
  var BREAKDOWN_SCROLL_DOWN = '<%= j l(:label_member_breakdown_scroll_down) %>';

  function bdEscape(value) {
    var div = document.createElement('div');
    div.textContent = value == null ? '' : String(value);
    return div.innerHTML;
  }

  function getTempExcludedIds() {
    try {
      return new URLSearchParams(window.location.search).getAll('temp_excluded_ids[]');
    } catch (e) {
      return [];
    }
  }

  function breakdownDonutConfig(items, total) {
    return {
      type: 'doughnut',
      data: {
        labels: items.map(function(it) { return it.label; }),
        datasets: [{
          data: items.map(function(it) { return it.hours; }),
          backgroundColor: items.map(function(it) { return it.color; }),
          borderColor: '#ffffff',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutoutPercentage: 65,
        legend: { display: false },
        tooltips: {
          callbacks: {
            label: function(tooltipItem, data) {
              var label = data.labels[tooltipItem.index] || '';
              var value = data.datasets[0].data[tooltipItem.index] || 0;
              var pct = total > 0 ? ((value / total) * 100).toFixed(1) : '0.0';
              return label + ': ' + formatTeamHours(value) + ' (' + pct + '%)';
            }
          }
        }
      }
    };
  }

  var BREAKDOWN_LEGEND_PAGE_SIZE = 4;

  function initialsFor(name) {
    var parts = String(name || '').trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return '?';
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
  }

  function breakdownAvatarHtml(name, size) {
    var dim = size || 'w-8 h-8';
    return '<span class="inline-flex items-center justify-center ' + dim + ' rounded-full bg-slate-100 text-slate-600 text-xs font-semibold shrink-0">' + bdEscape(initialsFor(name)) + '</span>';
  }

  function breakdownLegendRows(items) {
    return items.map(function(it) {
      return '' +
        '<div class="flex items-center gap-1.5 py-[3px]">' +
          '<span class="w-2 h-2 rounded-full shrink-0" style="background:' + it.color + '"></span>' +
          '<span class="flex-1 min-w-0 truncate text-gray-600 text-xs leading-tight" title="' + bdEscape(it.label) + '">' + bdEscape(it.label) + '</span>' +
          '<span class="font-semibold text-gray-800 whitespace-nowrap text-xs ml-2">' + formatTeamHours(it.hours) + '</span>' +
          '<span class="font-semibold whitespace-nowrap text-xs w-12 text-right" style="color:' + it.color + '">' + it.percentage + '%</span>' +
        '</div>';
    }).join('');
  }

  function renderLegendPage(card, items, page) {
    var legend = card.querySelector('.member-bd-legend');
    if (!legend) return;
    var size = BREAKDOWN_LEGEND_PAGE_SIZE;
    var totalPages = Math.max(1, Math.ceil(items.length / size));
    page = Math.max(0, Math.min(page, totalPages - 1));
    legend.setAttribute('data-page', String(page));
    legend.innerHTML = breakdownLegendRows(items.slice(page * size, page * size + size));

    var up = card.querySelector('.member-bd-page-up');
    var down = card.querySelector('.member-bd-page-down');
    [[up, page <= 0], [down, page >= totalPages - 1]].forEach(function(pair) {
      var btn = pair[0];
      if (!btn) return;
      btn.disabled = pair[1];
      btn.classList.toggle('opacity-30', pair[1]);
      btn.classList.toggle('pointer-events-none', pair[1]);
    });
  }

  function breakdownCardHtml(member, index, grouping) {
    var items = member.groupings[grouping] || [];
    var multiPage = items.length > BREAKDOWN_LEGEND_PAGE_SIZE;
    return '' +
    '<div class="member-bd-card rounded-lg border border-gray-200 bg-white p-4 flex flex-col" data-member-index="' + index + '">' +
      '<div class="flex items-center justify-between gap-2 mb-3">' +
        '<span class="flex items-center gap-2 min-w-0">' +
          breakdownAvatarHtml(member.name) +
          '<span class="font-semibold text-gray-900 truncate" title="' + bdEscape(member.name) + '">' + bdEscape(member.name) + '</span>' +
        '</span>' +
        '<button type="button" class="member-bd-expand ta-bd-icon-btn inline-flex items-center justify-center w-7 h-7 rounded-md shrink-0" data-member-index="' + index + '" title="' + bdEscape(BREAKDOWN_EXPAND_TITLE) + '">' +
          '<span class="material-symbols-outlined" style="font-size:18px;">open_in_full</span>' +
        '</button>' +
      '</div>' +
      '<div class="flex items-center gap-4">' +
        '<div class="relative w-[140px] h-[140px] shrink-0">' +
          '<canvas id="member-bd-donut-' + index + '"></canvas>' +
          '<div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">' +
            '<span class="text-base font-bold text-gray-900 leading-tight">' + formatTeamHours(member.total_hours) + '</span>' +
            '<span class="text-[10px] text-gray-500 leading-tight">' + bdEscape(BREAKDOWN_TOTAL_LABEL) + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="flex-1 min-w-0 flex flex-col justify-center self-stretch">' +
          '<div class="member-bd-legend min-w-0" data-page="0"></div>' +
          (multiPage ?
            '<div class="flex justify-end gap-0.5 shrink-0 mt-1">' +
              '<button type="button" class="member-bd-page-up ta-bd-icon-btn inline-flex items-center justify-center w-5 h-5 rounded" title="' + bdEscape(BREAKDOWN_SCROLL_UP) + '"><span class="material-symbols-outlined" style="font-size:14px;">keyboard_arrow_up</span></button>' +
              '<button type="button" class="member-bd-page-down ta-bd-icon-btn inline-flex items-center justify-center w-5 h-5 rounded" title="' + bdEscape(BREAKDOWN_SCROLL_DOWN) + '"><span class="material-symbols-outlined" style="font-size:14px;">keyboard_arrow_down</span></button>' +
            '</div>'
            : '') +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function destroyBreakdownCharts() {
    memberBreakdownCharts.forEach(function(chart) { try { chart.destroy(); } catch (e) {} });
    memberBreakdownCharts = [];
  }

  function renderMemberBreakdown(grouping) {
    var grid = document.getElementById('member-breakdown-grid');
    var emptyEl = document.getElementById('member-breakdown-empty');
    if (!grid || !memberBreakdownData) return;

    destroyBreakdownCharts();
    var members = memberBreakdownData.members || [];

    if (!members.length) {
      grid.innerHTML = '';
      grid.classList.add('hidden');
      if (emptyEl) emptyEl.classList.remove('hidden');
      return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');
    grid.classList.remove('hidden');
    grid.innerHTML = members.map(function(m, i) { return breakdownCardHtml(m, i, grouping); }).join('');

    members.forEach(function(m, i) {
      var items = m.groupings[grouping] || [];
      var canvas = document.getElementById('member-bd-donut-' + i);
      if (canvas) {
        var chart = new Chart(canvas.getContext('2d'), breakdownDonutConfig(items, m.total_hours));
        memberBreakdownCharts.push(chart);
      }
      var card = grid.querySelector('.member-bd-card[data-member-index="' + i + '"]');
      if (card) renderLegendPage(card, items, 0);
    });
  }

  function setBreakdownActiveButton(buttons, active) {
    Array.prototype.forEach.call(buttons, function(btn) {
      if (btn === active) {
        btn.classList.remove('!bg-white', '!text-gray-700', 'hover:!bg-gray-50');
        btn.classList.add('!bg-[#3b82f6]', '!text-white');
      } else {
        btn.classList.remove('!bg-[#3b82f6]', '!text-white');
        btn.classList.add('!bg-white', '!text-gray-700', 'hover:!bg-gray-50');
      }
    });
  }

  // Keep the Member Breakdown in sync with the temporary-exclusion set. The URL has
  // already been updated by the toggle handler, so invalidate the cached payload and,
  // when the section is open, re-fetch (the request reads temp_excluded_ids from the
  // URL via getTempExcludedIds()). When collapsed, the next expand loads fresh data.
  function refreshMemberBreakdownExclusions() {
    var container = document.querySelector('.ta-member-breakdown');
    var body = document.getElementById('member-breakdown-body');
    if (!container || !body) return;
    memberBreakdownData = null;
    memberBreakdownLoaded = false;
    if (!body.classList.contains('hidden') && !memberBreakdownLoading) {
      loadMemberBreakdown(container);
    }
  }

  function loadMemberBreakdown(container) {
    memberBreakdownLoading = true;
    var loadingEl = document.getElementById('member-breakdown-loading');
    var grid = document.getElementById('member-breakdown-grid');
    var emptyEl = document.getElementById('member-breakdown-empty');
    var errorEl = document.getElementById('member-breakdown-error');
    if (loadingEl) loadingEl.classList.remove('hidden');
    if (grid) grid.classList.add('hidden');
    if (emptyEl) emptyEl.classList.add('hidden');
    if (errorEl) errorEl.classList.add('hidden');

    var params = new URLSearchParams();
    ['team-id', 'filter', 'from', 'to'].forEach(function(attr) {
      var val = container.getAttribute('data-' + attr);
      if (val) params.append(attr.replace('team-id', 'team_id'), val);
    });
    getTempExcludedIds().forEach(function(id) { params.append('temp_excluded_ids[]', id); });

    fetch(container.getAttribute('data-breakdown-url') + '?' + params.toString(), {
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(function(response) { return response.json(); })
      .then(function(data) {
        memberBreakdownData = data;
        memberBreakdownLoaded = true;
        memberBreakdownLoading = false;
        if (loadingEl) loadingEl.classList.add('hidden');
        renderMemberBreakdown(currentBreakdownGrouping);
      })
      .catch(function(error) {
        console.error('Error loading member breakdown:', error);
        memberBreakdownLoading = false;
        if (loadingEl) loadingEl.classList.add('hidden');
        if (errorEl) errorEl.classList.remove('hidden');
      });
  }

  function openBreakdownModal(index) {
    if (!memberBreakdownData) return;
    var member = memberBreakdownData.members[index];
    if (!member) return;

    var items = member.groupings[currentBreakdownGrouping] || [];
    var dot = document.getElementById('member-breakdown-modal-dot');
    if (dot) dot.textContent = initialsFor(member.name);
    document.getElementById('member-breakdown-modal-title').textContent = member.name;
    document.getElementById('member-breakdown-modal-grouping').textContent = '· ' + (BREAKDOWN_GROUPING_LABEL[currentBreakdownGrouping] || '');
    document.getElementById('member-breakdown-modal-total').textContent = formatTeamHours(member.total_hours);
    document.getElementById('member-breakdown-modal-count').textContent = BREAKDOWN_TOTAL_LABEL;
    document.getElementById('member-breakdown-modal-legend').innerHTML = items.map(function(it) {
      return '' +
        '<div class="flex items-center gap-2 py-1.5 border-b border-gray-50">' +
          '<span class="w-3 h-3 rounded-full shrink-0" style="background:' + it.color + '"></span>' +
          '<span class="flex-1 min-w-0 truncate text-gray-700" title="' + bdEscape(it.label) + '">' + bdEscape(it.label) + '</span>' +
          '<span class="font-semibold text-gray-900 whitespace-nowrap">' + formatTeamHours(it.hours) + '</span>' +
          '<span class="font-semibold w-14 text-right whitespace-nowrap" style="color:' + it.color + '">' + it.percentage + '%</span>' +
        '</div>';
    }).join('');

    if (memberBreakdownModalChart) { try { memberBreakdownModalChart.destroy(); } catch (e) {} memberBreakdownModalChart = null; }
    var canvas = document.getElementById('member-breakdown-modal-chart');
    if (canvas) {
      memberBreakdownModalChart = new Chart(canvas.getContext('2d'), breakdownDonutConfig(items, member.total_hours));
    }
    if (memberBreakdownModal) memberBreakdownModal.show();
  }

  function initMemberBreakdown() {
    var container = document.querySelector('.ta-member-breakdown');
    if (!container) return;

    var toggle = document.getElementById('member-breakdown-toggle');
    var body = document.getElementById('member-breakdown-body');
    var chevron = document.getElementById('member-breakdown-chevron');

    toggle.addEventListener('click', function() {
      var nowHidden = body.classList.toggle('hidden');
      var expanded = !nowHidden;
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      if (chevron) chevron.classList.toggle('-rotate-90', !expanded);
      if (expanded && !memberBreakdownLoaded && !memberBreakdownLoading) {
        loadMemberBreakdown(container);
      }
    });

    var groupButtons = container.querySelectorAll('.member-bd-group-btn');
    Array.prototype.forEach.call(groupButtons, function(btn) {
      btn.addEventListener('click', function() {
        var grouping = btn.getAttribute('data-grouping');
        if (grouping === currentBreakdownGrouping) return;
        currentBreakdownGrouping = grouping;
        setBreakdownActiveButton(groupButtons, btn);
        if (memberBreakdownLoaded) renderMemberBreakdown(grouping);
      });
    });

    var grid = document.getElementById('member-breakdown-grid');
    grid.addEventListener('click', function(event) {
      var pageBtn = event.target.closest('.member-bd-page-up, .member-bd-page-down');
      var expandBtn = event.target.closest('.member-bd-expand');
      if (pageBtn) {
        var card = pageBtn.closest('.member-bd-card');
        var idx = parseInt(card.getAttribute('data-member-index'), 10);
        var member = memberBreakdownData && memberBreakdownData.members[idx];
        if (!member) return;
        var items = member.groupings[currentBreakdownGrouping] || [];
        var legend = card.querySelector('.member-bd-legend');
        var current = parseInt(legend.getAttribute('data-page') || '0', 10);
        renderLegendPage(card, items, pageBtn.classList.contains('member-bd-page-up') ? current - 1 : current + 1);
      } else if (expandBtn) {
        openBreakdownModal(parseInt(expandBtn.getAttribute('data-member-index'), 10));
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    var modalEl = document.getElementById('team-member-details-modal');
    if (modalEl && typeof Modal !== 'undefined') {
      teamMemberDetailsModal = new Modal(modalEl, {
        placement: 'center',
        backdrop: 'dynamic',
        backdropClasses: 'bg-gray-900/50 fixed inset-0 z-40',
        closable: true
      });
    }

    var breakdownModalEl = document.getElementById('member-breakdown-modal');
    if (breakdownModalEl && typeof Modal !== 'undefined') {
      memberBreakdownModal = new Modal(breakdownModalEl, {
        placement: 'center',
        backdrop: 'dynamic',
        backdropClasses: 'bg-gray-900/50 fixed inset-0 z-40',
        closable: true,
        onHide: function() {
          if (memberBreakdownModalChart) { try { memberBreakdownModalChart.destroy(); } catch (e) {} memberBreakdownModalChart = null; }
        }
      });
    }

    initMemberBreakdown();
  });

</script>

