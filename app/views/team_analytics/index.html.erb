<script>
  // Auto-submit team selector on change
  function switchTeamChartType(chartType) {
    const hiddenField = document.getElementById('chart_type_hidden');
    const form = document.getElementById('team-analytics-form');
    if (hiddenField && form) {
      hiddenField.value = chartType;
      form.submit();
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Initialize chart
    initChart();
    initTeamDonutChart();
    
    // Restore activity view state
    restoreActivityViewState();
    
    // Restore project view state
    restoreProjectViewState();
    
    // Restore member view state
    restoreMemberViewState();
  });

  var teamDonutChart = null;
  var TEAM_TABLEAU10 = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'];

  function formatTeamHours(hours) {
    var value = parseFloat(hours || 0);
    var timespanFormat = '<%= Setting.timespan_format %>';

    if (timespanFormat === 'minutes') {
      var h = Math.floor(value);
      var m = Math.round((value - h) * 60);
      return h + ':' + (m < 10 ? '0' : '') + m;
    }
    return value.toFixed(2);
  }

  function initTeamDonutChart() {
    var donutCanvas = document.getElementById('team-donut-chart');
    if (!donutCanvas) return;

    if (teamDonutChart) {
      teamDonutChart.destroy();
      teamDonutChart = null;
    }

    var labels = [];
    var values = [];
    <% if @view_mode == 'activity' && @activity_totals.present? %>
      <% @activity_totals.sort_by { |_, hours| -hours }.each do |activity, hours| %>
        labels.push('<%= j activity %>');
        values.push(<%= hours.to_f %>);
      <% end %>
    <% elsif @view_mode == 'project' && @project_totals.present? %>
      <% @project_totals.sort_by { |_, hours| -hours }.each do |project, hours| %>
        labels.push('<%= j project %>');
        values.push(<%= hours.to_f %>);
      <% end %>
    <% elsif @view_mode == 'members' && @member_totals.present? %>
      <% @member_totals.sort_by { |_, hours| -hours }.each do |member_name, hours| %>
        labels.push('<%= j member_name %>');
        values.push(<%= hours.to_f %>);
      <% end %>
    <% end %>

    if (!labels.length || !values.length) return;

    var total = values.reduce(function(sum, val) { return sum + val; }, 0);
    var totalDisplay = document.getElementById('team-total-hours-display');
    if (totalDisplay) totalDisplay.textContent = formatTeamHours(total);

    var colors = labels.map(function(_, index) { return TEAM_TABLEAU10[index % TEAM_TABLEAU10.length]; });
    teamDonutChart = new Chart(donutCanvas.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: labels,
        datasets: [{
          data: values,
          backgroundColor: colors,
          borderColor: '#ffffff',
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutoutPercentage: 65,
        legend: { display: false },
        tooltips: {
          callbacks: {
            label: function(tooltipItem, data) {
              var label = data.labels[tooltipItem.index] || '';
              var value = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index] || 0;
              var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return label + ': ' + formatTeamHours(value) + ' (' + percentage + '%)';
            }
          }
        }
      }
    });

    var legend = document.getElementById('team-donut-legend');
    if (!legend) return;
    legend.innerHTML = '';

    labels.forEach(function(label, index) {
      var value = values[index];
      var percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
      var item = document.createElement('div');
      item.className = 'flex items-center justify-between text-xs';
      item.innerHTML = '<div class="flex items-center gap-1.5 flex-1 min-w-0">' +
        '<div class="w-2.5 h-2.5 rounded-sm flex-shrink-0" style="background-color: ' + colors[index] + '"></div>' +
        '<span class="text-gray-700 truncate">' + label + '</span>' +
        '</div>' +
        '<div class="flex items-center gap-1.5 ml-2 flex-shrink-0">' +
        '<span class="font-semibold text-gray-900">' + formatTeamHours(value) + '</span>' +
        '<span class="text-gray-500">(' + percentage + '%)</span>' +
        '</div>';
      legend.appendChild(item);
    });
  }

  // Chart initialization
  var teamChart = null;

  function initChart() {
    var chartElement = document.getElementById('time-chart');
    if (!chartElement) {
      console.log('Chart element not found');
      return;
    }

    // Prevent multiple chart creation
    if (teamChart) {
      teamChart.destroy();
      teamChart = null;
    }

    try {
      var chartData = chartElement.getAttribute('data-chart');
      if (!chartData || chartData === 'null' || chartData === '') {
        console.log('No chart data available');
        return;
      }

      var config = JSON.parse(chartData);
      
      // Ensure responsive configuration
      if (!config.options) {
        config.options = {};
      }
      config.options.responsive = true;
      config.options.maintainAspectRatio = false;

      // Add custom tooltip callback for weekly grouping (bar and line charts)
      if ((config.type === 'bar' || config.type === 'line') && config.data.datasets[0].tooltipLabels) {
        if (!config.options.plugins) config.options.plugins = {};
        if (!config.options.plugins.tooltip) config.options.plugins.tooltip = {};
        if (!config.options.plugins.tooltip.callbacks) config.options.plugins.tooltip.callbacks = {};
        
        config.options.plugins.tooltip.callbacks.title = function(context) {
          var index = context[0].dataIndex;
          var tooltipLabels = context[0].dataset.tooltipLabels;
          return tooltipLabels ? tooltipLabels[index] : context[0].label;
        };
      }

      console.log('Creating chart with config:', config);
      teamChart = new Chart(chartElement, config);
      console.log('Chart created successfully');
      
    } catch (error) {
      console.error('Error creating chart:', error);
    }
  }

  var TEAM_VIEW_CONFIG = {
    activity: {
      prefix: 'team-activity',
      storageKey: 'team_activity_view_mode',
      hiddenFieldId: 'activity_view_state_field',
      paginationInfoId: 'team-activity-pagination-info',
      regenerate: regenerateChartForViewState
    },
    project: {
      prefix: 'team-project',
      storageKey: 'team_project_view_mode',
      hiddenFieldId: 'project_view_state_field',
      paginationInfoId: 'team-project-pagination-info',
      regenerate: regenerateChartForProjectViewState
    },
    member: {
      prefix: 'team-member',
      storageKey: 'team_member_view_mode',
      hiddenFieldId: 'member_view_state_field',
      paginationInfoId: 'team-member-pagination-info',
      regenerate: regenerateChartForMemberViewState
    }
  };

  function updateTeamToggleButtons(viewType, isSummary) {
    var detailBtn = document.getElementById('show-detailed-btn-' + viewType);
    var summaryBtn = document.getElementById('show-summary-btn-' + viewType);
    if (!detailBtn || !summaryBtn) return;

    if (isSummary) {
      summaryBtn.style.backgroundColor = '#3b82f6';
      summaryBtn.style.color = 'white';
      summaryBtn.className = summaryBtn.className.replace(/!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900/g, '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]');

      detailBtn.style.backgroundColor = '';
      detailBtn.style.color = '';
      detailBtn.className = detailBtn.className.replace(/!text-white !bg-\[#3b82f6\] hover:!bg-\[#2563eb\]/g, '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900');
    } else {
      detailBtn.style.backgroundColor = '#3b82f6';
      detailBtn.style.color = 'white';
      detailBtn.className = detailBtn.className.replace(/!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900/g, '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]');

      summaryBtn.style.backgroundColor = '';
      summaryBtn.style.color = '';
      summaryBtn.className = summaryBtn.className.replace(/!text-white !bg-\[#3b82f6\] hover:!bg-\[#2563eb\]/g, '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900');
    }
  }

  function updateTeamPaginationInfo(viewType, viewState) {
    var config = TEAM_VIEW_CONFIG[viewType];
    if (!config) return;
    var paginationInfo = document.getElementById(config.paginationInfoId);
    if (!paginationInfo) return;

    if (viewState === 'detailed') {
      paginationInfo.textContent = paginationInfo.getAttribute('data-detailed-text') || '';
      return;
    }

    var count = parseInt(paginationInfo.getAttribute('data-summary-count')) || 0;
    paginationInfo.textContent = '(1-' + count + '/' + count + ')';
  }

  function showDetailedView(viewType, options) {
    var config = TEAM_VIEW_CONFIG[viewType];
    if (!config) return;

    var detailedView = document.getElementById(config.prefix + '-detailed-view');
    var summaryView = document.getElementById(config.prefix + '-summary-view');
    if (!detailedView || !summaryView) return;

    detailedView.style.display = 'block';
    summaryView.style.display = 'none';
    updateTeamToggleButtons(viewType, false);
    updateTeamPaginationInfo(viewType, 'detailed');

    var hiddenField = document.getElementById(config.hiddenFieldId);
    if (hiddenField) hiddenField.value = 'detailed';

    if (!(options && options.persist === false)) {
      localStorage.setItem(config.storageKey, 'detailed');
    }
    if (!(options && options.reload === false)) {
      config.regenerate('detailed');
    }
  }

  function showSummaryView(viewType, options) {
    var config = TEAM_VIEW_CONFIG[viewType];
    if (!config) return;

    var detailedView = document.getElementById(config.prefix + '-detailed-view');
    var summaryView = document.getElementById(config.prefix + '-summary-view');
    if (!detailedView || !summaryView) return;

    detailedView.style.display = 'none';
    summaryView.style.display = 'block';
    updateTeamToggleButtons(viewType, true);
    updateTeamPaginationInfo(viewType, 'summary');

    var hiddenField = document.getElementById(config.hiddenFieldId);
    if (hiddenField) hiddenField.value = 'summary';

    if (!(options && options.persist === false)) {
      localStorage.setItem(config.storageKey, 'summary');
    }
    if (!(options && options.reload === false)) {
      config.regenerate('summary');
    }
  }

  // Regenerate chart based on activity view state (summary vs detailed)
  function regenerateChartForViewState(viewState) {
    // Get current URL parameters
    var urlParams = new URLSearchParams(window.location.search);
    
    // Add/update activity_view_state parameter
    urlParams.set('activity_view_state', viewState);
    
    // Build new URL
    var baseUrl = window.location.pathname;
    var newUrl = baseUrl + '?' + urlParams.toString();
    
    // Reload page with new view state parameter
    window.location.href = newUrl;
  }

  // Restore activity view preference
  function restoreActivityViewState() {
    restoreTeamViewState('activity');
  }

  // Regenerate chart based on project view state (summary vs detailed)
  function regenerateChartForProjectViewState(viewState) {
    // Get current URL parameters
    var urlParams = new URLSearchParams(window.location.search);
    
    // Add/update project_view_state parameter
    urlParams.set('project_view_state', viewState);
    
    // Build new URL
    var baseUrl = window.location.pathname;
    var newUrl = baseUrl + '?' + urlParams.toString();
    
    // Reload page with new view state parameter
    window.location.href = newUrl;
  }

  // Restore project view preference
  function restoreProjectViewState() {
    restoreTeamViewState('project');
  }

  // Regenerate chart when member view state changes
  function regenerateChartForMemberViewState(viewState) {
    // Get current URL parameters
    var urlParams = new URLSearchParams(window.location.search);
    
    // Add/update member_view_state parameter
    urlParams.set('member_view_state', viewState);
    
    // Build new URL
    var baseUrl = window.location.pathname;
    var newUrl = baseUrl + '?' + urlParams.toString();
    
    // Reload page with new view state parameter
    window.location.href = newUrl;
  }

  // Restore member view preference
  function restoreMemberViewState() {
    restoreTeamViewState('member');
  }

  function restoreTeamViewState(viewType) {
    var config = TEAM_VIEW_CONFIG[viewType];
    if (!config) return;
    var detailedView = document.getElementById(config.prefix + '-detailed-view');
    var summaryView = document.getElementById(config.prefix + '-summary-view');
    if (!detailedView || !summaryView) return;

    var hiddenField = document.getElementById(config.hiddenFieldId);
    var serverMode = hiddenField ? hiddenField.value : null;
    var savedMode = localStorage.getItem(config.storageKey);
    var currentMode = serverMode || savedMode || 'detailed';

    if (currentMode === 'summary') {
      showSummaryView(viewType, { reload: false, persist: false });
    } else {
      showDetailedView(viewType, { reload: false, persist: false });
    }
  }

</script>
