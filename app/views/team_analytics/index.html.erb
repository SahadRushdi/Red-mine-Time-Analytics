<%= render 'time_analytics/includes' %>

<!-- jsTree CSS and JS from CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.16/themes/default/style.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.16/jstree.min.js"></script>

<!-- Material Icons from Google Fonts -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
  /* Tree view slide-out panel */
  .tree-view-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    display: none;
  }
  
  .tree-view-panel {
    position: fixed;
    top: 0;
    left: -450px;
    width: 450px;
    height: 100%;
    background-color: #fff;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
    z-index: 9999;
    transition: left 0.3s ease-in-out;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  
  .tree-view-panel.open {
    left: 0;
  }
  
  .tree-view-header {
    background-color: #614ba6;
    color: #fff;
    padding: 24px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
  }
  
  .tree-view-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: bold;
  }
  
  .tree-view-close {
    background: none;
    border: none;
    color: #fff;
    font-size: 28px;
    cursor: pointer;
    padding: 0;
    width: 30px;
    height: 30px;
    line-height: 28px;
    text-align: center;
  }
  
  .tree-view-close:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }
  
  .tree-view-content {
    padding: 20px;
    flex-grow: 1;
    overflow-y: auto;
  }
  
  .tree-view-toggle-btn {
    display: inline-block;
    margin-left: 15px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px 8px;
    color: #555;
    font-size: 22px;
    transition: color 0.2s, background-color 0.2s;
    border-radius: 3px;
    vertical-align: middle;
    text-decoration: none;
    outline: none;
    line-height: 1;
  }
  
  .tree-view-toggle-btn:hover {
    background-color: #f0f0f0;
    color: #169;
    text-decoration: none;
  }
  
  .tree-view-toggle-btn:focus {
    outline: none;
    box-shadow: none;
  }
  
  .tree-view-toggle-btn .material-symbols-outlined {
    font-size: 24px;
    vertical-align: middle;
    display: block;
  }
  
  /* jsTree customization */
  #team-tree-container .jstree-default .jstree-anchor {
    height: auto;
    line-height: 28px;
    padding: 4px 8px;
  }
  
  #team-tree-container .jstree-default .jstree-node {
    margin-bottom: 2px;
  }
  
  #team-tree-container .jstree-default .jstree-clicked {
    background-color: #e3f2fd !important;
    border-radius: 4px;
  }
  
  #team-tree-container .jstree-default .jstree-hovered {
    background-color: #f5f5f5 !important;
    border-radius: 4px;
  }
  
  /* Make member names stand out */
  #team-tree-container .jstree-anchor[data-user-id] {
    color: #169;
    font-weight: 500;
  }
  
  #team-tree-container .jstree-anchor[data-user-id]:hover {
    text-decoration: underline;
  }
  
  /* Projects node styling */
  #team-tree-container .jstree-node[data-type="projects"] .jstree-anchor {
    color: #666;
    font-style: italic;
    font-size: 0.95em;
  }
  
</style>

<script type="text/javascript">
  // Tree view functions
  function openTreeView() {
    $('.tree-view-overlay').fadeIn(200);
    $('.tree-view-panel').addClass('open');
    loadTreeData();
  }
  
  function closeTreeView() {
    $('.tree-view-overlay').fadeOut(200);
    $('.tree-view-panel').removeClass('open');
  }
  
  function loadTreeData() {
    var fromDate = '<%= @from %>';
    var toDate = '<%= @to %>';
    
    $.ajax({
      url: '<%= team_analytics_tree_data_path %>',
      type: 'GET',
      data: { from: fromDate, to: toDate },
      dataType: 'json',
      success: function(data) {
        initializeTree(data);
      },
      error: function(xhr, status, error) {
        console.error('Error loading tree data:', error);
        $('#team-tree-container').html('<p style="color: red;">Error loading tree view. Please try again.</p>');
      }
    });
  }
  
  function initializeTree(treeData) {
    $('#team-tree-container').jstree('destroy');
    
    $('#team-tree-container').jstree({
      'core': {
        'data': treeData,
        'themes': {
          'name': 'default',
          'responsive': true,
          'dots': true,
          'icons': false
        }
      },
      'plugins': ['types']
    });
    
    // Handle member node clicks - open Individual Dashboard
    $('#team-tree-container').on('select_node.jstree', function (e, data) {
      if (data.node.data && data.node.data.user_id) {
        var userId = data.node.data.user_id;
        var url = '<%= my_time_path %>' + '?user_id=' + userId;
        window.open(url, '_blank');
      }
    });
  }
  
  $(document).ready(function() {
    // Close tree view when clicking overlay
    $('.tree-view-overlay').on('click', function() {
      closeTreeView();
    });
  });
</script>

<!-- Tree View Overlay -->
<div class="tree-view-overlay"></div>

<!-- Tree View Slide-out Panel -->
<div class="tree-view-panel">
  <div class="tree-view-header">
    <h3>Team Hierarchy</h3>
    <button class="tree-view-close" onclick="closeTreeView()" title="Close">&times;</button>
  </div>
  <div class="tree-view-content">
    <div id="team-tree-container">
      <p style="text-align: center; color: #999; padding: 20px;">Loading team structure...</p>
    </div>
  </div>
</div>

<div class="flex items-start justify-between mb-6 flex-wrap gap-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 mb-1">
      <%= l(:label_team_dashboard) || "Team Dashboard" %> - <%= @selected_team&.name %>
    </h1>
    <p class="text-sm text-gray-500">
      <%= "#{@from.strftime('%b %d')} – #{@to.strftime('%b %d, %Y')}" %>
    </p>
  </div>

  <div class="flex items-center justify-end gap-3 flex-wrap">
    <div id="filters" class="m-0">
      <%= render(partial: 'team_analytics/filters_panel') %>
    </div>

    <%= link_to team_analytics_export_csv_path(params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :page, :view_mode, :team_id)),
        method: :post,
        style: 'background-color: #3b82f6 !important; color: white !important;',
        class: 'inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium !text-white !bg-[#3b82f6] rounded-lg hover:!bg-[#2563eb] focus:ring-4 focus:ring-blue-300 shadow-xs focus:outline-none transition-colors' do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z"/>
      </svg>
      <%= l(:label_export_csv) %>
    <% end %>

    <button class="tree-view-toggle-btn" onclick="openTreeView()" title="Open Team Hierarchy View">
      <span class="material-symbols-outlined">account_tree</span>
    </button>
  </div>
</div>

<div class="ts-summary-cards-row mb-6">
  <div class="ts-summary-card ts-summary-card--total flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Total Hours</p>
      <p class="ts-summary-card-value"><%= format_hours(@total_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>
  <div class="ts-summary-card ts-summary-card--active-days flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M3 4h18M8 2v4m8-4v4M5 8h14v12H5z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label"><%= max_label_for_grouping(@grouping) %></p>
      <p class="ts-summary-card-value"><%= format_hours(@max_period_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>
  <div class="ts-summary-card ts-summary-card--average flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M4 19h16M7 16v-4m5 4V8m5 8v-6"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label"><%= min_label_for_grouping(@grouping) %></p>
      <p class="ts-summary-card-value"><%= format_hours(@min_period_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>
  <div class="ts-summary-card ts-summary-card--issues flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M9 5h6M8 3h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V5a2 2 0 012-2zm2 7h6m-6 4h4"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Team Size</p>
      <p class="ts-summary-card-value"><%= @team_size %> <span class="ts-summary-card-unit">members</span></p>
    </div>
  </div>
</div>

<%# Dashboard Analytics Section - Summary, Time Overview, and Visualization %>
<div class="analytics-section">

  <%# Time Overview Box (Middle) - Shows Date, Team Member Count, Hours %>
  <% if (@view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members') && @time_overview_data&.any? %>
    <div class="box time-overview-box">
      <h3 class="text-base font-semibold text-gray-900 mb-3 text-center"><%= time_overview_header(@grouping) %></h3>
      
      <div class="relative overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-sm text-gray-700 bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3">
                <%= @grouping == 'daily' ? l(:label_date) : l("label_#{@grouping}") %>
              </th>
              <th scope="col" class="px-6 py-3 text-center">Team Size</th>
              <th scope="col" class="px-6 py-3 text-right"><%= l(:label_hours) %></th>
            </tr>
          </thead>
          <tbody>
            <% @time_overview_data.slice(@offset, @limit).each do |entry| %>
              <tr class="bg-white border-b hover:bg-gray-50">
                <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap"><%= entry.period %></th>
                <td class="px-6 py-4 text-center text-gray-900"><%= entry.member_count %></td>
                <td class="px-6 py-4 text-right font-mono text-gray-900"><%= format_hours(entry.hours) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="bg-gray-50 border-t-2 border-gray-200">
              <td class="px-6 py-3 font-semibold text-gray-900"><%= l(:label_total) %></td>
              <td class="px-6 py-3"></td>
              <td class="px-6 py-3 text-right font-semibold text-gray-900"><%= format_hours(@total_hours) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
      
      <%# Pagination %>
      <div class="pagination-wrapper">
        <% current_page = params[:page].to_i > 0 ? params[:page].to_i : 1 %>
        <% permitted_params = params.permit(:filter, :from, :to, :grouping, :chart_type, :per_page, :view_mode, :team_id) %>
        <%= pagination_links(current_page, @total_pages, permitted_params).html_safe %>
        
        <div class="pagination-info">
          (<%= @offset + 1 %>-<%= [@offset + @limit, @entry_count].min %>/<%= @entry_count %>)
        </div>
      </div>
    </div>
  <% end %>

  <%# Visualization Section (Right Side) %>
  <div class="box visualization-section">
    <h3 style="display: flex; justify-content: flex-end;">
      <div class="visualization-controls">
        <% if @view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members' %>
          <% chart_type = %w[line bar].include?(params[:chart_type]) ? params[:chart_type] : 'line' %>
          <div class="inline-flex gap-2">
            <button type="button"
                    onclick="switchTeamChartType('line')"
                    style="<%= chart_type == 'line' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= chart_type == 'line' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
              Trend
            </button>
            <button type="button"
                    onclick="switchTeamChartType('bar')"
                    style="<%= chart_type == 'bar' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                    class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= chart_type == 'bar' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
              Stacked
            </button>
          </div>
        <% end %>
      </div>
    </h3>
    
    <% if (@view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members') && @chart_data.present? && @entry_count > 0 %>
      <div id="chart-container" style="display: block;">
        <div class="chart-wrapper">
          <canvas id="time-chart" class="chart" 
                  data-chart='<%= @chart_data %>' 
                  data-grouping-label="<%= grouping_label(@grouping) %>"></canvas>
        </div>
      </div>
    <% elsif @view_mode == 'time_entries' || @view_mode == 'activity' || @view_mode == 'project' || @view_mode == 'members' %>
      <div class="chart-container" style="display: flex; align-items: center; justify-content: center; min-height: 300px; background: #f9f9f9; border: 1px dashed #ccc; border-radius: 5px;">
        <div style="text-align: center; padding: 40px; color: #666;">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          <p style="margin: 0; font-size: 1.1em; font-weight: 500;">No Data Available</p>
          <p style="margin: 10px 0 0 0; font-size: 0.9em;">
            <% if @team_size == 0 %>
              No active team members found for this period
            <% elsif @time_entries.empty? %>
              No time entries found for the selected period and team
            <% else %>
              Adjust filters to view chart
            <% end %>
          </p>
        </div>
      </div>
    <% else %>
      <div class="chart-container" style="display: flex; align-items: center; justify-content: center; min-height: 300px; background: #f9f9f9; border: 1px dashed #ccc; border-radius: 5px;">
        <div style="text-align: center; padding: 40px; color: #666;">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 15px; opacity: 0.5;">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          <p style="margin: 0; font-size: 1.1em; font-weight: 500;">Chart Visualization</p>
          <p style="margin: 10px 0 0 0; font-size: 0.9em;">Chart will be available for this view soon</p>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render(partial: 'team_analytics/view_togglers') %>
<% summary_chart_colors = ['#4E79A7', '#F28E2B', '#E15759', '#76B7B2', '#59A14F', '#EDC948', '#B07AA1', '#FF9DA7', '#9C755F', '#BAB0AC'] %>

<%# Additional View-Specific Content %>
<% if @view_mode == 'activity' %>
  <%# Activity Analysis Tables - Show pivot table for Activity × Time Period %>
  <% if @activities&.any? %>
    <div class="ta-analysis-layout flex gap-6 mb-6">
      <div class="ta-analysis-table flex-1 bg-white rounded-lg shadow-md border border-gray-200 min-w-0">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
              <h3 class="text-lg font-semibold text-gray-900 whitespace-nowrap">Time by Activity</h3>
              <div class="inline-flex rounded-md shadow-sm" role="group">
                <button type="button" id="show-detailed-btn-activity"
                        onclick="showDetailedView('activity');"
                        style="<%= (@activity_view_state != 'summary') ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-l-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= (@activity_view_state != 'summary') ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">data_table</span>
                  Detailed
                </button>
                <button type="button" id="show-summary-btn-activity"
                        onclick="showSummaryView('activity');"
                        style="<%= @activity_view_state == 'summary' ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
                        class="inline-flex items-center px-4 py-2 text-sm font-medium transition-colors border border-gray-300 rounded-r-lg focus:outline-none focus:ring-4 focus:ring-blue-300 <%= @activity_view_state == 'summary' ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
                  <span class="material-symbols-outlined mr-2" aria-hidden='true' style="font-size: 18px;">summarize</span>
                  Summary
                </button>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
              <span class="text-sm text-gray-600 whitespace-nowrap">Hours: <strong class="text-gray-900"><%= format_hours(@grand_total || 0) %></strong></span>
              <%= form_tag team_analytics_path, method: :get, local: true, class: 'flex items-center gap-2' do %>
            <%= hidden_field_tag :filter, params[:filter] %>
            <%= hidden_field_tag :from, params[:from] %>
            <%= hidden_field_tag :to, params[:to] %>
            <%= hidden_field_tag :grouping, params[:grouping] %>
            <%= hidden_field_tag :chart_type, params[:chart_type] %>
            <%= hidden_field_tag :view_mode, @view_mode %>
            <%= hidden_field_tag :team_id, params[:team_id] %>
            <%= hidden_field_tag :activity_view_state, @activity_view_state, id: 'activity_view_state_field' %>
            <%= label_tag :per_page, 'Per page:', class: 'text-sm text-gray-600 whitespace-nowrap' %>
            <%= select_tag :per_page, options_for_select(per_page_options, @limit),
                onchange: 'this.form.submit()',
                class: 'ts-per-page-select px-3 py-1.5 text-sm text-center border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500' %>
              <% end %>
            </div>
          </div>
        </div>

      <%# Detailed View: Pivot Table (Time Period × Activity matrix) - Default %>
      <div id="team-activity-detailed-view" class="pivot-table-wrapper ta-analysis-table-scroll overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
          <thead class="text-sm text-gray-700 bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 border-r-2 border-gray-300"><%= @grouping == 'daily' ? l(:label_date) : l("label_#{@grouping}") %></th>
              <% @activities.each do |activity| %>
                <th scope="col" class="px-6 py-3 text-center border-r border-gray-200"><%= activity %></th>
              <% end %>
              <th scope="col" class="px-6 py-3 text-right border-l-2 border-gray-300 font-bold"><%= l(:label_hours) %></th>
            </tr>
          </thead>
          <tbody>
            <% @paginated_periods.each_with_index do |period_display, index| %>
              <% period_key = @activity_pivot_data[:raw_periods][(@offset + index)] %>
              <tr class="bg-white border-b hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap"><%= period_display %></td>
                <% @activities.each do |activity| %>
                  <td class="px-6 py-4 text-center text-gray-900">
                    <% hours = @matrix_data[period_key][activity] || 0 %>
                    <%= hours > 0 ? format_hours(hours) : '—' %>
                  </td>
                <% end %>
                <td class="px-6 py-4 text-right font-semibold text-gray-900"><%= format_hours(@period_totals[period_key] || 0) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <%# Summary View: Simple Activity Table (Hidden by default) %>
      <div id="team-activity-summary-view" style="display: none;" class="px-4 py-4">
