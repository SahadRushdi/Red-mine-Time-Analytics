<%= label_tag :per_page, 'Per page:', class: 'text-sm text-gray-600 whitespace-nowrap' %>
<%= hidden_field_tag :per_page, @limit, id: 'per-page-field' %>
<div class="relative">
  <button type="button" id="per-page-dropdown-button" onclick="togglePerPageDropdown()"
          class="inline-flex h-[34px] min-w-[100px] items-center justify-between gap-2 rounded-md border border-gray-300 bg-white px-3 text-sm font-medium text-gray-900 hover:bg-gray-50 focus:outline-none focus:ring-0">
    <span id="per-page-label"><%= @limit %></span>
    <svg class="h-4 w-4 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>
  <div id="per-page-dropdown" class="hidden absolute right-0 z-20 mt-1 min-w-[100px] overflow-y-auto rounded-lg border border-gray-200 bg-white py-1 shadow-xl">
    <% per_page_options.each do |label, value| %>
      <button type="button" class="leaves-dropdown-option <%= 'leaves-dropdown-option--active' if value == @limit %> w-full px-4 py-2 text-left text-sm text-gray-700" onclick="selectPerPage(<%= value %>)"><%= label %></button>
    <% end %>
  </div>
</div>
