<%#
  "Customize groups" popup — session-only drag-and-drop remap of activities into Activity Groups.
  Shared by the Team Dashboard and Individual Dashboard's Activity "Grouped" tab; the element ids
  here are generic (not page-prefixed) so the same JS wiring (see team_activity_groups.js /
  ta_activity_group_board.js) works on either page. Nothing here is ever persisted.
%>
<div id="customize-groups-modal" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto h-[calc(100%-1rem)] max-h-full">
  <div class="relative w-full max-w-4xl max-h-full">
    <div class="relative bg-white rounded-xl shadow-2xl border border-gray-100 overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between p-5 border-b border-gray-100 bg-gray-50/50">
        <div>
          <h3 class="text-xl font-bold text-gray-900"><%= l(:label_customize_groups) %></h3>
          <p class="text-sm text-gray-500">Drag activities between groups. Applies to your view only.</p>
        </div>
        <button type="button" id="customize-groups-close-btn" class="!text-gray-400 !bg-transparent hover:!bg-gray-200 hover:!text-gray-900 !rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center focus:!outline-none !ring-0 !border-0 !shadow-none transition-colors cursor-pointer" data-modal-hide="customize-groups-modal">
          <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
          </svg>
          <span class="sr-only">Close modal</span>
        </button>
      </div>
      <!-- Body -->
      <div class="p-5">
        <div id="customize-groups-board" class="ta-group-board"></div>
      </div>
      <!-- Footer -->
      <div class="flex items-center p-4 space-x-2 border-t border-gray-100 bg-gray-50/50 justify-between">
        <button type="button" id="customize-groups-reset-btn" class="!text-blue-600 !bg-transparent hover:!underline !border-none !outline-none !shadow-none !ring-0 text-sm font-semibold cursor-pointer">
          Reset to default
        </button>
        <button type="button" id="customize-groups-apply-btn" class="!text-white !bg-[#3b82f6] hover:!bg-[#2563eb] !border-none !outline-none !shadow-none !ring-0 rounded-lg text-sm font-semibold px-5 py-2.5 transition-all cursor-pointer">
          Apply
        </button>
      </div>
    </div>
  </div>
</div>
