<%= form_tag team_analytics_path, method: :get, local: true, id: 'team-analytics-form', class: 'ta-filter-form flex items-center gap-3 flex-wrap' do %>
  <% selected_filter = params[:filter] || 'this_month' %>
  <% current_chart_type = %w[line bar].include?(params[:chart_type]) ? params[:chart_type] : 'line' %>
  <%= hidden_field_tag :chart_type, current_chart_type, id: 'chart_type_hidden' %>
  <%= hidden_field_tag :view_mode, @view_mode %>
  <%= hidden_field_tag :filter, selected_filter, id: 'filter_hidden' %>
  <%= hidden_field_tag :activity_view_state, @activity_view_state, id: 'activity_view_state_field' %>
  <%= hidden_field_tag :project_view_state, @project_view_state, id: 'project_view_state_field' %>
  <%= hidden_field_tag :member_view_state, @member_view_state, id: 'member_view_state_field' %>
  <%= hidden_field_tag :team_id, @selected_team&.id, id: 'team_id_hidden' %>
  <%= hidden_field_tag :grouping, @grouping, id: 'grouping_hidden' %>

  <div class="ta-period-group inline-flex rounded-lg shadow-sm" role="group">
    <% [
      ['this_month', 'This Month'],
      ['last_month', 'Last Month'],
      ['last_3_months', 'Last 3 Months'],
      ['custom', 'Custom Range']
    ].each_with_index do |(value, label), idx| %>
      <% active = selected_filter == value %>
      <% button_classes = ['ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 focus:outline-none focus:ring-4 focus:ring-blue-300'] %>
      <% button_classes << 'rounded-l-lg' if idx.zero? %>
      <% button_classes << 'rounded-r-lg' if idx == 3 %>
      <% button_classes << (active ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900') %>
      <button type="button"
              onclick="<%= value == 'custom' ? 'toggleCustomDateRange()' : "setTeamFilterAndSubmit('#{value}')" %>"
              style="<%= active ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
              class="<%= button_classes.join(' ') %>">
        <%= label %>
      </button>
    <% end %>
  </div>

  <div id="custom-date-range" class="ta-custom-range <%= selected_filter == 'custom' ? 'flex' : 'hidden' %> flex-nowrap items-center gap-2">
    <span class="ta-custom-range-label text-sm text-gray-600"><%= l(:label_from) %>:</span>
    <%= date_field_tag :from, params[:from] || @from, class: 'ta-date-input block w-40 min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm' %>
    <span class="ta-custom-range-label text-sm text-gray-600"><%= l(:label_to) %>:</span>
    <%= date_field_tag :to, params[:to] || @to, class: 'ta-date-input block w-40 min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm' %>
  </div>

  <% if @teams.count > 1 %>
    <div class="relative">
      <button type="button" id="team-dropdown-button" onclick="toggleTeamDropdown()"
          class="inline-flex items-center justify-between min-w-48 px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
        <span id="team-selected-text"><%= @selected_team&.name %></span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div id="team-dropdown" class="hidden absolute z-10 mt-1 min-w-48 bg-white border border-gray-300 rounded-lg shadow-xl py-1 max-h-72 overflow-y-auto">
        <ul class="text-sm">
          <% @teams.each do |team| %>
            <li>
              <button type="button" onclick="setTeamAndSubmit('<%= team.id %>', '<%= j team.name %>')"
                  class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 <%= @selected_team&.id == team.id ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
                <%= team.name %>
              </button>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="relative">
    <button type="button" id="grouping-dropdown-button" onclick="toggleGroupingDropdown()"
        class="inline-flex items-center justify-between min-w-36 px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
      <span id="grouping-selected-text"><%= grouping_label(@grouping) %></span>
      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    <div id="grouping-dropdown" class="hidden absolute z-10 mt-1 min-w-36 bg-white border border-gray-300 rounded-lg shadow-xl py-1">
      <ul class="text-sm">
        <% team_grouping_options.each do |label, value| %>
          <li>
            <button type="button" onclick="setGroupingAndSubmit('<%= value %>', '<%= j label %>')"
                class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 <%= @grouping == value ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
              <%= label %>
            </button>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

<script type="text/javascript">
  function setTeamFilterAndSubmit(filterValue) {
    const filterHidden = document.getElementById('filter_hidden');
    const form = document.getElementById('team-analytics-form');
    if (filterHidden && form) {
      filterHidden.value = filterValue;
      form.submit();
    }
  }

  function toggleCustomDateRange() {
    const customRange = document.getElementById('custom-date-range');
    const filterHidden = document.getElementById('filter_hidden');
    if (!customRange || !filterHidden) return;

    if (customRange.classList.contains('hidden')) {
      customRange.classList.remove('hidden');
      customRange.classList.add('flex');
      filterHidden.value = 'custom';
    } else {
      customRange.classList.add('hidden');
      customRange.classList.remove('flex');
      filterHidden.value = 'this_month';
    }
  }

  function toggleTeamDropdown() {
    const dropdown = document.getElementById('team-dropdown');
    if (dropdown) dropdown.classList.toggle('hidden');
  }

  function setTeamAndSubmit(teamId, teamName) {
    const teamHidden = document.getElementById('team_id_hidden');
    const teamText = document.getElementById('team-selected-text');
    const form = document.getElementById('team-analytics-form');
    const dropdown = document.getElementById('team-dropdown');
    if (teamHidden && teamText && form) {
      teamHidden.value = teamId;
      teamText.textContent = teamName;
      if (dropdown) dropdown.classList.add('hidden');
      form.submit();
    }
  }

  function toggleGroupingDropdown() {
    const dropdown = document.getElementById('grouping-dropdown');
    if (dropdown) dropdown.classList.toggle('hidden');
  }

  function setGroupingAndSubmit(groupingValue, groupingText) {
    const groupingHidden = document.getElementById('grouping_hidden');
    const groupingLabel = document.getElementById('grouping-selected-text');
    const dropdown = document.getElementById('grouping-dropdown');
    const form = document.getElementById('team-analytics-form');
    if (groupingHidden && groupingLabel && form) {
      groupingHidden.value = groupingValue;
      groupingLabel.textContent = groupingText;
      if (dropdown) dropdown.classList.add('hidden');
      form.submit();
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('team-analytics-form');
    const fromInput = form ? form.querySelector('input[name="from"]') : null;
    const toInput = form ? form.querySelector('input[name="to"]') : null;
    const filterHidden = document.getElementById('filter_hidden');

    if (!form) return;

    const submitCustomRangeIfReady = function() {
      if (filterHidden && filterHidden.value === 'custom' && fromInput && toInput && fromInput.value && toInput.value) {
        form.submit();
      }
    };

    if (fromInput) fromInput.addEventListener('change', submitCustomRangeIfReady);
    if (toInput) toInput.addEventListener('change', submitCustomRangeIfReady);

    document.addEventListener('click', function(event) {
      const teamDropdown = document.getElementById('team-dropdown');
      const teamButton = document.getElementById('team-dropdown-button');
      if (teamDropdown && teamButton && !teamButton.contains(event.target) && !teamDropdown.contains(event.target)) {
        teamDropdown.classList.add('hidden');
      }

      const groupingDropdown = document.getElementById('grouping-dropdown');
      const groupingButton = document.getElementById('grouping-dropdown-button');
      if (groupingDropdown && groupingButton && !groupingButton.contains(event.target) && !groupingDropdown.contains(event.target)) {
        groupingDropdown.classList.add('hidden');
      }
    });
  });
</script>
