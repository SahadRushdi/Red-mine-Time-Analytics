<div class="mb-0" style="margin-bottom: -1px;">
  <ul class="flex flex-wrap text-sm font-medium text-center text-gray-500 border-b border-gray-200">
    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :team_id).merge(view_mode: 'activity', chart_type: 'line')),
          class: "ta-view-tab inline-block p-4 rounded-t-lg #{@view_mode == 'activity' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50'}" do %>
        Activity
      <% end %>
    </li>
    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :team_id).merge(view_mode: 'project', chart_type: 'line')),
          class: "ta-view-tab inline-block p-4 rounded-t-lg #{@view_mode == 'project' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50'}" do %>
        Project
      <% end %>
    </li>
    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :team_id).merge(view_mode: 'members', chart_type: 'line')),
          class: "ta-view-tab inline-block p-4 rounded-t-lg #{@view_mode == 'members' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50'}" do %>
        Members
      <% end %>
    </li>
  </ul>
</div>
