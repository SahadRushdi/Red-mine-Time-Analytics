<%
  # Sorting/pagination controls are shared across the three view modes but target a
  # view-specific summary container + view-state field, so resolve the active one here.
  sort_targets = {
    'members'  => { container: 'team-member-summary-view',  state: @member_view_state,   state_param: :member_view_state,   field_id: 'member_view_state_field' },
    'activity' => { container: 'team-activity-summary-view', state: @activity_view_state, state_param: :activity_view_state, field_id: 'activity_view_state_field' },
    'project'  => { container: 'team-project-summary-view',  state: @project_view_state,  state_param: :project_view_state,  field_id: 'project_view_state_field' }
  }
  current_sort = sort_targets[@view_mode]
%>
<div class="ta-team-tabs-row flex flex-col lg:flex-row lg:items-center lg:justify-between gap-2 px-4">
  <ul class="flex flex-wrap text-sm font-medium text-center text-gray-500 -mb-px">
    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :overview_page, :team_id, :chart_type, :activity_view_state, :project_view_state, :member_view_state).merge(view_mode: 'members')),
          class: "ta-view-tab inline-block p-4 rounded-t-lg #{@view_mode == 'members' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50'}",
          onclick: "sessionStorage.setItem('scrollToTeamTable','true');",
          data: { team_tab_nav: true } do %>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 0a10 10 0 1 0 10 10A10.011 10.011 0 0 0 10 0Zm0 5a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 13a8.949 8.949 0 0 1-4.951-1.488A3.987 3.987 0 0 1 9 13h2a3.987 3.987 0 0 1 3.951 3.512A8.949 8.949 0 0 1 10 18Z"/>
          </svg>
          Members
        </div>
      <% end %>
    </li>
    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :overview_page, :team_id, :chart_type, :activity_view_state, :project_view_state, :member_view_state).merge(view_mode: 'activity')),
          class: "ta-view-tab inline-block p-4 rounded-t-lg #{@view_mode == 'activity' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50'}",
          onclick: "sessionStorage.setItem('scrollToTeamTable','true');",
          data: { team_tab_nav: true } do %>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 10a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-7 8a7 7 0 0 1 14 0H3Zm14.5-9.5a2.5 2.5 0 1 0-2.5-2.5 2.5 2.5 0 0 0 2.5 2.5Zm-1.795 3.704A6.96 6.96 0 0 1 20 18h-2a4.96 4.96 0 0 0-2.295-4.296Z"/>
          </svg>
          Activity
        </div>
      <% end %>
    </li>
    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :overview_page, :team_id, :chart_type, :activity_view_state, :project_view_state, :member_view_state).merge(view_mode: 'project')),
          class: "ta-view-tab inline-block p-4 rounded-t-lg #{@view_mode == 'project' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50'}",
          onclick: "sessionStorage.setItem('scrollToTeamTable','true');",
          data: { team_tab_nav: true } do %>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 18 20">
            <path d="M16 1h-3.278A1.992 1.992 0 0 0 11 0H7a1.993 1.993 0 0 0-1.722 1H2a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm-3 14H5a1 1 0 0 1 0-2h8a1 1 0 0 1 0 2Zm0-4H5a1 1 0 0 1 0-2h8a1 1 0 1 1 0 2Zm0-5H5a1 1 0 0 1 0-2h2V2h4v2h2a1 1 0 1 1 0 2Z"/>
          </svg>
          Project
        </div>
      <% end %>
    </li>
  </ul>

  <% if current_sort %>
    <div class="flex flex-wrap items-center gap-3 pb-2 lg:pb-0">
      <div id="summary-sort-buttons" class="flex items-center gap-2" style="<%= current_sort[:state] == 'summary' ? '' : 'display: none;' %>">
        <button type="button" id="sort-name-<%= current_sort[:container] %>" onclick="sortSummaryCards('<%= current_sort[:container] %>', 'name')" style="background:#fff;color:#6b7280;border-color:#d1d5db;" class="text-xs px-2.5 py-1 font-medium rounded-lg border transition-colors">A–Z ↑</button>
        <button type="button" id="sort-hours-<%= current_sort[:container] %>" onclick="sortSummaryCards('<%= current_sort[:container] %>', 'hours')" style="background:#eff6ff;color:#1d4ed8;border-color:#93c5fd;" class="text-xs px-2.5 py-1 font-medium rounded-lg border transition-colors">Hours ↓</button>
      </div>
      <%= form_tag team_analytics_path, method: :get, local: true, class: 'flex items-center gap-2' do %>
        <%= hidden_field_tag :filter, params[:filter] %>
        <%= hidden_field_tag :from, params[:from] %>
        <%= hidden_field_tag :to, params[:to] %>
        <%= hidden_field_tag :grouping, params[:grouping] %>
        <%= hidden_field_tag :chart_type, params[:chart_type] %>
        <%= hidden_field_tag :view_mode, @view_mode %>
        <%= hidden_field_tag :team_id, params[:team_id] %>
        <%= hidden_field_tag current_sort[:state_param], current_sort[:state], id: current_sort[:field_id] %>
        <%= render 'per_page_dropdown' %>
      <% end %>
    </div>
  <% end %>
</div>
