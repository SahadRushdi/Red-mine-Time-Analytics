    <li class="me-2">
      <%= link_to team_analytics_path(params.permit(:filter, :from, :to, :grouping, :per_page, :page, :overview_page, :team_id, :chart_type, :activity_view_state, :project_view_state, :member_view_state).merge(view_mode: 'activity')),
