<%= render 'time_analytics/includes' %>

<%# ── Header ──────────────────────────────────────────────────────────────── %>
<div class="flex items-center justify-between mb-6 flex-wrap gap-4">
  <div class="flex items-center gap-4">
    <%= link_to my_time_path(filter: @filter, from: @from, to: @to),
        class: 'inline-flex items-center gap-2 px-4 py-2 text-sm font-medium !text-gray-700 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 focus:ring-2 focus:ring-blue-300 transition-colors' do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>Back to My Time</span>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        My Work Log
      </h1>
      <p class="text-sm text-gray-500">
        <%= @from && @to ? "#{@from.strftime('%b %d')} – #{@to.strftime('%b %d, %Y')}" : 'All Time' %>
        <% if @last_entry %>
          <% local_time = @last_entry.created_on.in_time_zone(User.current.time_zone || 'UTC') %>
          <span class="ml-2">· Last entry:
            <% if local_time.to_date == Date.today %>
              Today, <%= local_time.strftime('%I:%M %p') %>
            <% elsif local_time.to_date == Date.yesterday %>
              Yesterday, <%= local_time.strftime('%I:%M %p') %>
            <% else %>
              <%= local_time.strftime('%b %d, %I:%M %p') %>
            <% end %>
          </span>
        <% end %>
      </p>
    </div>
  </div>

  <%# Filter + Grouping Controls %>
  <%= form_tag time_entry_panel_path, method: :get, local: true, id: 'time-entry-panel-form', class: 'ta-filter-form flex items-center gap-3 flex-wrap' do %>
    <%= hidden_field_tag :filter, @filter, id: 'filter_hidden' %>
    <%= hidden_field_tag :grouping, @grouping, id: 'tep_grouping_hidden' %>

    <%# Time period buttons %>
    <div class="ta-period-group inline-flex rounded-lg shadow-sm" role="group">
      <% ['last_7_days', 'last_14_days', 'this_week', 'last_week', 'this_month', 'custom'].each_with_index do |f, i| %>
        <% labels = { 'last_7_days' => 'Last 7 Days', 'last_14_days' => 'Last 14 Days', 'this_week' => 'This Week', 'last_week' => 'Last Week', 'this_month' => 'This Month', 'custom' => 'Custom Range' } %>
        <% is_active = @filter == f %>
        <% rounded = i == 0 ? 'rounded-l-lg' : (i == 5 ? 'rounded-r-lg' : '') %>
        <button type="button" onclick="<%= f == 'custom' ? 'toggleCustomDateRange()' : "setFilterAndSubmit('#{f}')" %>"
            style="<%= is_active ? 'background-color: #3b82f6 !important; color: white !important;' : '' %>"
            class="ta-period-btn px-4 py-2.5 text-sm font-medium transition-colors border border-gray-300 <%= rounded %> focus:outline-none focus:ring-4 focus:ring-blue-300 <%= is_active ? '!text-white !bg-[#3b82f6] hover:!bg-[#2563eb]' : '!text-gray-700 !bg-white hover:!bg-gray-50 hover:!text-gray-900' %>">
          <%= labels[f] %>
        </button>
      <% end %>
    </div>

    <%# Custom date range %>
    <div id="custom-date-range" class="ta-custom-range <%= 'hidden' unless @filter == 'custom' %> flex flex-nowrap items-center gap-2">
      <div id="tep-date-range-picker" date-rangepicker datepicker-format="mm/dd/yyyy" datepicker-show-on-focus="false" class="flex flex-nowrap items-center gap-2">
        <span class="ta-custom-range-label text-sm text-gray-600">From:</span>
        <%= text_field_tag :from, (@filter == 'custom' && @from ? @from.strftime('%m/%d/%Y') : ''), id: 'tep-date-range-start', autocomplete: 'off', placeholder: 'Select date start', class: 'ta-date-input block w-40 min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm placeholder:text-gray-400 focus:outline-none focus:ring-0 focus:border-gray-400', 'datepicker-format' => 'mm/dd/yyyy', 'datepicker-show-on-focus' => 'false', 'datepicker-autohide' => 'true' %>
        <span class="ta-custom-range-label text-sm text-gray-600">To:</span>
        <%= text_field_tag :to, (@filter == 'custom' && @to ? @to.strftime('%m/%d/%Y') : ''), id: 'tep-date-range-end', autocomplete: 'off', placeholder: 'Select date end', class: 'ta-date-input block w-40 min-w-0 shrink-0 px-3 py-2.5 text-sm text-gray-900 bg-white border border-gray-300 rounded-lg shadow-sm placeholder:text-gray-400 focus:outline-none focus:ring-0 focus:border-gray-400', 'datepicker-format' => 'mm/dd/yyyy', 'datepicker-show-on-focus' => 'false', 'datepicker-autohide' => 'true' %>
      </div>
    </div>

    <%# Grouping dropdown %>
    <div class="relative tep-grouping-wrapper">
      <button type="button" id="tep-grouping-btn" onclick="toggleTepGroupingDropdown()"
              class="inline-flex items-center justify-between w-32 px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
        <span id="tep-grouping-text"><%= @grouping.capitalize %></span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div id="tep-grouping-dropdown" class="hidden absolute z-10 mt-1 w-32 bg-white border border-gray-300 rounded-lg shadow-xl py-1">
        <% [['daily', 'Daily'], ['weekly', 'Weekly'], ['monthly', 'Monthly']].each do |val, label| %>
          <button type="button" onclick="setTepGroupingAndSubmit('<%= val %>')"
                  class="w-full text-left px-4 py-2 text-sm hover:!bg-gray-100 hover:!text-gray-900 <%= @grouping == val ? '!bg-blue-50 !text-[#3b82f6] font-semibold' : '!text-gray-700' %>">
            <%= label %>
          </button>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%# ── Summary Cards ────────────────────────────────────────────────────────── %>
<div class="ts-summary-cards-row mb-6">
  <div class="ts-summary-card ts-summary-card--total flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Total hours</p>
      <p class="ts-summary-card-value"><%= format_hours(@total_hours) %> <span class="ts-summary-card-unit">hrs</span></p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--active-days flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Projects</p>
      <p class="ts-summary-card-value"><%= @unique_projects_count %> <span class="ts-summary-card-unit">active</span></p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--average flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">All Issues</p>
      <p class="ts-summary-card-value"><%= @all_issues_count %> <span class="ts-summary-card-unit">assigned</span></p>
    </div>
  </div>

  <div class="ts-summary-card ts-summary-card--issues flex items-center gap-4">
    <div class="ts-summary-card-icon">
      <svg class="ts-summary-card-icon-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.9" d="M9 5h6M8 3h8a2 2 0 012 2v14a2 2 0 01-2 2H8a2 2 0 01-2-2V5a2 2 0 012-2zm2 7h6m-6 4h4"></path>
      </svg>
    </div>
    <div class="ts-summary-card-content">
      <p class="ts-summary-card-label">Issues Worked</p>
      <p class="ts-summary-card-value"><%= @issues_worked_count %> <span class="ts-summary-card-unit">issues</span></p>
    </div>
  </div>
</div>

<%# ── Tabs + Content ───────────────────────────────────────────────────────── %>
<div class="bg-white rounded-lg shadow-sm border border-gray-200">
  <%# Tab Bar + Search %>
  <div class="flex items-end justify-between px-6 pt-2 pb-0 border-b border-gray-200 flex-wrap gap-3" style="margin-bottom: -1px;">
    <ul class="flex flex-wrap text-sm font-medium text-center text-gray-500 -mb-px">
      <li class="me-2">
        <button type="button" id="tab-time-logs" onclick="switchTab('time-logs')"
                class="ta-view-tab inline-block px-4 py-2.5 rounded-t-lg text-gray-500 hover:text-gray-600 hover:bg-gray-50 ta-view-tab-active">
          <span class="inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Logged
            <span class="ts-tab-badge"><%= @grouped_entries.count { |g| g[:entry_count] > 0 } %></span>
          </span>
        </button>
      </li>
      <li class="me-2">
        <button type="button" id="tab-recent-work" onclick="switchTab('recent-work')"
                class="ta-view-tab inline-block px-4 py-2.5 rounded-t-lg text-gray-500 hover:text-gray-600 hover:bg-gray-50">
          <span class="inline-flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Unlogged
            <span class="ts-tab-badge"><%= @issues_without_logs.count %></span>
          </span>
        </button>
      </li>
    </ul>

    <div class="relative">
      <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
        <svg class="w-4 h-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
        </svg>
      </div>
      <input type="search" id="ts-search-input" placeholder="Search issues..."
             class="ts-search-input block w-80 text-base border border-gray-300"
             oninput="filterTableRows()">
    </div>
  </div>

  <%# ── Tab: Time Logs (grouped) ─────────────────────────────────────────── %>
  <div id="panel-time-logs">
    <% periods_with_entries = @grouped_entries.count { |g| g[:entry_count] > 0 } %>
    <% period_label = @grouping == 'daily' ? 'day' : (@grouping == 'weekly' ? 'week' : 'month') %>
    <% show_dates_column = @grouping != 'daily' %>
    <div class="px-6 py-2 text-sm text-gray-500 flex items-center justify-between border-b border-gray-100">
      <span><%= pluralize(periods_with_entries, period_label) %> with entries · Total: <strong><%= format_hours(@total_hours) %> hours</strong> logged this period</span>
    </div>

    <% if @grouped_entries.any? %>
      <% @grouped_entries.each_with_index do |group, idx| %>
        <%
          period_key = group[:key]
          date_str   = period_key.strftime('%Y-%m-%d')

          case @grouping
          when 'weekly'
            week_end   = [period_key + 6.days, @to].min
            period_display = "Week of #{period_key.strftime('%b %-d')} - #{week_end.strftime('%b %-d, %Y')}"
            is_today_group = (Date.current >= period_key && Date.current <= period_key + 6.days)
            period_start = period_key
            period_end   = week_end
          when 'monthly'
            period_display = period_key.strftime('%B %Y')
            is_today_group = (Date.current.beginning_of_month == period_key)
            period_start = period_key
            period_end   = [period_key.end_of_month, @to].min
          else # daily
            period_display = period_key.strftime('%A, %b %-d, %Y')
            is_today_group = (period_key == Date.current)
            period_start = period_key
            period_end   = period_key
          end

          has_entries    = group[:entry_count] > 0
          auto_expand    = false
        %>

        <%# Group header row %>
        <div id="tep-group-row-<%= idx %>"
             class="tep-group-row flex items-center justify-between px-5 py-3 border-b border-gray-100 hover:bg-gray-50 cursor-pointer transition-colors"
             data-period-key="<%= date_str %>"
             data-expand-id="tep-expand-<%= idx %>"
             data-chevron-id="tep-chevron-<%= idx %>"
             onclick="toggleTepGroup(<%= idx %>)">
          <div class="flex items-center gap-3">
            <svg id="tep-chevron-<%= idx %>"
                 class="w-4 h-4 text-gray-400 transition-transform duration-200 <%= auto_expand ? 'tep-chevron-open' : '' %>"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
            <div>
              <span class="font-medium text-gray-800 text-sm">
                <%= period_display %>
              </span>
              <% if is_today_group %>
                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">Today</span>
              <% end %>
              <% if @grouping != 'daily' && has_entries %>
                <span class="block text-sm font-medium text-gray-500 mt-0.5"><%= group[:entry_count] %> entr<%= group[:entry_count] == 1 ? 'y' : 'ies' %></span>
              <% end %>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="flex items-center gap-1.5 text-sm text-gray-600">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="font-semibold text-gray-900"><%= format_hours(group[:total_hours]) %></span>
              <% if @grouping == 'daily' %>
                <span class="text-sm font-medium text-gray-500"><%= group[:entry_count] %> entr<%= group[:entry_count] == 1 ? 'y' : 'ies' %></span>
              <% end %>
            </div>

            <button type="button"
                    onclick="event.stopPropagation(); toggleTepInlineForm(<%= idx %>, '<%= date_str %>')"
                    id="tep-log-btn-<%= idx %>"
                    class="tep-action-btn inline-flex items-center gap-1 px-4 py-2 text-xs font-semibold rounded-lg"
                    style="background-color: #16a34a !important; color: white !important;">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              Log
            </button>
          </div>
        </div>

        <%# Expandable content %>
        <div id="tep-expand-<%= idx %>" class="<%= auto_expand ? '' : 'hidden' %> border-b border-gray-100" data-period-key="<%= date_str %>">

          <%# ── Inline log form — single horizontal strip ──────────────── %>
          <div id="tep-inline-form-<%= idx %>" class="hidden tep-inline-form">
            <div class="flex items-center gap-2 px-4 py-3 bg-blue-50 border-b border-blue-100 border-l-4 border-l-blue-500 flex-wrap">

              <%# Label %>
              <div class="flex items-center gap-1.5 flex-shrink-0">
                <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-sm font-bold text-blue-700 whitespace-nowrap"><%= period_display %></span>
              </div>

              <div class="w-px h-5 bg-blue-200 flex-shrink-0"></div>

              <%# Issue — custom searchable dropdown %>
              <div class="relative flex-1 min-w-[200px]" id="tep-issue-wrapper-<%= idx %>">
                <input type="text"
                       id="tep-issue-search-<%= idx %>"
                       placeholder="🔍 Search issue…  *"
                       autocomplete="off"
                       onfocus="openTepIssueDropdown(<%= idx %>)"
                       oninput="filterTepIssues(<%= idx %>)"
                       onkeydown="handleTepIssueKey(event, <%= idx %>)"
                       class="tep-field w-full text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white">
                <input type="hidden" id="tep-issue-<%= idx %>">
                <div id="tep-issue-list-<%= idx %>"
                     class="tep-issue-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                     style="min-width: 320px; max-height: 220px; top: calc(100% + 2px);">
                  <% @issues.each do |issue| %>
                    <div class="tep-issue-option px-3 py-2 text-sm cursor-pointer flex items-start gap-2 border-b border-gray-50 last:border-0"
                         tabindex="0"
                         data-id="<%= issue.id %>"
                         data-text="#<%= issue.id %> – <%= j(issue.subject) %>"
                         data-search="<%= j("#{issue.id} #{issue.subject.downcase}") %>"
                         onclick="selectTepIssue(<%= idx %>, '<%= issue.id %>', this.getAttribute('data-text'))"
                         onkeydown="handleTepIssueOptionKey(event, <%= idx %>, '<%= issue.id %>', this.getAttribute('data-text'))">
                      <span class="font-bold text-blue-600 flex-shrink-0">#<%= issue.id %></span>
                      <span class="text-gray-700 leading-relaxed"><%= issue.subject %></span>                    </div>
                  <% end %>
                </div>
              </div>

              <%# Date – weekly/monthly only %>
              <% if @grouping != 'daily' %>
                <input type="text" id="tep-date-<%= idx %>"
                       value="<%= (is_today_group ? Date.current : period_key).strftime('%m/%d/%Y') %>"
                       data-grouping="<%= @grouping %>"
                       data-period-start="<%= period_start.strftime('%Y-%m-%d') %>"
                       data-period-end="<%= period_end.strftime('%Y-%m-%d') %>"
                       datepicker
                       datepicker-format="mm/dd/yyyy"
                       datepicker-autohide
                       title="Date"
                       class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">
              <% else %>
                <input type="hidden" id="tep-date-<%= idx %>" value="<%= date_str %>">
              <% end %>

              <%# Hours %>
              <input type="text" id="tep-hours-<%= idx %>"
                     placeholder="Hours *"
                     autocomplete="off"
                     oninput="formatHoursInput(this)"
                     title="Hours (e.g. 1, 1:30, 10)"
                     class="tep-field text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-24">

              <%# Activity — custom Flowbite-style dropdown %>
              <div class="relative flex-shrink-0" id="tep-activity-wrapper-<%= idx %>">
                <button type="button"
                        id="tep-activity-btn-<%= idx %>"
                        onclick="toggleTepActivityDropdown(<%= idx %>)"
                        onkeydown="tepHandleActivityDropdownTriggerKey(event, 'tep-activity-list-<%= idx %>')"
                        class="tep-field flex items-center justify-between gap-2 text-sm px-3 !border !border-gray-300 !rounded-lg !bg-white w-44 text-left whitespace-nowrap !outline-none !shadow-none !ring-0">
                  <span id="tep-activity-text-<%= idx %>" class="text-gray-400 truncate flex-1">Activity *</span>
                  <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <input type="hidden" id="tep-activity-<%= idx %>">
                <div id="tep-activity-list-<%= idx %>"
                     class="tep-activity-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                     style="min-width: 200px; max-height: 220px; top: calc(100% + 2px);">
                  <div class="px-3 py-2 text-sm text-gray-400 italic">Select an issue first</div>
                </div>
              </div>

              <%# Comment %>
              <input type="text" id="tep-comment-<%= idx %>"
                     placeholder="Comment (optional)"
                     autocomplete="off"
                     class="tep-field text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-1 min-w-[100px]">

              <%# Cancel %>
              <button type="button" onclick="hideTepInlineForm(<%= idx %>)"
                      class="tep-action-btn flex-shrink-0 px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0"
                      style="background-color: #dc2626 !important;">
                ✕ Cancel
              </button>

              <%# Save %>
              <button type="button" onclick="submitTepInlineLog(event, <%= idx %>)"
                      class="tep-action-btn flex-shrink-0 inline-flex items-center gap-1 px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0"
                      style="background-color: #2563eb !important;">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Save
              </button>
            </div>
            <div id="tep-inline-error-<%= idx %>" class="hidden px-4 py-2 text-sm text-red-800 bg-red-50 border-b border-red-100 border-l-4 border-l-red-400" role="alert"></div>
          </div>

          <%# ── Issue rows table ────────────────────────────────────────── %>
          <% issue_rows = group[:issue_rows] %>
          <% if issue_rows.any? %>
            <div class="overflow-x-auto border-l-4 border-blue-300 pl-4">
              <table class="w-full text-sm ts-table">
                <colgroup>
                  <% if show_dates_column %><col style="width: 148px;"><% end %>
                  <col style="width: 32px;">
                  <col style="width: 55%;">
                  <col style="width: 150px;">
                  <col style="width: 130px;">
                  <col style="width: 96px;">
                  <col style="width: 130px;">
                  <col style="width: 130px;">
                </colgroup>
                <tbody>
                  <% issue_rows.each_with_index do |row, row_idx| %>
              <% issue     = row[:issue] %>
              <% logged    = row[:logged_hours] %>
              <% pct       = [[(issue.done_ratio || 0), 0].max, 100].min %>
              <% dates_str = row[:spent_on_dates].sort.map { |d| d.strftime('%b %-d') }.join(', ') %>
              <% entry_uid = "#{idx}-#{row_idx}" %>
              <tr class="tep-issue-row border-b border-gray-100 hover:bg-gray-50 cursor-pointer"
                  data-search-text="<%= "##{issue.id} #{issue.subject} #{issue.project.name} #{issue.tracker.name} #{issue.status.name}".downcase %>"
                  data-period-key="<%= date_str %>"
                  data-issue-id="<%= issue.id %>"
                  data-expand-id="tep-issue-expand-<%= entry_uid %>"
                  data-chevron-id="tep-issue-chevron-<%= entry_uid %>"
                  onclick="tepToggleIssueEntries('<%= entry_uid %>')">
                      <% if @grouping != 'daily' %>
                        <td class="px-4 py-3 text-gray-400 text-sm whitespace-nowrap"><%= dates_str %></td>
                      <% end %>
                      <td class="px-2 py-3 w-8 text-center">
                        <svg id="tep-issue-chevron-<%= entry_uid %>"
                             class="w-4 h-4 text-gray-400 inline-block transition-transform duration-200"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex items-start gap-1.5">
                          <% if issue.priority.try(:position).to_i >= 3 %>
                            <svg class="w-3.5 h-3.5 flex-shrink-0 mt-0.5" style="color:#ef4444;" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                          <% end %>
                          <div>
                            <span class="ts-tracker-badge"><%= issue.tracker.name %></span>
                            <%= link_to "##{issue.id}", issue_path(issue), target: '_blank',
                                  class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline mr-1',
                                  onclick: 'event.stopPropagation();' %>
                            <%= link_to ": #{h(issue.subject)}".html_safe, issue_path(issue), target: '_blank',
                                  class: 'text-sm !text-black hover:!text-blue-600 hover:!underline',
                                  onclick: 'event.stopPropagation();' %>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-600 whitespace-nowrap"><%= issue.project.name %></td>
                      <td class="px-4 py-3">
                        <span class="ts-status-badge"><%= issue.status.name %></span>
                      </td>
                      <td class="px-4 py-3 text-right text-sm font-semibold text-gray-900 whitespace-nowrap ts-logged-col">
                        <%= format_hours(logged) %>h
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                          <div class="ts-progress-bar-bg" style="width: 72px; flex-shrink: 0;">
                            <div class="ts-progress-bar-fill" style="width:<%= pct %>%; background-color:#3b82f6;"></div>
                          </div>
                          <span class="text-sm text-gray-500 w-8 text-right"><%= pct %>%</span>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap">
                        <%= time_ago_in_words(row[:effective_updated] || issue.updated_on) %> ago
                      </td>
                    </tr>
                    <%# ── Expanded entries sub-table ────────────────────────── %>
                    <tr id="tep-issue-expand-<%= entry_uid %>" class="tep-issue-expand-row hidden" data-period-key="<%= date_str %>" data-issue-id="<%= issue.id %>">
                      <td colspan="<%= @grouping != 'daily' ? 9 : 8 %>" class="px-0 py-0 bg-slate-50 border-b border-gray-200">
                        <div class="pl-10 pr-4 py-3 border-l-4 border-blue-300">
                          <% if row[:entries].any? %>
                            <table class="w-full">
                              <tbody>
                                <% row[:entries].each do |entry| %>
                                  <%# Display row %>
                                  <tr id="tep-entry-display-<%= entry.id %>" class="border-b border-gray-100 hover:bg-gray-50 transition-colors group">
                                    <td class="px-3 py-2.5 text-sm text-gray-500 whitespace-nowrap font-medium w-32"><%= entry.spent_on.strftime('%b %-d, %Y') %></td>
                                    <td class="px-3 py-2.5 w-52 ">
                                      <span class="inline-flex items-center px-2.5 py-1 rounded text-sm font-medium bg-blue-100 text-blue-700"><%= entry.activity.name %></span>
                                    </td>
                                    <td class="px-3 py-2.5 text-sm text-gray-600"><%= entry.comments.present? ? h(entry.comments) : '<span class="italic text-gray-300">—</span>'.html_safe %></td>
                                    <td class="px-3 py-2.5 text-right text-sm font-semibold text-gray-900 whitespace-nowrap w-16"><%= format_hours(entry.hours) %>h</td>
                                    <td class="px-3 py-2.5 w-20">
                                      <div class="flex items-center justify-end gap-1">
                                        <button type="button"
                                                onclick="event.stopPropagation(); tepToggleEditEntry(<%= entry.id %>)"
                                                class="tep-entry-icon-btn p-1 text-blue-500 hover:text-blue-700"
                                                title="Edit">
                                          <span class="material-icons" style="font-size:18px;line-height:1;">edit</span>
                                        </button>
                                        <button type="button"
                                                onclick="event.stopPropagation(); tepDeleteEntry(<%= entry.id %>, '<%= tep_entry_destroy_path(entry.id) %>', '<%= form_authenticity_token %>')"
                                                class="tep-entry-icon-btn p-1 text-red-400 hover:text-red-600"
                                                title="Delete">
                                          <span class="material-icons" style="font-size:18px;line-height:1;">delete</span>
                                        </button>
                                      </div>
                                    </td>
                                  </tr>
                                  <%# Edit form row (hidden by default) %>
                                  <tr id="tep-entry-edit-<%= entry.id %>" class="hidden bg-blue-50 border-b border-blue-100">
                                    <td colspan="5" class="px-3 py-3">
                                       <%= form_tag tep_entry_update_path(entry.id), method: :patch,
                                             class: 'tep-entry-edit-form flex items-end gap-3 flex-wrap',
                                             onsubmit: 'tepMarkStateForRestore(); tepPersistOpenState(); event.stopPropagation()' do %>
                                        <div>
                                          <p class="text-sm font-medium text-gray-500 mb-1">Date</p>
                                          <span class="text-sm font-medium text-gray-700"><%= entry.spent_on.strftime('%b %-d, %Y') %></span>
                                        </div>
                                        <%# Flowbite-style activity dropdown %>
                                        <div class="relative flex-shrink-0" id="tep-edit-act-wrapper-<%= entry.id %>">
                                          <label class="block text-sm font-medium text-gray-500 mb-1">Activity</label>
                                          <button type="button"
                                                  id="tep-edit-act-btn-<%= entry.id %>"
                                                  onclick="event.stopPropagation(); tepToggleEditActivityDropdown(<%= entry.id %>)"
                                                  onkeydown="tepHandleActivityDropdownTriggerKey(event, 'tep-edit-act-list-<%= entry.id %>')"
                                                  class="tep-field tep-entry-act-trigger flex items-center justify-between gap-2 text-sm px-3 py-2 !border !border-gray-300 !rounded-lg !bg-white w-64 text-left !outline-none !shadow-none !ring-0">
                                            <span id="tep-edit-act-text-<%= entry.id %>" class="text-gray-700 truncate flex-1"><%= entry.activity.name %></span>
                                            <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                          </button>
                                          <input type="hidden" name="activity_id" id="tep-edit-act-val-<%= entry.id %>" value="<%= entry.activity_id %>">
                                          <div id="tep-edit-act-list-<%= entry.id %>"
                                               class="tep-activity-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                                               style="min-width:200px; max-height:min(320px, calc(100vh - 240px)); top:calc(100% + 2px); bottom:auto;">
                                            <% entry.project.activities.active.sorted.each do |act| %>
                                              <button type="button"
                                                      onclick="event.stopPropagation(); tepSetEditActivity(<%= entry.id %>, <%= act.id %>, '<%= j(act.name) %>')"
                                                      onkeydown="tepHandleActivityDropdownOptionKey(event, 'tep-edit-act-list-<%= entry.id %>')"
                                                      class="tep-activity-option tep-entry-act-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900 <%= act.id == entry.activity_id ? '!font-semibold !bg-blue-50' : '' %>">
                                                <%= act.name %>
                                              </button>
                                            <% end %>
                                          </div>
                                        </div>
                                        <div class="flex-1" style="min-width:160px;">
                                          <label class="block text-sm font-medium text-gray-500 mb-1">Comment</label>
                                          <input type="text" name="comments" value="<%= h(entry.comments) %>"
                                                 class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-300 focus:outline-none bg-white" />
                                        </div>
                                        <div>
                                          <label class="block text-sm font-medium text-gray-500 mb-1">Hours</label>
                                          <input type="text" name="hours" value="<%= format_hours(entry.hours) %>"
                                                  class="w-24 text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-300 focus:outline-none bg-white"
                                                  placeholder="Hours" title="Hours (e.g. 1, 1:30, 10)" />
                                        </div>
                                        <div class="flex items-end gap-2">
                                          <button type="submit"
                                                  class="tep-entry-save-btn px-4 py-2 text-sm font-semibold !text-white rounded-lg !border-0 !outline-none !shadow-none !ring-0"
                                                  style="background-color:#3b82f6 !important;">Save</button>
                                          <button type="button"
                                                  onclick="event.stopPropagation(); tepToggleEditEntry(<%= entry.id %>)"
                                                  class="tep-entry-cancel-btn px-4 py-2 text-sm font-medium !text-gray-600 !bg-white rounded-lg">Cancel</button>
                                        </div>
                                      <% end %>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="px-5 py-4 text-sm text-gray-400 italic">No entries for this <%= period_label %>.</div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No time entries</h3>
        <p class="mt-1 text-sm text-gray-500">You haven't logged any time in this period.</p>
      </div>
    <% end %>
  </div>

  <%# ── Tab: Issues Worked On ─────────────────────────────────────────────── %>
  <div id="panel-recent-work" class="hidden">
    <div class="px-6 py-2 text-sm text-gray-500 flex items-center gap-2 border-b border-gray-100">
      <svg class="w-4 h-4" style="color: #6366f1;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
      <span>Issues assigned to you without time entries in this period. <%= @issues_without_logs.count %> of <%= @all_issues_count %> issues</span>
    </div>

    <% if @issues_without_logs.any? %>
      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Issue</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Project</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Status</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Last Updated</th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            <% @issues_without_logs.each do |issue| %>
              <tr class="ts-issue-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                  data-search-text="<%= "##{issue.id} #{issue.subject} #{issue.project.name} #{issue.tracker.name} #{issue.status.name}".downcase %>">
                <td class="px-4 py-3">
                  <div class="flex items-start gap-1.5">
                    <% if issue.priority.try(:position).to_i >= 3 %>
                      <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style="color: #ef4444;" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                      </svg>
                    <% end %>
                    <div>
                      <span class="ts-tracker-badge"><%= issue.tracker.name %></span>
                      <%= link_to "##{issue.id}", issue_path(issue), target: '_blank',
                            class: 'text-sm font-semibold !text-black hover:!text-blue-600 hover:!underline mr-1 transition-colors' %>
                      <%= link_to ": #{h(issue.subject)}".html_safe, issue_path(issue), target: '_blank',
                            class: 'text-sm !text-black hover:!text-blue-600 hover:!underline transition-colors' %>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= issue.project.name %></td>
                <td class="px-4 py-3">
                  <span class="ts-status-badge"><%= issue.status.name %></span>
                </td>
                <td class="px-4 py-3 text-gray-500 text-sm"><%= time_ago_in_words(@issue_last_activity[issue.id] || issue.updated_on) %> ago</td>
                <td class="px-4 py-3 text-center">
                  <button type="button"
                      onclick="event.stopPropagation(); toggleIssueInlineForm(<%= issue.id %>)"
                      id="issue-log-btn-<%= issue.id %>"
                      class="ts-log-btn inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium rounded-lg transition-colors"
                      style="background-color: #16a34a !important; color: white !important;">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Log
                  </button>
                </td>
              </tr>

              <%# Inline log form for this issue %>
              <tr id="issue-inline-row-<%= issue.id %>" class="hidden">
                <td colspan="5" class="px-0 py-0">
                  <div id="issue-inline-form-<%= issue.id %>" class="tep-inline-form">
                    <div class="flex items-center gap-2 px-4 py-3 bg-blue-50 border-b border-blue-100 border-l-4 border-l-blue-500 flex-wrap">
                      <div class="flex items-center gap-1.5 flex-shrink-0">
                        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="text-sm font-bold text-blue-700 whitespace-nowrap">#<%= issue.id %> – <%= issue.subject %></span>
                      </div>
                      <div class="w-px h-5 bg-blue-200 flex-shrink-0"></div>

                      <input type="text" id="issue-date-<%= issue.id %>" value="<%= Date.current.strftime('%m/%d/%Y') %>"
                             datepicker
                             datepicker-format="mm/dd/yyyy"
                             datepicker-autohide
                             class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">

                      <input type="text" id="issue-hours-<%= issue.id %>" placeholder="Hours *"
                              autocomplete="off"
                              oninput="formatHoursInput(this)"
                              title="Hours (e.g. 1, 1:30, 10)"
                              class="tep-field text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-24">

                      <div class="relative flex-shrink-0" id="issue-activity-wrapper-<%= issue.id %>">
                        <button type="button"
                                id="issue-activity-btn-<%= issue.id %>"
                                onclick="toggleIssueActivityDropdown(<%= issue.id %>)"
                                onkeydown="tepHandleActivityDropdownTriggerKey(event, 'issue-activity-list-<%= issue.id %>')"
                                class="tep-field flex items-center justify-between gap-2 text-sm px-3 !border !border-gray-300 !rounded-lg !bg-white w-44 text-left whitespace-nowrap !outline-none !shadow-none !ring-0">
                          <span id="issue-activity-text-<%= issue.id %>" class="text-gray-400 truncate flex-1">Activity *</span>
                          <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                          </svg>
                        </button>
                        <input type="hidden" id="issue-activity-<%= issue.id %>">
                        <div id="issue-activity-list-<%= issue.id %>"
                             class="tep-activity-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                             style="min-width: 200px; max-height: 220px; top: calc(100% + 2px);">
                          <div class="px-3 py-2 text-sm text-gray-400 italic">Loading...</div>
                        </div>
                      </div>

                      <input type="text" id="issue-comment-<%= issue.id %>" placeholder="Comment (optional)"
                             autocomplete="off"
                             class="tep-field text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-1 min-w-[200px]">

                      <button type="button" onclick="hideIssueInlineForm(<%= issue.id %>)"
                              class="tep-action-btn flex-shrink-0 px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0"
                              style="background-color: #dc2626 !important;">
                        ✕ Cancel
                      </button>
                      <button type="button" onclick="submitIssueInlineLog(event, <%= issue.id %>)"
                              class="tep-action-btn flex-shrink-0 inline-flex items-center gap-1 px-4 py-2.5 text-sm font-semibold rounded-lg !text-white !border-0 !outline-none !shadow-none !ring-0"
                              style="background-color: #2563eb !important;">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Save
                      </button>
                    </div>
                    <div id="issue-inline-error-<%= issue.id %>" class="hidden px-4 py-2 text-sm text-red-800 bg-red-50 border-b border-red-100 border-l-4 border-l-red-400" role="alert"></div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">All caught up!</h3>
        <p class="mt-1 text-sm text-gray-500">You've logged time for all assigned issues in this period.</p>
      </div>
    <% end %>
  </div>
</div>

<button id="deleteButton" data-modal-target="deleteModal" data-modal-toggle="deleteModal" type="button" class="hidden"></button>

<div id="deleteModal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 right-0 left-0 z-[9999] justify-center items-center w-full h-full bg-gray-900/50">
  <div class="relative p-4 w-full max-w-md">
    <div class="relative p-4 text-center bg-white rounded-lg shadow sm:p-5">
      <button type="button"
              class="tep-delete-close text-gray-400 absolute top-2.5 right-2.5 bg-transparent rounded-lg text-sm p-1.5 inline-flex items-center"
              data-modal-hide="deleteModal"
              onclick="tepCloseDeleteModal()">
        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
        <span class="sr-only">Close modal</span>
      </button>
      <svg class="text-gray-400 w-11 h-11 mb-3.5 mx-auto" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <p class="mb-4 text-gray-500">Are you sure you want to delete this entry?</p>
      <div class="flex justify-center items-center space-x-4">
        <button type="button"
                onclick="tepConfirmDelete()"
                class="tep-delete-confirm py-2 px-3 text-sm font-medium text-center text-white rounded-lg bg-red-600">
          Delete
        </button>
        <button data-modal-hide="deleteModal"
                type="button"
                onclick="tepCloseDeleteModal()"
                class="tep-delete-cancel py-2 px-3 text-sm font-medium text-gray-500 bg-white rounded-lg border border-gray-200">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // ── Tab switching ────────────────────────────────────────────────────────
  function switchTab(tabName) {
    ['time-logs', 'recent-work'].forEach(function(t) {
      var panel = document.getElementById('panel-' + t);
      var tab   = document.getElementById('tab-' + t);
      if (t === tabName) {
        panel.classList.remove('hidden');
        tab.classList.add('ta-view-tab-active');
      } else {
        panel.classList.add('hidden');
        tab.classList.remove('ta-view-tab-active');
      }
    });
    document.getElementById('ts-search-input').value = '';
    filterTableRows();
  }

  // ── Search / filter ──────────────────────────────────────────────────────
  function filterTableRows() {
    var query = document.getElementById('ts-search-input').value.toLowerCase().trim();
    var activePanel = document.querySelector('[id^="panel-"]:not(.hidden)');
    if (!activePanel) return;

    if (activePanel.id === 'panel-time-logs') {
      filterLoggedRows(query);
      return;
    }

    activePanel.querySelectorAll('.ts-issue-row').forEach(function(row) {
      var text = row.getAttribute('data-search-text') || '';
      var expandRow = row.nextElementSibling;
      if (!query || text.includes(query)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
        if (expandRow && expandRow.id && expandRow.id.startsWith('issue-inline-row-')) {
          expandRow.classList.add('hidden');
        }
      }
    });
  }

  function resetLoggedRows() {
    document.querySelectorAll('#panel-time-logs .tep-group-row[data-period-key]').forEach(function(row) {
      row.style.display = '';
      var expand = document.getElementById(row.getAttribute('data-expand-id'));
      var chevron = document.getElementById(row.getAttribute('data-chevron-id'));
      if (expand) expand.classList.add('hidden');
      if (chevron) chevron.classList.remove('tep-chevron-open');
    });

    document.querySelectorAll('#panel-time-logs .tep-issue-row[data-period-key][data-issue-id]').forEach(function(row) {
      row.style.display = '';
      var expand = document.getElementById(row.getAttribute('data-expand-id'));
      var chevron = document.getElementById(row.getAttribute('data-chevron-id'));
      if (expand) expand.classList.add('hidden');
      if (chevron) chevron.style.transform = '';
    });
  }

  function filterLoggedRows(query) {
    if (!query) {
      resetLoggedRows();
      tepRestoreOpenState();
      return;
    }

    var matchedPeriods = {};

    document.querySelectorAll('#panel-time-logs .tep-issue-row[data-search-text]').forEach(function(row) {
      var text = row.getAttribute('data-search-text') || '';
      var matches = text.includes(query);
      var periodKey = row.getAttribute('data-period-key');
      var expandRow = document.getElementById(row.getAttribute('data-expand-id'));
      var chevron = document.getElementById(row.getAttribute('data-chevron-id'));

      if (matches && periodKey) {
        matchedPeriods[periodKey] = true;
      }

      row.style.display = matches ? '' : 'none';
      if (expandRow) expandRow.classList.add('hidden');
      if (chevron) chevron.style.transform = '';
    });

    document.querySelectorAll('#panel-time-logs .tep-group-row[data-period-key]').forEach(function(row) {
      var periodKey = row.getAttribute('data-period-key');
      var expand = document.getElementById(row.getAttribute('data-expand-id'));
      var chevron = document.getElementById(row.getAttribute('data-chevron-id'));
      var shouldShow = !!matchedPeriods[periodKey];

      row.style.display = shouldShow ? '' : 'none';
      if (expand) expand.classList.toggle('hidden', !shouldShow);
      if (chevron) {
        if (shouldShow) {
          chevron.classList.add('tep-chevron-open');
        } else {
          chevron.classList.remove('tep-chevron-open');
        }
      }
    });
  }

  // ── Period filter ────────────────────────────────────────────────────────
  function setFilterAndSubmit(filterValue) {
    document.getElementById('filter_hidden').value = filterValue;
    if (filterValue !== 'custom') { document.getElementById('custom-date-range').classList.add('hidden'); }
    document.getElementById('time-entry-panel-form').submit();
  }

  function toggleCustomDateRange() {
    var customRange  = document.getElementById('custom-date-range');
    var filterHidden = document.getElementById('filter_hidden');
    var startInput = document.getElementById('tep-date-range-start');
    var endInput = document.getElementById('tep-date-range-end');
    if (customRange.classList.contains('hidden')) {
      customRange.classList.remove('hidden');
      filterHidden.value = 'custom';
    } else {
      customRange.classList.add('hidden');
      [startInput, endInput].forEach(function(input) {
        if (input && input.datepicker && input.datepicker.hide) input.datepicker.hide();
      });
    }
  }

  function submitTepCustomDateRangeIfComplete() {
    var startInput = document.getElementById('tep-date-range-start');
    var endInput = document.getElementById('tep-date-range-end');
    var filterHidden = document.getElementById('filter_hidden');
    var form = document.getElementById('time-entry-panel-form');

    if (filterHidden) {
      filterHidden.value = 'custom';
    }

    if (!(startInput && endInput)) return;
    if (!startInput.value || !endInput.value) return;
    if (!form || form.dataset.submitting === '1') return;
    form.dataset.submitting = '1';
    form.submit();
  }

  function bindTepCustomDateRangeEvents() {
    var startInput = document.getElementById('tep-date-range-start');
    var endInput = document.getElementById('tep-date-range-end');
    var picker = document.getElementById('tep-date-range-picker');
    var datepickerInstances = [startInput && startInput.datepicker, endInput && endInput.datepicker].filter(Boolean);

    function handleDateRangeChange() {
      submitTepCustomDateRangeIfComplete();
    }

    [startInput, endInput, picker].forEach(function(element) {
      if (element) {
        element.addEventListener('changeDate', handleDateRangeChange);
      }
    });

    datepickerInstances.forEach(function(datepicker) {
      if (datepicker && datepicker.setOptions) {
        datepicker.setOptions({ todayHighlight: true, showOnFocus: false, showOnClick: false, autohide: true });
      }
    });

    function hideTepRangePickers() {
      [startInput, endInput].forEach(function(input) {
        if (input && input.datepicker && input.datepicker.hide) input.datepicker.hide();
      });
    }

    function bindManualToggle(input, otherInput) {
      if (!input || input.dataset.manualToggleBound === '1') return;
      input.addEventListener('click', function(event) {
        event.preventDefault();
        event.stopPropagation();
        if (!input.datepicker) return;
        if (otherInput && otherInput.datepicker && otherInput.datepicker.active) {
          otherInput.datepicker.hide();
        }
        if (input.datepicker.active) {
          input.datepicker.hide();
        } else {
          input.datepicker.show();
        }
      });
      input.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && input.datepicker && input.datepicker.hide) {
          input.datepicker.hide();
          input.blur();
        }
      });
      input.dataset.manualToggleBound = '1';
    }

    bindManualToggle(startInput, endInput);
    bindManualToggle(endInput, startInput);

    function suppressAutoOpen() {
      [startInput, endInput].forEach(function(input) {
        if (!input) return;
        if (document.activeElement === input) input.blur();
      });
      hideTepRangePickers();
    }

    setTimeout(suppressAutoOpen, 0);
    setTimeout(suppressAutoOpen, 120);

    if (!window.__tepRangeOutsideCloseBound) {
      document.addEventListener('mousedown', function(event) {
        var target = event.target;
        var isInsideRangeUi = (picker && picker.contains(target)) ||
          (startInput && target === startInput) ||
          (endInput && target === endInput) ||
          !!target.closest('.datepicker');
        if (isInsideRangeUi) return;
        hideTepRangePickers();
      });
      window.__tepRangeOutsideCloseBound = true;
    }
  }

  // ── Grouping dropdown ────────────────────────────────────────────────────
  function toggleTepGroupingDropdown() {
    document.getElementById('tep-grouping-dropdown').classList.toggle('hidden');
  }

  function setTepGroupingAndSubmit(groupingValue) {
    document.getElementById('tep_grouping_hidden').value = groupingValue;
    document.getElementById('tep-grouping-dropdown').classList.add('hidden');
    document.getElementById('time-entry-panel-form').submit();
  }

  document.addEventListener('click', function(e) {
    var dropdown = document.getElementById('tep-grouping-dropdown');
    var btn      = document.getElementById('tep-grouping-btn');
    if (dropdown && btn && !dropdown.contains(e.target) && !btn.contains(e.target)) {
      dropdown.classList.add('hidden');
    }
    // Close any open edit-form activity dropdowns
    document.querySelectorAll('[id^="tep-edit-act-list-"]').forEach(function(list) {
      if (!list.classList.contains('hidden')) {
        var eid = list.id.replace('tep-edit-act-list-', '');
        var wrapper = document.getElementById('tep-edit-act-wrapper-' + eid);
        var clickedInsideList = !!list.contains(e.target);
        if (wrapper && !wrapper.contains(e.target) && !clickedInsideList) tepCloseFloatingDropdown(list);
      }
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindTepCustomDateRangeEvents);
  } else {
    bindTepCustomDateRangeEvents();
  }

  // ── Group expand / collapse ──────────────────────────────────────────────
  function toggleTepGroup(idx) {
    var expand  = document.getElementById('tep-expand-' + idx);
    var chevron = document.getElementById('tep-chevron-' + idx);
    if (!expand) return;
    if (expand.classList.contains('hidden')) {
      expand.classList.remove('hidden');
      if (chevron) chevron.classList.add('tep-chevron-open');
    } else {
      expand.classList.add('hidden');
      if (chevron) chevron.classList.remove('tep-chevron-open');
      closeTepIssueDropdown(idx);
      closeTepActivityDropdown(idx);
      // Hide inline form when collapsing
      var form = document.getElementById('tep-inline-form-' + idx);
      if (form) form.classList.add('hidden');
    }
    tepPersistOpenState();
  }

  // ── Inline form (Time Logs tab) ──────────────────────────────────────────
  function toggleTepInlineForm(idx, dateStr) {
    // Ensure group is expanded
    var expand  = document.getElementById('tep-expand-' + idx);
    var chevron = document.getElementById('tep-chevron-' + idx);
    if (expand && expand.classList.contains('hidden')) {
      expand.classList.remove('hidden');
      if (chevron) chevron.classList.add('tep-chevron-open');
    }

    var form = document.getElementById('tep-inline-form-' + idx);
    if (!form) return;

    if (form.classList.contains('hidden')) {
      // Close any other open inline forms
      document.querySelectorAll('[id^="tep-inline-form-"]').forEach(function(f) { f.classList.add('hidden'); });
      form.classList.remove('hidden');
      // Reset fields
      var issueSelect = document.getElementById('tep-issue-' + idx);
      if (issueSelect) issueSelect.value = '';
      var hoursInput = document.getElementById('tep-hours-' + idx);
      if (hoursInput) hoursInput.value = '';
      var commentInput = document.getElementById('tep-comment-' + idx);
      if (commentInput) commentInput.value = '';
      resetTepActivityDropdown(idx);
      resetTepIssueDropdown(idx);
      hideTepInlineError(idx);
      initTepInlinePeriodDatepicker(idx);
      // Scroll form into view
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      form.classList.add('hidden');
    }
  }

  function normalizeTepDateForSubmit(value) {
    if (!value) return value;
    var yyyymmdd = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (yyyymmdd) return value;

    var mmddyyyy = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (mmddyyyy) {
      var month = mmddyyyy[1].padStart(2, '0');
      var day = mmddyyyy[2].padStart(2, '0');
      return mmddyyyy[3] + '-' + month + '-' + day;
    }
    return value;
  }

  function initTepInlinePeriodDatepicker(idx) {
    var input = document.getElementById('tep-date-' + idx);
    if (!input || input.type === 'hidden') return;

    var periodStartRaw = input.getAttribute('data-period-start');
    var periodEndRaw = input.getAttribute('data-period-end');
    if (!periodStartRaw || !periodEndRaw) return;

    var periodStart = new Date(periodStartRaw + 'T00:00:00');
    var periodEnd = new Date(periodEndRaw + 'T00:00:00');
    var startMs = new Date(periodStart.getFullYear(), periodStart.getMonth(), periodStart.getDate()).getTime();
    var endMs = new Date(periodEnd.getFullYear(), periodEnd.getMonth(), periodEnd.getDate()).getTime();

    function applyHighlight() {
      var pickers = document.querySelectorAll('.datepicker-picker');
      pickers.forEach(function(picker) {
        if (picker.offsetParent === null) return; // Skip hidden pickers
        var cells = picker.querySelectorAll('.datepicker-cell.day[data-date]');
        cells.forEach(function(cell) {
          var rawDate = Number(cell.getAttribute('data-date'));
          if (!rawDate) return;
          // Remove old classes first
          cell.classList.remove('tep-period-start', 'tep-period-end', 'tep-period-range');
          // Add appropriate class
          if (rawDate === startMs) {
            cell.classList.add('tep-period-start');
          } else if (rawDate === endMs) {
            cell.classList.add('tep-period-end');
          } else if (rawDate > startMs && rawDate < endMs) {
            cell.classList.add('tep-period-range');
          }
        });
      });
    }

    function scheduleHighlight() {
      setTimeout(applyHighlight, 50);
      setTimeout(applyHighlight, 200);
    }

    // Clean up previous listeners
    if (input._tepClickHandler) {
      input.removeEventListener('click', input._tepClickHandler);
    }

    input._tepClickHandler = scheduleHighlight;
    input.addEventListener('click', input._tepClickHandler);
  }

  function initIssueInlineDatepicker(issueId) {
    var input = document.getElementById('issue-date-' + issueId);
    if (!input) return;

    if (input.datepicker && input.datepicker.setOptions) {
      input.datepicker.setOptions({
        format: 'mm/dd/yyyy',
        autohide: true,
        showOnFocus: false
      });
      if (input.value && input.datepicker.setDate) {
        input.datepicker.setDate(input.value, { render: true, autohide: false });
      }
      return;
    }

    if (window.Datepicker) {
      new window.Datepicker(input, {
        format: 'mm/dd/yyyy',
        autohide: true,
        showOnFocus: false
      });
    }
  }

  function hideTepInlineForm(idx) {
    var form = document.getElementById('tep-inline-form-' + idx);
    if (form) form.classList.add('hidden');
    closeTepIssueDropdown(idx);
    closeTepActivityDropdown(idx);
  }

  // ── Floating dropdown helpers (portal to body) ───────────────────────────
  var tepFloatingDropdownState = {};

  function tepEnsureDropdownPortalState(list) {
    if (!list || !list.id) return null;
    if (!tepFloatingDropdownState[list.id]) {
      tepFloatingDropdownState[list.id] = {
        parent: list.parentNode,
        nextSibling: list.nextSibling,
        anchorId: null
      };
    }
    return tepFloatingDropdownState[list.id];
  }

  function tepPositionFloatingDropdown(list, anchor) {
    if (!list || !anchor) return;

    var rect = anchor.getBoundingClientRect();
    var minWidth = parseFloat(list.style.minWidth || '0') || 0;
    var targetWidth = Math.max(Math.round(rect.width), Math.round(minWidth));
    var viewportPadding = 8;
    var preferredHeight = Math.min(list.scrollHeight || 220, 320);
    var spaceBelow = Math.max(0, window.innerHeight - rect.bottom - viewportPadding);
    var spaceAbove = Math.max(0, rect.top - viewportPadding);
    var openUp = spaceBelow < 160 && spaceAbove > spaceBelow;
    var maxHeight = Math.max(120, openUp ? spaceAbove : spaceBelow);

    list.style.position = 'fixed';
    var left = Math.max(viewportPadding, rect.left);
    if (left + targetWidth > window.innerWidth - viewportPadding) {
      left = Math.max(viewportPadding, window.innerWidth - viewportPadding - targetWidth);
    }
    list.style.left = left + 'px';
    list.style.width = targetWidth + 'px';
    list.style.maxHeight = Math.min(preferredHeight, maxHeight) + 'px';
    list.style.top = openUp ? 'auto' : (rect.bottom + 2) + 'px';
    list.style.bottom = openUp ? (window.innerHeight - rect.top + 2) + 'px' : 'auto';
    list.style.zIndex = '10050';
  }

  function tepOpenFloatingDropdown(list, anchor) {
    if (!list || !anchor || !list.id || !anchor.id) return;
    var state = tepEnsureDropdownPortalState(list);
    if (!state) return;

    state.anchorId = anchor.id;
    if (list.parentNode !== document.body) {
      document.body.appendChild(list);
    }
    list.classList.remove('hidden');
    tepPositionFloatingDropdown(list, anchor);
  }

  function tepCloseFloatingDropdown(list) {
    if (!list || !list.id) return;
    var state = tepFloatingDropdownState[list.id];
    list.classList.add('hidden');

    if (!state || !state.parent) return;
    if (list.parentNode !== state.parent) {
      state.parent.insertBefore(list, state.nextSibling);
    }
    state.anchorId = null;
    list.style.position = '';
    list.style.left = '';
    list.style.top = '';
    list.style.bottom = '';
    list.style.width = '';
    list.style.maxHeight = '';
    list.style.zIndex = '';
  }

  function tepSyncFloatingDropdownPositions() {
    Object.keys(tepFloatingDropdownState).forEach(function(listId) {
      var list = document.getElementById(listId);
      var state = tepFloatingDropdownState[listId];
      if (!list || !state || list.classList.contains('hidden') || !state.anchorId) return;
      var anchor = document.getElementById(state.anchorId);
      if (!anchor) {
        tepCloseFloatingDropdown(list);
        return;
      }
      tepPositionFloatingDropdown(list, anchor);
    });
  }

  if (!window.__tepFloatingDropdownListenersBound) {
    window.addEventListener('resize', tepSyncFloatingDropdownPositions);
    document.addEventListener('scroll', tepSyncFloatingDropdownPositions, true);
    window.__tepFloatingDropdownListenersBound = true;
  }

  function resetTepActivityDropdown(idx) {
    var hidden = document.getElementById('tep-activity-' + idx);
    var text   = document.getElementById('tep-activity-text-' + idx);
    var list   = document.getElementById('tep-activity-list-' + idx);
    if (hidden) hidden.value = '';
    if (text)   { text.textContent = 'Activity *'; text.classList.add('text-gray-400'); text.classList.remove('text-gray-900'); }
    if (list)   { list.innerHTML = '<div class="px-3 py-2 text-sm text-gray-400 italic">Select an issue first</div>'; }
    closeTepActivityDropdown(idx);
  }

  // ── Custom activity dropdown ─────────────────────────────────────────────
  function toggleTepActivityDropdown(idx) {
    var list = document.getElementById('tep-activity-list-' + idx);
    var anchor = document.getElementById('tep-activity-btn-' + idx);
    if (!list) return;
    if (list.classList.contains('hidden')) {
      tepOpenFloatingDropdown(list, anchor);
    } else {
      tepCloseFloatingDropdown(list);
    }
  }

  function closeTepActivityDropdown(idx) {
    var list = document.getElementById('tep-activity-list-' + idx);
    if (list) tepCloseFloatingDropdown(list);
  }

  function selectTepActivity(idx, activityId, activityName) {
    var hidden = document.getElementById('tep-activity-' + idx);
    var text   = document.getElementById('tep-activity-text-' + idx);
    if (hidden) hidden.value = activityId;
    if (text)   { text.textContent = activityName; text.classList.remove('text-gray-400'); text.classList.add('text-gray-900'); }
    closeTepActivityDropdown(idx);
  }

  // Close activity dropdown when clicking outside
  document.addEventListener('click', function(e) {
    document.querySelectorAll('[id^="tep-activity-wrapper-"]').forEach(function(wrapper) {
      var idx = wrapper.id.replace('tep-activity-wrapper-', '');
      var list = document.getElementById('tep-activity-list-' + idx);
      var clickedInsideList = !!(list && list.contains(e.target));
      if (!wrapper.contains(e.target)) {
        if (clickedInsideList) return;
        closeTepActivityDropdown(idx);
      }
    });
  });

  async function loadTepActivities(idx) {
    var issueId = (document.getElementById('tep-issue-' + idx) || {}).value;
    var list    = document.getElementById('tep-activity-list-' + idx);
    var text    = document.getElementById('tep-activity-text-' + idx);
    var hidden  = document.getElementById('tep-activity-' + idx);
    if (!list) return;
    if (!issueId) { resetTepActivityDropdown(idx); return; }
    if (hidden) hidden.value = '';
    if (text)   { text.textContent = 'Loading…'; }
    list.innerHTML = '<div class="px-3 py-2 text-sm text-gray-400 italic">Loading…</div>';
    try {
      var resp = await fetch('<%= time_entry_panel_activities_path(':issue_id') %>'.replace(':issue_id', issueId));
      var data = await resp.json();
      list.innerHTML = '';
      (data.activities || []).forEach(function(a) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tep-activity-option w-full text-left px-4 py-2 text-sm hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700';
        btn.style.cssText = 'background:transparent;outline:none;box-shadow:none;border:none;';
        btn.textContent = a.name;
        btn.setAttribute('data-id', a.id);
        btn.setAttribute('onkeydown', "tepHandleActivityDropdownOptionKey(event, 'tep-activity-list-" + idx + "')");
        btn.onclick = function() { selectTepActivity(idx, a.id, a.name); };
        list.appendChild(btn);
      });
      if (text) { text.textContent = 'Activity *'; text.classList.add('text-gray-400'); text.classList.remove('text-gray-900'); }
    } catch(e) {
      list.innerHTML = '<div class="px-3 py-2 text-xs text-red-400">Failed to load</div>';
    }
  }

  function resetTepIssueDropdown(idx) {
    var hidden = document.getElementById('tep-issue-' + idx);
    var search = document.getElementById('tep-issue-search-' + idx);
    if (hidden) hidden.value = '';
    if (search) search.value = '';
    closeTepIssueDropdown(idx);
  }

  // ── Custom issue searchable dropdown ────────────────────────────────────
  function openTepIssueDropdown(idx) {
    var list = document.getElementById('tep-issue-list-' + idx);
    var anchor = document.getElementById('tep-issue-search-' + idx);
    if (!list) return;
    // Show all options first
    list.querySelectorAll('.tep-issue-option').forEach(function(opt) { opt.style.display = ''; });
    tepOpenFloatingDropdown(list, anchor);
  }

  function closeTepIssueDropdown(idx) {
    var list = document.getElementById('tep-issue-list-' + idx);
    if (list) tepCloseFloatingDropdown(list);
  }

  function filterTepIssues(idx) {
    var search = document.getElementById('tep-issue-search-' + idx);
    var list   = document.getElementById('tep-issue-list-' + idx);
    if (!search || !list) return;
    var query = search.value.toLowerCase().replace('#', '');
    tepOpenFloatingDropdown(list, search);
    var opts = list.querySelectorAll('.tep-issue-option');
    var anyVisible = false;
    opts.forEach(function(opt) {
      var text = (opt.getAttribute('data-search') || '').toLowerCase();
      if (!query || text.includes(query)) {
        opt.style.display = '';
        anyVisible = true;
      } else {
        opt.style.display = 'none';
      }
    });
    // Clear hidden value if user is typing (de-selecting)
    var hidden = document.getElementById('tep-issue-' + idx);
    if (hidden) hidden.value = '';
    resetTepActivityDropdown(idx);
  }

  function selectTepIssue(idx, issueId, displayText) {
    var hidden = document.getElementById('tep-issue-' + idx);
    var search = document.getElementById('tep-issue-search-' + idx);
    if (hidden) hidden.value = issueId;
    if (search) search.value = displayText;
    closeTepIssueDropdown(idx);
    loadTepActivities(idx);
  }

  function handleTepIssueKey(event, idx) {
    var list = document.getElementById('tep-issue-list-' + idx);
    if (!list) return;
    if (event.key === 'Escape') { closeTepIssueDropdown(idx); return; }
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      var visible = Array.from(list.querySelectorAll('.tep-issue-option')).filter(function(o) { return o.style.display !== 'none'; });
      if (visible.length) { visible[0].focus(); }
    }
  }

  function handleTepIssueOptionKey(event, idx, issueId, displayText) {
    var list = document.getElementById('tep-issue-list-' + idx);
    if (!list) return;
    var visible = Array.from(list.querySelectorAll('.tep-issue-option')).filter(function(o) { return o.style.display !== 'none'; });
    var current = event.target;
    var currentIdx = visible.indexOf(current);

    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      selectTepIssue(idx, issueId, displayText);
      var searchInput = document.getElementById('tep-issue-search-' + idx);
      if (searchInput) searchInput.focus();
    } else if (event.key === 'ArrowDown') {
      event.preventDefault();
      var next = visible[currentIdx + 1];
      if (next) next.focus();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (currentIdx === 0) {
        var searchInput = document.getElementById('tep-issue-search-' + idx);
        if (searchInput) searchInput.focus();
      } else {
        var prev = visible[currentIdx - 1];
        if (prev) prev.focus();
      }
    } else if (event.key === 'Escape') {
      closeTepIssueDropdown(idx);
      var searchInput = document.getElementById('tep-issue-search-' + idx);
      if (searchInput) searchInput.focus();
    }
  }

  // Close issue dropdown when clicking outside
  document.addEventListener('click', function(e) {
    document.querySelectorAll('[id^="tep-issue-wrapper-"]').forEach(function(wrapper) {
      var idx = wrapper.id.replace('tep-issue-wrapper-', '');
      var list = document.getElementById('tep-issue-list-' + idx);
      var clickedInsideList = !!(list && list.contains(e.target));
      if (!wrapper.contains(e.target)) {
        if (clickedInsideList) return;
        closeTepIssueDropdown(idx);
      }
    });
  });


  function showTepInlineError(idx, msg) {
    var el = document.getElementById('tep-inline-error-' + idx);
    if (el) { el.textContent = msg; el.classList.remove('hidden'); }
  }

  function hideTepInlineError(idx) {
    var el = document.getElementById('tep-inline-error-' + idx);
    if (el) el.classList.add('hidden');
  }

  function tepReloadWithStateRestore() {
    tepMarkStateForRestore();
    tepPersistOpenState();
    location.reload();
  }

  async function submitTepInlineLog(event, idx) {
    event.preventDefault();
    hideTepInlineError(idx);

    var dateStr    = (document.getElementById('tep-date-'     + idx) || {}).value;
    var issueId    = (document.getElementById('tep-issue-'    + idx) || {}).value;
    var hoursRaw   = (document.getElementById('tep-hours-'    + idx) || {}).value;
    var activityId = (document.getElementById('tep-activity-' + idx) || {}).value;
    var comment    = (document.getElementById('tep-comment-'  + idx) || {}).value;

    dateStr = normalizeTepDateForSubmit(dateStr);

    if (!issueId)    { showTepInlineError(idx, 'Please select an issue.');   return; }
    var hours = parseHoursMinutes(hoursRaw);
    if (hours === null) { showTepInlineError(idx, 'Enter a valid number of hours.'); return; }
    if (!activityId) { showTepInlineError(idx, 'Please select an activity.'); return; }

    var saveBtn = event.target;
    saveBtn.disabled = true;

    try {
      var resp = await fetch('<%= create_time_entry_panel_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content || ''
        },
        body: JSON.stringify({ issue_id: issueId, spent_on: dateStr, hours: hours, activity_id: activityId, comments: comment })
      });
      var data = await resp.json();
      if (data.success) {
        tepReloadWithStateRestore();
      } else {
        showTepInlineError(idx, data.errors ? data.errors.join(', ') : (data.error || 'Failed to save.'));
      }
    } catch(e) {
      showTepInlineError(idx, 'Network error. Please try again.');
    } finally {
      saveBtn.disabled = false;
    }
  }

  // ── Inline form (Issues Worked On tab) ──────────────────────────────────
  var issueActivitiesLoaded = {};

  async function toggleIssueInlineForm(issueId) {
    var row = document.getElementById('issue-inline-row-' + issueId);
    if (!row) return;

    if (row.classList.contains('hidden')) {
      // Close any other open inline forms
      document.querySelectorAll('[id^="tep-inline-form-"]').forEach(function(f) { f.classList.add('hidden'); });
      document.querySelectorAll('[id^="issue-inline-row-"]').forEach(function(r) { r.classList.add('hidden'); });

      row.classList.remove('hidden');
      var inlineForm = document.getElementById('issue-inline-form-' + issueId);
      if (inlineForm) inlineForm.classList.remove('hidden');
      // Load activities if not yet loaded
      if (!issueActivitiesLoaded[issueId]) {
        await loadIssueActivities(issueId);
        issueActivitiesLoaded[issueId] = true;
      }
      // Reset fields
      var dateEl = document.getElementById('issue-date-' + issueId);
      if (dateEl) dateEl.value = '<%= Date.current.strftime('%m/%d/%Y') %>';
      var hoursEl = document.getElementById('issue-hours-' + issueId);
      if (hoursEl) hoursEl.value = '';
      var commentEl = document.getElementById('issue-comment-' + issueId);
      if (commentEl) commentEl.value = '';
      initIssueInlineDatepicker(issueId);
      resetIssueActivityDropdown(issueId);
      hideIssueInlineError(issueId);
      row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      row.classList.add('hidden');
    }
  }

  function hideIssueInlineForm(issueId) {
    var row = document.getElementById('issue-inline-row-' + issueId);
    if (row) row.classList.add('hidden');
    closeIssueActivityDropdown(issueId);
  }

  function toggleIssueActivityDropdown(issueId) {
    var list = document.getElementById('issue-activity-list-' + issueId);
    var anchor = document.getElementById('issue-activity-btn-' + issueId);
    if (!list) return;
    if (list.classList.contains('hidden')) {
      tepOpenFloatingDropdown(list, anchor);
    } else {
      tepCloseFloatingDropdown(list);
    }
  }

  function closeIssueActivityDropdown(issueId) {
    var list = document.getElementById('issue-activity-list-' + issueId);
    if (list) tepCloseFloatingDropdown(list);
  }

  function resetIssueActivityDropdown(issueId) {
    var hidden = document.getElementById('issue-activity-' + issueId);
    var text = document.getElementById('issue-activity-text-' + issueId);
    if (hidden) hidden.value = '';
    if (text) {
      text.textContent = 'Activity *';
      text.classList.add('text-gray-400');
      text.classList.remove('text-gray-900');
    }
    closeIssueActivityDropdown(issueId);
  }

  function selectIssueActivity(issueId, activityId, activityName) {
    var hidden = document.getElementById('issue-activity-' + issueId);
    var text = document.getElementById('issue-activity-text-' + issueId);
    if (hidden) hidden.value = activityId;
    if (text) {
      text.textContent = activityName;
      text.classList.remove('text-gray-400');
      text.classList.add('text-gray-900');
    }
    closeIssueActivityDropdown(issueId);
  }

  async function loadIssueActivities(issueId) {
    var list = document.getElementById('issue-activity-list-' + issueId);
    if (!list) return;
    try {
      var resp = await fetch('<%= time_entry_panel_activities_path(':issue_id') %>'.replace(':issue_id', issueId));
      var data = await resp.json();
      list.innerHTML = '';
      (data.activities || []).forEach(function(a) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tep-activity-option w-full text-left px-4 py-2 text-sm hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700';
        btn.style.cssText = 'background:transparent;outline:none;box-shadow:none;border:none;';
        btn.textContent = a.name;
        btn.setAttribute('data-id', a.id);
        btn.setAttribute('onkeydown', "tepHandleActivityDropdownOptionKey(event, 'issue-activity-list-" + issueId + "')");
        btn.onclick = function() { selectIssueActivity(issueId, a.id, a.name); };
        list.appendChild(btn);
      });
      resetIssueActivityDropdown(issueId);
    } catch(e) {
      list.innerHTML = '<div class="px-3 py-2 text-sm text-red-400">Failed to load</div>';
    }
  }

  function showIssueInlineError(issueId, msg) {
    var el = document.getElementById('issue-inline-error-' + issueId);
    if (el) { el.textContent = msg; el.classList.remove('hidden'); }
  }

  function hideIssueInlineError(issueId) {
    var el = document.getElementById('issue-inline-error-' + issueId);
    if (el) el.classList.add('hidden');
  }

  async function submitIssueInlineLog(event, issueId) {
    event.preventDefault();
    hideIssueInlineError(issueId);

    var date       = (document.getElementById('issue-date-'     + issueId) || {}).value;
    var hoursRaw   = (document.getElementById('issue-hours-'    + issueId) || {}).value;
    var activityId = (document.getElementById('issue-activity-' + issueId) || {}).value;
    var comment    = (document.getElementById('issue-comment-'  + issueId) || {}).value;

    date = normalizeTepDateForSubmit(date);

    if (!date)       { showIssueInlineError(issueId, 'Please select a date.');    return; }
    var hours = parseHoursMinutes(hoursRaw);
    if (hours === null) { showIssueInlineError(issueId, 'Enter a valid number of hours.'); return; }
    if (!activityId) { showIssueInlineError(issueId, 'Please select an activity.'); return; }

    var saveBtn = event.currentTarget || event.target;
    saveBtn.disabled = true;

    try {
      var resp = await fetch('<%= create_time_entry_panel_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content || ''
        },
        body: JSON.stringify({ issue_id: issueId, spent_on: date, hours: hours, activity_id: activityId, comments: comment })
      });
      var data = await resp.json();
      if (data.success) {
        tepReloadWithStateRestore();
      } else {
        showIssueInlineError(issueId, data.errors ? data.errors.join(', ') : (data.error || 'Failed to save.'));
      }
    } catch(e) {
      showIssueInlineError(issueId, 'Network error. Please try again.');
    } finally {
      saveBtn.disabled = false;
    }
  }

  // Close unlogged activity dropdown when clicking outside
  document.addEventListener('click', function(e) {
    document.querySelectorAll('[id^="issue-activity-wrapper-"]').forEach(function(wrapper) {
      var issueId = wrapper.id.replace('issue-activity-wrapper-', '');
      var list = document.getElementById('issue-activity-list-' + issueId);
      var clickedInsideList = !!(list && list.contains(e.target));
      if (!wrapper.contains(e.target)) {
        if (clickedInsideList) return;
        closeIssueActivityDropdown(issueId);
      }
    });
  });

  // ── Shared utilities ─────────────────────────────────────────────────────
  function formatHoursInput(input) {
    input.value = input.value.replace(/[^\d:.]/g, '');
  }

  function parseHoursMinutes(value) {
    if (!value || !value.trim()) return null;
    var trimmed = value.trim();

    if (trimmed.includes(':')) {
      var parts = trimmed.split(':');
      if (parts.length !== 2) return null;
      var h = parseInt(parts[0], 10);
      var m = parseInt(parts[1], 10);
      if (isNaN(h) || isNaN(m) || m < 0 || m > 59 || h < 0) return null;
      if (h === 0 && m === 0) return null;
      return h + (m / 60.0);
    }

    var hours = parseFloat(trimmed);
    if (isNaN(hours) || hours < 0) return null;
    return hours;
  }

  function tepIsPrintableActivityKey(key) {
    return !!key && key.length === 1 && /^[a-z0-9]$/i.test(key);
  }

  function tepGetActivityDropdownButtons(list) {
    return Array.from(list.querySelectorAll('button')).filter(function(button) {
      return button.offsetParent !== null && !button.disabled;
    });
  }

  function tepFindActivityDropdownMatch(list, key) {
    var normalizedKey = key.toLowerCase();
    return tepGetActivityDropdownButtons(list).find(function(button) {
      var text = (button.textContent || '').trim().toLowerCase();
      return text.indexOf(normalizedKey) === 0;
    }) || null;
  }

  function tepFocusActivityDropdownButton(buttons, index) {
    if (index < 0 || index >= buttons.length) return;
    buttons[index].focus();
  }

  function tepHandleActivityDropdownTriggerKey(event, listId) {
    var list = document.getElementById(listId);
    if (!list) return;

    var key = event.key;
    if (key !== 'ArrowDown' && key !== 'ArrowUp' && !tepIsPrintableActivityKey(key)) {
      return;
    }

    event.preventDefault();

    var trigger = event.currentTarget;
    var wasHidden = list.classList.contains('hidden');
    if (wasHidden && trigger && typeof trigger.click === 'function') {
      trigger.click();
    }

    setTimeout(function() {
      var buttons = tepGetActivityDropdownButtons(list);
      if (!buttons.length) return;

      if (tepIsPrintableActivityKey(key)) {
        var match = tepFindActivityDropdownMatch(list, key);
        if (match) {
          match.focus();
          return;
        }
      }

      if (key === 'ArrowUp') {
        tepFocusActivityDropdownButton(buttons, buttons.length - 1);
      } else {
        tepFocusActivityDropdownButton(buttons, 0);
      }
    }, 0);
  }

  function tepHandleActivityDropdownOptionKey(event, listId) {
    var list = document.getElementById(listId);
    if (!list) return;

    var buttons = tepGetActivityDropdownButtons(list);
    var current = event.currentTarget;
    var currentIndex = buttons.indexOf(current);

    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      if (current && typeof current.click === 'function') current.click();
      return;
    }

    if (event.key === 'ArrowDown') {
      event.preventDefault();
      tepFocusActivityDropdownButton(buttons, currentIndex + 1 < buttons.length ? currentIndex + 1 : 0);
      return;
    }

    if (event.key === 'ArrowUp') {
      event.preventDefault();
      tepFocusActivityDropdownButton(buttons, currentIndex > 0 ? currentIndex - 1 : buttons.length - 1);
      return;
    }

    if (tepIsPrintableActivityKey(event.key)) {
      event.preventDefault();
      var match = tepFindActivityDropdownMatch(list, event.key);
      if (match) {
        match.focus();
      }
    }
  }

  // ── Edit-form activity dropdown ──────────────────────────────────────────────
  function tepToggleEditActivityDropdown(entryId) {
    document.querySelectorAll('[id^="tep-edit-act-list-"]').forEach(function(l) {
      if (l.id !== 'tep-edit-act-list-' + entryId) tepCloseFloatingDropdown(l);
    });
    var list = document.getElementById('tep-edit-act-list-' + entryId);
    var anchor = document.getElementById('tep-edit-act-btn-' + entryId);
    if (!list) return;
    if (list.classList.contains('hidden')) {
      tepOpenFloatingDropdown(list, anchor);
    } else {
      tepCloseFloatingDropdown(list);
    }
  }

  function tepSetEditActivity(entryId, activityId, activityName) {
    var hidden = document.getElementById('tep-edit-act-val-'  + entryId);
    var text   = document.getElementById('tep-edit-act-text-' + entryId);
    if (hidden) hidden.value = activityId;
    if (text)   text.textContent = activityName;
    var list = document.getElementById('tep-edit-act-list-' + entryId);
    if (list) tepCloseFloatingDropdown(list);
  }

  // ── Issue entries: expand / collapse ────────────────────────────────────────
  function tepToggleIssueEntries(uid) {    var expand  = document.getElementById('tep-issue-expand-' + uid);
    var chevron = document.getElementById('tep-issue-chevron-' + uid);
    if (!expand) return;
    var isHidden = expand.classList.contains('hidden');
    expand.classList.toggle('hidden');
    if (chevron) chevron.style.transform = isHidden ? 'rotate(90deg)' : '';
    tepPersistOpenState();
  }

  // ── Entry inline edit toggle ─────────────────────────────────────────────────
  function tepToggleEditEntry(entryId) {
    var display = document.getElementById('tep-entry-display-' + entryId);
    var edit    = document.getElementById('tep-entry-edit-'    + entryId);
    if (!display || !edit) return;
    display.classList.toggle('hidden');
    edit.classList.toggle('hidden');
    if (edit.classList.contains('hidden')) {
      var list = document.getElementById('tep-edit-act-list-' + entryId);
      if (list) tepCloseFloatingDropdown(list);
    }
    if (!edit.classList.contains('hidden')) {
      edit.querySelector('input[name="hours"]').focus();
    }
  }

  // ── Entry delete (Flowbite modal) ───────────────────────────────────────────
  var tepPendingDelete = null;

  function tepOpenDeleteModal() {
    var modal = document.getElementById('deleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function tepCloseDeleteModal() {
    var modal = document.getElementById('deleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  function tepDeleteEntry(entryId, url, token) {
    tepPendingDelete = { entryId: entryId, url: url, token: token };
    var trigger = document.getElementById('deleteButton');
    if (trigger) {
      trigger.click();
      // Fallback in case Flowbite auto-toggle is unavailable
      setTimeout(function() {
        var modal = document.getElementById('deleteModal');
        if (modal && modal.classList.contains('hidden')) tepOpenDeleteModal();
      }, 0);
    } else {
      tepOpenDeleteModal();
    }
  }

  function tepConfirmDelete() {
    if (!tepPendingDelete) return;
    var url = tepPendingDelete.url;
    var token = tepPendingDelete.token;
    tepMarkStateForRestore();
    tepPersistOpenState();
    tepCloseDeleteModal();

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = url;
    [['_method', 'DELETE'], ['authenticity_token', token]].forEach(function(pair) {
      var input = document.createElement('input');
      input.type = 'hidden'; input.name = pair[0]; input.value = pair[1];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }

  // ── Persist/restore Logged tab expanded state ────────────────────────────
  var tepLoggedStateKey = 'tep-logged-state:' + window.location.pathname + '?' + window.location.search;
  var tepRestoreFlagKey = 'tep-logged-state-restore:' + window.location.pathname;

  function tepMarkStateForRestore() {
    try {
      sessionStorage.setItem(tepRestoreFlagKey, '1');
    } catch (e) {
      // Ignore storage errors
    }
  }

  function tepConsumeStateRestoreFlag() {
    try {
      var shouldRestore = sessionStorage.getItem(tepRestoreFlagKey) === '1';
      sessionStorage.removeItem(tepRestoreFlagKey);
      return shouldRestore;
    } catch (e) {
      return false;
    }
  }

  function tepGetLoggedState() {
    try {
      var raw = localStorage.getItem(tepLoggedStateKey);
      return raw ? JSON.parse(raw) : { openGroups: [], openIssues: [] };
    } catch (e) {
      return { openGroups: [], openIssues: [] };
    }
  }

  function tepSetLoggedState(state) {
    try {
      localStorage.setItem(tepLoggedStateKey, JSON.stringify(state));
    } catch (e) {
      // Ignore storage errors
    }
  }

  function tepPersistOpenState() {
    var openGroups = [];
    var openIssues = [];

    document.querySelectorAll('.tep-group-row[data-period-key]').forEach(function(row) {
      var expandId = row.getAttribute('data-expand-id');
      var expand = expandId ? document.getElementById(expandId) : null;
      if (expand && !expand.classList.contains('hidden')) {
        openGroups.push(row.getAttribute('data-period-key'));
      }
    });

    document.querySelectorAll('.tep-issue-row[data-period-key][data-issue-id]').forEach(function(row) {
      var expandId = row.getAttribute('data-expand-id');
      var expand = expandId ? document.getElementById(expandId) : null;
      if (expand && !expand.classList.contains('hidden')) {
        openIssues.push(row.getAttribute('data-period-key') + '::' + row.getAttribute('data-issue-id'));
      }
    });

    tepSetLoggedState({
      openGroups: Array.from(new Set(openGroups)),
      openIssues: Array.from(new Set(openIssues))
    });
  }

  function tepFindGroupRow(periodKey) {
    return Array.from(document.querySelectorAll('.tep-group-row[data-period-key]')).find(function(row) {
      return row.getAttribute('data-period-key') === periodKey;
    });
  }

  function tepFindIssueRow(periodKey, issueId) {
    return Array.from(document.querySelectorAll('.tep-issue-row[data-period-key][data-issue-id]')).find(function(row) {
      return row.getAttribute('data-period-key') === periodKey && row.getAttribute('data-issue-id') === issueId;
    });
  }

  function tepRestoreOpenState() {
    var state = tepGetLoggedState();
    if (!state) return;

    (state.openGroups || []).forEach(function(periodKey) {
      var row = tepFindGroupRow(periodKey);
      if (!row) return;
      var expand = document.getElementById(row.getAttribute('data-expand-id'));
      var chevron = document.getElementById(row.getAttribute('data-chevron-id'));
      if (expand) expand.classList.remove('hidden');
      if (chevron) chevron.classList.add('tep-chevron-open');
    });

    (state.openIssues || []).forEach(function(token) {
      var parts = token.split('::');
      if (parts.length !== 2) return;
      var periodKey = parts[0];
      var issueId = parts[1];

      var issueRow = tepFindIssueRow(periodKey, issueId);
      if (!issueRow) return;

      var groupRow = tepFindGroupRow(periodKey);
      if (groupRow) {
        var groupExpand = document.getElementById(groupRow.getAttribute('data-expand-id'));
        var groupChevron = document.getElementById(groupRow.getAttribute('data-chevron-id'));
        if (groupExpand) groupExpand.classList.remove('hidden');
        if (groupChevron) groupChevron.classList.add('tep-chevron-open');
      }

      var expand = document.getElementById(issueRow.getAttribute('data-expand-id'));
      var chevron = document.getElementById(issueRow.getAttribute('data-chevron-id'));
      if (expand) expand.classList.remove('hidden');
      if (chevron) chevron.style.transform = 'rotate(90deg)';
    });
  }

  function tepInitLoggedStatePersistence() {
    if (tepConsumeStateRestoreFlag()) {
      tepRestoreOpenState();
    }
    tepPersistOpenState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tepInitLoggedStatePersistence);
  } else {
    tepInitLoggedStatePersistence();
  }
</script>
