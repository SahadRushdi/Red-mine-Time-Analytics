<% html_title 'Team Management' %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Team Management</h2>
      <p class="text-sm text-gray-500">Manage teams, members, vacancies, and hiring needs from one panel.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'New Team', new_admin_ta_team_path, class: 'inline-flex items-center rounded-lg bg-blue-500 px-4 py-2 text-sm font-medium text-white hover:bg-blue-600' %>
      <%= link_to 'Settings', admin_ta_team_settings_path, class: 'inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50' %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <div class="space-y-6 xl:col-span-2">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:flex xl:h-[590px] xl:flex-col">
        <div class="border-b border-gray-200 px-4 py-3">
          <h3 class="font-semibold text-gray-900">Organizational Hierarchy</h3>
        </div>
        <div class="max-h-[520px] overflow-y-scroll overflow-x-hidden p-4 ta-stable-scroll xl:h-full xl:max-h-none xl:flex-1 xl:min-h-0">
          <% if @all_teams.empty? %>
            <p class="text-sm text-gray-500">No teams found.</p>
          <% else %>
            <%= ta_team_tree(@root_teams, 0, @team_children_map, @team_active_member_counts, @team_open_hiring_counts, @team_active_memberships_map) %>
          <% end %>
        </div>
      </div>

    </div>

    <aside>
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:flex xl:h-[590px] xl:flex-col">
        <div class="border-b border-gray-200 px-4 py-3">
          <div class="flex items-center justify-between">
            <h3 class="font-semibold text-gray-900">Global Member List</h3>
            <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-700">
              <%= @unallocated_users.size %> unallocated
            </span>
          </div>
        </div>

        <div class="border-b border-gray-200 px-4 pt-2">
          <ul class="-mb-px flex flex-wrap text-sm font-medium text-center">
            <li class="me-2">
              <button type="button" id="team-sidebar-members-tab" data-team-tab-target="team-sidebar-members-panel" class="ta-view-tab inline-block rounded-t-lg p-4 ta-view-tab-active">
                Members
              </button>
            </li>
            <li class="me-2">
              <button type="button" id="team-sidebar-vacancies-tab" data-team-tab-target="team-sidebar-vacancies-panel" class="ta-view-tab inline-block rounded-t-lg p-4 text-gray-500 hover:text-gray-600 hover:bg-gray-50">
                Vacancy List
              </button>
            </li>
          </ul>
        </div>

        <div id="team-sidebar-members-panel" class="p-4 xl:flex-1 xl:min-h-0">
          <div class="max-h-[680px] space-y-3 overflow-y-scroll overflow-x-hidden pr-1 ta-stable-scroll xl:h-full xl:max-h-none">
            <% if @unallocated_users.any? %>
              <div class="rounded-lg border border-amber-200 bg-amber-50 p-3">
                <div class="mb-2 flex items-center justify-between">
                  <p class="text-sm font-semibold text-amber-900">Unallocated Members</p>
                  <span class="rounded-full bg-amber-200 px-2 py-0.5 text-xs font-semibold text-amber-800"><%= @unallocated_users.size %></span>
                </div>
                <p class="text-xs text-amber-700">Drag a member to a team in Organizational Hierarchy or use “Add to Team”.</p>
              </div>

              <% @unallocated_users.each_with_index do |user, idx| %>
                <div class="ta-unallocated-member-card rounded-lg border border-amber-300 bg-amber-50/30 p-3"
                     draggable="true"
                     data-user-id="<%= user.id %>"
                     data-user-name="<%= h(user.name) %>"
                     data-default-role="member">
                  <button type="button"
                          class="ta-member-card-toggle w-full flex items-center justify-between gap-2 text-left"
                          onclick="event.stopPropagation(); toggleMemberAssignCard('<%= idx %>')">
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-gray-900"><%= h(user.name) %></span>
                      <span class="block text-xs text-gray-500"><%= h(user.mail) %></span>
                    </span>
                    <svg id="ta-member-assign-chevron-<%= idx %>" class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </button>
                  <div id="ta-member-assign-expand-<%= idx %>" class="hidden mt-2">
                  <%= form_tag assign_member_admin_ta_teams_path, method: :post, class: 'ta-inline-assignment-form grid grid-cols-[minmax(0,1fr)_160px_auto] items-end gap-2' do %>
                    <%= hidden_field_tag :user_id, user.id %>
                    <div class="relative min-w-0">
                      <button type="button" id="assign-team-button-<%= idx %>" data-ta-dropdown-toggle="assign-team-dropdown-<%= idx %>" class="inline-flex items-center justify-between w-full px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
                        <span class="assign-team-label truncate" data-default-text="Select team">Select team</span>
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                      <div id="assign-team-dropdown-<%= idx %>" data-ta-dropdown-menu="true" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
                        <ul class="max-h-48 overflow-y-auto overflow-x-hidden py-1 text-sm text-gray-700">
                          <% @all_teams.each do |team| %>
                            <li>
                              <button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="<%= team.id %>" data-ta-dropdown-label="<%= h(team.name) %>" data-ta-dropdown-target="assign_team_<%= idx %>" data-ta-dropdown-label-target="assign-team-button-<%= idx %>">
                                <%= h(team.name) %>
                              </button>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                      <%= hidden_field_tag :team_id, '', id: "assign_team_#{idx}", required: true %>
                    </div>

                    <div class="relative w-full">
                      <button type="button" id="assign-role-button-<%= idx %>" data-ta-dropdown-toggle="assign-role-dropdown-<%= idx %>" class="inline-flex items-center justify-between w-full px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
                        <span class="assign-role-label" data-default-text="Team Member">Team Member</span>
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                      <div id="assign-role-dropdown-<%= idx %>" data-ta-dropdown-menu="true" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
                        <ul class="py-1 text-sm text-gray-700">
                          <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="member" data-ta-dropdown-label="Team Member" data-ta-dropdown-target="assign_role_<%= idx %>" data-ta-dropdown-label-target="assign-role-button-<%= idx %>">Team Member</button></li>
                          <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="lead" data-ta-dropdown-label="Team Lead" data-ta-dropdown-target="assign_role_<%= idx %>" data-ta-dropdown-label-target="assign-role-button-<%= idx %>">Team Lead</button></li>
                        </ul>
                      </div>
                      <%= hidden_field_tag :role, 'member', id: "assign_role_#{idx}" %>
                    </div>

                    <%= submit_tag 'Add to Team', class: 'h-10 rounded-lg bg-blue-500 px-3 text-sm font-medium text-white hover:bg-blue-600 whitespace-nowrap' %>
                  <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No unallocated members.</p>
            <% end %>
          </div>
        </div>

        <div id="team-sidebar-vacancies-panel" class="hidden p-4 xl:flex-1 xl:min-h-0">
          <div class="space-y-2 xl:h-full xl:overflow-y-auto xl:overflow-x-hidden xl:pr-1 ta-stable-scroll">
            <% if @open_hiring_needs.any? %>
              <% @open_hiring_needs.each do |need| %>
                <div class="rounded-lg border border-gray-200 p-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-gray-900"><%= h(need.position_title) %></p>
                      <p class="text-xs text-gray-500"><%= h(need.team.name) %></p>
                      <p class="mt-1 text-xs font-medium text-blue-700">Priority: <%= need.priority.titleize %></p>
                    </div>
                    <%= button_to mark_filled_admin_ta_hiring_need_path(need), method: :patch, class: 'ta-vacancy-action-button inline-flex items-center rounded-lg bg-emerald-700 px-3 py-2 text-center text-xs font-medium text-white hover:bg-emerald-800 focus:outline-none focus:ring-4 focus:ring-emerald-300', form_class: 'shrink-0' do %>
                      <svg class="mr-1.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Fill Hired
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No open vacancies.</p>
            <% end %>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
    <h3 class="mb-4 font-semibold text-gray-900">Add Hiring Need</h3>
    <%= form_for @new_hiring_need, url: create_hiring_need_admin_ta_teams_path, html: { class: 'grid grid-cols-1 gap-4 md:grid-cols-3' } do |f| %>
      <div>
        <%= f.label :position_title, 'Position Title', class: 'mb-1 block text-sm font-medium text-gray-700' %>
        <%= f.text_field :position_title, required: true, class: 'ta-hiring-position-input ts-search-input !block !w-full !h-[48px] !rounded-lg !border !border-gray-300 !px-3 !text-base !text-gray-900 !shadow-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]', placeholder: 'Enter position title' %>
      </div>
      <div>
        <%= label_tag 'hiring-team-button', 'Team', class: 'mb-1 block text-sm font-medium text-gray-700' %>
        <div class="relative">
          <button type="button" id="hiring-team-button" data-ta-dropdown-toggle="hiring-team-dropdown" class="inline-flex h-[48px] items-center justify-between w-full px-4 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
            <span class="hiring-team-label" data-default-text="Select Team">Select Team</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="hiring-team-dropdown" data-ta-dropdown-menu="true" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
            <ul class="max-h-40 overflow-auto py-1 text-sm text-gray-700">
              <% @all_teams.each do |team| %>
                <li>
                  <button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="<%= team.id %>" data-ta-dropdown-label="<%= h(team.name) %>" data-ta-dropdown-target="ta_hiring_need_team_id" data-ta-dropdown-label-target="hiring-team-button">
                    <%= h(team.name) %>
                  </button>
                </li>
              <% end %>
            </ul>
          </div>
          <%= f.hidden_field :team_id, required: true %>
        </div>
      </div>
      <div>
        <%= label_tag 'hiring-priority-button', 'Priority', class: 'mb-1 block text-sm font-medium text-gray-700' %>
        <div class="relative">
          <button type="button" id="hiring-priority-button" data-ta-dropdown-toggle="hiring-priority-dropdown" class="inline-flex h-[48px] items-center justify-between w-full px-4 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
            <span class="hiring-priority-label" data-default-text="<%= @new_hiring_need.priority.titleize %>"><%= @new_hiring_need.priority.titleize %></span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="hiring-priority-dropdown" data-ta-dropdown-menu="true" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
            <ul class="py-1 text-sm text-gray-700">
              <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="high" data-ta-dropdown-label="High" data-ta-dropdown-target="ta_hiring_need_priority" data-ta-dropdown-label-target="hiring-priority-button">High</button></li>
              <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="medium" data-ta-dropdown-label="Medium" data-ta-dropdown-target="ta_hiring_need_priority" data-ta-dropdown-label-target="hiring-priority-button">Medium</button></li>
              <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="low" data-ta-dropdown-label="Low" data-ta-dropdown-target="ta_hiring_need_priority" data-ta-dropdown-label-target="hiring-priority-button">Low</button></li>
            </ul>
          </div>
          <%= f.hidden_field :priority, required: true %>
        </div>
      </div>
      <div class="md:col-span-3 flex justify-end pt-1">
        <%= f.submit 'Add Hiring Need', class: 'ta-hiring-submit-btn inline-flex h-[44px] items-center !rounded-lg bg-blue-500 px-5 text-sm font-medium text-white hover:bg-blue-600' %>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200">
    <div class="ta-team-history-tabs-header flex items-end justify-between px-6 pt-2 pb-0 border-b border-gray-200 flex-wrap gap-3">
      <ul class="ts-tab-group flex flex-wrap text-sm font-medium text-center text-gray-500 -mb-px">
        <li class="me-2">
          <button type="button" id="team-history-tab-vacancy" data-team-history-tab-target="team-history-panel-vacancy"
                  class="ta-view-tab inline-block px-4 py-2.5 rounded-t-lg text-gray-500 hover:text-gray-600 hover:bg-gray-50 ta-view-tab-active">
            <span class="inline-flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Vacancy History
              <span class="ts-tab-badge"><%= @hiring_need_history.size %></span>
            </span>
          </button>
        </li>
        <li class="me-2">
          <button type="button" id="team-history-tab-member" data-team-history-tab-target="team-history-panel-member"
                  class="ta-view-tab inline-block px-4 py-2.5 rounded-t-lg text-gray-500 hover:text-gray-600 hover:bg-gray-50">
            <span class="inline-flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-gray-300"></span>
              Member History
              <span class="ts-tab-badge"><%= @active_memberships.size %></span>
            </span>
          </button>
        </li>
      </ul>
    </div>

    <div id="team-history-panel-vacancy">
      <% open_count = @hiring_need_history.count(&:open?) %>
      <% filled_count = @hiring_need_history.count(&:filled?) %>
      <div class="px-6 py-2 text-sm text-gray-500 flex items-center justify-between border-b border-gray-100">
        <span><%= @hiring_need_history.size %> total vacancies · <span class="text-red-600"><%= open_count %> open</span> · <span class="text-green-600"><%= filled_count %> filled</span></span>
      </div>

      <div class="overflow-x-auto">
        <table class="ts-table w-full text-sm text-left">
          <thead class="bg-gray-50">
            <tr class="border-b border-gray-200">
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('position'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('position'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Position</span>
                  <span id="ta-vacancy-sort-icon-position" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('team'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('team'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Team</span>
                  <span id="ta-vacancy-sort-icon-team" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('priority'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('priority'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Priority</span>
                  <span id="ta-vacancy-sort-icon-priority" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('status'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('status'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Status</span>
                  <span id="ta-vacancy-sort-icon-status" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('opened'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('opened'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Opened</span>
                  <span id="ta-vacancy-sort-icon-opened" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('filled'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('filled'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Filled</span>
                  <span id="ta-vacancy-sort-icon-filled" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
              <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                <span role="button" tabindex="0" onclick="toggleVacancyHistorySort('duration'); this.blur();"
                      onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleVacancyHistorySort('duration'); }"
                      class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                  <span>Duration</span>
                  <span id="ta-vacancy-sort-icon-duration" class="sort desc icon icon-sorted-asc"></span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% if @hiring_need_history.any? %>
              <% @hiring_need_history.each do |need| %>
                <% duration_days = [(need.filled_on || Date.current) - need.created_at.to_date, 0].max.to_i %>
                <% priority_sort_value = need.priority == 'high' ? 3 : (need.priority == 'medium' ? 2 : 1) %>
                <tr class="ts-issue-row ta-vacancy-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                    data-sort-position="<%= need.position_title.to_s.downcase %>"
                    data-sort-team="<%= need.team.name.to_s.downcase %>"
                    data-sort-priority="<%= priority_sort_value %>"
                    data-sort-status="<%= need.open? ? 2 : 1 %>"
                    data-sort-opened="<%= need.created_at.to_i %>"
                    data-sort-filled="<%= need.filled_on ? need.filled_on.to_time.to_i : 0 %>"
                    data-sort-duration="<%= duration_days %>">
                  <td class="px-4 py-3 font-semibold text-gray-900"><%= h(need.position_title) %></td>
                  <td class="px-4 py-3 text-gray-600"><%= h(need.team.name) %></td>
                  <td class="px-4 py-3">
                    <% priority_classes = need.priority == 'high' ? 'bg-red-100 text-red-700 border-red-200' : (need.priority == 'medium' ? 'bg-amber-100 text-amber-700 border-amber-200' : 'bg-green-100 text-green-700 border-green-200') %>
                    <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium <%= priority_classes %>"><%= need.priority.titleize %></span>
                  </td>
                  <td class="px-4 py-3">
                    <% if need.open? %>
                      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-600"><span class="h-2 w-2 rounded-full bg-red-400"></span>Open</span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-green-600"><span class="h-2 w-2 rounded-full bg-green-400"></span>Filled</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-gray-600"><%= format_date(need.created_at.to_date) %></td>
                  <td class="px-4 py-3 text-gray-600"><%= need.filled_on ? format_date(need.filled_on) : '—' %></td>
                  <td class="px-4 py-3 text-gray-700">
                    <% if need.open? %>
                      <span class="inline-flex items-center gap-1">
                        <svg class="h-3.5 w-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0"></path>
                        </svg>
                        <%= duration_days %>d
                      </span>
                    <% else %>
                      —
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="px-4 py-6 text-center text-sm text-gray-500">No vacancy history available.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div id="team-history-panel-member" class="hidden">
      <div class="px-6 py-2 text-sm text-gray-500 flex items-center justify-between border-b border-gray-100">
        <span><%= @member_history_groups.size %> members with team assignments</span>
        <div class="relative w-full max-w-md">
          <input type="text" id="ta-member-history-search" placeholder="Search member, email, team, or role..."
                 class="ts-search-input !block !w-full !h-[48px] !rounded-lg !border !border-gray-300 !px-3 !text-base !text-gray-900 !shadow-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]"
                 oninput="filterMemberHistoryRows()">
        </div>
      </div>

      <% if @member_history_groups.any? %>
        <div class="overflow-x-auto">
          <table class="ts-table w-full text-sm text-left">
            <thead class="bg-gray-50">
              <tr class="border-b border-gray-200">
                <th class="px-4 py-2.5 w-8"></th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Member</th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Current Role</th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Active Teams</th>
                <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Last Updated</th>
              </tr>
            </thead>
            <tbody>
              <% @member_history_groups.each_with_index do |group, idx| %>
                <% user = group[:user] %>
                <% latest_active_membership = group[:memberships].select(&:active?).max_by(&:start_date) %>
                <% latest_any_membership = group[:memberships].max_by(&:start_date) %>
                <% current_role = latest_active_membership&.role || latest_any_membership&.role %>
                <% search_text = [
                  user.name,
                  user.mail,
                  group[:memberships].map { |m| m.team&.name }.join(' '),
                  group[:memberships].map(&:role).join(' ')
                ].join(' ').downcase %>
                <tr class="ts-issue-row ta-member-history-group-row border-b border-gray-100 hover:bg-gray-50 transition-colors cursor-pointer"
                    data-search-text="<%= h(search_text) %>"
                    data-expand-id="ta-member-history-expand-<%= idx %>"
                    data-chevron-id="ta-member-history-chevron-<%= idx %>"
                    onclick="toggleMemberHistoryRows('<%= idx %>')">
                  <td class="px-4 py-3 text-center">
                    <svg id="ta-member-history-chevron-<%= idx %>" class="w-4 h-4 text-gray-400 inline-block transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-semibold text-gray-900"><%= h(user.name) %></span>
                      <span class="text-xs text-gray-500"><%= h(user.mail) %></span>
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <% if current_role == 'lead' %>
                      <span class="inline-flex items-center rounded-md border border-indigo-200 bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Team Lead</span>
                    <% else %>
                      <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Team Member</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-gray-700"><%= group[:active_team_count] %></td>
                  <td class="px-4 py-3 text-gray-500 text-sm"><%= group[:last_updated_on] ? "#{time_ago_in_words(group[:last_updated_on])} ago" : '—' %></td>
                </tr>
                <tr id="ta-member-history-expand-<%= idx %>" class="ta-member-history-expand-row hidden">
                  <td colspan="5" class="px-0 py-0 bg-slate-50 border-b border-gray-200">
                    <div class="pl-10 pr-4 py-3 border-l-4 border-blue-300">
                      <table class="w-full text-sm">
                        <thead>
                          <tr class="border-b border-gray-200">
                            <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Team</th>
                            <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Role</th>
                            <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Start Date</th>
                            <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">End Date</th>
                            <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Status</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% group[:memberships].each do |membership| %>
                            <tr class="border-b border-gray-100 last:border-0">
                              <td class="px-3 py-2.5 text-gray-800"><%= h(membership.team&.name.to_s) %></td>
                              <td class="px-3 py-2.5">
                                <% if membership.lead? %>
                                  <span class="inline-flex items-center rounded-md border border-indigo-200 bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Team Lead</span>
                                <% else %>
                                  <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Team Member</span>
                                <% end %>
                              </td>
                              <td class="px-3 py-2.5 text-gray-600"><%= membership.start_date ? format_date(membership.start_date) : '—' %></td>
                              <td class="px-3 py-2.5 text-gray-600"><%= membership.end_date ? format_date(membership.end_date) : '—' %></td>
                              <td class="px-3 py-2.5">
                                <% if membership.active? %>
                                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Active</span>
                                <% else %>
                                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500"><span class="h-2 w-2 rounded-full bg-gray-300"></span>Inactive</span>
                                <% end %>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-6 py-10 text-center text-sm text-gray-500">
          No member assignment history available.
        </div>
      <% end %>
    </div>
  </div>
</div>


<script type="text/javascript">
  function resetVacancyHistorySortIcons(activeColumn) {
    var columns = ['position', 'team', 'priority', 'status', 'opened', 'filled', 'duration'];
    columns.forEach(function(column) {
      var icon = document.getElementById('ta-vacancy-sort-icon-' + column);
      if (!icon) return;

      if (column !== activeColumn) {
        delete icon.dataset.order;
      }
      var order = icon.dataset.order || 'desc';
      icon.className = order === 'asc' ? 'sort asc icon icon-sorted-desc' : 'sort desc icon icon-sorted-asc';
    });
  }

  function toggleVacancyHistorySort(column) {
    var panel = document.getElementById('team-history-panel-vacancy');
    var tbody = panel ? panel.querySelector('table.ts-table tbody') : null;
    if (!tbody) return;

    var rows = Array.from(tbody.querySelectorAll('tr.ta-vacancy-row'));
    var sortIcon = document.getElementById('ta-vacancy-sort-icon-' + column);
    if (!sortIcon) return;

    var currentOrder = sortIcon.dataset.order || 'desc';
    var nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';
    var numericColumns = ['priority', 'status', 'opened', 'filled', 'duration'];

    rows.sort(function(a, b) {
      var attrName = 'data-sort-' + column;
      var aValue = a.getAttribute(attrName) || '';
      var bValue = b.getAttribute(attrName) || '';

      if (numericColumns.indexOf(column) !== -1) {
        aValue = parseInt(aValue || '0', 10);
        bValue = parseInt(bValue || '0', 10);
        return nextOrder === 'asc' ? aValue - bValue : bValue - aValue;
      }

      var stringCompare = aValue.localeCompare(bValue);
      return nextOrder === 'asc' ? stringCompare : -stringCompare;
    });

    rows.forEach(function(row) { tbody.appendChild(row); });

    delete sortIcon.dataset.order;
    sortIcon.dataset.order = nextOrder;
    resetVacancyHistorySortIcons(column);
  }

  function toggleMemberHistoryRows(rowId) {
    var expandRow = document.getElementById('ta-member-history-expand-' + rowId);
    var chevron = document.getElementById('ta-member-history-chevron-' + rowId);
    if (!expandRow || !chevron) return;

    var willOpen = expandRow.classList.contains('hidden');
    expandRow.classList.toggle('hidden');
    chevron.style.transform = willOpen ? 'rotate(90deg)' : '';
  }

  function filterMemberHistoryRows() {
    var input = document.getElementById('ta-member-history-search');
    var query = input ? input.value.toLowerCase().trim() : '';
    var groupRows = document.querySelectorAll('#team-history-panel-member .ta-member-history-group-row');

    groupRows.forEach(function(row) {
      var text = row.getAttribute('data-search-text') || '';
      var matches = !query || text.indexOf(query) !== -1;
      var expandId = row.getAttribute('data-expand-id');
      var expandRow = expandId ? document.getElementById(expandId) : null;
      var chevronId = row.getAttribute('data-chevron-id');
      var chevron = chevronId ? document.getElementById(chevronId) : null;

      row.style.display = matches ? '' : 'none';
      if (!matches && expandRow) {
        expandRow.classList.add('hidden');
        if (chevron) chevron.style.transform = '';
      }
      if (matches && expandRow && query) {
        expandRow.classList.remove('hidden');
        if (chevron) chevron.style.transform = 'rotate(90deg)';
      }
      if (matches && expandRow && !query) {
        expandRow.classList.add('hidden');
        if (chevron) chevron.style.transform = '';
      }
    });
  }

  function toggleMemberAssignCard(cardId) {
    var expand = document.getElementById('ta-member-assign-expand-' + cardId);
    var chevron = document.getElementById('ta-member-assign-chevron-' + cardId);
    if (!expand || !chevron) return;

    var willOpen = expand.classList.contains('hidden');
    expand.classList.toggle('hidden');
    chevron.style.transform = willOpen ? 'rotate(90deg)' : '';
  }

  function setupTeamDragAndDrop() {
    var memberCards = document.querySelectorAll('.ta-unallocated-member-card[data-user-id]');
    var teamDropzones = document.querySelectorAll('.ta-team-dropzone[data-team-id]');

    memberCards.forEach(function(card) {
      card.addEventListener('dragstart', function(event) {
        card.classList.add('ta-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', JSON.stringify({
          userId: card.getAttribute('data-user-id'),
          userName: card.getAttribute('data-user-name') || '',
          role: card.getAttribute('data-default-role') || 'member'
        }));
      });

      card.addEventListener('dragend', function() {
        card.classList.remove('ta-dragging');
        document.querySelectorAll('.ta-team-dropzone.ta-dropzone-hover').forEach(function(zone) {
          zone.classList.remove('ta-dropzone-hover');
        });
      });
    });

    teamDropzones.forEach(function(zone) {
      zone.addEventListener('dragover', function(event) {
        event.preventDefault();
        event.dataTransfer.dropEffect = 'move';
        zone.classList.add('ta-dropzone-hover');
      });

      zone.addEventListener('dragenter', function(event) {
        event.preventDefault();
        zone.classList.add('ta-dropzone-hover');
      });

      zone.addEventListener('dragleave', function(event) {
        var related = event.relatedTarget;
        if (!related || !zone.contains(related)) {
          zone.classList.remove('ta-dropzone-hover');
        }
      });

      zone.addEventListener('drop', function(event) {
        event.preventDefault();
        zone.classList.remove('ta-dropzone-hover');

        var payloadRaw = event.dataTransfer.getData('text/plain');
        if (!payloadRaw) return;

        var payload;
        try {
          payload = JSON.parse(payloadRaw);
        } catch (_error) {
          return;
        }

        var userId = payload.userId;
        var teamId = zone.getAttribute('data-team-id');
        var role = payload.role || 'member';
        if (!userId || !teamId) return;

        var form = document.createElement('form');
        form.method = 'post';
        form.action = '<%= assign_member_admin_ta_teams_path %>';
        form.style.display = 'none';

        var tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = 'authenticity_token';
        tokenInput.value = '<%= form_authenticity_token %>';
        form.appendChild(tokenInput);

        var userInput = document.createElement('input');
        userInput.type = 'hidden';
        userInput.name = 'user_id';
        userInput.value = userId;
        form.appendChild(userInput);

        var teamInput = document.createElement('input');
        teamInput.type = 'hidden';
        teamInput.name = 'team_id';
        teamInput.value = teamId;
        form.appendChild(teamInput);

        var roleInput = document.createElement('input');
        roleInput.type = 'hidden';
        roleInput.name = 'role';
        roleInput.value = role;
        form.appendChild(roleInput);

        document.body.appendChild(form);
        form.submit();
      });
    });
  }

  function setupTeamMemberToggles() {
    document.querySelectorAll('[data-ta-member-toggle="true"]').forEach(function(button) {
      var targetId = button.getAttribute('data-collapse-toggle');
      if (!targetId) return;

      var target = document.getElementById(targetId);
      var icon = button.querySelector('[data-ta-member-toggle-icon="true"]');
      if (!target || !icon) return;

      function syncState() {
        var expanded = !target.classList.contains('hidden');
        button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        icon.style.transform = expanded ? 'rotate(90deg)' : '';
      }

      button.addEventListener('click', function() {
        setTimeout(syncState, 0);
      });

      syncState();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    function closeAllDropdowns() {
      document.querySelectorAll('[data-ta-dropdown-menu="true"]').forEach(function(dropdown) {
        dropdown.classList.add('hidden');
      });
    }

    document.addEventListener('click', function(event) {
      var toggleButton = event.target.closest('[data-ta-dropdown-toggle]');
      if (toggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var dropdownId = toggleButton.getAttribute('data-ta-dropdown-toggle');
        var dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        var isHidden = dropdown.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) dropdown.classList.remove('hidden');
        return;
      }

      var optionButton = event.target.closest('[data-ta-dropdown-target]');
      if (optionButton) {
        event.preventDefault();
        var value = optionButton.getAttribute('data-ta-dropdown-value');
        var label = optionButton.getAttribute('data-ta-dropdown-label');
        var targetId = optionButton.getAttribute('data-ta-dropdown-target');
        var buttonId = optionButton.getAttribute('data-ta-dropdown-label-target');
        var hiddenInput = document.getElementById(targetId);
        var button = document.getElementById(buttonId);
        if (hiddenInput) hiddenInput.value = value;
        if (button) {
          var labelEl = button.querySelector('span');
          if (labelEl) labelEl.textContent = label;
        }
        closeAllDropdowns();
        return;
      }

      closeAllDropdowns();
    });

    document.addEventListener('submit', function(event) {
      if (!event.target.classList.contains('ta-inline-assignment-form')) return;
      var teamField = event.target.querySelector('input[name="team_id"]');
      if (!teamField || !teamField.value) {
        event.preventDefault();
        alert('Please select a team.');
      }
    }, true);

    function switchTeamSidebarTab(targetPanelId) {
      var tabs = [
        { tab: document.getElementById('team-sidebar-members-tab'), panel: document.getElementById('team-sidebar-members-panel') },
        { tab: document.getElementById('team-sidebar-vacancies-tab'), panel: document.getElementById('team-sidebar-vacancies-panel') }
      ];

      tabs.forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) {
          item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        } else {
          item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        }
      });
    }

    document.querySelectorAll('[data-team-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchTeamSidebarTab(tabButton.getAttribute('data-team-tab-target'));
      });
    });

    function switchTeamHistoryTab(targetPanelId) {
      var tabs = [
        { tab: document.getElementById('team-history-tab-vacancy'), panel: document.getElementById('team-history-panel-vacancy') },
        { tab: document.getElementById('team-history-tab-member'), panel: document.getElementById('team-history-panel-member') }
      ];

      tabs.forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) {
          item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        } else {
          item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        }
      });
    }

    document.querySelectorAll('[data-team-history-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchTeamHistoryTab(tabButton.getAttribute('data-team-history-tab-target'));
      });
    });

    resetVacancyHistorySortIcons('position');
    setupTeamDragAndDrop();
    setupTeamMemberToggles();

    // Keep initial server-rendered tab state to avoid first-paint layout mutation
  });
</script>
