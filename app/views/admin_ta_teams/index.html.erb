  function setupTeamDragAndDrop() {
    var memberCards = document.querySelectorAll('.ta-unallocated-member-card[data-user-id]');
    var teamDropzones = document.querySelectorAll('.ta-team-dropzone[data-team-id]');

    memberCards.forEach(function(card) {
      card.addEventListener('dragstart', function(event) {
        card.classList.add('ta-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', JSON.stringify({
          userId: card.getAttribute('data-user-id'),
          userName: card.getAttribute('data-user-name') || '',
          role: card.getAttribute('data-default-role') || 'member',
          sidebarTab: card.getAttribute('data-sidebar-tab') || '',
          defaultStartDate: card.getAttribute('data-default-start-date') || '',
          defaultEndDate: card.getAttribute('data-default-end-date') || ''
        }));
      });

      card.addEventListener('dragend', function() {
        card.classList.remove('ta-dragging');
        document.querySelectorAll('.ta-team-dropzone.ta-dropzone-hover').forEach(function(zone) {
          zone.classList.remove('ta-dropzone-hover');
        });
      });
    });

    teamDropzones.forEach(function(zone) {
      zone.addEventListener('dragover', function(event) {
        event.preventDefault();
        event.dataTransfer.dropEffect = 'move';
        zone.classList.add('ta-dropzone-hover');
      });

      zone.addEventListener('dragenter', function(event) {
        event.preventDefault();
        zone.classList.add('ta-dropzone-hover');
      });

      zone.addEventListener('dragleave', function(event) {
        var related = event.relatedTarget;
        if (!related || !zone.contains(related)) {
          zone.classList.remove('ta-dropzone-hover');
        }
      });

      zone.addEventListener('drop', function(event) {
        event.preventDefault();
        zone.classList.remove('ta-dropzone-hover');

        var payloadRaw = event.dataTransfer.getData('text/plain');
        if (!payloadRaw) return;

        var payload;
        try {
          payload = JSON.parse(payloadRaw);
        } catch (_error) {
          return;
        }

        var userId = payload.userId;
        var teamId = zone.getAttribute('data-team-id');
        var teamName = zone.getAttribute('data-team-name');
        var role = payload.role || 'member';
        if (!userId || !teamId) return;

        teamAssignOpenModal({
          userId: userId,
          userName: payload.userName,
          teamId: teamId,
          teamName: teamName,
          role: role,
          sidebarTab: payload.sidebarTab || '',
          defaultStartDate: payload.defaultStartDate || '',
          defaultEndDate: payload.defaultEndDate || ''
        });
      });
    });
  }

  function setupTeamMemberToggles() {
    document.querySelectorAll('[data-ta-member-toggle="true"]').forEach(function(button) {
      var targetId = button.getAttribute('data-collapse-toggle');
      if (!targetId) return;

      var target = document.getElementById(targetId);
      var icon = button.querySelector('[data-ta-member-toggle-icon="true"]');
      if (!target || !icon) return;

      function syncState() {
        var expanded = !target.classList.contains('hidden');
        button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        icon.style.transform = expanded ? 'rotate(90deg)' : '';
      }

      button.addEventListener('click', function() {
        setTimeout(syncState, 0);
      });

      syncState();
    });
  }

  document.addEventListener('click', function(event) {
    var addTeamEls = teamMembersAddTeamElements();
    if (addTeamEls.wrapper && addTeamEls.list) {
      var clickedInsideTeamList = !!addTeamEls.list.contains(event.target);
      if (!addTeamEls.wrapper.contains(event.target) && !clickedInsideTeamList) {
        teamMembersCloseAddTeamDropdown();
      }
    }

    var addUserEls = teamMembersAddUserElements();
    if (addUserEls.wrapper && addUserEls.list) {
      var clickedInsideAddUserList = !!addUserEls.list.contains(event.target);
      if (!addUserEls.wrapper.contains(event.target) && !clickedInsideAddUserList) {
        teamMembersCloseAddUserDropdown();
      }
    }

    var addRoleEls = teamMembersAddRoleElements();
    if (addRoleEls.wrapper && addRoleEls.list && !addRoleEls.wrapper.contains(event.target) && !addRoleEls.list.contains(event.target)) {
      teamMembersCloseAddRoleDropdown();
    }

    document.querySelectorAll('[id^="ta-team-member-role-wrapper-"]').forEach(function(wrapper) {
      var membershipId = wrapper.id.replace('ta-team-member-role-wrapper-', '');
      var list = document.getElementById('ta-team-member-role-list-' + membershipId);
      if (!list) return;
      if (!wrapper.contains(event.target) && !list.contains(event.target)) {
        teamMembersCloseFloatingDropdown(list);
      }
    });

    teamMembersCloseDeleteModalIfBackdrop(event);
  });

  if (!window.__teamManagementModalListenersBound) {
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        teamMembersCloseAddModal();
        teamMembersCloseDeleteModal();
      }
    });
    window.__teamManagementModalListenersBound = true;
  }

  document.addEventListener('DOMContentLoaded', function() {
    function closeAllDropdowns() {
      document.querySelectorAll('[data-ta-dropdown-menu="true"]').forEach(function(dropdown) {
        dropdown.classList.add('hidden');
      });
      document.querySelectorAll('[data-ta-hiring-team-menu="true"]').forEach(function(dropdown) {
        dropdown.classList.add('hidden');
      });
    }

    document.addEventListener('click', function(event) {
      var hiringToggleButton = event.target.closest('[data-ta-hiring-team-toggle]');
      if (hiringToggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var hiringDropdown = document.getElementById('ta-hiring-team-dropdown');
        if (!hiringDropdown) return;
        var isHidden = hiringDropdown.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) hiringDropdown.classList.remove('hidden');
        return;
      }

      var hiringOptionButton = event.target.closest('[data-ta-hiring-team-value]');
      if (hiringOptionButton) {
        event.preventDefault();
        var hiringValue = hiringOptionButton.getAttribute('data-ta-hiring-team-value');
        var hiringLabel = hiringOptionButton.getAttribute('data-ta-hiring-team-label');
        var hiringHiddenInput = document.getElementById('ta-hiring-need-team-id');
        var hiringButtonLabel = document.getElementById('ta-hiring-team-label');
        if (hiringHiddenInput) hiringHiddenInput.value = hiringValue;
        if (hiringButtonLabel) hiringButtonLabel.textContent = hiringLabel;
        closeAllDropdowns();
        return;
      }

      var toggleButton = event.target.closest('[data-ta-dropdown-toggle]');
      if (toggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var dropdownId = toggleButton.getAttribute('data-ta-dropdown-toggle');
        var dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        var isHidden = dropdown.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) dropdown.classList.remove('hidden');
        return;
      }

      var optionButton = event.target.closest('[data-ta-dropdown-target]');
      if (optionButton) {
        event.preventDefault();
        var value = optionButton.getAttribute('data-ta-dropdown-value');
        var label = optionButton.getAttribute('data-ta-dropdown-label');
        var targetId = optionButton.getAttribute('data-ta-dropdown-target');
        var buttonId = optionButton.getAttribute('data-ta-dropdown-label-target');
        var hiddenInput = document.getElementById(targetId);
        var button = document.getElementById(buttonId);
        if (hiddenInput) hiddenInput.value = value;
        if (button) {
          var labelEl = button.querySelector('span');
          if (labelEl) labelEl.textContent = label;
        }
        closeAllDropdowns();
        return;
      }

      closeAllDropdowns();
    });

    function switchTeamSidebarTab(targetPanelId) {
      var tabs = [
        { tab: document.getElementById('team-sidebar-members-tab'), panel: document.getElementById('team-sidebar-members-panel') },
        { tab: document.getElementById('team-sidebar-locked-tab'), panel: document.getElementById('team-sidebar-locked-panel') },
        { tab: document.getElementById('team-sidebar-vacancies-tab'), panel: document.getElementById('team-sidebar-vacancies-panel') }
      ];

      tabs.forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) {
          item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        } else {
          item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        }
      });
      updateWorkforceOverviewCountBadge(targetPanelId);
    }

    function updateWorkforceOverviewCountBadge(activePanelId) {
      var badge = document.getElementById('workforce-overview-count-badge');
      if (!badge) return;
      if (activePanelId === 'team-sidebar-vacancies-panel') {
        badge.textContent = '<%= @open_hiring_needs.size %> open positions';
      } else if (activePanelId === 'team-sidebar-locked-panel') {
        badge.textContent = '<%= @locked_users.size %> locked members';
      } else {
        badge.textContent = '<%= @unallocated_users.size %> unallocated';
      }
    }

    document.querySelectorAll('[data-team-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchTeamSidebarTab(tabButton.getAttribute('data-team-tab-target'));
      });
    });

    function switchTeamMainTab(targetPanelId) {
      var tabs = [
        { tab: document.getElementById('team-main-tab-structure'), panel: document.getElementById('team-main-panel-structure') },
        { tab: document.getElementById('team-main-tab-members'), panel: document.getElementById('team-main-panel-members') }
      ];

      tabs.forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) {
          item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        } else {
          item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        }
      });

      if (targetPanelId === 'team-main-panel-members') {
        applyTeamHistoryPagination('member', true);
      }
    }

    document.querySelectorAll('[data-team-main-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchTeamMainTab(tabButton.getAttribute('data-team-main-tab-target'));
      });
    });

    function setupTeamSplitLayout() {
      var splitLayout = document.getElementById('ta-team-split-layout');
      var mainColumn = document.getElementById('ta-team-main-column');
      var splitter = document.getElementById('ta-team-splitter-controls');
      if (!splitLayout || !mainColumn || !splitter) return;

      var SPLIT_STORAGE_KEY = 'taTeamSplitLeftPercent';
      var DEFAULT_LEFT_PERCENT = 64;
      var MIN_LEFT_PERCENT = 22;
      var MAX_LEFT_PERCENT = 78;
      var dragging = false;
      var pointerId = null;
      var mediaQuery = window.matchMedia('(min-width: 1280px)');

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function isDesktopWidth() {
        return mediaQuery.matches;
      }

      function applySplitPercent(percent, persist) {
        var safePercent = clamp(percent, MIN_LEFT_PERCENT, MAX_LEFT_PERCENT);
        mainColumn.style.flexBasis = safePercent + '%';
        if (persist && window.sessionStorage) {
          sessionStorage.setItem(SPLIT_STORAGE_KEY, String(safePercent));
        }
      }

      function loadSavedSplitPercent() {
        var saved = window.sessionStorage ? sessionStorage.getItem(SPLIT_STORAGE_KEY) : null;
        var parsed = parseFloat(saved);
        if (Number.isNaN(parsed)) return DEFAULT_LEFT_PERCENT;
        return clamp(parsed, MIN_LEFT_PERCENT, MAX_LEFT_PERCENT);
      }

      function updateSplitFromPointer(clientX, persist) {
        var rect = splitLayout.getBoundingClientRect();
        if (!rect.width) return;
        var percent = ((clientX - rect.left) / rect.width) * 100;
        applySplitPercent(percent, persist);
      }

      splitter.addEventListener('pointerdown', function(event) {
        if (!isDesktopWidth()) return;
        dragging = true;
        pointerId = event.pointerId;
        splitter.classList.add('is-dragging');
        document.body.classList.add('ta-team-split-dragging');
        if (splitter.setPointerCapture) splitter.setPointerCapture(pointerId);
        event.preventDefault();
      });

      window.addEventListener('pointermove', function(event) {
        if (!dragging || !isDesktopWidth()) return;
        if (pointerId !== null && event.pointerId !== pointerId) return;
        updateSplitFromPointer(event.clientX, true);
      });

      function stopDragging(event) {
        if (!dragging) return;
        if (event && pointerId !== null && event.pointerId !== pointerId) return;
        dragging = false;
        splitter.classList.remove('is-dragging');
        document.body.classList.remove('ta-team-split-dragging');
        if (pointerId !== null && splitter.releasePointerCapture) {
          try { splitter.releasePointerCapture(pointerId); } catch (_error) {}
        }
        pointerId = null;
      }

      window.addEventListener('pointerup', stopDragging);
      window.addEventListener('pointercancel', stopDragging);

      function syncSplitForViewport() {
        if (!isDesktopWidth()) {
          mainColumn.style.flexBasis = '';
          return;
        }
        applySplitPercent(loadSavedSplitPercent(), false);
      }

      syncSplitForViewport();
      window.addEventListener('resize', syncSplitForViewport);
    }

    resetVacancyHistorySortIcons('position');
    resetMemberHistorySortIcons('name');
    <%
      active_sidebar_panel_id = case @active_sidebar_tab
                                 when 'vacancies' then 'team-sidebar-vacancies-panel'
                                 when 'locked' then 'team-sidebar-locked-panel'
                                 else 'team-sidebar-members-panel'
                                 end
    %>
    switchTeamSidebarTab('<%= active_sidebar_panel_id %>');
    updateWorkforceOverviewCountBadge('<%= active_sidebar_panel_id %>');
    setupTeamDragAndDrop();
    setupTeamMemberToggles();
    setupTeamSplitLayout();
    initTeamMemberAddDatepickers();
    document.querySelectorAll('input[name="ta_move_mode"]').forEach(function(radio) {
      radio.addEventListener('change', teamManagementUpdateMoveDateDefault);
    });
    applyTeamHistoryPagination('vacancy', false);
    applyTeamHistoryPagination('member', true);
    switchTeamMainTab('<%= @active_main_tab == 'members' ? 'team-main-panel-members' : 'team-main-panel-structure' %>');
    setTimeout(function() { applyTeamHistoryPagination('member', true); }, 0);

    <% if @show_add_member_modal %>
      teamMembersOpenAddModal();
      <% if selected_add_member_team %>
        teamMembersSelectAddTeam('<%= selected_add_member_team.id %>', '<%= j(selected_add_member_team.name) %>');
      <% end %>
    <% end %>

    // Prevent default first-input autofocus from selecting the hiring title field on initial page load.
    function clearInitialHiringTitleFocus() {
      var hiringTitleInput = document.getElementById('ta_hiring_need_title');
      if (!hiringTitleInput) return;
      if (document.activeElement === hiringTitleInput) {
        hiringTitleInput.blur();
      }
    }
    setTimeout(clearInitialHiringTitleFocus, 0);
    setTimeout(clearInitialHiringTitleFocus, 100);

    // Keep initial server-rendered tab state to avoid first-paint layout mutation
  });
</script>
