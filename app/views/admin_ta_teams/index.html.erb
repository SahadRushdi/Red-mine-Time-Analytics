<% html_title 'Team Administration' %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Team Administration</h2>
      <p class="text-sm text-gray-500">Manage teams, members, vacancies, and hiring needs from one panel.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'New Team', new_admin_ta_team_path, class: 'ta-btn-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
      <%= link_to 'Settings', admin_ta_team_settings_path, class: 'inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50' %>
    </div>
  </div>

  <div id="ta-team-split-layout" class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <div id="ta-team-main-column" class="space-y-6 xl:col-span-2">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:flex xl:h-[700px] xl:flex-col">
        <div class="border-b border-gray-200 px-4 pt-2">
          <ul class="-mb-px flex flex-wrap text-sm font-medium text-center">
            <li class="me-2">
              <button type="button"
                      id="team-main-tab-structure"
                      data-team-main-tab-target="team-main-panel-structure"
                      class="ta-view-tab inline-block rounded-t-lg p-4 ta-view-tab-active">
                Team Structure
              </button>
            </li>
            <li class="me-2">
              <button type="button"
                      id="team-main-tab-members"
                      data-team-main-tab-target="team-main-panel-members"
                      class="ta-view-tab inline-block rounded-t-lg p-4 text-gray-500 hover:text-gray-600 hover:bg-gray-50">
                <span class="inline-flex items-center gap-2">
                  <span>All Members</span>
                  <span class="ts-tab-badge"><%= @member_history_groups.size %></span>
                </span>
              </button>
            </li>
          </ul>
        </div>

        <div id="team-main-panel-structure" class="max-h-[520px] overflow-y-scroll overflow-x-hidden p-4 ta-stable-scroll xl:h-full xl:max-h-none xl:flex-1 xl:min-h-0">
          <% if @all_teams.empty? %>
            <p class="text-sm text-gray-500">No teams found.</p>
          <% else %>
            <%= ta_team_tree(@root_teams, 0, @team_children_map, @team_active_member_counts, @team_open_hiring_counts, @team_active_memberships_map) %>
          <% end %>
        </div>

        <div id="team-main-panel-members" class="hidden xl:flex-1 xl:min-h-0">
          <div class="px-4 py-3 text-sm text-gray-500 flex items-center justify-between border-b border-gray-100">
            <span><%= @member_history_groups.size %> members with team assignments</span>
            <div class="relative w-full max-w-md">
              <input type="text" id="ta-member-history-search" placeholder="Search member, team, or role..."
                     class="ts-search-input !block !w-full !h-[44px] !rounded-lg !border !border-gray-300 !px-3 !text-sm !text-gray-900 !shadow-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]"
                     oninput="filterMemberHistoryRows()">
            </div>
          </div>

          <% if @member_history_groups.any? %>
            <div class="overflow-x-auto xl:flex-1 xl:min-h-0">
              <table class="ts-table w-full text-sm text-left">
                <thead class="bg-gray-50">
                  <tr class="border-b border-gray-200">
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Members</th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Start Date</th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">Last Updated</th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Details</th>
                  </tr>
                </thead>
                <tbody>
                  <% @member_history_groups.each_with_index do |group, idx| %>
                    <% user = group[:user] %>
                    <% latest_active_membership = group[:memberships].select(&:active?).max_by(&:start_date) %>
                    <% latest_any_membership = group[:memberships].max_by(&:start_date) %>
                    <% current_membership = latest_active_membership || latest_any_membership %>
                    <% current_role = current_membership&.role %>
                    <% member_start_date = current_membership&.start_date %>
                    <% role_label = current_role == 'lead' ? 'Team Lead' : 'Team Member' %>
                    <% role_classes = current_role == 'lead' ? 'border-indigo-200 bg-indigo-100 text-indigo-700' : 'border-slate-200 bg-slate-100 text-slate-700' %>
                    <% search_text = [
                      user.name,
                      group[:memberships].map { |m| m.team&.name.to_s }.join(' '),
                      group[:memberships].map(&:role).join(' ')
                    ].join(' ').downcase %>
                    <% modal_id = "ta-member-history-modal-#{idx}" %>
                    <tr class="ts-issue-row ta-member-history-group-row border-b border-gray-100 hover:bg-gray-50 transition-colors"
                        data-search-text="<%= h(search_text) %>">
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-semibold text-gray-900"><%= h(user.name) %></span>
                          <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium <%= role_classes %>"><%= role_label %></span>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-gray-600"><%= member_start_date ? format_date(member_start_date) : '—' %></td>
                      <td class="px-4 py-3 text-gray-500 text-sm"><%= group[:last_updated_on] ? "#{time_ago_in_words(group[:last_updated_on])} ago" : '—' %></td>
                      <td class="px-4 py-3 text-right">
                        <button type="button"
                                data-modal-target="<%= modal_id %>"
                                data-modal-toggle="<%= modal_id %>"
                                class="ta-member-details-btn"
                                title="View history">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12z"></path>
                          </svg>
                        </button>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <nav id="team-history-member-pagination" class="hidden px-4 py-3 border-t border-gray-200 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between" aria-label="All members pagination">
              <span id="team-history-member-pagination-info" class="text-sm text-gray-700"></span>
              <ul id="team-history-member-pagination-links" class="inline-flex -space-x-px text-sm h-8"></ul>
            </nav>
          <% else %>
            <div class="px-6 py-10 text-center text-sm text-gray-500">
              No member assignment history available.
            </div>
          <% end %>
        </div>
      </div>

      <% if @member_history_groups.any? %>
        <% @member_history_groups.each_with_index do |group, idx| %>
          <% user = group[:user] %>
          <% modal_id = "ta-member-history-modal-#{idx}" %>
          <div id="<%= modal_id %>" tabindex="-1" aria-hidden="true" class="ta-member-history-modal hidden fixed top-0 right-0 left-0 z-[9999] flex justify-center items-center w-full h-full bg-gray-900/50">
            <div class="relative p-4 w-full max-w-3xl max-h-full">
              <div class="relative bg-white rounded-lg shadow">
                <div class="flex items-start justify-between p-4 border-b rounded-t">
                  <h3 class="text-lg font-semibold text-gray-900"><%= h(user.name) %> · Team Assignment History</h3>
                  <button type="button"
                          data-modal-hide="<%= modal_id %>"
                          class="tep-delete-close text-gray-400 bg-transparent rounded-lg text-sm p-1.5 ml-auto inline-flex items-center">
                    <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Close modal</span>
                  </button>
                </div>
                <div class="p-4 max-h-[70vh] overflow-y-auto">
                  <table class="ts-table w-full text-sm text-left">
                    <thead class="bg-gray-50">
                      <tr class="border-b border-gray-200">
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Team</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Role</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Start Date</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">End Date</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% group[:memberships].each do |membership| %>
                        <% history_team_name = membership.team&.name.presence || 'Deleted Team' %>
                        <tr class="border-b border-gray-100 last:border-0">
                          <td class="px-3 py-2.5 text-gray-800"><%= h(history_team_name) %></td>
                          <td class="px-3 py-2.5">
                            <% if membership.lead? %>
                              <span class="inline-flex items-center rounded-md border border-indigo-200 bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Team Lead</span>
                            <% else %>
                              <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Team Member</span>
                            <% end %>
                          </td>
                          <td class="px-3 py-2.5 text-gray-600"><%= membership.start_date ? format_date(membership.start_date) : '—' %></td>
                          <td class="px-3 py-2.5 text-gray-600"><%= membership.end_date ? format_date(membership.end_date) : '—' %></td>
                          <td class="px-3 py-2.5">
                            <% if membership.active? %>
                              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Active</span>
                            <% else %>
                              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500"><span class="h-2 w-2 rounded-full bg-gray-300"></span>Inactive</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

    </div>

    <div id="ta-team-splitter-controls"
         class="hidden xl:flex"
         role="separator"
         aria-label="Resize panel widths"
         aria-orientation="vertical"
         title="Drag to resize panels">
      <span id="ta-team-splitter-handle" class="ta-team-splitter-handle" aria-hidden="true"></span>
    </div>

    <aside id="ta-team-sidebar-column">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:flex xl:h-[700px] xl:flex-col">
        <div class="border-b border-gray-200 px-4 pt-2">
          <ul class="-mb-px flex flex-wrap text-sm font-medium text-center">
            <li class="me-2">
              <button type="button" id="team-sidebar-members-tab" data-team-tab-target="team-sidebar-members-panel" class="ta-view-tab inline-block rounded-t-lg p-4 ta-view-tab-active">
                <span class="inline-flex items-center gap-2">
                  <span>Unallocated Members</span>
                  <span class="ts-tab-badge"><%= @unallocated_users.size %></span>
                </span>
              </button>
            </li>
            <li class="me-2">
              <button type="button" id="team-sidebar-vacancies-tab" data-team-tab-target="team-sidebar-vacancies-panel" class="ta-view-tab inline-block rounded-t-lg p-4 text-gray-500 hover:text-gray-600 hover:bg-gray-50">
                <span class="inline-flex items-center gap-2">
                  <span>Open Positions</span>
                  <span class="ts-tab-badge"><%= @open_hiring_needs.size %></span>
                </span>
              </button>
            </li>
          </ul>
        </div>

        <div id="team-sidebar-members-panel" class="p-4 xl:flex-1 xl:min-h-0">
          <div class="max-h-[680px] space-y-3 overflow-y-scroll overflow-x-hidden pr-1 ta-stable-scroll xl:h-full xl:max-h-none">
            <% if @unallocated_users.any? %>
              <% @unallocated_users.each_with_index do |user, idx| %>
                <div class="ta-unallocated-member-card rounded-lg border border-[#3b82f6] bg-blue-50/70 p-3"
                      draggable="true"
                      data-user-id="<%= user.id %>"
                      data-user-name="<%= h(user.name) %>"
                     data-default-role="member">
                  <button type="button"
                          class="ta-member-card-toggle w-full flex items-center justify-between gap-2 text-left"
                          onclick="event.stopPropagation(); toggleMemberAssignCard('<%= idx %>')">
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-gray-900"><%= h(user.name) %></span>
                      <span class="block text-xs text-gray-500"><%= h(user.mail) %></span>
                    </span>
                    <svg id="ta-member-assign-chevron-<%= idx %>" class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </button>
                  <div id="ta-member-assign-expand-<%= idx %>" class="hidden mt-2">
                  <%= form_tag assign_member_admin_ta_teams_path, method: :post, class: 'ta-inline-assignment-form grid grid-cols-[minmax(0,1fr)_160px_auto] items-end gap-2' do %>
                    <%= hidden_field_tag :user_id, user.id %>
                    <div class="relative min-w-0">
                      <button type="button" id="assign-team-button-<%= idx %>" data-ta-dropdown-toggle="assign-team-dropdown-<%= idx %>" class="inline-flex items-center justify-between w-full px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
                        <span class="assign-team-label truncate" data-default-text="Select team">Select team</span>
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                      <div id="assign-team-dropdown-<%= idx %>" data-ta-dropdown-menu="true" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
                        <ul class="max-h-48 overflow-y-auto overflow-x-hidden py-1 text-sm text-gray-700">
                          <% @all_teams.each do |team| %>
                            <li>
                              <button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="<%= team.id %>" data-ta-dropdown-label="<%= h(team.name) %>" data-ta-dropdown-target="assign_team_<%= idx %>" data-ta-dropdown-label-target="assign-team-button-<%= idx %>">
                                <%= h(team.name) %>
                              </button>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                      <%= hidden_field_tag :team_id, '', id: "assign_team_#{idx}", required: true %>
                    </div>

                    <div class="relative w-full">
                      <button type="button" id="assign-role-button-<%= idx %>" data-ta-dropdown-toggle="assign-role-dropdown-<%= idx %>" class="inline-flex items-center justify-between w-full px-4 py-2 text-sm font-medium !text-gray-900 !bg-white border border-gray-300 rounded-lg hover:!bg-gray-50 hover:!text-gray-900 focus:ring-2 focus:ring-[#3b82f6] focus:border-[#3b82f6] transition-colors">
                        <span class="assign-role-label" data-default-text="Team Member">Team Member</span>
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                      <div id="assign-role-dropdown-<%= idx %>" data-ta-dropdown-menu="true" class="hidden absolute z-10 mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
                        <ul class="py-1 text-sm text-gray-700">
                          <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="member" data-ta-dropdown-label="Team Member" data-ta-dropdown-target="assign_role_<%= idx %>" data-ta-dropdown-label-target="assign-role-button-<%= idx %>">Team Member</button></li>
                          <li><button type="button" class="w-full text-left px-4 py-2 hover:!bg-gray-100 hover:!text-gray-900 !text-gray-700" data-ta-dropdown-value="lead" data-ta-dropdown-label="Team Lead" data-ta-dropdown-target="assign_role_<%= idx %>" data-ta-dropdown-label-target="assign-role-button-<%= idx %>">Team Lead</button></li>
                        </ul>
                      </div>
                      <%= hidden_field_tag :role, 'member', id: "assign_role_#{idx}" %>
                    </div>

                    <%= submit_tag 'Add to Team', class: 'h-10 rounded-lg bg-blue-500 px-3 text-sm font-medium text-white hover:bg-blue-600 whitespace-nowrap' %>
                  <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No unallocated members.</p>
            <% end %>
          </div>
        </div>

        <div id="team-sidebar-vacancies-panel" class="hidden p-4 xl:flex-1 xl:min-h-0">
          <div class="space-y-2 xl:h-full xl:overflow-y-auto xl:overflow-x-hidden xl:pr-1 ta-stable-scroll">
            <% if @open_hiring_needs.any? %>
              <% @open_hiring_needs.each do |need| %>
                <% team_name = need.team&.name.presence || 'Deleted Team' %>
                <div class="rounded-lg border border-gray-200 p-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-gray-900"><%= h(need.position_title) %></p>
                      <p class="text-xs text-gray-500"><%= h(team_name) %></p>
                      <p class="mt-1 text-xs font-medium text-blue-700">Priority: <%= need.priority.titleize %></p>
                    </div>
                    <%= button_to mark_filled_admin_ta_hiring_need_path(need), method: :patch, class: 'ta-vacancy-action-button inline-flex items-center rounded-lg bg-emerald-700 px-3 py-2 text-center text-xs font-medium text-white hover:bg-emerald-800 focus:outline-none focus:ring-4 focus:ring-emerald-300', form_class: 'shrink-0' do %>
                      <svg class="mr-1.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Fill Hired
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No open positions.</p>
            <% end %>
          </div>
        </div>
      </div>
    </aside>
  </div>

</div>


<script type="text/javascript">
  function resetVacancyHistorySortIcons(activeColumn) {
    var columns = ['position', 'team', 'priority', 'status', 'opened', 'filled', 'duration'];
    columns.forEach(function(column) {
      var icon = document.getElementById('ta-vacancy-sort-icon-' + column);
      if (!icon) return;

      if (column !== activeColumn) {
        delete icon.dataset.order;
      }
      var order = icon.dataset.order || 'desc';
      icon.className = order === 'asc' ? 'sort asc icon icon-sorted-desc' : 'sort desc icon icon-sorted-asc';
    });
  }

  function toggleVacancyHistorySort(column) {
    var panel = document.getElementById('team-history-panel-vacancy');
    var tbody = panel ? panel.querySelector('table.ts-table tbody') : null;
    if (!tbody) return;

    var rows = Array.from(tbody.querySelectorAll('tr.ta-vacancy-row'));
    var sortIcon = document.getElementById('ta-vacancy-sort-icon-' + column);
    if (!sortIcon) return;

    var currentOrder = sortIcon.dataset.order || 'desc';
    var nextOrder = currentOrder === 'desc' ? 'asc' : 'desc';
    var numericColumns = ['priority', 'status', 'opened', 'filled', 'duration'];

    rows.sort(function(a, b) {
      var attrName = 'data-sort-' + column;
      var aValue = a.getAttribute(attrName) || '';
      var bValue = b.getAttribute(attrName) || '';

      if (numericColumns.indexOf(column) !== -1) {
        aValue = parseInt(aValue || '0', 10);
        bValue = parseInt(bValue || '0', 10);
        return nextOrder === 'asc' ? aValue - bValue : bValue - aValue;
      }

      var stringCompare = aValue.localeCompare(bValue);
      return nextOrder === 'asc' ? stringCompare : -stringCompare;
    });

    rows.forEach(function(row) { tbody.appendChild(row); });

    delete sortIcon.dataset.order;
    sortIcon.dataset.order = nextOrder;
    resetVacancyHistorySortIcons(column);
    applyTeamHistoryPagination('vacancy', true);
  }

  var teamHistoryPagination = {
    vacancy: { currentPage: 1, perPage: 10 },
    member: { currentPage: 1, perPage: 10 }
  };

  function teamHistoryCreatePageButton(config) {
    var li = document.createElement('li');
    var button = document.createElement('button');
    button.type = 'button';
    button.textContent = config.label;
    button.className = config.className;
    button.setAttribute('aria-label', config.ariaLabel || config.label);
    if (config.current) button.setAttribute('aria-current', 'page');
    if (config.disabled) {
      button.disabled = true;
    } else {
      button.addEventListener('click', config.onClick);
    }
    li.appendChild(button);
    return li;
  }

  function teamHistoryRenderPaginationControls(type, totalMatched, totalPages, startIndex, endIndex) {
    var nav = document.getElementById('team-history-' + type + '-pagination');
    var info = document.getElementById('team-history-' + type + '-pagination-info');
    var links = document.getElementById('team-history-' + type + '-pagination-links');
    if (!nav || !info || !links) return;

    if (totalMatched === 0) {
      nav.classList.add('hidden');
      info.textContent = '';
      links.innerHTML = '';
      return;
    }

    var state = teamHistoryPagination[type];
    nav.classList.remove('hidden');
    info.textContent = 'Showing ' + startIndex + '-' + endIndex + ' of ' + totalMatched + (type === 'vacancy' ? ' hiring requests' : ' members');
    links.innerHTML = '';

    var prevClass = 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 rounded-s-lg ' +
      (state.currentPage === 1
        ? 'text-gray-300 bg-gray-50 cursor-not-allowed'
        : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700');
    links.appendChild(teamHistoryCreatePageButton({
      label: 'Previous',
      ariaLabel: 'Previous page',
      className: prevClass,
      disabled: state.currentPage === 1,
      onClick: function() {
        state.currentPage -= 1;
        applyTeamHistoryPagination(type, true);
      }
    }));

    for (var page = 1; page <= totalPages; page++) {
      (function(pageNumber) {
        var isCurrent = pageNumber === state.currentPage;
        var pageClass = 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 ' +
          (isCurrent
            ? 'text-blue-600 bg-blue-50 hover:bg-blue-100 hover:text-blue-700'
            : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700');
        links.appendChild(teamHistoryCreatePageButton({
          label: String(pageNumber),
          ariaLabel: 'Page ' + pageNumber,
          className: pageClass,
          current: isCurrent,
          onClick: function() {
            state.currentPage = pageNumber;
            applyTeamHistoryPagination(type, true);
          }
        }));
      })(page);
    }

    var nextClass = 'flex items-center justify-center px-3 h-8 leading-tight border border-gray-300 rounded-e-lg ' +
      (state.currentPage === totalPages
        ? 'text-gray-300 bg-gray-50 cursor-not-allowed'
        : 'text-gray-500 bg-white hover:bg-gray-100 hover:text-gray-700');
    links.appendChild(teamHistoryCreatePageButton({
      label: 'Next',
      ariaLabel: 'Next page',
      className: nextClass,
      disabled: state.currentPage === totalPages,
      onClick: function() {
        state.currentPage += 1;
        applyTeamHistoryPagination(type, true);
      }
    }));
  }

  function teamHistoryGetRows(type) {
    if (type === 'vacancy') {
      return Array.from(document.querySelectorAll('#team-history-panel-vacancy .ta-vacancy-row'));
    }
    return Array.from(document.querySelectorAll('#team-main-panel-members .ta-member-history-group-row'));
  }

  function applyTeamHistoryPagination(type, preservePage) {
    var state = teamHistoryPagination[type];
    if (!state) return;

    var memberHistorySearchInput = document.getElementById('ta-member-history-search');
    var query = type === 'member'
      ? ((memberHistorySearchInput && memberHistorySearchInput.value) || '').toLowerCase().trim()
      : '';
    var rows = teamHistoryGetRows(type);
    var matchedRows = rows.filter(function(row) {
      var text = (row.getAttribute('data-search-text') || '').toLowerCase();
      return !query || text.indexOf(query) !== -1;
    });

    var totalPages = Math.max(1, Math.ceil(matchedRows.length / state.perPage));
    if (!preservePage) {
      state.currentPage = 1;
    } else if (state.currentPage > totalPages) {
      state.currentPage = totalPages;
    }

    var start = (state.currentPage - 1) * state.perPage;
    var end = start + state.perPage;
    var currentRows = matchedRows.slice(start, end);
    var visibleSet = new Set(currentRows);

    rows.forEach(function(row) {
      var shouldShow = visibleSet.has(row);
      row.style.display = shouldShow ? '' : 'none';
    });

    var startIndex = matchedRows.length ? (start + 1) : 0;
    var endIndex = matchedRows.length ? Math.min(end, matchedRows.length) : 0;
    teamHistoryRenderPaginationControls(type, matchedRows.length, totalPages, startIndex, endIndex);
  }

  function filterMemberHistoryRows() {
    applyTeamHistoryPagination('member', false);
  }

  function toggleMemberAssignCard(cardId) {
    var expand = document.getElementById('ta-member-assign-expand-' + cardId);
    var chevron = document.getElementById('ta-member-assign-chevron-' + cardId);
    if (!expand || !chevron) return;

    var willOpen = expand.classList.contains('hidden');
    expand.classList.toggle('hidden');
    chevron.style.transform = willOpen ? 'rotate(90deg)' : '';
  }

  function setupTeamDragAndDrop() {
    var memberCards = document.querySelectorAll('.ta-unallocated-member-card[data-user-id]');
    var teamDropzones = document.querySelectorAll('.ta-team-dropzone[data-team-id]');

    memberCards.forEach(function(card) {
      card.addEventListener('dragstart', function(event) {
        card.classList.add('ta-dragging');
        event.dataTransfer.effectAllowed = 'move';
        event.dataTransfer.setData('text/plain', JSON.stringify({
          userId: card.getAttribute('data-user-id'),
          userName: card.getAttribute('data-user-name') || '',
          role: card.getAttribute('data-default-role') || 'member'
        }));
      });

      card.addEventListener('dragend', function() {
        card.classList.remove('ta-dragging');
        document.querySelectorAll('.ta-team-dropzone.ta-dropzone-hover').forEach(function(zone) {
          zone.classList.remove('ta-dropzone-hover');
        });
      });
    });

    teamDropzones.forEach(function(zone) {
      zone.addEventListener('dragover', function(event) {
        event.preventDefault();
        event.dataTransfer.dropEffect = 'move';
        zone.classList.add('ta-dropzone-hover');
      });

      zone.addEventListener('dragenter', function(event) {
        event.preventDefault();
        zone.classList.add('ta-dropzone-hover');
      });

      zone.addEventListener('dragleave', function(event) {
        var related = event.relatedTarget;
        if (!related || !zone.contains(related)) {
          zone.classList.remove('ta-dropzone-hover');
        }
      });

      zone.addEventListener('drop', function(event) {
        event.preventDefault();
        zone.classList.remove('ta-dropzone-hover');

        var payloadRaw = event.dataTransfer.getData('text/plain');
        if (!payloadRaw) return;

        var payload;
        try {
          payload = JSON.parse(payloadRaw);
        } catch (_error) {
          return;
        }

        var userId = payload.userId;
        var teamId = zone.getAttribute('data-team-id');
        var role = payload.role || 'member';
        if (!userId || !teamId) return;

        var form = document.createElement('form');
        form.method = 'post';
        form.action = '<%= assign_member_admin_ta_teams_path %>';
        form.style.display = 'none';

        var tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = 'authenticity_token';
        tokenInput.value = '<%= form_authenticity_token %>';
        form.appendChild(tokenInput);

        var userInput = document.createElement('input');
        userInput.type = 'hidden';
        userInput.name = 'user_id';
        userInput.value = userId;
        form.appendChild(userInput);

        var teamInput = document.createElement('input');
        teamInput.type = 'hidden';
        teamInput.name = 'team_id';
        teamInput.value = teamId;
        form.appendChild(teamInput);

        var roleInput = document.createElement('input');
        roleInput.type = 'hidden';
        roleInput.name = 'role';
        roleInput.value = role;
        form.appendChild(roleInput);

        document.body.appendChild(form);
        form.submit();
      });
    });
  }

  function setupTeamMemberToggles() {
    document.querySelectorAll('[data-ta-member-toggle="true"]').forEach(function(button) {
      var targetId = button.getAttribute('data-collapse-toggle');
      if (!targetId) return;

      var target = document.getElementById(targetId);
      var icon = button.querySelector('[data-ta-member-toggle-icon="true"]');
      if (!target || !icon) return;

      function syncState() {
        var expanded = !target.classList.contains('hidden');
        button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        icon.style.transform = expanded ? 'rotate(90deg)' : '';
      }

      button.addEventListener('click', function() {
        setTimeout(syncState, 0);
      });

      syncState();
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    function closeAllDropdowns() {
      document.querySelectorAll('[data-ta-dropdown-menu="true"]').forEach(function(dropdown) {
        dropdown.classList.add('hidden');
      });
      document.querySelectorAll('[data-ta-hiring-team-menu="true"]').forEach(function(dropdown) {
        dropdown.classList.add('hidden');
      });
    }

    document.addEventListener('click', function(event) {
      var hiringToggleButton = event.target.closest('[data-ta-hiring-team-toggle]');
      if (hiringToggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var hiringDropdown = document.getElementById('ta-hiring-team-dropdown');
        if (!hiringDropdown) return;
        var isHidden = hiringDropdown.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) hiringDropdown.classList.remove('hidden');
        return;
      }

      var hiringOptionButton = event.target.closest('[data-ta-hiring-team-value]');
      if (hiringOptionButton) {
        event.preventDefault();
        var hiringValue = hiringOptionButton.getAttribute('data-ta-hiring-team-value');
        var hiringLabel = hiringOptionButton.getAttribute('data-ta-hiring-team-label');
        var hiringHiddenInput = document.getElementById('ta-hiring-need-team-id');
        var hiringButtonLabel = document.getElementById('ta-hiring-team-label');
        if (hiringHiddenInput) hiringHiddenInput.value = hiringValue;
        if (hiringButtonLabel) hiringButtonLabel.textContent = hiringLabel;
        closeAllDropdowns();
        return;
      }

      var toggleButton = event.target.closest('[data-ta-dropdown-toggle]');
      if (toggleButton) {
        event.preventDefault();
        event.stopPropagation();
        var dropdownId = toggleButton.getAttribute('data-ta-dropdown-toggle');
        var dropdown = document.getElementById(dropdownId);
        if (!dropdown) return;
        var isHidden = dropdown.classList.contains('hidden');
        closeAllDropdowns();
        if (isHidden) dropdown.classList.remove('hidden');
        return;
      }

      var optionButton = event.target.closest('[data-ta-dropdown-target]');
      if (optionButton) {
        event.preventDefault();
        var value = optionButton.getAttribute('data-ta-dropdown-value');
        var label = optionButton.getAttribute('data-ta-dropdown-label');
        var targetId = optionButton.getAttribute('data-ta-dropdown-target');
        var buttonId = optionButton.getAttribute('data-ta-dropdown-label-target');
        var hiddenInput = document.getElementById(targetId);
        var button = document.getElementById(buttonId);
        if (hiddenInput) hiddenInput.value = value;
        if (button) {
          var labelEl = button.querySelector('span');
          if (labelEl) labelEl.textContent = label;
        }
        closeAllDropdowns();
        return;
      }

      closeAllDropdowns();
    });

    document.addEventListener('submit', function(event) {
      if (!event.target.classList.contains('ta-inline-assignment-form')) return;
      var teamField = event.target.querySelector('input[name="team_id"]');
      if (!teamField || !teamField.value) {
        event.preventDefault();
        alert('Please select a team.');
      }
    }, true);

    function switchTeamSidebarTab(targetPanelId) {
      var tabs = [
        { tab: document.getElementById('team-sidebar-members-tab'), panel: document.getElementById('team-sidebar-members-panel') },
        { tab: document.getElementById('team-sidebar-vacancies-tab'), panel: document.getElementById('team-sidebar-vacancies-panel') }
      ];

      tabs.forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) {
          item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        } else {
          item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        }
      });
      updateWorkforceOverviewCountBadge(targetPanelId);
    }

    function updateWorkforceOverviewCountBadge(activePanelId) {
      var badge = document.getElementById('workforce-overview-count-badge');
      if (!badge) return;
      if (activePanelId === 'team-sidebar-vacancies-panel') {
        badge.textContent = '<%= @open_hiring_needs.size %> open positions';
      } else {
        badge.textContent = '<%= @unallocated_users.size %> unallocated';
      }
    }

    document.querySelectorAll('[data-team-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchTeamSidebarTab(tabButton.getAttribute('data-team-tab-target'));
      });
    });

    function switchTeamMainTab(targetPanelId) {
      var tabs = [
        { tab: document.getElementById('team-main-tab-structure'), panel: document.getElementById('team-main-panel-structure') },
        { tab: document.getElementById('team-main-tab-members'), panel: document.getElementById('team-main-panel-members') }
      ];

      tabs.forEach(function(item) {
        if (!item.tab || !item.panel) return;
        var active = item.panel.id === targetPanelId;
        item.panel.classList.toggle('hidden', !active);
        item.tab.classList.toggle('ta-view-tab-active', active);
        if (active) {
          item.tab.classList.remove('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        } else {
          item.tab.classList.add('text-gray-500', 'hover:text-gray-600', 'hover:bg-gray-50');
        }
      });
    }

    document.querySelectorAll('[data-team-main-tab-target]').forEach(function(tabButton) {
      tabButton.addEventListener('click', function() {
        switchTeamMainTab(tabButton.getAttribute('data-team-main-tab-target'));
      });
    });

    function setupTeamSplitLayout() {
      var splitLayout = document.getElementById('ta-team-split-layout');
      var mainColumn = document.getElementById('ta-team-main-column');
      var splitter = document.getElementById('ta-team-splitter-controls');
      if (!splitLayout || !mainColumn || !splitter) return;

      var SPLIT_STORAGE_KEY = 'taTeamSplitLeftPercent';
      var DEFAULT_LEFT_PERCENT = 64;
      var MIN_LEFT_PERCENT = 22;
      var MAX_LEFT_PERCENT = 78;
      var dragging = false;
      var pointerId = null;
      var mediaQuery = window.matchMedia('(min-width: 1280px)');

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function isDesktopWidth() {
        return mediaQuery.matches;
      }

      function applySplitPercent(percent, persist) {
        var safePercent = clamp(percent, MIN_LEFT_PERCENT, MAX_LEFT_PERCENT);
        mainColumn.style.flexBasis = safePercent + '%';
        if (persist && window.sessionStorage) {
          sessionStorage.setItem(SPLIT_STORAGE_KEY, String(safePercent));
        }
      }

      function loadSavedSplitPercent() {
        var saved = window.sessionStorage ? sessionStorage.getItem(SPLIT_STORAGE_KEY) : null;
        var parsed = parseFloat(saved);
        if (Number.isNaN(parsed)) return DEFAULT_LEFT_PERCENT;
        return clamp(parsed, MIN_LEFT_PERCENT, MAX_LEFT_PERCENT);
      }

      function updateSplitFromPointer(clientX, persist) {
        var rect = splitLayout.getBoundingClientRect();
        if (!rect.width) return;
        var percent = ((clientX - rect.left) / rect.width) * 100;
        applySplitPercent(percent, persist);
      }

      splitter.addEventListener('pointerdown', function(event) {
        if (!isDesktopWidth()) return;
        dragging = true;
        pointerId = event.pointerId;
        splitter.classList.add('is-dragging');
        document.body.classList.add('ta-team-split-dragging');
        if (splitter.setPointerCapture) splitter.setPointerCapture(pointerId);
        event.preventDefault();
      });

      window.addEventListener('pointermove', function(event) {
        if (!dragging || !isDesktopWidth()) return;
        if (pointerId !== null && event.pointerId !== pointerId) return;
        updateSplitFromPointer(event.clientX, true);
      });

      function stopDragging(event) {
        if (!dragging) return;
        if (event && pointerId !== null && event.pointerId !== pointerId) return;
        dragging = false;
        splitter.classList.remove('is-dragging');
        document.body.classList.remove('ta-team-split-dragging');
        if (pointerId !== null && splitter.releasePointerCapture) {
          try { splitter.releasePointerCapture(pointerId); } catch (_error) {}
        }
        pointerId = null;
      }

      window.addEventListener('pointerup', stopDragging);
      window.addEventListener('pointercancel', stopDragging);

      function syncSplitForViewport() {
        if (!isDesktopWidth()) {
          mainColumn.style.flexBasis = '';
          return;
        }
        applySplitPercent(loadSavedSplitPercent(), false);
      }

      syncSplitForViewport();
      window.addEventListener('resize', syncSplitForViewport);
    }

    resetVacancyHistorySortIcons('position');
    updateWorkforceOverviewCountBadge('team-sidebar-members-panel');
    setupTeamDragAndDrop();
    setupTeamMemberToggles();
    setupTeamSplitLayout();
    applyTeamHistoryPagination('vacancy', false);
    applyTeamHistoryPagination('member', false);

    // Prevent default first-input autofocus from selecting the hiring title field on initial page load.
    function clearInitialHiringTitleFocus() {
      var hiringTitleInput = document.getElementById('ta_hiring_need_position_title');
      if (!hiringTitleInput) return;
      if (document.activeElement === hiringTitleInput) {
        hiringTitleInput.blur();
      }
    }
    setTimeout(clearInitialHiringTitleFocus, 0);
    setTimeout(clearInitialHiringTitleFocus, 100);

    // Keep initial server-rendered tab state to avoid first-paint layout mutation
  });
</script>
