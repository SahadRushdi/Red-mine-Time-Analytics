<% html_title 'Teams' %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'flowbite.min.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'tailwind.output.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'time_analytics.css', plugin: 'redmine_time_analytics' %>
  <%= stylesheet_link_tag 'team_management.css', plugin: 'redmine_time_analytics' %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <%= javascript_include_tag 'flowbite.min.js', plugin: 'redmine_time_analytics' %>
<% end %>

<div class="space-y-6">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="!mb-1 text-2xl font-bold text-gray-900">Teams</h2>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to 'New Team', new_admin_ta_team_path, class: 'ta-btn-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium' %>
      <%= link_to 'Settings', admin_ta_team_settings_path, class: 'inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50' %>
    </div>
  </div>

  <div id="ta-team-split-layout" class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <div id="ta-team-main-column" class="space-y-6 xl:col-span-2">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:flex ta-team-xl-h-780 xl:flex-col">
        <div class="border-b border-gray-200 px-4 pt-2">
          <ul class="-mb-px flex flex-wrap text-sm font-medium text-center">
            <li class="me-2">
              <button type="button"
                      id="team-main-tab-structure"
                      data-team-main-tab-target="team-main-panel-structure"
                      class="ta-view-tab inline-block rounded-t-lg p-4 <%= @active_main_tab == 'structure' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50' %>">
                <span class="inline-flex items-center gap-2">
                  <svg class="h-4 w-4 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="5" r="2"></circle>
                    <circle cx="6" cy="19" r="2"></circle>
                    <circle cx="18" cy="19" r="2"></circle>
                    <path d="M12 7v8M12 13H7.5M12 13H16.5"></path>
                  </svg>
                  <span>Team Structure</span>
                </span>
              </button>
            </li>
            <li class="me-2">
              <button type="button"
                      id="team-main-tab-members"
                      data-team-main-tab-target="team-main-panel-members"
                      class="ta-view-tab inline-block rounded-t-lg p-4 <%= @active_main_tab == 'members' ? 'ta-view-tab-active' : 'text-gray-500 hover:text-gray-600 hover:bg-gray-50' %>">
                <span class="inline-flex items-center gap-2">
                  <svg class="h-4 w-4 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M17 20a4 4 0 0 0-8 0"></path>
                    <path d="M12 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z"></path>
                    <path d="M19 20a6 6 0 0 0-2-4.47"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                  <span>Members</span>
                  <span class="ts-tab-badge"><%= @member_history_groups.size %></span>
                </span>
              </button>
            </li>
          </ul>
        </div>

        <div id="team-main-panel-structure" class="ta-team-sidebar-panel <%= 'hidden' unless @active_main_tab == 'structure' %> max-h-[570px] ta-team-xl-max-h-760 overflow-y-scroll overflow-x-hidden p-4 ta-stable-scroll xl:flex-1 xl:min-h-0">
          <% if @all_teams.empty? %>
            <p class="text-sm text-gray-500">No teams found.</p>
          <% else %>
            <%= ta_team_tree(@root_teams, 0, @team_children_map, @team_active_member_counts, @team_open_hiring_counts, @team_active_memberships_map) %>
          <% end %>
        </div>

        <div id="team-main-panel-members" class="ta-team-sidebar-panel <%= 'hidden' unless @active_main_tab == 'members' %> xl:flex-1 xl:min-h-0">
          <div class="px-4 py-3 text-sm text-gray-500 flex items-center justify-between border-b border-gray-100">
            <span><%= @member_history_groups.size %> members with team assignments</span>
            <div class="relative w-full max-w-md">
              <input type="text" id="ta-member-history-search" placeholder="Search member, team, or role..."
                     class="ts-search-input !block !w-full !h-[44px] !rounded-lg !border !border-gray-300 !px-3 !text-sm !text-gray-900 !shadow-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]"
                     oninput="filterMemberHistoryRows()">
            </div>
          </div>

          <% if @member_history_groups.any? %>
            <div class="overflow-x-auto overflow-y-auto pb-4 xl:flex-1 xl:min-h-0">
              <table class="ts-table w-full text-sm text-left">
                <thead class="bg-gray-50">
                  <tr class="border-b border-gray-200">
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                      <span role="button" tabindex="0" onclick="toggleMemberHistorySort('name'); this.blur();"
                            onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleMemberHistorySort('name'); }"
                            class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                        <span>Members</span>
                        <span id="ta-member-history-sort-icon-name" class="sort desc icon icon-sorted-asc"></span>
                      </span>
                    </th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                      <span role="button" tabindex="0" onclick="toggleMemberHistorySort('team'); this.blur();"
                            onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleMemberHistorySort('team'); }"
                            class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                        <span>Team</span>
                        <span id="ta-member-history-sort-icon-team" class="sort desc icon icon-sorted-asc"></span>
                      </span>
                    </th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                      <span role="button" tabindex="0" onclick="toggleMemberHistorySort('start-date'); this.blur();"
                            onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleMemberHistorySort('start-date'); }"
                            class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                        <span>Start Date</span>
                        <span id="ta-member-history-sort-icon-start-date" class="sort desc icon icon-sorted-asc"></span>
                      </span>
                    </th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide">
                      <span role="button" tabindex="0" onclick="toggleMemberHistorySort('last-updated'); this.blur();"
                            onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); toggleMemberHistorySort('last-updated'); }"
                            class="inline-flex items-center gap-1 cursor-pointer text-gray-600 hover:text-gray-900 focus:outline-none">
                        <span>Last Updated</span>
                        <span id="ta-member-history-sort-icon-last-updated" class="sort desc icon icon-sorted-asc"></span>
                      </span>
                    </th>
                    <th class="px-4 py-2.5 text-sm font-semibold text-gray-600 tracking-wide text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @member_history_groups.each_with_index do |group, idx| %>
                    <% user = group[:user] %>
                    <% latest_active_membership = group[:memberships].select(&:active?).max_by(&:start_date) %>
                    <% latest_any_membership = group[:memberships].max_by(&:start_date) %>
                    <% current_membership = latest_active_membership || latest_any_membership %>
                    <% current_role = current_membership&.role %>
                    <% current_team = current_membership&.team %>
                    <% member_start_date = current_membership&.start_date %>
                    <% role_label = current_role == 'lead' ? 'Team Lead' : 'Team Member' %>
                    <% role_classes = current_role == 'lead' ? 'border-indigo-200 bg-indigo-100 text-indigo-700' : 'border-slate-200 bg-slate-100 text-slate-700' %>
                    <% search_text = [
                      user.name,
                      group[:memberships].map { |m| m.team&.name.to_s }.join(' '),
                      group[:memberships].map(&:role).join(' ')
                    ].join(' ').downcase %>
                    <% modal_id = "ta-member-history-modal-#{idx}" %>
                    <% form_id = current_membership ? "ta-member-history-form-#{current_membership.id}" : nil %>
                    <% last_updated_on = group[:last_updated_on] %>
                    <tr class="ts-issue-row ta-member-history-group-row border-b border-gray-100 hover:bg-gray-50"
                        data-search-text="<%= h(search_text) %>"
                        data-membership-id="<%= current_membership&.id %>"
                        data-sort-name="<%= user.name.to_s.downcase %>"
                        data-sort-team="<%= current_team&.name.to_s.downcase %>"
                        data-sort-start-date="<%= member_start_date ? member_start_date.to_time.to_i : 0 %>"
                        data-sort-last-updated="<%= last_updated_on ? last_updated_on.to_i : 0 %>">
                      <td class="px-4 py-3">
                        <div class="ta-team-member-view flex items-center gap-2">
                          <span class="text-sm font-semibold text-gray-900"><%= h(user.name) %></span>
                          <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium <%= role_classes %>"><%= role_label %></span>
                        </div>
                        <% if current_membership %>
                          <div class="ta-team-member-edit hidden tep-inline-form">
                            <div class="relative inline-flex w-full max-w-[11rem]" id="ta-team-member-role-wrapper-<%= current_membership.id %>">
                              <button type="button"
                                      id="ta-team-member-role-btn-<%= current_membership.id %>"
                                      onclick="toggleTeamMemberRoleDropdown(<%= current_membership.id %>)"
                                      class="tep-field ta-team-role-button flex items-center justify-between gap-2 text-sm px-3 !border !border-gray-300 !rounded-lg !bg-white w-full text-left whitespace-nowrap !outline-none !shadow-none !ring-0">
                                <span id="ta-team-member-role-text-<%= current_membership.id %>" class="text-gray-700 truncate flex-1"><%= current_membership.lead? ? 'Team Lead' : 'Team Member' %></span>
                                <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                              </button>
                              <input type="hidden"
                                     name="ta_team_membership[role]"
                                     id="ta-team-member-role-<%= current_membership.id %>"
                                     value="<%= current_membership.role %>"
                                     form="<%= form_id %>">
                              <div id="ta-team-member-role-list-<%= current_membership.id %>"
                                   class="tep-activity-dropdown ta-team-role-dropdown hidden absolute left-0 z-[9999] bg-white border border-gray-200 rounded-lg shadow-xl"
                                   style="top: calc(100% + 2px);">
                                <button type="button"
                                        class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                        onclick="teamMembersSelectRole(<%= current_membership.id %>, 'member', 'Team Member')">
                                  Team Member
                                </button>
                                <button type="button"
                                        class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                        onclick="teamMembersSelectRole(<%= current_membership.id %>, 'lead', 'Team Lead')">
                                  Team Lead
                                </button>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </td>
                      <td class="px-4 py-3 text-gray-600"><%= current_team ? h(current_team.name) : '—' %></td>
                      <td class="px-4 py-3 text-gray-600">
                        <div class="ta-team-member-view"><%= member_start_date ? format_date(member_start_date) : '—' %></div>
                        <% if current_membership %>
                          <div class="ta-team-member-edit hidden tep-inline-form">
                            <input type="text"
                                   id="ta-team-member-start-date-<%= current_membership.id %>"
                                   name="ta_team_membership[start_date]"
                                   form="<%= form_id %>"
                                   value="<%= member_start_date ? member_start_date.strftime('%m/%d/%Y') : '' %>"
                                   autocomplete="off"
                                   placeholder="mm/dd/yyyy"
                                   datepicker
                                   datepicker-format="mm/dd/yyyy"
                                   datepicker-autohide
                                   class="tep-field ta-date-input text-sm px-3 py-2 border border-gray-300 rounded-lg bg-white flex-shrink-0 w-36">
                          </div>
                        <% end %>
                      </td>
                      <td class="px-4 py-3 text-gray-500 text-sm"><%= last_updated_on ? "#{time_ago_in_words(last_updated_on)} ago" : '—' %></td>
                      <td class="px-4 py-3 text-right">
                        <div class="ta-team-member-view inline-flex items-center justify-end gap-1">
                          <button type="button"
                                  data-modal-target="<%= modal_id %>"
                                  data-modal-toggle="<%= modal_id %>"
                                  class="ta-member-details-btn"
                                  title="View history"
                                  aria-label="View history">
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7S3.732 16.057 2.458 12z"></path>
                            </svg>
                          </button>
                          <% if current_membership && current_team %>
                            <button type="button"
                                    onclick="event.stopPropagation(); this.blur(); toggleTeamMemberInlineEdit(<%= current_membership.id %>)"
                                    class="ta-inline-icon-btn"
                                    title="Edit"
                                    aria-label="Edit member">
                              <span class="material-icons ta-inline-material-icon">edit</span>
                            </button>
                            <button type="button"
                                    onclick="event.stopPropagation(); this.blur(); teamMembersDelete(<%= current_membership.id %>, '<%= admin_ta_team_membership_path(current_team, current_membership) %>', '<%= form_authenticity_token %>', 'members')"
                                    class="ta-inline-icon-btn ta-inline-icon-btn--danger"
                                    title="Delete"
                                    aria-label="Delete member">
                              <span class="material-icons ta-inline-material-icon">delete</span>
                            </button>
                          <% end %>
                        </div>
                        <% if current_membership %>
                          <div class="ta-team-member-edit hidden inline-flex items-center justify-end gap-2">
                            <button type="submit"
                                    form="<%= form_id %>"
                                    class="ta-btn-primary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Save</button>
                            <button type="button"
                                    onclick="event.stopPropagation(); this.blur(); toggleTeamMemberInlineEdit(<%= current_membership.id %>)"
                                    class="ta-btn-secondary inline-flex items-center rounded-lg px-3 py-1.5 text-xs font-medium">Cancel</button>
                          </div>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="hidden">
              <% @member_history_groups.each do |group| %>
                <% current_membership = group[:memberships].select(&:active?).max_by(&:start_date) || group[:memberships].max_by(&:start_date) %>
                <% next unless current_membership && current_membership.team %>
                <% form_id = "ta-member-history-form-#{current_membership.id}" %>
                <%= form_tag admin_ta_team_membership_path(current_membership.team, current_membership), method: :patch, id: form_id, onsubmit: "return submitTeamMemberInlineEdit(#{current_membership.id})" do %>
                  <%= hidden_field_tag :main_tab, 'members', form: form_id, id: "ta-member-history-main-tab-#{current_membership.id}" %>
                  <%= hidden_field_tag :sidebar_tab, nil, form: form_id, id: "ta-member-history-sidebar-tab-#{current_membership.id}" %>
                  <%= hidden_field_tag :page, nil, form: form_id, id: "ta-member-history-page-#{current_membership.id}" %>
                <% end %>
              <% end %>
            </div>
            <nav id="team-history-member-pagination" class="hidden px-4 py-3 border-t border-gray-200 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between" aria-label="Members pagination">
              <span id="team-history-member-pagination-info" class="text-sm text-gray-700"></span>
              <ul id="team-history-member-pagination-links" class="inline-flex -space-x-px text-sm h-8"></ul>
            </nav>
          <% else %>
            <div class="px-6 py-10 text-center text-sm text-gray-500">
              No member assignment history available.
            </div>
          <% end %>
        </div>
      </div>

      <% if @member_history_groups.any? %>
        <% @member_history_groups.each_with_index do |group, idx| %>
          <% user = group[:user] %>
          <% modal_id = "ta-member-history-modal-#{idx}" %>
          <div id="<%= modal_id %>" tabindex="-1" aria-hidden="true" class="ta-member-history-modal hidden fixed top-0 right-0 left-0 z-[9999] flex justify-center items-center w-full h-full bg-gray-900/50">
            <div class="relative p-4 w-full max-w-3xl max-h-full">
              <div class="relative bg-white rounded-lg shadow">
                <div class="flex items-start justify-between p-4 border-b rounded-t">
                  <h3 class="text-lg font-semibold text-gray-900"><%= h(user.name) %> · Team Assignment History</h3>
                  <button type="button"
                          data-modal-hide="<%= modal_id %>"
                          class="tep-delete-close text-gray-400 bg-transparent rounded-lg text-sm p-1.5 ml-auto inline-flex items-center">
                    <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Close modal</span>
                  </button>
                </div>
                <div class="p-4 max-h-[70vh] overflow-y-auto">
                  <table class="ts-table w-full text-sm text-left">
                    <thead class="bg-gray-50">
                      <tr class="border-b border-gray-200">
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Team</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Role</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Start Date</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">End Date</th>
                        <th class="px-3 py-2 text-xs font-semibold text-gray-500 text-left">Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% group[:memberships].each do |membership| %>
                        <% history_team_name = membership.team&.name.presence || 'Deleted Team' %>
                        <tr class="border-b border-gray-100 last:border-0">
                          <td class="px-3 py-2.5 text-gray-800"><%= h(history_team_name) %></td>
                          <td class="px-3 py-2.5">
                            <% if membership.lead? %>
                              <span class="inline-flex items-center rounded-md border border-indigo-200 bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Team Lead</span>
                            <% else %>
                              <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">Team Member</span>
                            <% end %>
                          </td>
                          <td class="px-3 py-2.5 text-gray-600"><%= membership.start_date ? format_date(membership.start_date) : '—' %></td>
                          <td class="px-3 py-2.5 text-gray-600"><%= membership.end_date ? format_date(membership.end_date) : '—' %></td>
                          <td class="px-3 py-2.5">
                            <% if membership.active? %>
                              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600"><span class="h-2 w-2 rounded-full bg-emerald-400"></span>Active</span>
                            <% else %>
                              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500"><span class="h-2 w-2 rounded-full bg-gray-300"></span>Inactive</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <% selected_add_member_team = @all_teams.find { |team| team.id.to_s == @selected_add_member_team_id.to_s } %>
      <div id="taTeamMembersAddModal" tabindex="-1" aria-hidden="true" class="hidden fixed inset-0 z-[10000] flex items-start justify-center overflow-y-auto bg-gray-900/50 p-4 sm:items-center">
        <div class="relative w-full max-w-3xl">
          <div class="relative bg-white rounded-lg shadow">
            <div class="flex items-start justify-between p-4 border-b rounded-t">
              <div>
                <h3 class="text-xl font-semibold text-gray-900">Add Team Member</h3>
                <p id="ta-add-team-member-team-hint" class="text-xs text-gray-500 mt-1">Select a team and member to create the assignment.</p>
              </div>
              <button type="button"
                      onclick="teamMembersCloseAddModal()"
                      class="tep-delete-close text-gray-400 bg-transparent rounded-lg text-sm p-1.5 ml-auto inline-flex items-center">
                <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                <span class="sr-only">Close modal</span>
              </button>
            </div>

            <div class="p-4 md:p-6 overflow-visible">
              <form id="ta-team-member-modal-form"
                    action=""
                    method="post"
                    class="space-y-6"
                    data-create-path-base="<%= admin_ta_team_memberships_path(0) %>"
                    onsubmit="return submitTeamMemberAddForm()">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <%= hidden_field_tag :main_tab, @active_main_tab.presence || 'structure' %>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                  <div class="md:col-span-2">
                    <%= label_tag :ta_add_team_member_team_search, 'Team', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
                    <div class="relative min-w-0" id="ta-add-team-member-team-wrapper">
                      <input type="text"
                             id="ta-add-team-member-team-search"
                             value="<%= selected_add_member_team ? h(selected_add_member_team.name) : '' %>"
                             placeholder="Select team... *"
                             autocomplete="off"
                             onclick="teamMembersOpenAddTeamDropdown()"
                             oninput="teamMembersFilterAddTeams()"
                             onkeydown="teamMembersHandleAddTeamKey(event)"
                             class="ta-team-settings-member-input block h-[34px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900"
                             required>
                      <%= hidden_field_tag 'ta_team_membership[team_id]', @selected_add_member_team_id, id: 'ta-add-team-member-team-id' %>
                      <div id="ta-add-team-member-team-list"
                           class="tep-issue-dropdown hidden absolute left-0 z-[10050] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                           style="min-width: 320px; max-height: 220px; top: calc(100% + 2px);">
                        <% ta_teams_in_tree_order(@all_teams).each do |team, level| %>
                          <% indent = '&nbsp;&nbsp;' * level %>
                          <div class="tep-issue-option px-3 py-2 text-sm cursor-pointer flex items-start gap-2 border-b border-gray-50 last:border-0"
                               tabindex="0"
                               data-id="<%= team.id %>"
                               data-text="<%= h(team.name) %>"
                               data-search="<%= team.name.downcase %>"
                               onclick="teamMembersSelectAddTeam('<%= team.id %>', '<%= j(team.name) %>')"
                               onkeydown="teamMembersHandleAddTeamOptionKey(event, '<%= team.id %>', '<%= j(team.name) %>')">
                            <span class="text-gray-700 leading-relaxed"><%= indent.html_safe %><%= h(team.name) %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-2">
                    <%= label_tag :ta_team_membership_user_search_modal, 'User', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
                    <div class="relative min-w-0" id="ta-add-team-member-user-wrapper">
                      <input type="text"
                             id="ta-add-team-member-user-search"
                             placeholder="Search member... *"
                             autocomplete="off"
                             onclick="teamMembersOpenAddUserDropdown()"
                             oninput="teamMembersFilterAddUsers()"
                             onkeydown="teamMembersHandleAddUserKey(event)"
                             class="ta-team-settings-member-input block h-[34px] w-full rounded-lg border border-gray-300 bg-white px-3 text-sm text-gray-900"
                             required>
                      <%= hidden_field_tag 'ta_team_membership[user_id]', nil, id: 'ta-add-team-member-user-id' %>
                      <div id="ta-add-team-member-user-list"
                           class="tep-issue-dropdown hidden absolute left-0 z-[10050] bg-white border border-gray-200 rounded-lg shadow-xl overflow-y-auto"
                           style="min-width: 320px; max-height: 220px; top: calc(100% + 2px);">
                        <% @add_member_available_users.each do |user| %>
                          <% user_text = "#{user.name} (#{user.mail})" %>
                          <div class="tep-issue-option px-3 py-2 text-sm cursor-pointer flex items-start gap-2 border-b border-gray-50 last:border-0"
                               tabindex="0"
                               data-id="<%= user.id %>"
                               data-text="<%= j(user_text) %>"
                               data-search="<%= j("#{user.name} #{user.mail}".downcase) %>"
                               onclick="teamMembersSelectAddUser('<%= user.id %>', this.getAttribute('data-text'))"
                               onkeydown="teamMembersHandleAddUserOptionKey(event, '<%= user.id %>', this.getAttribute('data-text'))">
                            <span class="text-gray-700 leading-relaxed"><%= h(user.name) %> <span class="text-gray-400">(<%= h(user.mail) %>)</span></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <div class="md:col-span-2">
                    <%= label_tag :ta_add_team_member_role, 'Role', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
                    <div class="relative" id="ta-add-team-member-role-wrapper">
                      <button type="button"
                              id="ta-add-team-member-role-btn"
                              onclick="teamMembersToggleAddRoleDropdown()"
                              onkeydown="teamMembersHandleAddRoleTriggerKey(event)"
                              class="ts-search-input !inline-flex !h-[43px] !w-full !items-center !justify-between !rounded-lg !border !border-gray-300 !bg-white !px-3 !text-sm !font-medium !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]">
                        <span id="ta-add-team-member-role-text" class="text-gray-700 truncate flex-1 text-left"><%= @add_member_membership.role == 'lead' ? 'Team Lead' : 'Team Member' %></span>
                        <svg class="h-4 w-4 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                      </button>
                      <%= hidden_field_tag 'ta_team_membership[role]', @add_member_membership.role, id: 'ta-add-team-member-role-value' %>
                      <div id="ta-add-team-member-role-list"
                           class="tep-activity-dropdown hidden absolute z-[10050] mt-1 w-full bg-white border border-gray-300 rounded-lg shadow-xl py-1">
                        <ul class="max-h-60 overflow-auto py-1 text-sm text-gray-700">
                          <li>
                            <button type="button"
                                    class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                    onclick="teamMembersSelectAddRole('member', 'Team Member')"
                                    onkeydown="teamMembersHandleAddRoleOptionKey(event, 'member', 'Team Member')">
                              Team Member
                            </button>
                          </li>
                          <li>
                            <button type="button"
                                    class="tep-activity-option w-full text-left px-4 py-2 text-sm !text-gray-700 hover:!bg-gray-100 hover:!text-gray-900"
                                    onclick="teamMembersSelectAddRole('lead', 'Team Lead')"
                                    onkeydown="teamMembersHandleAddRoleOptionKey(event, 'lead', 'Team Lead')">
                              Team Lead
                            </button>
                          </li>
                        </ul>
                      </div>
                    </div>
                    <p class="mt-1 text-xs text-gray-500">Team leads can view team analytics.</p>
                  </div>

                  <div>
                    <%= label_tag :ta_add_team_member_start_date, 'Start Date', class: 'mb-1 block text-sm font-medium text-gray-700 required' %>
                    <%= text_field_tag 'ta_team_membership[start_date]',
                                       (@add_member_membership.start_date || Date.current).strftime('%m/%d/%Y'),
                                       id: 'ta-add-team-member-start-date',
                                       autocomplete: 'off',
                                       placeholder: 'mm/dd/yyyy',
                                       required: true,
                                       datepicker: true,
                                       'datepicker-format': 'mm/dd/yyyy',
                                       'datepicker-autohide': true,
                                       class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
                  </div>

                  <div>
                    <%= label_tag :ta_add_team_member_end_date, 'End Date', class: 'mb-1 block text-sm font-medium text-gray-700' %>
                    <%= text_field_tag 'ta_team_membership[end_date]',
                                       '',
                                       id: 'ta-add-team-member-end-date',
                                       autocomplete: 'off',
                                       placeholder: 'mm/dd/yyyy',
                                       datepicker: true,
                                       'datepicker-format': 'mm/dd/yyyy',
                                       'datepicker-autohide': true,
                                       class: 'ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]' %>
                    <p class="mt-1 text-xs text-gray-500">Leave empty for active members.</p>
                  </div>
                </div>

                <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-100 pt-4">
                  <button type="button"
                          onclick="teamMembersCloseAddModal()"
                          class="ta-btn-secondary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">
                    <%= l(:button_cancel) %>
                  </button>
                  <button type="submit"
                          class="ta-btn-save-primary inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium">Create</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>

      <div id="taTeamMembersDeleteModal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 right-0 left-0 z-[9999] justify-center items-center w-full h-full bg-gray-900/50">
        <div class="relative p-4 w-full max-w-md">
          <div class="relative p-4 text-center bg-white rounded-lg shadow sm:p-5">
            <button type="button"
                    class="tep-delete-close text-gray-400 absolute top-2.5 right-2.5 bg-transparent rounded-lg text-sm p-1.5 inline-flex items-center"
                    onclick="teamMembersCloseDeleteModal()">
              <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
              <span class="sr-only">Close modal</span>
            </button>
            <svg class="text-gray-400 w-11 h-11 mb-3.5 mx-auto" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
            </svg>
            <p class="mb-4 text-gray-500">Are you sure you want to delete this member assignment?</p>
            <div class="flex justify-center items-center space-x-4">
              <button type="button" onclick="teamMembersConfirmDelete()" class="tep-delete-confirm py-2 px-3 text-sm font-medium text-center text-white rounded-lg bg-red-600">
                Delete
              </button>
              <button type="button"
                      onclick="teamMembersCloseDeleteModal()"
                      class="tep-delete-cancel py-2 px-3 text-sm font-medium text-gray-500 bg-white rounded-lg border border-gray-200">
                Cancel
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="taTeamMemberMoveModal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 right-0 left-0 z-[10000] justify-center items-center w-full h-full bg-gray-900/50">
        <div class="relative p-4 w-full max-w-lg">
          <div class="relative bg-white rounded-xl shadow-lg border border-gray-200">
            <div class="flex items-center justify-between p-4 border-b">
              <h3 class="text-lg font-bold text-gray-900">Move Team Member</h3>
              <button type="button" onclick="teamManagementCloseMoveModal()" class="ta-modal-close-btn text-gray-400 hover:text-gray-900 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
            <div class="p-6">
              <div class="mb-6 rounded-lg bg-blue-50 p-4 border border-blue-100">
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 rounded-full bg-blue-500 p-1 text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-blue-900">Moving <span id="ta-move-member-name" class="font-bold"></span></p>
                    <p class="text-xs text-blue-700 mt-1">To team: <span id="ta-move-target-team-name" class="font-bold"></span></p>
                  </div>
                </div>
              </div>

              <div class="space-y-3">
                <label class="relative flex cursor-pointer rounded-xl border border-gray-200 p-4 transition-all hover:bg-gray-50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
                  <input type="radio" name="ta_move_mode" value="move" checked class="mt-1 h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500">
                  <div class="ml-3">
                    <span class="block text-sm font-bold text-gray-900">Remove and Move</span>
                    <span class="mt-1 block text-xs text-gray-500">Deletes from current team and adds to new team. Start date defaults to previous start date.</span>
                  </div>
                </label>

                <label class="relative flex cursor-pointer rounded-xl border border-gray-200 p-4 transition-all hover:bg-gray-50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
                  <input type="radio" name="ta_move_mode" value="inactivate_and_add" class="mt-1 h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500">
                  <div class="ml-3">
                    <span class="block text-sm font-bold text-gray-900">Inactivate and Move</span>
                    <span class="mt-1 block text-xs text-gray-500">Keeps history in current team (with end date) and starts new membership. Defaults to today.</span>
                  </div>
                </label>
              </div>

              <div class="mt-4 border-t border-gray-100 pt-4">
                <label for="ta-move-start-date" class="mb-1.5 block text-sm font-medium text-gray-700">Start date in new team</label>
                <input type="text"
                       id="ta-move-start-date"
                       autocomplete="off"
                       placeholder="mm/dd/yyyy"
                       datepicker
                       datepicker-format="mm/dd/yyyy"
                       datepicker-autohide
                       class="ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]">
                <p id="ta-move-date-hint" class="mt-1.5 text-xs text-gray-500"></p>
              </div>
            </div>
            <div class="flex items-center justify-end gap-3 p-4 border-t bg-gray-50 rounded-b-xl">
              <button type="button" onclick="teamManagementCloseMoveModal()" class="ta-btn-secondary rounded-lg px-4 py-2 text-sm font-medium transition-colors">Cancel</button>
              <button type="button" onclick="teamManagementConfirmMove()" class="ta-btn-primary rounded-lg px-4 py-2 text-sm font-medium transition-colors shadow-sm">Confirm Move</button>
            </div>
          </div>
        </div>
      </div>

      <div id="taTeamAssignModal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 right-0 left-0 z-[10000] justify-center items-center w-full h-full bg-gray-900/50">
        <div class="relative p-4 w-full max-w-lg">
          <div class="relative bg-white rounded-xl shadow-lg border border-gray-200">
            <div class="flex items-center justify-between p-4 border-b">
              <h3 class="text-lg font-bold text-gray-900">Add to Team</h3>
              <button type="button" onclick="teamAssignCloseModal()" class="ta-modal-close-btn text-gray-400 hover:text-gray-900 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
            </div>
            <div class="p-6">
              <div class="mb-6 rounded-lg bg-blue-50 p-4 border border-blue-100">
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 rounded-full bg-blue-500 p-1 text-white">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-blue-900">Adding <span id="ta-assign-member-name" class="font-bold"></span></p>
                    <p class="text-xs text-blue-700 mt-1">To team: <span id="ta-assign-target-team-name" class="font-bold"></span></p>
                  </div>
                </div>
              </div>

              <div>
                <label for="ta-assign-start-date" class="mb-1.5 block text-sm font-medium text-gray-700">Start date</label>
                <input type="text"
                       id="ta-assign-start-date"
                       autocomplete="off"
                       placeholder="mm/dd/yyyy"
                       datepicker
                       datepicker-format="mm/dd/yyyy"
                       datepicker-autohide
                       class="ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]">
              </div>

              <div class="mt-4">
                <label for="ta-assign-end-date" class="mb-1.5 block text-sm font-medium text-gray-700">End date <span class="text-gray-400 font-normal">(optional)</span></label>
                <input type="text"
                       id="ta-assign-end-date"
                       autocomplete="off"
                       placeholder="mm/dd/yyyy"
                       datepicker
                       datepicker-format="mm/dd/yyyy"
                       datepicker-autohide
                       class="ta-team-field ts-search-input !block !h-[43px] !w-full !rounded-lg !border !border-gray-300 !bg-white !px-3 !py-0 !text-sm !text-gray-900 !shadow-none focus:!outline-none focus:!ring-2 focus:!ring-[#3b82f6] focus:!border-[#3b82f6]">
              </div>
            </div>
            <div class="flex items-center justify-end gap-3 p-4 border-t bg-gray-50 rounded-b-xl">
              <button type="button" onclick="teamAssignCloseModal()" class="ta-btn-secondary rounded-lg px-4 py-2 text-sm font-medium transition-colors">Cancel</button>
              <button type="button" onclick="teamAssignConfirm()" class="ta-btn-primary rounded-lg px-4 py-2 text-sm font-medium transition-colors shadow-sm">Confirm Add</button>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div id="ta-team-splitter-controls"
         class="hidden xl:flex"
         role="separator"
         aria-label="Resize panel widths"
         aria-orientation="vertical"
         title="Drag to resize panels">
      <span id="ta-team-splitter-handle" class="ta-team-splitter-handle" aria-hidden="true"></span>
    </div>

    <aside id="ta-team-sidebar-column">
      <div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden xl:flex ta-team-xl-h-780 xl:flex-col">
        <div class="border-b border-gray-200 px-4 pt-2">
          <ul class="-mb-px flex flex-wrap text-sm font-medium text-center">
            <li class="me-2">
              <button type="button" id="team-sidebar-members-tab" data-team-tab-target="team-sidebar-members-panel" class="ta-view-tab inline-block rounded-t-lg p-4 ta-view-tab-active">
                <span class="inline-flex items-center gap-2">
                  <svg class="h-4 w-4 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M15 19a4 4 0 0 0-8 0"></path>
                    <path d="M11 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z"></path>
                    <path d="M17 8h4"></path>
                    <path d="M19 6v4"></path>
                  </svg>
                  <span>Active</span>
                  <span class="ts-tab-badge"><%= @unallocated_users.size %></span>
                </span>
              </button>
            </li>
            <li class="me-2">
              <button type="button" id="team-sidebar-locked-tab" data-team-tab-target="team-sidebar-locked-panel" class="ta-view-tab inline-block rounded-t-lg p-4 text-gray-500 hover:text-gray-600 hover:bg-gray-50">
                <span class="inline-flex items-center gap-2">
                  <svg class="h-4 w-4 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <span>Locked</span>
                  <span class="ts-tab-badge"><%= @locked_users.size %></span>
                </span>
              </button>
            </li>
            <li class="me-2">
              <button type="button" id="team-sidebar-vacancies-tab" data-team-tab-target="team-sidebar-vacancies-panel" class="ta-view-tab inline-block rounded-t-lg p-4 text-gray-500 hover:text-gray-600 hover:bg-gray-50">
                <span class="inline-flex items-center gap-2">
                  <svg class="h-4 w-4 flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M10 21h4"></path>
                    <path d="M12 21v-6"></path>
                    <path d="M7 7h10a2 2 0 0 1 2 2v7H5V9a2 2 0 0 1 2-2Z"></path>
                    <path d="M9 7V6a3 3 0 0 1 6 0v1"></path>
                  </svg>
                  <span>Open Positions</span>
                  <span class="ts-tab-badge"><%= @open_hiring_needs.size %></span>
                </span>
              </button>
            </li>
          </ul>
        </div>

        <div id="team-sidebar-members-panel" class="p-4 ta-team-sidebar-panel xl:flex-1 xl:min-h-0">
          <div class="max-h-[760px] ta-team-xl-max-h-760 space-y-3 overflow-y-scroll overflow-x-hidden pr-1 ta-stable-scroll xl:flex-1 xl:min-h-0">
            <% if @unallocated_users.any? %>
              <% @unallocated_users.each_with_index do |user, i| %>
                <%= render 'member_assign_card', user: user, idx: "unassigned-#{i}",
                      all_teams: @all_teams,
                      default_start_date: Date.today.strftime('%m/%d/%Y'),
                      default_end_date: '',
                      sidebar_tab: 'members' %>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No unassigned members.</p>
            <% end %>
          </div>
        </div>

        <div id="team-sidebar-locked-panel" class="hidden p-4 ta-team-sidebar-panel xl:flex-1 xl:min-h-0">
          <div class="max-h-[760px] ta-team-xl-max-h-760 space-y-3 overflow-y-scroll overflow-x-hidden pr-1 ta-stable-scroll xl:flex-1 xl:min-h-0">
            <% if @locked_users.any? %>
              <% @locked_users.each_with_index do |user, i| %>
                <%= render 'member_assign_card', user: user, idx: "locked-#{i}",
                      all_teams: @all_teams,
                      default_start_date: user.created_on.to_date.strftime('%m/%d/%Y'),
                      default_end_date: (@locked_user_lock_dates[user.id] || user.updated_on.to_date).strftime('%m/%d/%Y'),
                      sidebar_tab: 'locked' %>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No locked members.</p>
            <% end %>
          </div>
        </div>

        <div id="team-sidebar-vacancies-panel" class="hidden p-4 ta-team-sidebar-panel xl:flex-1 xl:min-h-0">
          <div class="max-h-[760px] ta-team-xl-max-h-760 space-y-2 overflow-y-scroll overflow-x-hidden pr-1 ta-stable-scroll xl:flex-1 xl:min-h-0">
            <% if @open_hiring_needs.any? %>
              <% @open_hiring_needs.each do |need| %>
                <% team_name = need.team&.name.presence || 'Deleted Team' %>
                <div class="rounded-lg border border-gray-200 p-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-gray-900"><%= h(need.title) %></p>
                      <p class="text-xs text-gray-500"><%= h(team_name) %></p>
                      <p class="mt-1 text-xs font-medium text-blue-700">Priority: <%= need.priority.titleize %></p>
                    </div>
                    <%= button_to mark_filled_admin_ta_hiring_need_path(need), method: :patch, params: { sidebar_tab: 'vacancies' }, class: 'ta-vacancy-action-button inline-flex items-center rounded-lg bg-emerald-700 px-3 py-2 text-center text-xs font-medium text-white hover:bg-emerald-800 focus:outline-none focus:ring-4 focus:ring-emerald-300', form_class: 'shrink-0' do %>
                      <svg class="mr-1.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Fill Hired
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-500">No open positions.</p>
            <% end %>
          </div>
        </div>
      </div>
    </aside>
  </div>

</div>


<script type="text/javascript">
  function normalizeTeamMemberDate(value) {
    if (!value) return value;
    var yyyymmdd = value.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (yyyymmdd) return value;
    var mmddyyyy = value.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!mmddyyyy) return value;
    return mmddyyyy[3] + '-' + mmddyyyy[1].padStart(2, '0') + '-' + mmddyyyy[2].padStart(2, '0');
  }

  var teamMembersAddModalState = {
    parent: null,
    nextSibling: null
  };

  function teamHistoryVisibleMemberRows() {
    return Array.from(document.querySelectorAll('#team-main-panel-members .ta-member-history-group-row')).filter(function(row) {
      return row.style.display !== 'none';
    });
  }

  function teamHistoryDatepickerOrientationForRow(row) {
    var visibleRows = teamHistoryVisibleMemberRows();
    var rowIndex = visibleRows.indexOf(row);
    return rowIndex >= 0 && rowIndex < 5 ? 'bottom auto' : 'top auto';
  }

  function initTeamMemberInlineDatepickers(membershipId) {
    var row = document.querySelector('.ta-member-history-group-row[data-membership-id="' + membershipId + '"]');
    var input = document.getElementById('ta-team-member-start-date-' + membershipId);
    if (!input) return;
    var orientation = teamHistoryDatepickerOrientationForRow(row);
    if (input.datepicker && input.datepicker.setOptions) {
      input.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true, orientation: orientation });
      return;
    }
    if (window.Datepicker) {
      new window.Datepicker(input, {
        format: 'mm/dd/yyyy',
        autohide: true,
        orientation: orientation
      });
    }
  }

  function toggleTeamMemberInlineEdit(membershipId) {
    var row = document.querySelector('.ta-member-history-group-row[data-membership-id="' + membershipId + '"]');
    if (!row) return;
    var shouldOpen = !row.classList.contains('is-editing');
    document.querySelectorAll('.ta-member-history-group-row.is-editing').forEach(function(editRow) {
      editRow.classList.remove('is-editing');
      editRow.querySelectorAll('.ta-team-member-view').forEach(function(viewEl) {
        viewEl.classList.remove('hidden');
      });
      editRow.querySelectorAll('.ta-team-member-edit').forEach(function(editEl) {
        editEl.classList.add('hidden');
      });
      teamMembersCloseRoleDropdownByRow(editRow);
    });
    if (shouldOpen) {
      row.classList.add('is-editing');
      row.querySelectorAll('.ta-team-member-view').forEach(function(viewEl) {
        viewEl.classList.add('hidden');
      });
      row.querySelectorAll('.ta-team-member-edit').forEach(function(editEl) {
        editEl.classList.remove('hidden');
      });
      initTeamMemberInlineDatepickers(membershipId);
      var roleButton = document.getElementById('ta-team-member-role-btn-' + membershipId);
      if (roleButton) roleButton.focus();
    }
  }

  var teamMembersDropdownState = {};

  function teamMembersEnsureDropdownState(list) {
    if (!list || !list.id) return null;
    if (!teamMembersDropdownState[list.id]) {
      teamMembersDropdownState[list.id] = {
        parent: list.parentNode,
        nextSibling: list.nextSibling,
        anchorId: null
      };
    }
    return teamMembersDropdownState[list.id];
  }

  function teamMembersPositionFloatingDropdown(list, anchor) {
    if (!list || !anchor) return;
    var rect = anchor.getBoundingClientRect();
    var minWidth = parseFloat(list.style.minWidth || '0') || 0;
    var targetWidth = Math.max(Math.round(rect.width), Math.round(minWidth));
    var viewportPadding = 8;
    var preferredHeight = Math.min(list.scrollHeight || 180, 260);
    var spaceBelow = Math.max(0, window.innerHeight - rect.bottom - viewportPadding);
    var spaceAbove = Math.max(0, rect.top - viewportPadding);
    var openUp = spaceBelow < 140 && spaceAbove > spaceBelow;
    var maxHeight = Math.max(100, openUp ? spaceAbove : spaceBelow);

    list.style.position = 'fixed';
    var left = Math.max(viewportPadding, rect.left);
    if (left + targetWidth > window.innerWidth - viewportPadding) {
      left = Math.max(viewportPadding, window.innerWidth - viewportPadding - targetWidth);
    }
    list.style.left = left + 'px';
    list.style.width = targetWidth + 'px';
    list.style.maxHeight = Math.min(preferredHeight, maxHeight) + 'px';
    list.style.top = openUp ? 'auto' : (rect.bottom + 2) + 'px';
    list.style.bottom = openUp ? (window.innerHeight - rect.top + 2) + 'px' : 'auto';
    list.style.zIndex = '10050';
  }

  function teamMembersOpenFloatingDropdown(list, anchor) {
    if (!list || !anchor || !list.id || !anchor.id) return;
    var state = teamMembersEnsureDropdownState(list);
    if (!state) return;
    state.anchorId = anchor.id;
    if (list.parentNode !== document.body) {
      document.body.appendChild(list);
    }
    list.classList.remove('hidden');
    teamMembersPositionFloatingDropdown(list, anchor);
  }

  function teamMembersCloseFloatingDropdown(list) {
    if (!list || !list.id) return;
    var state = teamMembersDropdownState[list.id];
    list.classList.add('hidden');
    if (!state || !state.parent) return;
    if (list.parentNode !== state.parent) {
      state.parent.insertBefore(list, state.nextSibling);
    }
    state.anchorId = null;
    list.style.position = '';
    list.style.left = '';
    list.style.top = '';
    list.style.bottom = '';
    list.style.width = '';
    list.style.maxHeight = '';
    list.style.zIndex = '';
  }

  function teamMembersSyncFloatingDropdownPositions() {
    Object.keys(teamMembersDropdownState).forEach(function(listId) {
      var list = document.getElementById(listId);
      var state = teamMembersDropdownState[listId];
      if (!list || !state || list.classList.contains('hidden') || !state.anchorId) return;
      var anchor = document.getElementById(state.anchorId);
      if (!anchor) {
        teamMembersCloseFloatingDropdown(list);
        return;
      }
      teamMembersPositionFloatingDropdown(list, anchor);
    });
  }

  if (!window.__teamMembersFloatingDropdownListenersBound) {
    window.addEventListener('resize', teamMembersSyncFloatingDropdownPositions);
    document.addEventListener('scroll', teamMembersSyncFloatingDropdownPositions, true);
    window.__teamMembersFloatingDropdownListenersBound = true;
  }

  function teamMembersCloseRoleDropdown(membershipId) {
    var list = document.getElementById('ta-team-member-role-list-' + membershipId);
    if (list) teamMembersCloseFloatingDropdown(list);
  }

  function teamMembersCloseRoleDropdownByRow(row) {
    if (!row) return;
    var membershipId = row.getAttribute('data-membership-id');
    if (membershipId) teamMembersCloseRoleDropdown(membershipId);
  }

  function teamMembersCloseAllRoleDropdowns() {
    document.querySelectorAll('[id^="ta-team-member-role-list-"]').forEach(function(list) {
      teamMembersCloseFloatingDropdown(list);
    });
  }

  function toggleTeamMemberRoleDropdown(membershipId) {
    var list = document.getElementById('ta-team-member-role-list-' + membershipId);
    var anchor = document.getElementById('ta-team-member-role-btn-' + membershipId);
    if (!list || !anchor) return;
    if (list.classList.contains('hidden')) {
      teamMembersCloseAllRoleDropdowns();
      teamMembersOpenFloatingDropdown(list, anchor);
    } else {
      teamMembersCloseFloatingDropdown(list);
    }
  }

  function teamMembersSelectRole(membershipId, role, label) {
    var hidden = document.getElementById('ta-team-member-role-' + membershipId);
    var text = document.getElementById('ta-team-member-role-text-' + membershipId);
    if (hidden) hidden.value = role;
    if (text) {
      text.textContent = label;
      text.classList.remove('text-gray-400');
      text.classList.add('text-gray-700');
    }
    teamMembersCloseRoleDropdown(membershipId);
  }

  function submitTeamMemberInlineEdit(membershipId) {
    var startInput = document.getElementById('ta-team-member-start-date-' + membershipId);
    if (startInput) startInput.value = normalizeTeamMemberDate(startInput.value);
    var pageInput = document.getElementById('ta-member-history-page-' + membershipId);
    var sidebarTabInput = document.getElementById('ta-member-history-sidebar-tab-' + membershipId);
    var mainTabInput = document.getElementById('ta-member-history-main-tab-' + membershipId);
    if (pageInput && teamHistoryPagination.member) pageInput.value = teamHistoryPagination.member.currentPage;
    if (sidebarTabInput) {
      sidebarTabInput.value = document.querySelector('#team-sidebar-vacancies-panel:not(.hidden)') ? 'vacancies' : 'members';
    }
    if (mainTabInput) mainTabInput.value = document.querySelector('#team-main-panel-members:not(.hidden)') ? 'members' : 'structure';
    return true;
  }

  var teamMembersPendingDelete = null;

  function teamMembersOpenDeleteModal() {
    var modal = document.getElementById('taTeamMembersDeleteModal');
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function teamMembersCloseDeleteModal() {
    var modal = document.getElementById('taTeamMembersDeleteModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  function teamMembersDelete(membershipId, url, token) {
    var mainTab = arguments.length > 3 ? arguments[3] : null;
    var page = teamHistoryPagination.member ? teamHistoryPagination.member.currentPage : null;
    var sidebarTab = document.querySelector('#team-sidebar-vacancies-panel:not(.hidden)') ? 'vacancies' : 'members';
    teamMembersPendingDelete = { membershipId: membershipId, url: url, token: token, mainTab: mainTab, page: page, sidebarTab: sidebarTab };
    teamMembersOpenDeleteModal();
  }

  function teamMembersConfirmDelete() {
    if (!teamMembersPendingDelete) return;
    teamMembersCloseDeleteModal();

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = teamMembersPendingDelete.url;
    [['authenticity_token', teamMembersPendingDelete.token], ['_method', 'DELETE']].forEach(function(pair) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = pair[0];
      input.value = pair[1];
      form.appendChild(input);
    });
    if (teamMembersPendingDelete.mainTab) {
      var tabInput = document.createElement('input');
      tabInput.type = 'hidden';
      tabInput.name = 'main_tab';
      tabInput.value = teamMembersPendingDelete.mainTab;
      form.appendChild(tabInput);
    }
    if (teamMembersPendingDelete.sidebarTab) {
      var sidebarTabInput = document.createElement('input');
      sidebarTabInput.type = 'hidden';
      sidebarTabInput.name = 'sidebar_tab';
      sidebarTabInput.value = teamMembersPendingDelete.sidebarTab;
      form.appendChild(sidebarTabInput);
    }
    if (teamMembersPendingDelete.page) {
      var pageInput = document.createElement('input');
      pageInput.type = 'hidden';
      pageInput.name = 'page';
      pageInput.value = teamMembersPendingDelete.page;
      form.appendChild(pageInput);
    }
    document.body.appendChild(form);
    form.submit();
  }

  function teamHistoryCloseMemberEditingState() {
    document.querySelectorAll('.ta-member-history-group-row.is-editing').forEach(function(editRow) {
      editRow.classList.remove('is-editing');
      editRow.querySelectorAll('.ta-team-member-view').forEach(function(viewEl) {
        viewEl.classList.remove('hidden');
      });
      editRow.querySelectorAll('.ta-team-member-edit').forEach(function(editEl) {
        editEl.classList.add('hidden');
      });
      teamMembersCloseRoleDropdownByRow(editRow);
    });
  }

  function resetMemberHistorySortIcons(activeColumn) {
    var columns = ['name', 'team', 'start-date', 'last-updated'];
    columns.forEach(function(column) {
      var icon = document.getElementById('ta-member-history-sort-icon-' + column);
      if (!icon) return;

      if (column !== activeColumn) {
        delete icon.dataset.order;
      }
      var order = icon.dataset.order || 'desc';
      icon.className = order === 'asc' ? 'sort asc icon icon-sorted-desc' : 'sort desc icon icon-sorted-asc';
    });
  }

  var teamManagementMoveState = {
    membershipId: null,
    userId: null,
    userName: null,
    sourceTeamId: null,
    targetTeamId: null,
    targetTeamName: null,
    memberStartDate: null
  };

  function teamManagementHandleDragStart(event) {
    var target = event.currentTarget;
    var data = {
      membershipId: target.dataset.membershipId,
      userId: target.dataset.userId,
      userName: target.dataset.userName,
      teamId: target.dataset.teamId,
      startDate: target.dataset.startDate || ''
    };
    event.dataTransfer.setData('application/json', JSON.stringify(data));
    event.dataTransfer.effectAllowed = 'move';
    
    // Optional: add a class to the element being dragged
    target.classList.add('opacity-50');
    
    // Clear tooltip if any
    var tooltipId = target.dataset.tooltipTarget;
    if (tooltipId) {
      var tooltip = document.getElementById(tooltipId);
      if (tooltip) tooltip.classList.add('invisible', 'opacity-0');
    }
  }

  function teamManagementHandleDragOver(event) {
    event.preventDefault();
    event.dataTransfer.dropEffect = 'move';
    var target = event.currentTarget;
    if (target.classList.contains('ta-team-dropzone')) {
      target.classList.add('ta-team-dropzone--active');
    }
  }

  function teamManagementHandleDragLeave(event) {
    var target = event.currentTarget;
    target.classList.remove('ta-team-dropzone--active');
  }

  function teamManagementHandleDrop(event) {
    event.preventDefault();
    var target = event.currentTarget;
    target.classList.remove('ta-team-dropzone--active');

    var jsonData = event.dataTransfer.getData('application/json');
    if (!jsonData) return;

    var data = JSON.parse(jsonData);
    var targetTeamId = target.dataset.teamId;
    var targetTeamName = target.dataset.teamName;

    // Don't do anything if dropped on the same team
    if (data.teamId == targetTeamId) return;

    teamManagementMoveState = {
      membershipId: data.membershipId,
      userId: data.userId,
      userName: data.userName,
      sourceTeamId: data.teamId,
      targetTeamId: targetTeamId,
      targetTeamName: targetTeamName,
      memberStartDate: data.startDate || ''
    };

    teamManagementOpenMoveModal();
  }

  function teamManagementGetTodayFormatted() {
    var today = new Date();
    var mm = String(today.getMonth() + 1).padStart(2, '0');
    var dd = String(today.getDate()).padStart(2, '0');
    var yyyy = today.getFullYear();
    return mm + '/' + dd + '/' + yyyy;
  }

  function teamManagementUpdateMoveDateDefault() {
    var checked = document.querySelector('input[name="ta_move_mode"]:checked');
    var moveMode = checked ? checked.value : 'move';
    var dateInput = document.getElementById('ta-move-start-date');
    var hint = document.getElementById('ta-move-date-hint');
    if (!dateInput) return;

    var newDate;
    if (moveMode === 'move') {
      newDate = teamManagementMoveState.memberStartDate || teamManagementGetTodayFormatted();
      if (hint) hint.textContent = 'Defaults to the member\'s previous start date. Change if needed.';
    } else {
      newDate = teamManagementGetTodayFormatted();
      if (hint) hint.textContent = 'This date will also be set as the end date for the current team.';
    }

    dateInput.value = newDate;
    if (dateInput.datepicker && dateInput.datepicker.setDate) {
      try { dateInput.datepicker.setDate(newDate); } catch (e) {}
    }
  }

  function teamManagementInitMoveDatepicker() {
    var dateInput = document.getElementById('ta-move-start-date');
    if (!dateInput) return;
    if (dateInput.datepicker && dateInput.datepicker.setOptions) {
      dateInput.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
      return;
    }
    if (window.Datepicker) {
      new window.Datepicker(dateInput, { format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
    }
    if (!dateInput.dataset.moveDatepickerLayerBound) {
      ['focus', 'click'].forEach(function(eventName) {
        dateInput.addEventListener(eventName, function() {
          setTimeout(function() {
            document.querySelectorAll('.datepicker, .datepicker-dropdown, .datepicker-picker').forEach(function(el) {
              el.style.zIndex = '12000';
            });
          }, 0);
        });
      });
      dateInput.dataset.moveDatepickerLayerBound = '1';
    }
  }

  function teamManagementOpenMoveModal() {
    var modal = document.getElementById('taTeamMemberMoveModal');
    if (!modal) return;

    document.getElementById('ta-move-member-name').textContent = teamManagementMoveState.userName;
    document.getElementById('ta-move-target-team-name').textContent = teamManagementMoveState.targetTeamName;

    // Reset to default mode (Remove and Move)
    var defaultRadio = modal.querySelector('input[name="ta_move_mode"][value="move"]');
    if (defaultRadio) defaultRadio.checked = true;

    teamManagementUpdateMoveDateDefault();
    teamManagementInitMoveDatepicker();

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function teamManagementCloseMoveModal() {
    var modal = document.getElementById('taTeamMemberMoveModal');
    if (!modal) return;

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
    
    // Remove drag opacity from all chips just in case
    document.querySelectorAll('.ta-team-member-chip').forEach(function(chip) {
      chip.classList.remove('opacity-50');
    });
  }

  function teamManagementConfirmMove() {
    var moveMode = document.querySelector('input[name="ta_move_mode"]:checked').value;
    var membershipId = teamManagementMoveState.membershipId;
    var targetTeamId = teamManagementMoveState.targetTeamId;
    var sourceTeamId = teamManagementMoveState.sourceTeamId;

    var dateInput = document.getElementById('ta-move-start-date');
    var startDate = dateInput ? normalizeTeamMemberDate(dateInput.value.trim()) : '';

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/ta_teams/' + sourceTeamId + '/memberships/' + membershipId + '/move';

    var tokenInput = document.createElement('input');
    tokenInput.type = 'hidden';
    tokenInput.name = 'authenticity_token';
    tokenInput.value = '<%= form_authenticity_token %>';
    form.appendChild(tokenInput);

    var targetTeamInput = document.createElement('input');
    targetTeamInput.type = 'hidden';
    targetTeamInput.name = 'target_team_id';
    targetTeamInput.value = targetTeamId;
    form.appendChild(targetTeamInput);

    var moveModeInput = document.createElement('input');
    moveModeInput.type = 'hidden';
    moveModeInput.name = 'move_mode';
    moveModeInput.value = moveMode;
    form.appendChild(moveModeInput);

    if (startDate) {
      var startDateInput = document.createElement('input');
      startDateInput.type = 'hidden';
      startDateInput.name = 'start_date';
      startDateInput.value = startDate;
      form.appendChild(startDateInput);
    }

    document.body.appendChild(form);
    form.submit();
  }

  var teamAssignState = {
    userId: null,
    userName: null,
    teamId: null,
    teamName: null,
    role: 'member',
    sidebarTab: '',
    defaultStartDate: '',
    defaultEndDate: ''
  };

  function teamAssignInitDatepickers() {
    ['ta-assign-start-date', 'ta-assign-end-date'].forEach(function(id) {
      var input = document.getElementById(id);
      if (!input) return;
      if (input.datepicker && input.datepicker.setOptions) {
        input.datepicker.setOptions({ format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
      } else if (window.Datepicker) {
        new window.Datepicker(input, { format: 'mm/dd/yyyy', autohide: true, orientation: 'top auto' });
      }
      if (!input.dataset.assignDatepickerLayerBound) {
        ['focus', 'click'].forEach(function(eventName) {
          input.addEventListener(eventName, function() {
            setTimeout(function() {
              document.querySelectorAll('.datepicker, .datepicker-dropdown, .datepicker-picker').forEach(function(el) {
                el.style.zIndex = '12000';
              });
            }, 0);
          });
        });
        input.dataset.assignDatepickerLayerBound = '1';
      }
    });
  }

  function teamAssignSetDateValue(inputId, value) {
    var input = document.getElementById(inputId);
    if (!input) return;
    input.value = value || '';
    if (input.datepicker && input.datepicker.setDate) {
      try {
        if (value) {
          input.datepicker.setDate(value);
        } else {
          input.datepicker.setDate({ clear: true });
        }
      } catch (e) {}
    }
  }

  function teamAssignOpenModal(state) {
    var modal = document.getElementById('taTeamAssignModal');
    if (!modal) return;

    teamAssignState = {
      userId: state.userId,
      userName: state.userName,
      teamId: state.teamId,
      teamName: state.teamName,
      role: state.role || 'member',
      sidebarTab: state.sidebarTab || '',
      defaultStartDate: state.defaultStartDate || '',
      defaultEndDate: state.defaultEndDate || ''
    };

    document.getElementById('ta-assign-member-name').textContent = teamAssignState.userName;
    document.getElementById('ta-assign-target-team-name').textContent = teamAssignState.teamName;

    teamAssignInitDatepickers();
    teamAssignSetDateValue('ta-assign-start-date', teamAssignState.defaultStartDate || teamManagementGetTodayFormatted());
    teamAssignSetDateValue('ta-assign-end-date', teamAssignState.defaultEndDate);

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
  }

  function teamAssignCloseModal() {
    var modal = document.getElementById('taTeamAssignModal');
    if (!modal) return;

    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');

    document.querySelectorAll('.ta-unallocated-member-card').forEach(function(card) {
      card.classList.remove('ta-dragging');
    });
  }

  function teamAssignAppendHiddenInput(form, name, value) {
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = name;
    input.value = value;
    form.appendChild(input);
  }

  function teamAssignConfirm() {
    var startInput = document.getElementById('ta-assign-start-date');
    var endInput = document.getElementById('ta-assign-end-date');
    var startDate = startInput ? normalizeTeamMemberDate(startInput.value.trim()) : '';
    var endDate = endInput ? normalizeTeamMemberDate(endInput.value.trim()) : '';

    if (!startDate) {
      alert('Please select a start date.');
      return;
    }

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '<%= assign_member_admin_ta_teams_path %>';

    teamAssignAppendHiddenInput(form, 'authenticity_token', '<%= form_authenticity_token %>');
    teamAssignAppendHiddenInput(form, 'user_id', teamAssignState.userId);
    teamAssignAppendHiddenInput(form, 'team_id', teamAssignState.teamId);
    teamAssignAppendHiddenInput(form, 'role', teamAssignState.role);
    teamAssignAppendHiddenInput(form, 'start_date', startDate);
    if (endDate) {
      teamAssignAppendHiddenInput(form, 'end_date', endDate);
    }
    if (teamAssignState.sidebarTab) {
      teamAssignAppendHiddenInput(form, 'sidebar_tab', teamAssignState.sidebarTab);
    }

    document.body.appendChild(form);
    form.submit();
  }

  function openAssignModalFromCard(idx) {
    var teamField = document.getElementById('assign_team_' + idx);
    var roleField = document.getElementById('assign_role_' + idx);
    var teamLabelEl = document.querySelector('#assign-team-button-' + idx + ' .assign-team-label');
    var card = teamField ? teamField.closest('.ta-unallocated-member-card') : null;
    if (!teamField || !teamField.value) {
      alert('Please select a team.');
      return;
    }
    if (!card) return;

    teamAssignOpenModal({
      userId: card.getAttribute('data-user-id'),
